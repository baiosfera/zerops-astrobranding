#!/usr/bin/env python3
"""
orchesbrand — Sovereign Agnostic Brand Pipeline CLI (v3.0) for Zerops Astrobranding.
100% Brand-Agnostic | Non-Destructive Brandbook Merge | Zero Phantom Directories.
Coordinates chroma_engine.py, fontgen_engine.py, envato_font_preview.py, and brandbook CSS/JSON.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


SCRIPTS_CANDIDATES = [
    Path("/var/www/zerops-astrobranding/scripts"),
    Path(__file__).resolve().parent.parent / "scripts",
]


def resolve_script(name: str) -> Path:
    for d in SCRIPTS_CANDIDATES:
        cand = d / name
        if cand.exists():
            return cand
    return SCRIPTS_CANDIDATES[0] / name


def find_project_dev_dir(project_name: Optional[str] = None) -> Optional[Path]:
    pname = (project_name or os.getenv("PROJECT_NAME") or os.getenv("ENGRAM_PROJECT") or "").strip()
    if not pname:
        return None
    for root in (Path("/mnt/localstorage"), Path("/var/www/localstorage"), Path("/var/www/baiosfera/PROYECTOS")):
        if not root.exists():
            continue
        direct = root / pname / "dev"
        if direct.exists():
            return direct
        try:
            for ch in root.iterdir():
                if ch.is_dir() and ch.name.lower() == pname.lower() and (ch / "dev").exists():
                    return ch / "dev"
        except Exception:
            pass
    return None


def resolve_brief_and_brand(brand: Optional[str], project_dir: Optional[Path], vertical: Optional[str]) -> Tuple[str, Optional[Path]]:
    """Discovers umbrella astrobranding_*.md and brand name dynamically without inventing data."""
    candidates: List[Path] = []
    if project_dir and project_dir.exists():
        if brand:
            candidates.append(project_dir / f"astrobranding_{brand.lower()}.md")
        candidates.extend(sorted(project_dir.glob("astrobranding_*.md")))
        if vertical:
            candidates.extend(sorted((project_dir / "workspaces" / vertical / "brand").glob("astrobranding_*.md")))

    if brand:
        b_up = re.sub(r"[^a-zA-Z0-9_-]+", "", brand).upper()
        candidates.append(Path(f"/var/www/baiosfera/ASTROLOGÍA/DIAG/{b_up}/astrobranding_{brand.lower()}.md"))

    brief = next((c for c in candidates if c.is_file()), None)
    resolved_brand = brand
    if not resolved_brand and brief:
        resolved_brand = brief.stem.replace("astrobranding_", "").upper()
    if not resolved_brand and project_dir:
        eco_file = project_dir / "ecosystem.json"
        if eco_file.exists():
            try:
                edata = json.loads(eco_file.read_text(encoding="utf-8"))
                resolved_brand = (edata.get("umbrella_name") or edata.get("brand_slug") or project_dir.parent.name).upper()
            except Exception:
                pass
    return (resolved_brand or "BRAND").upper(), brief


def deep_merge_non_destructive(base: Dict[str, Any], updates: Dict[str, Any]) -> Dict[str, Any]:
    out = dict(base)
    for k, v in updates.items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = deep_merge_non_destructive(out[k], v)
        else:
            out[k] = v
    return out


def merge_brandbook_non_destructive(
    target_dir: Path,
    project_dir: Optional[Path],
    brand: str,
    vertical: Optional[str],
    vertical_json_path: Optional[Path] = None,
) -> Tuple[Path, Path]:
    """
    Merges verified Chroma & Fontgen design tokens (plus vertical_context when supplied)
    into workspace brandbook.json WITHOUT overwriting metadata, brand_architecture,
    voice_tone_and_messaging, lexicon, or target_audience.
    """
    bb_path = target_dir / "brandbook.json"
    existing: Dict[str, Any] = {}
    for cand in (bb_path, project_dir / "brandbook.json" if project_dir else None):
        if cand and cand.is_file():
            try:
                loaded = json.loads(cand.read_text(encoding="utf-8"))
                if isinstance(loaded, dict) and (len(loaded) > 3 or "brand_architecture" in loaded):
                    existing = loaded
                    break
            except Exception:
                pass
        if cand and not existing and cand.is_file():
            try:
                loaded = json.loads(cand.read_text(encoding="utf-8"))
                if isinstance(loaded, dict):
                    existing = loaded
            except Exception:
                pass

    # If existing came from legacy broken stub (< 4 keys and missing brand_architecture), pull umbrella core from project_dir
    if project_dir and "brand_architecture" not in existing:
        umb = project_dir / "brandbook.json"
        if umb.is_file() and umb.resolve() != bb_path.resolve():
            try:
                uload = json.loads(umb.read_text(encoding="utf-8"))
                if isinstance(uload, dict) and "brand_architecture" in uload:
                    existing = deep_merge_non_destructive(uload, existing)
            except Exception:
                pass

    chroma_file = target_dir / "chroma_manifest.json"
    font_file = target_dir / "font_manifest.json"

    color_patch: Dict[str, Any] = {}
    selected_color_eco = None
    vertical_archetype = None
    css_root = ""
    tailwind_block = ""
    if chroma_file.is_file():
        cdata = json.loads(chroma_file.read_text(encoding="utf-8"))
        selected_color_eco = cdata.get("selected_ecosystem_id")
        vertical_archetype = cdata.get("vertical_archetype")
        themes = cdata.get("themes", {})
        dark_t = themes.get("dark", {})
        light_t = themes.get("light", {})
        color_patch = {
            "selected_ecosystem_id": selected_color_eco,
            "recommended_mode": cdata.get("recommended_mode", "light"),
            "dark": {k: {"$value": v["$value"], "$type": "color", "hex": v["hex"], "p3": v.get("p3", "")} for k, v in dark_t.items() if isinstance(v, dict) and "$value" in v},
            "light": {k: {"$value": v["$value"], "$type": "color", "hex": v["hex"], "p3": v.get("p3", "")} for k, v in light_t.items() if isinstance(v, dict) and "$value" in v},
            "accessibility": cdata.get("accessibility_audit", {}),
        }
        css_root = cdata.get("css_integration", {}).get("css_variables_root", "")
        tailwind_block = cdata.get("css_integration", {}).get("tailwind_v4_theme_block", "")

    font_patch: Dict[str, Any] = {}
    selected_font_eco = None
    disp_font, body_font, acc_font = "Space Grotesk", "Plus Jakarta Sans", "JetBrains Mono"
    disp_cat, acc_cat = "sans", "sans"
    if font_file.is_file():
        fdata = json.loads(font_file.read_text(encoding="utf-8"))
        selected_font_eco = fdata.get("selected_ecosystem_id")
        sel_eco = fdata.get("selected_ecosystem") or (fdata.get("candidate_ecosystems") or [{}])[0]
        tokens = sel_eco.get("tokens", {})
        disp_font = tokens.get("display_primary", {}).get("$value", disp_font)
        body_font = tokens.get("ui_secondary", {}).get("$value", body_font)
        acc_font = tokens.get("accent_brand", {}).get("$value", acc_font)
        disp_cat = tokens.get("display_primary", {}).get("category", "sans")
        acc_cat = tokens.get("accent_brand", {}).get("category", "sans")
        bridge = fdata.get("web_ready_bridge", {})
        font_patch = {
            "selected_ecosystem_id": selected_font_eco,
            "style_profile": fdata.get("style_profile"),
            "display_primary": {"$value": disp_font, "$type": "fontFamily", "url": tokens.get("display_primary", {}).get("url", "")},
            "ui_secondary": {"$value": body_font, "$type": "fontFamily", "url": tokens.get("ui_secondary", {}).get("url", "")},
            "accent_brand": {"$value": acc_font, "$type": "fontFamily", "url": tokens.get("accent_brand", {}).get("url", "")},
            "web_ready_bridge": bridge,
            "inheritance": fdata.get("inheritance", {}),
        }

    vertical_ctx: Dict[str, Any] = {}
    if vertical_json_path and vertical_json_path.is_file():
        try:
            vdata = json.loads(vertical_json_path.read_text(encoding="utf-8"))
            vertical_ctx = {
                "vertical_slug": vdata.get("vertical_slug") or vertical or vertical_json_path.stem,
                "display_name": vdata.get("display_name", ""),
                "funnel_type": vdata.get("funnel_type", ""),
                "domain_strategy": vdata.get("domain_strategy", ""),
                "custom_domain": vdata.get("custom_domain", ""),
                "role_in_ecosystem": vdata.get("role_in_ecosystem", ""),
                "vertical_archetype": vertical_archetype or "",
                "unique_mechanism": vdata.get("unique_mechanism", {}),
                "target_avatar": vdata.get("target_avatar", {}),
                "content_directives": vdata.get("content_directives", {}),
            }
        except Exception:
            pass

    patch: Dict[str, Any] = {
        "metadata": {
            "brand_name": existing.get("metadata", {}).get("brand_name") or brand,
            "updated_at": datetime.now(timezone.utc).isoformat(),
            **({"vertical_slug": vertical} if vertical else {}),
            **({"vertical_archetype": vertical_archetype} if vertical_archetype else {}),
        },
        "design_system": {
            "colors": color_patch,
            "typography": font_patch,
        },
    }
    if vertical_ctx:
        patch["vertical_context"] = vertical_ctx
    merged = deep_merge_non_destructive(existing, patch)
    if "$schema" not in merged:
        merged["$schema"] = "https://www.designtokens.org/tr/2025.10/format/"

    bb_path.write_text(json.dumps(merged, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

    disp_gen = "serif" if disp_cat == "serif" else "sans-serif"
    acc_gen = "serif" if acc_cat == "serif" else "sans-serif"
    css_lines = [
        f"/* Tailwind CSS v4 Brand Theme Tokens — {brand}" + (f" / {vertical}" if vertical else "") + " */",
        '@import "tailwindcss";',
        "",
        tailwind_block or "@theme {\n  --color-brand-primary: var(--brand-primary);\n}",
        "",
        "  /* Typography variables merged cleanly */",
        css_root or "",
        "",
        ":root {",
        f'  --font-display: "{disp_font}", {disp_gen};',
        f'  --font-body: "{body_font}", system-ui, sans-serif;',
        f'  --font-accent: "{acc_font}", {acc_gen};',
        "}",
    ]
    css_path = target_dir / "brandbook-theme.css"
    css_path.write_text("\n".join(css_lines).strip() + "\n", encoding="utf-8")
    return bb_path, css_path


def run_pipeline(
    brand: str,
    target_dir: Path,
    phases: List[str],
    brief_path: Optional[Path] = None,
    shards_path: Optional[Path] = None,
    vertical_json_path: Optional[Path] = None,
    project_dir: Optional[Path] = None,
    vertical: Optional[str] = None,
    preview_texts: str = "",
    no_live: bool = False,
    chroma_mode: str = "auto",
    style_profile: str = "auto",
    sort_mode: str = "hybrid",
    include_shortlist: bool = True,
    seed: int = 0,
) -> Dict[str, Any]:
    target_dir.mkdir(parents=True, exist_ok=True)
    results: Dict[str, Any] = {"brand": brand, "vertical": vertical, "target_dir": str(target_dir), "generated": []}

    run_all = "all" in phases
    if run_all or "chroma" in phases:
        cmd = [
            sys.executable, "-B", str(resolve_script("chroma_engine.py")),
            "--brand", brand, "--output-dir", str(target_dir), "--mode", chroma_mode,
        ]
        if vertical:
            cmd.extend(["--vertical", vertical])
        if brief_path:
            cmd.extend(["--brief", str(brief_path)])
        if shards_path:
            cmd.extend(["--shards", str(shards_path)])
        if vertical_json_path:
            cmd.extend(["--vertical-json", str(vertical_json_path)])
        subprocess.run(cmd, check=True)
        results["generated"].extend(["chroma_manifest.json", "chroma_preview.html"])

    if run_all or "fontgen" in phases:
        cmd = [
            sys.executable, "-B", str(resolve_script("fontgen_engine.py")),
            "--brand", brand, "--output-dir", str(target_dir),
            "--style-profile", style_profile, "--sort", sort_mode, "--seed", str(seed),
        ]
        if brief_path:
            cmd.extend(["--brief", str(brief_path)])
        elif not shards_path:
            cmd.append("--allow-default")
        if shards_path:
            cmd.extend(["--shards", str(shards_path)])
        if vertical_json_path:
            cmd.extend(["--vertical-json", str(vertical_json_path)])
        if no_live:
            cmd.append("--no-live")
        subprocess.run(cmd, check=True)
        fg_name = f"fontgen_{(vertical or brand).lower()}.md"
        results["generated"].extend(["font_manifest.json", fg_name])

    if (run_all or "previews" in phases) and not no_live and (target_dir / "font_manifest.json").exists():
        texts = preview_texts.strip() or ",".join([brand.upper(), (vertical or brand).replace("-", " ").upper()])
        cmd = [
            sys.executable, "-B", str(resolve_script("envato_font_preview.py")),
            "--from-manifest", str(target_dir / "font_manifest.json"),
            "--texts", texts,
            "--out", str(target_dir / "previews"),
            "--title", f"Galería Vanguardia Envato + Google Fonts — {brand.upper()}" + (f" ({vertical})" if vertical else ""),
        ]
        if include_shortlist:
            cmd.append("--include-shortlist")
        if (target_dir / "chroma_manifest.json").exists():
            cmd.extend(["--chroma", str(target_dir / "chroma_manifest.json")])
        subprocess.run(cmd, check=True)
        results["generated"].append("previews/preview_gallery.html")

    if run_all or "brandbook" in phases:
        bb, css = merge_brandbook_non_destructive(target_dir, project_dir, brand, vertical, vertical_json_path=vertical_json_path)
        results["generated"].extend([bb.name, css.name])

    return results


def audit_target(target_dir: Path, phases: List[str]) -> Tuple[bool, List[str]]:
    errors: List[str] = []
    checks = []
    if "all" in phases or "chroma" in phases:
        checks.append("chroma_manifest.json")
    if "all" in phases or "fontgen" in phases:
        checks.append("font_manifest.json")
    if "all" in phases or "brandbook" in phases:
        checks.extend(["brandbook.json", "brandbook-theme.css"])

    for fname in checks:
        p = target_dir / fname
        if not p.is_file():
            errors.append(f"Missing required artifact: {p}")
            continue
        if p.suffix == ".json":
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                if fname == "chroma_manifest.json":
                    if len(data.get("ecosystems", [])) < 3:
                        errors.append("chroma_manifest.json has < 3 ecosystems")
                    if not data.get("accessibility_audit", {}).get("wcag_2_2_compliance", {}).get("status_aaa"):
                        errors.append("chroma_manifest.json failed WCAG AAA status check")
                elif fname == "font_manifest.json":
                    if len(data.get("candidate_ecosystems", [])) < 3:
                        errors.append("font_manifest.json has < 3 ecosystems")
            except Exception as e:
                errors.append(f"Invalid JSON in {p}: {e}")
    return len(errors) == 0, errors


def run_unit_tests() -> int:
    print("Running orchesbrand v3.2 multi-vertical agnostic offline unit tests...")
    with tempfile.TemporaryDirectory(prefix="orchesbrand_v32_test_") as tmp:
        tp = Path(tmp)
        proj_dev = tp / "TestProj" / "dev"
        vert_dir = proj_dev / "verticals"
        ws_b2b = proj_dev / "workspaces" / "alpha-b2b" / "brand"
        ws_cos = proj_dev / "workspaces" / "orion-cosmic" / "brand"
        vert_dir.mkdir(parents=True, exist_ok=True)
        ws_b2b.mkdir(parents=True, exist_ok=True)
        ws_cos.mkdir(parents=True, exist_ok=True)

        shards_p = proj_dev / "client_dumps_15_shards.json"
        shards_p.write_text(json.dumps({
            "shard_01": {"data": {"tripod_of_iron": {"sun": {"sign": "Gemini"}, "midheaven_house_10": {"sign": "Gemini"}}}},
            "shard_02": {"data": {"fagan_bradley": {"midheaven": {"sign": "Taurus"}}}},
            "shard_03": {"data": {"shadbala": {"dominant_planet": "Sun"}, "nakshatra": {"name": "Chitra", "lord": "Mars"}}},
            "shard_04": {"data": {"day_master": {"name": "Jia", "element": "Wood"}, "four_pillars": {"month": {"element": "Metal"}}, "yong_shen": {"element": "Water"}}},
        }), encoding="utf-8")
        brief_p = proj_dev / "astrobranding_testcorp.md"
        brief_p.write_text("# Brief TESTCORP\n**Elemento balancín Yong Shen:** La tinta.\n", encoding="utf-8")
        seed_bb = {
            "metadata": {"brand_name": "TESTCORP"},
            "brand_architecture": {"core_promise": "Preserved umbrella architecture"},
            "voice_tone_and_messaging": {"primary_tone": "Direct and calm"},
            "lexicon": {"forbidden_terms": ["slop"]},
        }
        (proj_dev / "brandbook.json").write_text(json.dumps(seed_bb, indent=2), encoding="utf-8")
        v_b2b = vert_dir / "alpha-b2b.json"
        v_cos = vert_dir / "orion-cosmic.json"
        v_b2b.write_text(json.dumps({"vertical_slug": "alpha-b2b", "display_name": "Consultoría B2B e IA", "unique_mechanism": {"name": "M1"}}), encoding="utf-8")
        v_cos.write_text(json.dumps({"vertical_slug": "orion-cosmic", "display_name": "Orion — Sabidurías Cósmicas & Arquetipos Vocacionales", "unique_mechanism": {"name": "M2"}}), encoding="utf-8")

        run_pipeline("TESTCORP", ws_b2b, ["chroma", "fontgen", "brandbook"], brief_path=brief_p, shards_path=shards_p, vertical_json_path=v_b2b, project_dir=proj_dev, vertical="alpha-b2b", no_live=True)
        run_pipeline("TESTCORP", ws_cos, ["chroma", "fontgen", "brandbook"], brief_path=brief_p, shards_path=shards_p, vertical_json_path=v_cos, project_dir=proj_dev, vertical="orion-cosmic", no_live=True)
        for ws in (ws_b2b, ws_cos):
            ok, errs = audit_target(ws, ["chroma", "fontgen", "brandbook"])
            assert ok, f"Audit failed for {ws}: {errs}"

        bb_b2b = json.loads((ws_b2b / "brandbook.json").read_text(encoding="utf-8"))
        bb_cos = json.loads((ws_cos / "brandbook.json").read_text(encoding="utf-8"))
        assert bb_b2b["brand_architecture"]["core_promise"] == "Preserved umbrella architecture"
        assert bb_cos["brand_architecture"]["core_promise"] == "Preserved umbrella architecture"
        assert bb_b2b["vertical_context"]["vertical_slug"] == "alpha-b2b"
        assert bb_cos["vertical_context"]["vertical_slug"] == "orion-cosmic"
        assert bb_b2b["design_system"]["colors"]["selected_ecosystem_id"] != bb_cos["design_system"]["colors"]["selected_ecosystem_id"]
        assert bb_b2b["design_system"]["typography"]["display_primary"]["$value"] != bb_cos["design_system"]["typography"]["display_primary"]["$value"]
    assert not Path("/mnt/localstorage/TESTCORP").exists()
    print("✅ ORCHESBRAND v3.2 UNIT TESTS PASSED (multi-vertical umbrella isolation, non-destructive merge, 0 phantom dirs)")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="orchesbrand", description="Sovereign Agnostic Brand Pipeline CLI (v3.2)")
    parser.add_argument("--brand", default=None, help="Umbrella brand slug (e.g. AURELIUS)")
    parser.add_argument("--vertical", default=None, help="Vertical slug inside workspaces/<vertical>/brand")
    parser.add_argument("--project-dir", type=Path, default=None, help="Project dev root (e.g. /mnt/localstorage/<Project>/dev)")
    parser.add_argument("--output-dir", type=Path, default=None, help="Explicit output directory")
    parser.add_argument("--brief", type=Path, default=None, help="Explicit astrobranding_<brand>.md path")
    parser.add_argument("--shards", type=Path, default=None, help="Explicit client_dumps_15_shards.json path")
    parser.add_argument("--vertical-json", type=Path, default=None, help="Explicit verticals/<vertical>.json path")
    parser.add_argument("--chroma-mode", default="auto", choices=["auto", "synthesize", "brief"])
    parser.add_argument("--style-profile", default="auto", choices=["auto", "architectural_b2b", "cosmic_archetypal", "design_system_atelier", "editorial_manifesto", "editorial_brand"])
    parser.add_argument("--sort", default="hybrid", choices=["hybrid", "latest", "popular"], help="Envato Elements discovery sort order")
    parser.add_argument("--include-shortlist", action="store_true", help="Include ranked runner-up Envato fonts in preview gallery")
    parser.add_argument("--seed", type=int, default=0, help="Rotate ranked Envato font hits across iterations")
    parser.add_argument("--phases", default="chroma,fontgen,previews,brandbook", help="Comma-separated phases: chroma,fontgen,previews,brandbook,all")
    parser.add_argument("--preview-texts", default="", help="Comma-separated preview strings for Envato SVG gallery")
    parser.add_argument("--no-live", action="store_true", help="Offline mode (skip live Envato scraping/previews)")
    parser.add_argument("--audit", action="store_true", help="Validate generated artifacts strictly")
    parser.add_argument("--quiet", action="store_true", help="JSON output only")
    parser.add_argument("--test", action="store_true", help="Run self-contained offline unit tests")
    args = parser.parse_args()

    if args.test:
        return run_unit_tests()

    proj_dir = args.project_dir or find_project_dev_dir()
    brand, brief = resolve_brief_and_brand(args.brand, proj_dir, args.vertical)
    if args.brief:
        brief = args.brief

    shards = args.shards
    if not shards:
        b_up = re.sub(r"[^a-zA-Z0-9_-]+", "", brand).upper()
        for cand in (
            Path(f"/var/www/baiosfera/ASTROLOGÍA/DIAG/{b_up}/raw/json/dumps/client_dumps_15_shards.json"),
            proj_dir / "client_dumps_15_shards.json" if proj_dir else None,
        ):
            if cand and cand.is_file():
                shards = cand
                break

    vjson = args.vertical_json
    if not vjson and args.vertical and proj_dir:
        cand_v = proj_dir / "verticals" / f"{args.vertical.lower()}.json"
        if cand_v.is_file():
            vjson = cand_v

    if args.output_dir:
        targets = [(args.vertical, args.output_dir)]
    elif args.vertical and args.vertical.lower() != "all" and proj_dir:
        targets = [(args.vertical.lower(), proj_dir / "workspaces" / args.vertical.lower() / "brand")]
    elif proj_dir and (proj_dir / "workspaces").is_dir() and (args.vertical or "").lower() == "all":
        targets = [(d.name, d / "brand") for d in sorted((proj_dir / "workspaces").iterdir()) if d.is_dir()]
    elif proj_dir:
        targets = [(None, proj_dir)]
    else:
        targets = [(args.vertical, Path.cwd())]

    phases = [p.strip().lower() for p in args.phases.split(",") if p.strip()]
    all_res = []
    has_err = False
    for vslug, tdir in targets:
        vjson_target = vjson
        if not vjson_target and vslug and proj_dir:
            cand_vs = proj_dir / "verticals" / f"{vslug}.json"
            if cand_vs.is_file():
                vjson_target = cand_vs
        res = run_pipeline(
            brand=brand, target_dir=tdir, phases=phases, brief_path=brief,
            shards_path=shards, vertical_json_path=vjson_target, project_dir=proj_dir, vertical=vslug,
            preview_texts=args.preview_texts, no_live=args.no_live,
            chroma_mode=args.chroma_mode, style_profile=args.style_profile,
            sort_mode=args.sort, include_shortlist=args.include_shortlist or True, seed=args.seed,
        )
        if args.audit:
            ok, errs = audit_target(tdir, phases)
            res["audit_passed"] = ok
            if not ok:
                has_err = True
                res["audit_errors"] = errs
        all_res.append(res)
        if not args.quiet:
            print(f"✅ [{brand}" + (f"/{vslug}" if vslug else "") + f"] Artefactos en {tdir}: {', '.join(res['generated'])}")
            if not res.get("audit_passed", True):
                print(f"❌ Audit errors: {res.get('audit_errors')}", file=sys.stderr)

    if args.quiet:
        print(json.dumps(all_res, indent=2, ensure_ascii=False))
    return 1 if has_err else 0


if __name__ == "__main__":
    sys.exit(main())
