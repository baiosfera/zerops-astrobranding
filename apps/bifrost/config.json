{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "5432",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "5432",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "chromem",
    "config": {
      "path": "/var/www/chromem",
      "compress": true
    }
  },
  "plugins": [
    {
      "name": "semantic_cache",
      "enabled": true,
      "config": {
        "dimension": 1,
        "ttl": 86400,
        "threshold": 0.8,
        "vector_store_namespace": "BifrostLocalCache",
        "default_cache_key": "production-semantic-cache",
        "cache_by_model": true,
        "cache_by_provider": true
      }
    }
  ],
  "providers": {
    "freellmapi": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "keys": [
        {
          "name": "freellmapi-primary-pool",
          "value": "freellmapi-1a51f9aa17ab766b7e98b5b2ae3353a6bfb216d86868a4ef",
          "models": [
            "*"
          ],
          "aliases": {
            "auto": "auto",
            "gpt-4o": "auto",
            "gpt-4o-mini": "auto",
            "claude-3-5-sonnet": "auto",
            "claude-3-haiku": "auto",
            "gemini-2.5-flash": "auto",
            "llama-3.3-70b": "auto"
          },
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://freellmapi:3001",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 60,
        "max_retries": 1,
        "retry_backoff_initial": "300ms",
        "retry_backoff_max": "1s"
      }
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-pro-commercial",
          "value": "env.DEEPSEEK_PRO_KEY",
          "models": [
            "*"
          ],
          "aliases": {
            "auto": "deepseek-flash",
            "deepseek-chat": "deepseek-flash",
            "deepseek-flash": "deepseek-flash",
            "deepseek-v4-pro": "deepseek-v4-pro",
            "deepseek-coder": "deepseek-flash",
            "deepseek-reasoner": "deepseek-v4-pro"
          },
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 3,
        "retry_backoff_initial": "500ms",
        "retry_backoff_max": "3s"
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-production-main",
        "name": "Production Sovereign Key",
        "value": "vk-damaren-sovereign-2026",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-hermes-agent",
        "name": "Hermes Agent Autonomous",
        "value": "vk-hermes-agent",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 60
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-crewai",
        "name": "CrewAI Teams Autonomous",
        "value": "vk-crewai",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-pidev",
        "name": "PiDev Sovereign Code Builder",
        "value": "vk-pidev",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-pydanticai",
        "name": "PydanticAI Structured Contracts",
        "value": "vk-pydanticai",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 60
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      }
    ],
    "circuit_breaker_config": {
      "policies": [
        {
          "name": "freellmapi-exhaustion-breaker",
          "enabled": true,
          "primary_provider": "freellmapi",
          "primary_model": "*",
          "fallback_provider": "deepseek",
          "fallback_model": "deepseek-flash",
          "condition": {
            "operator": "OR",
            "signals": [
              {
                "source": "response_header",
                "header_name": "retry-after"
              },
              {
                "source": "response_header",
                "header_name": "x-ratelimit-remaining",
                "header_value": "0"
              }
            ]
          },
          "default_cooldown": "60s",
          "cooldown_header": "retry-after"
        }
      ]
    },
    "routing_rules": [
      {
        "id": "rule-explicit-pro-override",
        "name": "Route Explicit Pro Tier Requests Directly to DeepSeek",
        "cel_expression": "headers['x-force-deepseek'] == 'true' || headers['x-tier'] == 'pro' || headers['x-routing-tier'] == 'pro' || model.startsWith('deepseek') || model.startsWith('deepseek/')",
        "targets": [
          {
            "provider": "deepseek",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "freellmapi"
        ],
        "priority": 0
      },
      {
        "id": "rule-zero-cost-freellm-universal",
        "name": "Prioritize FreeLLMAPI ($0) for All Models (Chat, Code, Reasoning) with Paid Failover",
        "cel_expression": "true",
        "targets": [
          {
            "provider": "freellmapi",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "deepseek"
        ],
        "priority": 1
      }
    ]
  }
}