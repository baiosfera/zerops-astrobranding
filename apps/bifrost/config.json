{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "5432",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "5432",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "chromem",
    "config": {
      "path": "/mnt/localstorage/bifrost/chromem",
      "compress": true
    }
  },
  "plugins": [
    {
      "name": "semantic_cache",
      "enabled": true,
      "config": {
        "dimension": 1,
        "ttl": 86400,
        "threshold": 0.8,
        "vector_store_namespace": "BifrostLocalCache",
        "default_cache_key": "production-semantic-cache",
        "cache_by_model": true,
        "cache_by_provider": true
      }
    }
  ],
  "providers": {
    "freellmapi": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "keys": [
        {
          "name": "freellmapi-primary-pool",
          "value": "freellmapi-3201de79b7e7c2f46abf1718a0862337db9489157fd7d4ad",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://freellmapi:3001",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 3,
        "max_retries": 1,
        "retry_backoff_initial": "300ms",
        "retry_backoff_max": "1s"
      }
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-pro-commercial",
          "value": "env.DEEPSEEK_PRO_KEY",
          "models": ["*"],
          "aliases": {
            "auto": "deepseek-chat",
            "deepseek-chat": "deepseek-v4-pro",
            "deepseek-coder": "deepseek-v4-pro",
            "deepseek-reasoner": "deepseek-v4-pro"
          },
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 3,
        "retry_backoff_initial": "500ms",
        "retry_backoff_max": "3s"
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-production-main",
        "name": "Production Sovereign Key",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-astrobranding-prod",
        "name": "AstroBranding Production",
        "value": "env.BIFROST_VK_ASTROBRANDING",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-web-client",
        "name": "Web Client Application",
        "value": "env.BIFROST_VK_WEB",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-hermes-agent",
        "name": "Hermes Agent Autonomous",
        "value": "env.BIFROST_VK_HERMES",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 60
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-evolution-wa",
        "name": "Evolution WhatsApp Bot",
        "value": "env.BIFROST_VK_EVOLUTION",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 60
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-agy-operator",
        "name": "Antigravity AGY Operator",
        "value": "env.BIFROST_VK_AGY",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-crewai",
        "name": "CrewAI Teams Autonomous",
        "value": "env.BIFROST_VK_CREWAI",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-pydanticai",
        "name": "PydanticAI Structured Contracts",
        "value": "env.BIFROST_VK_PYDANTICAI",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      }
    ],
    "circuit_breaker_config": {
      "policies": [
        {
          "name": "freellmapi-429-exhaustion-breaker",
          "enabled": true,
          "primary_provider": "freellmapi",
          "primary_model": "*",
          "fallback_provider": "deepseek",
          "fallback_model": "deepseek-chat",
          "condition": {
            "operator": "OR",
            "signals": [
              {
                "source": "response_header",
                "header_name": "retry-after"
              }
            ]
          },
          "default_cooldown": "120s",
          "cooldown_header": "retry-after"
        }
      ]
    },
    "routing_rules": [
      {
        "id": "rule-coding-and-reasoning-to-deepseek",
        "name": "Route Coding, Complex Reasoning & Pro Tier Directly to DeepSeek",
        "cel_expression": "model.contains('deepseek') || model.contains('code') || model.contains('reason') || headers['x-tier'] == 'production' || headers['x-routing-tier'] == 'pro'",
        "targets": [
          {
            "provider": "deepseek",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "freellmapi"
        ],
        "priority": 0
      },
      {
        "id": "rule-freellm-zero-cost-priority",
        "name": "Prioritize FreeLLMAPI with Paid Commercial Failover",
        "cel_expression": "true",
        "targets": [
          {
            "provider": "freellmapi",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "deepseek"
        ],
        "priority": 1
      }
    ]
  }
}
