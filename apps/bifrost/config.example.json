{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "vector_store": {
    "enabled": true,
    "type": "chromem",
    "config": {
      "path": "/mnt/localstorage/bifrost/chromem",
      "compress": true
    }
  },
  "plugins": [
    {
      "name": "semantic_cache",
      "enabled": true,
      "config": {
        "dimension": 1,
        "ttl": 86400,
        "vector_store_namespace": "BifrostLocalCache",
        "default_cache_key": "elplacerdc-production-cache",
        "cache_by_model": true,
        "cache_by_provider": true
      }
    }
  ],
  "providers": {
    "freellmapi": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "keys": [
        {
          "name": "freellmapi-primary-pool",
          "value": "env.FREELLMAPI_UNIFIED_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://freellmapi:3001",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 120,
        "max_retries": 3,
        "retry_backoff_initial": "500ms",
        "retry_backoff_max": "3s"
      }
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-pro-commercial",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "aliases": {
            "deepseek-chat": "deepseek-v4-pro",
            "deepseek-coder": "deepseek-v4-pro",
            "deepseek-reasoner": "deepseek-v4-pro"
          },
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 3,
        "retry_backoff_initial": "500ms",
        "retry_backoff_max": "3s"
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-production-main",
        "name": "Production Sovereign Key",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "rule-coding-and-reasoning-to-deepseek",
        "name": "Route Coding and Deep Reasoning Directly to DeepSeek",
        "cel_expression": "model.contains('deepseek') || model.contains('code') || model.contains('reason') || headers['x-tier'] == 'production'",
        "targets": [
          {
            "provider": "deepseek",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "freellmapi"
        ],
        "priority": 0
      },
      {
        "id": "rule-freellm-zero-cost-priority",
        "name": "Prioritize FreeLLMAPI with Paid Commercial Failover",
        "cel_expression": "true",
        "targets": [
          {
            "provider": "freellmapi",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "deepseek"
        ],
        "priority": 1
      }
    ]
  }
}
