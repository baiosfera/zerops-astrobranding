                  couponsList.map((c) => {
                    const isPct = c.discountType === "percentage";
                    const discountDisplay = isPct ? `${c.discountValue}% OFF` : `${c.discountValue.toLocaleString("es-CO")} COP`;
                    const minFormatted = `${(c.minOrderAmount || 0).toLocaleString("es-CO")} COP`;
                    const usesDisplay = c.maxUses ? `${c.usedCount} / ${c.maxUses}` : `${c.usedCount} (Ilimitado)`;
                    return (
                      <tr class="hover:bg-zinc-800/30 transition-colors">
                        <td class="px-4 py-3 whitespace-nowrap">
                          <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                            {c.code}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-zinc-300 max-w-xs truncate">
                          {c.description || "Sin descripción"}
                        </td>
                        <td class="px-4 py-3 font-semibold text-white whitespace-nowrap">
                          {discountDisplay}
                        </td>
                        <td class="px-4 py-3 font-mono text-zinc-400 whitespace-nowrap">
                          {c.minOrderAmount > 0 ? minFormatted : "Sin mínimo"}
