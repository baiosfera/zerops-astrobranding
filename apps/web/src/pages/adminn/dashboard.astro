                            data-direction="up"
                            title="Mover arriba en la tienda"
                          >
                            ▲
                          </button>
                          <span class="min-w-6 text-center font-mono font-bold text-amber-400 text-xs px-1">
                            #{prod.displayOrder ?? 0}
