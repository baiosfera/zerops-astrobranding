    <!-- CLIENT SCRIPT: ENGINE 360° -->
    <script>
      import { actions } from "astro:actions";

      // 1. TABS SYSTEM WITH URL HASH MEMORY
      const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
      const tabPanes = document.querySelectorAll<HTMLElement>(".tab-pane");

      function activateTab(tabId: string) {
        tabButtons.forEach((btn) => {
          if (btn.dataset.target === tabId) {
            btn.classList.add("active");
          } else {
            btn.classList.remove("active");
          }
        });
        tabPanes.forEach((pane) => {
          if (pane.id === tabId) {
            pane.classList.add("active");
          } else {
            pane.classList.remove("active");
          }
        });
        history.replaceState(null, "", `#${tabId}`);
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.dataset.target) activateTab(btn.dataset.target);
        });
      });

      if (window.location.hash) {
        const hashTarget = window.location.hash.substring(1);
        if (document.getElementById(hashTarget)) {
          activateTab(hashTarget);
        }
      }

      // 2. NOTICE SYSTEM
      const notice = document.getElementById("dashboardNotice")!;
      function showNotice(type: "success" | "error", msg: string) {
        notice.classList.remove("hidden", "bg-emerald-950/80", "border-emerald-800", "text-emerald-200", "bg-red-950/80", "border-red-800", "text-red-200");
        if (type === "success") {
          notice.classList.add("bg-emerald-950/80", "border-emerald-800", "text-emerald-200");
        } else {
          notice.classList.add("bg-red-950/80", "border-red-800", "text-red-200");
        }
        notice.innerHTML = msg;
        notice.scrollIntoView({ behavior: "smooth", block: "nearest" });
        setTimeout(() => notice.classList.add("hidden"), 5000);
      }

      // 3. MATHEMATICALLY STRICT ASPECT-RATIO COMPRESSOR (PROPORTIONS INTACT, ZERO DISTORTION)
      async function compressImageStrict(
        file: File,
        maxWidth = 1200,
        maxHeight = 1200,
        quality = 0.85
      ): Promise<{ base64: string; name: string }> {
        if (!file.type.startsWith("image/")) {
          throw new Error("El archivo seleccionado no es una imagen válida.");
        }
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              // Scale invariant: guarantees EXACT aspect ratio without distortion
              const scale = Math.min(maxWidth / img.width, maxHeight / img.height, 1);
              const width = Math.round(img.width * scale);
              const height = Math.round(img.height * scale);

              const canvas = document.createElement("canvas");
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              if (!ctx) {
                return resolve({ base64: e.target?.result as string, name: file.name });
              }
              ctx.imageSmoothingEnabled = true;
              ctx.imageSmoothingQuality = "high";
              ctx.drawImage(img, 0, 0, width, height);

              const compressedBase64 = canvas.toDataURL("image/jpeg", quality);
              resolve({
                base64: compressedBase64,
                name: file.name.replace(/\.[^.]+$/, ".jpg"),
              });
            };
            img.onerror = () => reject(new Error("No se pudo procesar la imagen seleccionada."));
            img.src = e.target?.result as string;
          };
          reader.onerror = () => reject(new Error("Error al leer el archivo desde el dispositivo."));
          reader.readAsDataURL(file);
        });
      }

      // 4. MODALS MANAGEMENT
      const modalEditProduct = document.getElementById("modalEditProduct")!;
      const modalNewProduct = document.getElementById("modalNewProduct")!;
      const modalService = document.getElementById("modalService")!;

      document.querySelectorAll(".btn-close-modal").forEach((btn) => {
        btn.addEventListener("click", () => {
          modalEditProduct.classList.add("hidden");
          modalNewProduct.classList.add("hidden");
          modalService.classList.add("hidden");
        });
      });

      // 5. SEARCH FILTER FOR PRODUCTS
      const searchInput = document.getElementById("searchProducts") as HTMLInputElement;
      searchInput?.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        document.querySelectorAll<HTMLElement>(".product-row").forEach((row) => {
          const name = row.dataset.name || "";
          const cat = row.dataset.cat || "";
          if (name.includes(query) || cat.includes(query)) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });

      // 6. TOGGLE PRODUCT STATUS
      document.querySelectorAll<HTMLButtonElement>(".btn-toggle-product").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const productId = btn.dataset.id!;
          const currentActive = parseInt(btn.dataset.active || "1", 10);
          const nextActive = currentActive === 1 ? 0 : 1;

          btn.disabled = true;
          try {
            const { data, error } = await actions.toggleProductStatus({ productId, isActive: nextActive });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo cambiar el estado del producto.");
            } else {
              showNotice("success", nextActive === 1 ? "✅ Prenda activada en la tienda." : "Prenda ocultada.");
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al actualizar.");
          } finally {
            btn.disabled = false;
          }
        });
      });

      // 7. EDIT PRODUCT
      let editProdBase64 = "";
      let editProdFileName = "";
      const editProdImgFile = document.getElementById("editProdImgFile") as HTMLInputElement;
      const editProdImgPreviewContainer = document.getElementById("editProdImgPreviewContainer")!;
      const editProdImgPreview = document.getElementById("editProdImgPreview") as HTMLImageElement;

      editProdImgFile?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file);
          editProdBase64 = compressed.base64;
          editProdFileName = compressed.name;
          editProdImgPreview.src = compressed.base64;
          editProdImgPreviewContainer.classList.remove("hidden");
        } catch (err: any) {
          showNotice("error", err.message || "Error procesando la foto.");
        }
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-edit-product").forEach((btn) => {
        btn.addEventListener("click", () => {
          (document.getElementById("editProdId") as HTMLInputElement).value = btn.dataset.id || "";
          (document.getElementById("editProdName") as HTMLInputElement).value = btn.dataset.name || "";
          (document.getElementById("editProdPrice") as HTMLInputElement).value = btn.dataset.price || "";
          (document.getElementById("editProdStock") as HTMLInputElement).value = btn.dataset.stock || "0";
          (document.getElementById("editProdCategory") as HTMLInputElement).value = btn.dataset.category || "";
          (document.getElementById("editProdDescription") as HTMLTextAreaElement).value = btn.dataset.description || "";
          const slugInput = document.getElementById("editProdSlug") as HTMLInputElement;
          if (slugInput) slugInput.value = btn.dataset.slug || "";
          (document.getElementById("editProdImgCurrent") as HTMLImageElement).src = btn.dataset.image || "/placeholder.jpg";

          editProdBase64 = "";
          editProdFileName = "";
          editProdImgFile.value = "";
          editProdImgPreviewContainer.classList.add("hidden");

          modalEditProduct.classList.remove("hidden");
        });
      });

      document.getElementById("formEditProduct")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSubmitEditProduct") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Guardando...";

        const id = (document.getElementById("editProdId") as HTMLInputElement).value;
        const name = (document.getElementById("editProdName") as HTMLInputElement).value;
        const basePrice = parseInt((document.getElementById("editProdPrice") as HTMLInputElement).value, 10);
        const stock = parseInt((document.getElementById("editProdStock") as HTMLInputElement).value, 10);
        const category = (document.getElementById("editProdCategory") as HTMLInputElement).value;
        const description = (document.getElementById("editProdDescription") as HTMLTextAreaElement).value;
        const slugInput = document.getElementById("editProdSlug") as HTMLInputElement;
        const slug = slugInput ? slugInput.value : undefined;

        try {
          const payload: any = {
            id,
            name,
            basePrice,
            category,
            stock,
            description,
            slug,
          };
          if (editProdBase64 && editProdFileName) {
            payload.imageBase64 = editProdBase64;
            payload.imageName = editProdFileName;
          }

          const { data, error } = await actions.updateProduct(payload);
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar la prenda.");
          } else {
            showNotice("success", "✅ Prenda actualizada exitosamente.");
            modalEditProduct.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Guardar Cambios";
        }
      });

      // 8. NEW PRODUCT
      const btnOpenNewProductModal = document.getElementById("btnOpenNewProductModal");
      btnOpenNewProductModal?.addEventListener("click", () => {
        modalNewProduct.classList.remove("hidden");
      });

      let newProdBase64 = "";
      let newProdFileName = "";
      const newProdImgFile = document.getElementById("newProdImgFile") as HTMLInputElement;
      const newProdImgPreviewContainer = document.getElementById("newProdImgPreviewContainer")!;
      const newProdImgPreview = document.getElementById("newProdImgPreview") as HTMLImageElement;

      newProdImgFile?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file);
          newProdBase64 = compressed.base64;
          newProdFileName = compressed.name;
          newProdImgPreview.src = compressed.base64;
          newProdImgPreviewContainer.classList.remove("hidden");
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar la foto.");
        }
      });

      document.getElementById("formNewProduct")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSubmitNewProduct") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Publicando...";

        const name = (document.getElementById("newProdName") as HTMLInputElement).value;
        const basePrice = parseInt((document.getElementById("newProdPrice") as HTMLInputElement).value, 10);
        const stock = parseInt((document.getElementById("newProdStock") as HTMLInputElement).value, 10);
        const category = (document.getElementById("newProdCategory") as HTMLInputElement).value;
        const description = (document.getElementById("newProdDescription") as HTMLTextAreaElement).value;

        try {
          const payload: any = {
            name,
            basePrice,
            stock,
            category,
            description,
          };
          if (newProdBase64 && newProdFileName) {
            payload.imageBase64 = newProdBase64;
            payload.imageName = newProdFileName;
          }

          const { data, error } = await actions.createProduct(payload);
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al crear la prenda.");
          } else {
            showNotice("success", "✨ ¡Nueva prenda publicada con éxito!");
            modalNewProduct.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de red.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Publicar Prenda";
        }
      });

      // 9. HARD DELETE PRODUCT
      document.querySelectorAll<HTMLButtonElement>(".btn-delete-product").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const productId = btn.dataset.id!;
          const productName = btn.dataset.name!;
          if (!confirm(`¿Eliminar permanentemente "${productName}"? Esta acción borrará todas sus variantes de la base de datos.`)) {
            return;
          }
          try {
            const { data, error } = await actions.deleteProductHard({ productId });
            if (error || !data?.success) {
              showNotice("error", error?.message || "Error al eliminar producto.");
            } else {
              showNotice("success", "🗑️ Producto eliminado permanentemente.");
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error de conexión.");
          }
        });
      });

      // 10. SERVICES MANAGEMENT
      const btnOpenNewServiceModal = document.getElementById("btnOpenNewServiceModal");
      const serviceModalTitle = document.getElementById("serviceModalTitle")!;
      let serviceImgBase64 = "";
      let serviceImgFileName = "";
      const serviceImgFile = document.getElementById("serviceImgFile") as HTMLInputElement;
      const serviceImgPreviewContainer = document.getElementById("serviceImgPreviewContainer")!;
      const serviceImgPreview = document.getElementById("serviceImgPreview") as HTMLImageElement;

      serviceImgFile?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file);
          serviceImgBase64 = compressed.base64;
          serviceImgFileName = compressed.name;
          serviceImgPreview.src = compressed.base64;
          serviceImgPreviewContainer.classList.remove("hidden");
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar foto del servicio.");
        }
      });

      btnOpenNewServiceModal?.addEventListener("click", () => {
        serviceModalTitle.innerText = "Nuevo Servicio de Maquillaje";
        (document.getElementById("serviceId") as HTMLInputElement).value = "";
        (document.getElementById("serviceName") as HTMLInputElement).value = "";
        (document.getElementById("servicePrice") as HTMLInputElement).value = "200000";
        (document.getElementById("serviceDuration") as HTMLInputElement).value = "60";
        (document.getElementById("servicePriceRange") as HTMLInputElement).value = "$150.000 a $250.000";
        (document.getElementById("serviceBadge") as HTMLInputElement).value = "Atelier";
        (document.getElementById("serviceDepositReq") as HTMLSelectElement).value = "0";
        (document.getElementById("serviceDepositAmt") as HTMLInputElement).value = "0";
        (document.getElementById("serviceDescription") as HTMLTextAreaElement).value = "";
        (document.getElementById("serviceImgCurrent") as HTMLImageElement).src = "/images/services/maquillaje-social-1.jpg";

        serviceImgBase64 = "";
        serviceImgFileName = "";
        serviceImgFile.value = "";
        serviceImgPreviewContainer.classList.add("hidden");

        modalService.classList.remove("hidden");
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-edit-service").forEach((btn) => {
        btn.addEventListener("click", () => {
          serviceModalTitle.innerText = "Editar Servicio de Maquillaje";
          (document.getElementById("serviceId") as HTMLInputElement).value = btn.dataset.id || "";
          (document.getElementById("serviceName") as HTMLInputElement).value = btn.dataset.name || "";
          (document.getElementById("servicePrice") as HTMLInputElement).value = btn.dataset.price || "";
          (document.getElementById("serviceDuration") as HTMLInputElement).value = btn.dataset.duration || "60";
          (document.getElementById("servicePriceRange") as HTMLInputElement).value = btn.dataset.pricerange || "";
          (document.getElementById("serviceBadge") as HTMLInputElement).value = btn.dataset.badge || "";
          (document.getElementById("serviceDepositReq") as HTMLSelectElement).value = btn.dataset.depositReq || "0";
          (document.getElementById("serviceDepositAmt") as HTMLInputElement).value = btn.dataset.depositAmt || "0";
          (document.getElementById("serviceDescription") as HTMLTextAreaElement).value = btn.dataset.description || "";
          (document.getElementById("serviceImgCurrent") as HTMLImageElement).src = btn.dataset.image || "/images/services/maquillaje-social-1.jpg";

          serviceImgBase64 = "";
          serviceImgFileName = "";
          serviceImgFile.value = "";
          serviceImgPreviewContainer.classList.add("hidden");

          modalService.classList.remove("hidden");
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-toggle-service").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const serviceId = btn.dataset.id!;
          const currentActive = parseInt(btn.dataset.active || "1", 10);
          const nextActive = currentActive === 1 ? 0 : 1;

          btn.disabled = true;
          try {
            const { data, error } = await actions.toggleServiceStatus({ serviceId, isActive: nextActive });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo cambiar el estado del servicio.");
            } else {
              showNotice("success", nextActive === 1 ? "✅ Servicio activado." : "Servicio ocultado.");
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al actualizar.");
          } finally {
            btn.disabled = false;
          }
        });
      });

      document.getElementById("formService")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSubmitService") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Guardando...";

        const id = (document.getElementById("serviceId") as HTMLInputElement).value;
        const name = (document.getElementById("serviceName") as HTMLInputElement).value;
        const price = parseInt((document.getElementById("servicePrice") as HTMLInputElement).value, 10);
        const durationMinutes = parseInt((document.getElementById("serviceDuration") as HTMLInputElement).value, 10);
        const priceRange = (document.getElementById("servicePriceRange") as HTMLInputElement).value;
        const badge = (document.getElementById("serviceBadge") as HTMLInputElement).value;
        const depositRequired = parseInt((document.getElementById("serviceDepositReq") as HTMLSelectElement).value, 10);
        const depositAmount = parseInt((document.getElementById("serviceDepositAmt") as HTMLInputElement).value, 10);
        const description = (document.getElementById("serviceDescription") as HTMLTextAreaElement).value;

        try {
          const payload: any = {
            name,
            price,
            durationMinutes,
            priceRange,
            badge,
            depositRequired,
            depositAmount,
            description,
          };
          if (serviceImgBase64 && serviceImgFileName) {
            payload.imageBase64 = serviceImgBase64;
            payload.imageName = serviceImgFileName;
          }

          let res: any;
          if (id) {
            payload.id = id;
            res = await actions.updateService(payload);
          } else {
            res = await actions.createService(payload);
          }

          if (res.error || !res.data?.success) {
            showNotice("error", res.error?.message || "Error al guardar el servicio.");
          } else {
            showNotice("success", "💅 Servicio guardado exitosamente.");
            modalService.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de red.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Guardar Servicio";
        }
      });

      // 11. BOOKINGS STATUS SELECTOR
      document.querySelectorAll<HTMLSelectElement>(".booking-status-select").forEach((select) => {
        select.addEventListener("change", async () => {
          const bookingId = select.dataset.id!;
          const status = select.value as any;
          select.disabled = true;

          try {
            const { data, error } = await actions.updateBookingStatus({ bookingId, status });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo actualizar la cita.");
            } else {
              showNotice("success", `✅ Estado de cita actualizado a "${status}".`);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al actualizar.");
          } finally {
            select.disabled = false;
          }
        });
      });

      // 12. HERO BANNERS MANAGEMENT
      let heroMainBase64 = "";
      let heroMainFileName = "";
      const fileHeroMain = document.getElementById("fileHeroMain") as HTMLInputElement;
      const previewHeroMain = document.getElementById("previewHeroMain") as HTMLImageElement;
      const btnSaveHeroMain = document.getElementById("btnSaveHeroMain") as HTMLButtonElement;

      fileHeroMain?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file, 1600, 1600, 0.88);
          heroMainBase64 = compressed.base64;
          heroMainFileName = compressed.name;
          previewHeroMain.src = compressed.base64;
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar foto de portada.");
        }
      });

      btnSaveHeroMain?.addEventListener("click", async () => {
        if (!heroMainBase64 || !heroMainFileName) {
          showNotice("error", "Por favor seleccioná una nueva foto antes de guardar.");
          return;
        }
        btnSaveHeroMain.disabled = true;
        btnSaveHeroMain.innerText = "Subiendo Portada...";
        try {
          const { data, error } = await actions.uploadBannerImage({
            targetKey: "hero_image",
            imageBase64: heroMainBase64,
            imageName: heroMainFileName,
            altText: "Portada Principal Catalina Glamur",
          });
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar portada principal.");
          } else {
            showNotice("success", "🖼️ ¡Portada principal actualizada con éxito!");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSaveHeroMain.disabled = false;
          btnSaveHeroMain.innerText = "Actualizar Portada Principal";
        }
      });

      let heroSecBase64 = "";
      let heroSecFileName = "";
      const fileHeroSec = document.getElementById("fileHeroSec") as HTMLInputElement;
      const previewHeroSec = document.getElementById("previewHeroSec") as HTMLImageElement;
      const btnSaveHeroSec = document.getElementById("btnSaveHeroSec") as HTMLButtonElement;

      fileHeroSec?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file, 1600, 1600, 0.88);
          heroSecBase64 = compressed.base64;
          heroSecFileName = compressed.name;
          previewHeroSec.src = compressed.base64;
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar foto secundaria.");
        }
      });

      btnSaveHeroSec?.addEventListener("click", async () => {
        if (!heroSecBase64 || !heroSecFileName) {
          showNotice("error", "Por favor seleccioná una nueva foto antes de guardar.");
          return;
        }
        btnSaveHeroSec.disabled = true;
        btnSaveHeroSec.innerText = "Subiendo Portada...";
        try {
          const { data, error } = await actions.uploadBannerImage({
            targetKey: "hero_secondary_image",
            imageBase64: heroSecBase64,
            imageName: heroSecFileName,
            altText: "Atelier Social Catalina Glamur",
          });
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar portada secundaria.");
          } else {
            showNotice("success", "💄 ¡Portada secundaria actualizada con éxito!");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSaveHeroSec.disabled = false;
          btnSaveHeroSec.innerText = "Actualizar Portada Secundaria";
        }
      });
    </script>
  </body>
</html>
