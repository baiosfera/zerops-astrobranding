                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                          {order.paymentMethod === "cod" ? (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-sky-500/10 text-sky-400 border border-sky-500/30">
                              Contra Entrega
                            </span>
                          ) : (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-purple-500/10 text-purple-400 border border-purple-500/30">
                              Bancolombia Online
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3 font-mono font-semibold text-white whitespace-nowrap">
                          {new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(order.totalAmount)}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                          <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium ${
                            order.status === "approved"
                              ? "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"
                              : order.status === "pending_cod"
                                ? "bg-amber-500/15 text-amber-300 border border-amber-500/30"
                                : "bg-zinc-800 text-zinc-400 border border-zinc-700"
                          }`}>
                            {order.status === "pending_cod" ? "Pendiente COD" : order.status === "approved" ? "Aprobado" : order.status}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right text-[11px] font-mono text-zinc-400 whitespace-nowrap">
