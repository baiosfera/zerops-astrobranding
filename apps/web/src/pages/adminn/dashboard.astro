                    imgs = prod.images as string[];
                  } else if (typeof prod.images === "string") {
                    try { imgs = JSON.parse(prod.images); } catch (_) { imgs = []; }
                  }
                  const firstImg = imgs[0] || "/placeholder.jpg";
                  return (
                    <tr class="hover:bg-zinc-800/30 transition-colors product-row" data-name={prod.name.toLowerCase()} data-cat={(prod.category || "").toLowerCase()}>
                      <td class="px-3 py-3 text-center whitespace-nowrap">
                        <div class="inline-flex items-center gap-1 bg-zinc-950/80 border border-zinc-800 rounded-lg p-1">
                          <button
                            type="button"
                            class="btn-move-order w-6 h-6 rounded flex items-center justify-center text-zinc-400 hover:text-amber-400 hover:bg-zinc-800 transition-colors cursor-pointer text-xs"
