          <!-- Selector de Foto de Servicio -->
          <div>
            <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Foto del Servicio (Galería)</label>
            <div class="flex items-center space-x-3 mb-2">
              <img id="serviceImgCurrent" src="/placeholder.jpg" class="h-14 w-20 object-cover rounded-xl border border-zinc-800 bg-zinc-950 flex-shrink-0" />
              <div class="flex-1">
                <input
                  type="file"
                  id="serviceImgFile"
                  accept="image/*"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-400 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-zinc-800 file:text-amber-400 hover:file:bg-zinc-700 cursor-pointer"
                />
