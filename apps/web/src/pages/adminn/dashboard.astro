---
export const prerender = false;

import { getDb, products, orders, desc } from "@astrobranding/database";

// Handle direct logout navigation query (?logout=1)
if (Astro.url.searchParams.get("logout") === "1") {
  const sessionToken = Astro.cookies.get("admin_session")?.value;
  if (sessionToken) {
    const { revokeAdminSession } = await import("@astrobranding/database");
    await revokeAdminSession(sessionToken);
  }
  Astro.cookies.delete("admin_session", { path: "/" });
  Astro.cookies.delete("admin_session", { path: "/adminn" });
  return Astro.redirect("/adminn");
}

const adminUser = Astro.locals.adminUser;
if (!adminUser) {
  return Astro.redirect("/adminn");
}

const db = getDb();
const catalogItems = await db.select().from(products).orderBy(desc(products.createdAt));
const isSuperadmin = adminUser.role === "superadmin";

const activeCount = catalogItems.filter((p) => p.isActive === 1).length;
const inactiveCount = catalogItems.length - activeCount;
---

