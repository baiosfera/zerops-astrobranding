    <!-- CLIENT SCRIPT: ENGINE 360° -->
    <script>
      import { actions } from "astro:actions";


      // Orders filter
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".order-filter-btn");
      const orderRows = document.querySelectorAll<HTMLTableRowElement>(".order-row");

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.dataset.filter;
          filterBtns.forEach((b) => {
            if (b === btn) {
              b.className = "order-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/40 cursor-pointer";
            } else {
              b.className = "order-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-800 text-zinc-400 hover:text-white border border-zinc-700/60 cursor-pointer";
            }
          });

          orderRows.forEach((row) => {
            if (filter === "all" || row.dataset.env === filter) {
              row.style.display = "";
            } else {
              row.style.display = "none";
            }
          });
        });
      });

      // 1. TABS SYSTEM WITH URL HASH MEMORY
      const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
      const tabPanes = document.querySelectorAll<HTMLElement>(".tab-pane");

      function activateTab(tabId: string) {
        tabButtons.forEach((btn) => {
          if (btn.dataset.target === tabId) {
            btn.classList.add("active");
          } else {
            btn.classList.remove("active");
          }
        });
        tabPanes.forEach((pane) => {
          if (pane.id === tabId) {
            pane.classList.add("active");
          } else {
            pane.classList.remove("active");
          }
        });
        history.replaceState(null, "", `#${tabId}`);
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.dataset.target) activateTab(btn.dataset.target);
        });
      });

      if (window.location.hash) {
        const hashTarget = window.location.hash.substring(1);
        if (document.getElementById(hashTarget)) {
          activateTab(hashTarget);
        }
      }

      // 2. NOTICE SYSTEM
      const notice = document.getElementById("dashboardNotice")!;
      function showNotice(type: "success" | "error", msg: string) {
        notice.classList.remove("hidden", "bg-emerald-950/80", "border-emerald-800", "text-emerald-200", "bg-red-950/80", "border-red-800", "text-red-200");
        if (type === "success") {
          notice.classList.add("bg-emerald-950/80", "border-emerald-800", "text-emerald-200");
        } else {
          notice.classList.add("bg-red-950/80", "border-red-800", "text-red-200");
        }
        notice.innerHTML = msg;
        notice.scrollIntoView({ behavior: "smooth", block: "nearest" });
        setTimeout(() => notice.classList.add("hidden"), 5000);
      }

      // 3. MATHEMATICALLY STRICT ASPECT-RATIO COMPRESSOR (PROPORTIONS INTACT, ZERO DISTORTION)
      async function compressImageStrict(
        file: File,
        maxWidth = 1200,
        maxHeight = 1200,
        quality = 0.85
      ): Promise<{ base64: string; name: string }> {
        if (!file.type.startsWith("image/")) {
          throw new Error("El archivo seleccionado no es una imagen válida.");
        }
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              // Scale invariant: guarantees EXACT aspect ratio without distortion
              const scale = Math.min(maxWidth / img.width, maxHeight / img.height, 1);
              const width = Math.round(img.width * scale);
              const height = Math.round(img.height * scale);

              const canvas = document.createElement("canvas");
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              if (!ctx) {
                return resolve({ base64: e.target?.result as string, name: file.name });
              }
              ctx.imageSmoothingEnabled = true;
              ctx.imageSmoothingQuality = "high";
              ctx.drawImage(img, 0, 0, width, height);

              const compressedBase64 = canvas.toDataURL("image/jpeg", quality);
              resolve({
                base64: compressedBase64,
                name: file.name.replace(/\.[^.]+$/, ".jpg"),
              });
            };
            img.onerror = () => reject(new Error("No se pudo procesar la imagen seleccionada."));
            img.src = e.target?.result as string;
          };
          reader.onerror = () => reject(new Error("Error al leer el archivo desde el dispositivo."));
          reader.readAsDataURL(file);
        });
      }

            // --- GENERADOR DE ENLACES DE CUPONES ---
      const genCouponSelect = document.getElementById("genCouponSelect") as HTMLSelectElement | null;
      const genDestinationSelect = document.getElementById("genDestinationSelect") as HTMLSelectElement | null;
      const genResultUrl = document.getElementById("genCouponResultUrl") as HTMLInputElement | null;
      const btnCopyUrl = document.getElementById("btnCopyCouponUrl");
      const btnCopyIcon = document.getElementById("btnCopyCouponIcon");
      const btnCopyText = document.getElementById("btnCopyCouponText");

      function updateGeneratedUrl() {
        if (!genCouponSelect || !genDestinationSelect || !genResultUrl) return;
        const code = genCouponSelect.value;
        const dest = genDestinationSelect.value;
        const host = window.location.origin;
        genResultUrl.value = `${host}${dest}?cupon=${encodeURIComponent(code)}`;
      }

      genCouponSelect?.addEventListener("change", updateGeneratedUrl);
      genDestinationSelect?.addEventListener("change", updateGeneratedUrl);
      if (genCouponSelect) updateGeneratedUrl();

      btnCopyUrl?.addEventListener("click", async () => {
        if (!genResultUrl) return;
        try {
          await navigator.clipboard.writeText(genResultUrl.value);
          if (btnCopyIcon && btnCopyText) {
            btnCopyIcon.textContent = "✓";
            btnCopyText.textContent = "¡Copiado!";
            setTimeout(() => {
              btnCopyIcon.textContent = "📋";
              btnCopyText.textContent = "Copiar Enlace";
            }, 2500);
          }
          showNotice("success", "✅ Enlace copiado al portapapeles: " + genResultUrl.value);
        } catch (err) {
          genResultUrl.select();
          document.execCommand("copy");
          showNotice("success", "✅ Enlace copiado al portapapeles.");
        }
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-copy-quick-coupon").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const code = btn.dataset.code!;
          const url = `${window.location.origin}/shop?cupon=${encodeURIComponent(code)}`;
          try {
            await navigator.clipboard.writeText(url);
            showNotice("success", `✅ Enlace de tienda copiado para '${code}': ${url}`);
          } catch (_) {
            prompt("Copia este enlace:", url);
          }
        });
      });

      // 4. MODALS MANAGEMENT
      const modalEditProduct = document.getElementById("modalEditProduct")!;
      const modalNewProduct = document.getElementById("modalNewProduct")!;
      const modalService = document.getElementById("modalService")!;
      const modalNewCoupon = document.getElementById("modalNewCoupon");
      const modalEditCoupon = document.getElementById("modalEditCoupon");

      document.querySelectorAll(".btn-close-modal").forEach((btn) => {
        btn.addEventListener("click", () => {
          modalEditProduct.classList.add("hidden");
          modalNewProduct.classList.add("hidden");
          modalService.classList.add("hidden");
          modalNewCoupon?.classList.add("hidden");
          modalEditCoupon?.classList.add("hidden");
        });
      });

      // 5. SEARCH FILTER FOR PRODUCTS
      const searchInput = document.getElementById("searchProducts") as HTMLInputElement;
      searchInput?.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        document.querySelectorAll<HTMLElement>(".product-row").forEach((row) => {
          const name = row.dataset.name || "";
          const cat = row.dataset.cat || "";
          if (name.includes(query) || cat.includes(query)) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });

      // 6. TOGGLE PRODUCT STATUS
      document.querySelectorAll<HTMLButtonElement>(".btn-toggle-product").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const productId = btn.dataset.id!;
          const currentActive = parseInt(btn.dataset.active || "1", 10);
          const nextActive = currentActive === 1 ? 0 : 1;

          btn.disabled = true;
          try {
            const { data, error } = await actions.toggleProductStatus({ productId, isActive: nextActive });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo cambiar el estado del producto.");
            } else {
              showNotice("success", nextActive === 1 ? "✅ Prenda activada en la tienda." : "Prenda ocultada.");
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al actualizar.");
          } finally {
            btn.disabled = false;
          }
        });
      });

      // 7. EDIT PRODUCT (MULTI-FOTO + ORDEN)
      let currentProdExistingImages: string[] = [];
      let currentProdNewImages: Array<{ base64: string; name: string }> = [];

      const editProdGallery = document.getElementById("editProdGallery") as HTMLElement;
      const editProdImgFiles = document.getElementById("editProdImgFiles") as HTMLInputElement;
      const editProdNewFilesPreview = document.getElementById("editProdNewFilesPreview") as HTMLElement;

      function renderEditProdGallery() {
        if (!editProdGallery) return;
        editProdGallery.innerHTML = "";
        if (currentProdExistingImages.length === 0) {
          editProdGallery.innerHTML = '<span class="col-span-full text-zinc-500 text-center py-2 italic text-[11px]">Sin fotos registradas</span>';
          return;
        }

        currentProdExistingImages.forEach((url, idx) => {
          const item = document.createElement("div");
          item.className = "relative group aspect-square rounded-lg overflow-hidden border " + (idx === 0 ? "border-amber-500 ring-1 ring-amber-500/50" : "border-zinc-800");
          item.innerHTML = `
            <img src="${url}" class="w-full h-full object-cover object-top" />
            ${idx === 0 ? '<span class="absolute top-1 left-1 bg-amber-500 text-zinc-950 text-[8px] font-bold px-1 rounded shadow">PORTADA</span>' : ''}
            <div class="absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-1 p-1">
              ${idx !== 0 ? '<button type="button" class="btn-make-primary text-[9px] bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold px-1.5 py-0.5 rounded cursor-pointer w-full text-center">⭐ Portada</button>' : ''}
              <button type="button" class="btn-remove-img text-[9px] bg-red-950 text-red-300 px-1.5 py-0.5 rounded cursor-pointer w-full text-center hover:bg-red-900">✕ Quitar</button>
            </div>
          `;

          const btnPrimary = item.querySelector(".btn-make-primary");
          btnPrimary?.addEventListener("click", (e) => {
            e.stopPropagation();
            const target = currentProdExistingImages.splice(idx, 1)[0];
            currentProdExistingImages.unshift(target);
            renderEditProdGallery();
          });

          const btnRemove = item.querySelector(".btn-remove-img");
          btnRemove?.addEventListener("click", (e) => {
            e.stopPropagation();
            currentProdExistingImages.splice(idx, 1);
            renderEditProdGallery();
          });

          editProdGallery.appendChild(item);
        });
      }

      editProdImgFiles?.addEventListener("change", async (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (!files || files.length === 0) return;
        currentProdNewImages = [];
        if (editProdNewFilesPreview) {
          editProdNewFilesPreview.innerHTML = "";
          editProdNewFilesPreview.classList.remove("hidden");
        }

        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          try {
            const compressed = await compressImageStrict(file);
            currentProdNewImages.push(compressed);

            if (editProdNewFilesPreview) {
              const previewItem = document.createElement("div");
              previewItem.className = "relative aspect-square rounded-lg overflow-hidden border border-emerald-500/50";
              previewItem.innerHTML = `
                <img src="${compressed.base64}" class="w-full h-full object-cover object-top" />
                <span class="absolute bottom-0 inset-x-0 bg-emerald-950/90 text-emerald-300 text-[8px] text-center py-0.5 truncate px-1">Nueva</span>
              `;
              editProdNewFilesPreview.appendChild(previewItem);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error procesando una de las fotos.");
          }
        }
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-edit-product").forEach((btn) => {
        btn.addEventListener("click", () => {
          (document.getElementById("editProdId") as HTMLInputElement).value = btn.dataset.id || "";
          (document.getElementById("editProdName") as HTMLInputElement).value = btn.dataset.name || "";
          (document.getElementById("editProdPrice") as HTMLInputElement).value = btn.dataset.price || "";
          (document.getElementById("editProdStock") as HTMLInputElement).value = btn.dataset.stock || "0";
          (document.getElementById("editProdCategory") as HTMLInputElement).value = btn.dataset.category || "";
          (document.getElementById("editProdDisplayOrder") as HTMLInputElement).value = btn.dataset.order || "0";
          (document.getElementById("editProdDescription") as HTMLTextAreaElement).value = btn.dataset.description || "";
          const slugInput = document.getElementById("editProdSlug") as HTMLInputElement | null;
          if (slugInput) slugInput.value = btn.dataset.slug || "";

          // Cargar galería multi-fotos
          let imgsArray: string[] = [];
          try {
            imgsArray = btn.dataset.images ? JSON.parse(btn.dataset.images) : [];
          } catch (_) {
            imgsArray = [];
          }
          if (imgsArray.length === 0 && btn.dataset.image) {
            imgsArray = [btn.dataset.image];
          }

          currentProdExistingImages = [...imgsArray];
          currentProdNewImages = [];
          renderEditProdGallery();

          if (editProdImgFiles) editProdImgFiles.value = "";
          if (editProdNewFilesPreview) {
            editProdNewFilesPreview.innerHTML = "";
            editProdNewFilesPreview.classList.add("hidden");
          }

          modalEditProduct.classList.remove("hidden");
        });
      });

      // REORDER PRODUCTS (MOVE UP / DOWN)
      document.querySelectorAll<HTMLButtonElement>(".btn-move-order").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const productId = btn.dataset.id!;
          const direction = btn.dataset.direction as "up" | "down";
          btn.disabled = true;
          const row = btn.closest("tr");
          if (row) row.style.opacity = "0.5";
          try {
            const { data, error } = await actions.moveProductOrder({ productId, direction });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo actualizar el orden.");
              if (row) row.style.opacity = "1";
            } else {
              showNotice("success", "✅ Posición actualizada en la tienda.");
              setTimeout(() => {
                window.location.href = window.location.pathname + "?_t=" + Date.now() + "#tab-products";
              }, 300);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al mover la posición.");
            if (row) row.style.opacity = "1";
          } finally {
            btn.disabled = false;
          }
        });
      });

      document.getElementById("formEditProduct")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSubmitEditProduct") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Guardando...";

        const id = (document.getElementById("editProdId") as HTMLInputElement).value;
        const name = (document.getElementById("editProdName") as HTMLInputElement).value;
        const basePrice = parseInt((document.getElementById("editProdPrice") as HTMLInputElement).value, 10);
        const stock = parseInt((document.getElementById("editProdStock") as HTMLInputElement).value, 10);
        const category = (document.getElementById("editProdCategory") as HTMLInputElement).value;
        const displayOrder = parseInt((document.getElementById("editProdDisplayOrder") as HTMLInputElement).value, 10);
        const description = (document.getElementById("editProdDescription") as HTMLTextAreaElement).value;
        const slugInput = document.getElementById("editProdSlug") as HTMLInputElement | null;
        const slug = slugInput ? slugInput.value : undefined;

        try {
          const payload: any = {
            id,
            name,
            basePrice,
            category,
            stock,
            displayOrder: isNaN(displayOrder) ? 0 : displayOrder,
            description,
            slug,
          };
          payload.existingImages = currentProdExistingImages;
          if (currentProdNewImages.length > 0) {
            payload.newImages = currentProdNewImages;
          }

          const { data, error } = await actions.updateProduct(payload);
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar la prenda.");
          } else {
            showNotice("success", "✅ Prenda actualizada exitosamente.");
            modalEditProduct.classList.add("hidden");
            setTimeout(() => {
              window.location.href = window.location.pathname + "?_t=" + Date.now() + "#tab-products";
            }, 400);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Guardar Cambios";
        }
      });

      // 8. NEW PRODUCT
      const btnOpenNewProductModal = document.getElementById("btnOpenNewProductModal");
      btnOpenNewProductModal?.addEventListener("click", () => {
        modalNewProduct.classList.remove("hidden");
      });

      let newProdBase64 = "";
      let newProdFileName = "";
      const newProdImgFile = document.getElementById("newProdImgFile") as HTMLInputElement;
      const newProdImgPreviewContainer = document.getElementById("newProdImgPreviewContainer")!;
      const newProdImgPreview = document.getElementById("newProdImgPreview") as HTMLImageElement;

      newProdImgFile?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file);
          newProdBase64 = compressed.base64;
          newProdFileName = compressed.name;
          newProdImgPreview.src = compressed.base64;
          newProdImgPreviewContainer.classList.remove("hidden");
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar la foto.");
        }
      });

      document.getElementById("formNewProduct")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSubmitNewProduct") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Publicando...";

        const name = (document.getElementById("newProdName") as HTMLInputElement).value;
        const basePrice = parseInt((document.getElementById("newProdPrice") as HTMLInputElement).value, 10);
        const stock = parseInt((document.getElementById("newProdStock") as HTMLInputElement).value, 10);
        const category = (document.getElementById("newProdCategory") as HTMLInputElement).value;
        const displayOrderInput = document.getElementById("newProdDisplayOrder") as HTMLInputElement | null;
        const displayOrderVal = displayOrderInput && displayOrderInput.value ? parseInt(displayOrderInput.value, 10) : undefined;
        const description = (document.getElementById("newProdDescription") as HTMLTextAreaElement).value;

        try {
          const payload: any = {
            name,
            basePrice,
            stock,
            category,
            description,
          };
          if (displayOrderVal !== undefined && !isNaN(displayOrderVal)) {
            payload.displayOrder = displayOrderVal;
          }
          if (newProdBase64 && newProdFileName) {
            payload.imageBase64 = newProdBase64;
            payload.imageName = newProdFileName;
          }

          const { data, error } = await actions.createProduct(payload);
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al crear la prenda.");
          } else {
            showNotice("success", "✨ ¡Nueva prenda publicada con éxito!");
            modalNewProduct.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de red.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Publicar Prenda";
        }
      });

      // 9. HARD DELETE PRODUCT
      document.querySelectorAll<HTMLButtonElement>(".btn-delete-product").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const productId = btn.dataset.id!;
          const productName = btn.dataset.name!;
          if (!confirm(`¿Eliminar permanentemente "${productName}"? Esta acción borrará todas sus variantes de la base de datos.`)) {
            return;
          }
          try {
            const { data, error } = await actions.deleteProductHard({ productId });
            if (error || !data?.success) {
              showNotice("error", error?.message || "Error al eliminar producto.");
            } else {
              showNotice("success", "🗑️ Producto eliminado permanentemente.");
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error de conexión.");
          }
        });
      });

      // 10. SERVICES MANAGEMENT
      const btnOpenNewServiceModal = document.getElementById("btnOpenNewServiceModal");
      const serviceModalTitle = document.getElementById("serviceModalTitle")!;
      let serviceImgBase64 = "";
      let serviceImgFileName = "";
      const serviceImgFile = document.getElementById("serviceImgFile") as HTMLInputElement;
      const serviceImgPreviewContainer = document.getElementById("serviceImgPreviewContainer")!;
      const serviceImgPreview = document.getElementById("serviceImgPreview") as HTMLImageElement;

      serviceImgFile?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file);
          serviceImgBase64 = compressed.base64;
          serviceImgFileName = compressed.name;
          serviceImgPreview.src = compressed.base64;
          serviceImgPreviewContainer.classList.remove("hidden");
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar foto del servicio.");
        }
      });

      btnOpenNewServiceModal?.addEventListener("click", () => {
        serviceModalTitle.innerText = "Nuevo Servicio de Maquillaje";
        (document.getElementById("serviceId") as HTMLInputElement).value = "";
        (document.getElementById("serviceName") as HTMLInputElement).value = "";
        (document.getElementById("servicePrice") as HTMLInputElement).value = "200000";
        (document.getElementById("serviceDuration") as HTMLInputElement).value = "60";
        (document.getElementById("servicePriceRange") as HTMLInputElement).value = "$150.000 a $250.000";
        (document.getElementById("serviceBadge") as HTMLInputElement).value = "Atelier";
        (document.getElementById("serviceDepositReq") as HTMLSelectElement).value = "0";
        (document.getElementById("serviceDepositAmt") as HTMLInputElement).value = "0";
        (document.getElementById("serviceDescription") as HTMLTextAreaElement).value = "";
        (document.getElementById("serviceImgCurrent") as HTMLImageElement).src = "/images/services/maquillaje-social-1.jpg";

        serviceImgBase64 = "";
        serviceImgFileName = "";
        serviceImgFile.value = "";
        serviceImgPreviewContainer.classList.add("hidden");

        modalService.classList.remove("hidden");
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-edit-service").forEach((btn) => {
        btn.addEventListener("click", () => {
          serviceModalTitle.innerText = "Editar Servicio de Maquillaje";
          (document.getElementById("serviceId") as HTMLInputElement).value = btn.dataset.id || "";
          (document.getElementById("serviceName") as HTMLInputElement).value = btn.dataset.name || "";
          (document.getElementById("servicePrice") as HTMLInputElement).value = btn.dataset.price || "";
          (document.getElementById("serviceDuration") as HTMLInputElement).value = btn.dataset.duration || "60";
          (document.getElementById("servicePriceRange") as HTMLInputElement).value = btn.dataset.pricerange || "";
          (document.getElementById("serviceBadge") as HTMLInputElement).value = btn.dataset.badge || "";
          (document.getElementById("serviceDepositReq") as HTMLSelectElement).value = btn.dataset.depositReq || "0";
          (document.getElementById("serviceDepositAmt") as HTMLInputElement).value = btn.dataset.depositAmt || "0";
          (document.getElementById("serviceDescription") as HTMLTextAreaElement).value = btn.dataset.description || "";
          (document.getElementById("serviceImgCurrent") as HTMLImageElement).src = btn.dataset.image || "/images/services/maquillaje-social-1.jpg";

          serviceImgBase64 = "";
          serviceImgFileName = "";
          serviceImgFile.value = "";
          serviceImgPreviewContainer.classList.add("hidden");

          modalService.classList.remove("hidden");
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-toggle-service").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const serviceId = btn.dataset.id!;
          const currentActive = parseInt(btn.dataset.active || "1", 10);
          const nextActive = currentActive === 1 ? 0 : 1;

          btn.disabled = true;
          try {
            const { data, error } = await actions.toggleServiceStatus({ serviceId, isActive: nextActive });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo cambiar el estado del servicio.");
            } else {
              showNotice("success", nextActive === 1 ? "✅ Servicio activado." : "Servicio ocultado.");
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al actualizar.");
          } finally {
            btn.disabled = false;
          }
        });
      });

      document.getElementById("formService")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSubmitService") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Guardando...";

        const id = (document.getElementById("serviceId") as HTMLInputElement).value;
        const name = (document.getElementById("serviceName") as HTMLInputElement).value;
        const price = parseInt((document.getElementById("servicePrice") as HTMLInputElement).value, 10);
        const durationMinutes = parseInt((document.getElementById("serviceDuration") as HTMLInputElement).value, 10);
        const priceRange = (document.getElementById("servicePriceRange") as HTMLInputElement).value;
        const badge = (document.getElementById("serviceBadge") as HTMLInputElement).value;
        const depositRequired = parseInt((document.getElementById("serviceDepositReq") as HTMLSelectElement).value, 10);
        const depositAmount = parseInt((document.getElementById("serviceDepositAmt") as HTMLInputElement).value, 10);
        const description = (document.getElementById("serviceDescription") as HTMLTextAreaElement).value;

        try {
          const payload: any = {
            name,
            price,
            durationMinutes,
            priceRange,
            badge,
            depositRequired,
            depositAmount,
            description,
          };
          if (serviceImgBase64 && serviceImgFileName) {
            payload.imageBase64 = serviceImgBase64;
            payload.imageName = serviceImgFileName;
          }

          let res: any;
          if (id) {
            payload.id = id;
            res = await actions.updateService(payload);
          } else {
            res = await actions.createService(payload);
          }

          if (res.error || !res.data?.success) {
            showNotice("error", res.error?.message || "Error al guardar el servicio.");
          } else {
            showNotice("success", "💅 Servicio guardado exitosamente.");
            modalService.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de red.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Guardar Servicio";
        }
      });

      // 11. BOOKINGS STATUS SELECTOR
      document.querySelectorAll<HTMLSelectElement>(".booking-status-select").forEach((select) => {
        select.addEventListener("change", async () => {
          const bookingId = select.dataset.id!;
          const status = select.value as any;
          select.disabled = true;

          try {
            const { data, error } = await actions.updateBookingStatus({ bookingId, status });
            if (error || !data?.success) {
              showNotice("error", error?.message || "No se pudo actualizar la cita.");
            } else {
              showNotice("success", `✅ Estado de cita actualizado a "${status}".`);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error al actualizar.");
          } finally {
            select.disabled = false;
          }
        });
      });

      // 12. HERO BANNERS & LOOKBOOK MANAGEMENT
      let heroMainBase64 = "";
      let heroMainFileName = "";
      const fileHeroMain = document.getElementById("fileHeroMain") as HTMLInputElement;
      const previewHeroMain = document.getElementById("previewHeroMain") as HTMLImageElement;
      const btnSaveHeroMain = document.getElementById("btnSaveHeroMain") as HTMLButtonElement;

      fileHeroMain?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file, 1600, 1600, 0.88);
          heroMainBase64 = compressed.base64;
          heroMainFileName = compressed.name;
          previewHeroMain.src = compressed.base64;
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar foto de portada.");
        }
      });

      // --- HERO PRODUCT PORTADA INTERACTIVE SCRIPT ---
      let selectedHeroImgUrl = "";
      const heroProductSelect = document.getElementById("heroProductSelect") as HTMLSelectElement | null;
      const previewHeroTitle = document.getElementById("previewHeroTitle");
      const previewHeroSlug = document.getElementById("previewHeroSlug");
      const previewHeroPrice = document.getElementById("previewHeroPrice");
      const heroPhotosList = document.getElementById("heroProductPhotosList");

      function renderHeroProductPhotos() {
        if (!heroProductSelect || !heroPhotosList) return;
        const opt = heroProductSelect.selectedOptions[0];
        if (!opt) return;

        const name = opt.getAttribute("data-name") || "";
        const slug = opt.value;
        const price = opt.getAttribute("data-price") || "";
        const firstImg = opt.getAttribute("data-img") || "";
        let images: string[] = [];
        try {
          images = JSON.parse(opt.getAttribute("data-images") || "[]");
        } catch (_) {
          images = firstImg ? [firstImg] : [];
        }
        if (images.length === 0 && firstImg) images.push(firstImg);

        if (!selectedHeroImgUrl || !images.includes(selectedHeroImgUrl)) {
          selectedHeroImgUrl = images[0] || firstImg;
        }

        if (previewHeroMain) previewHeroMain.src = selectedHeroImgUrl;
        if (previewHeroTitle) previewHeroTitle.textContent = name;
        if (previewHeroSlug) previewHeroSlug.textContent = "/p/" + slug;
        if (previewHeroPrice) previewHeroPrice.textContent = price;

        heroPhotosList.innerHTML = "";
        images.forEach((imgUrl, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          const isSelected = imgUrl === selectedHeroImgUrl;
          btn.className = `relative w-14 h-16 rounded-lg overflow-hidden border-2 transition-all cursor-pointer ${
            isSelected ? "border-amber-400 ring-2 ring-amber-400/40 scale-105" : "border-zinc-800 hover:border-zinc-500 opacity-70 hover:opacity-100"
          }`;
          btn.innerHTML = `<img src="${imgUrl}" class="w-full h-full object-cover object-top" /><span class="absolute bottom-0 inset-x-0 bg-black/80 text-[8px] font-mono text-center text-white py-0.5">#${idx + 1}</span>`;
          btn.addEventListener("click", () => {
            selectedHeroImgUrl = imgUrl;
            if (previewHeroMain) previewHeroMain.src = imgUrl;
            renderHeroProductPhotos();
          });
          heroPhotosList.appendChild(btn);
        });
      }

      heroProductSelect?.addEventListener("change", () => {
        selectedHeroImgUrl = "";
        renderHeroProductPhotos();
      });

      if (heroProductSelect) {
        renderHeroProductPhotos();
      }

      btnSaveHeroMain?.addEventListener("click", async () => {
        if (!heroProductSelect) return;
        const opt = heroProductSelect.selectedOptions[0];
        if (!opt) return;

        const slug = opt.value;
        const name = opt.getAttribute("data-name") || "";
        const price = opt.getAttribute("data-price") || "";

        btnSaveHeroMain.disabled = true;
        btnSaveHeroMain.innerHTML = "<span>⏳</span> Guardando Portada...";
        try {
          const payload: any = {
            targetKey: "hero_image",
            productSlug: slug,
            imageUrl: selectedHeroImgUrl || opt.getAttribute("data-img") || "",
            productName: name,
            productPrice: price,
            altText: name,
          };
          if (heroMainBase64 && heroMainFileName) {
            payload.imageBase64 = heroMainBase64;
            payload.imageName = heroMainFileName;
          }
          const { data, error } = await actions.uploadBannerImage(payload);
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar portada principal.");
          } else {
            showNotice("success", `🌟 ¡'${name}' fijada como Portada Principal!`);
            setTimeout(() => {
              window.location.href = window.location.pathname + "?_t=" + Date.now() + "#tab-hero";
            }, 400);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSaveHeroMain.disabled = false;
          btnSaveHeroMain.innerHTML = "<span>★</span> Fijar esta Prenda y Foto como Portada Principal";
        }
      });

      // 1-Click Set Hero from Products Table (Tab 1)
      document.querySelectorAll(".btn-set-hero").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const slug = target.getAttribute("data-slug");
          const name = target.getAttribute("data-name") || "";
          const price = target.getAttribute("data-price") || "";
          const img = target.getAttribute("data-img") || "";

          if (!slug) return;
          target.disabled = true;
          const origText = target.innerHTML;
          target.innerHTML = "<span>⏳</span> Fijando...";
          try {
            const { data, error } = await actions.uploadBannerImage({
              targetKey: "hero_image",
              productSlug: slug,
              imageUrl: img,
              productName: name,
              productPrice: price,
              altText: name,
            });
            if (error || !data?.success) {
              showNotice("error", error?.message || "Error al fijar portada.");
              target.disabled = false;
              target.innerText = "★ Portada";
            } else {
              showNotice("success", `🌟 ¡'${name}' es ahora la Portada Principal!`);
              setTimeout(() => {
                window.location.href = window.location.pathname + "?_t=" + Date.now() + "#tab-products";
              }, 400);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error de conexión.");
            target.disabled = false;
            target.innerText = "★ Portada";
          }
        });
      });

      let heroSecBase64 = "";
      let heroSecFileName = "";
      const fileHeroSec = document.getElementById("fileHeroSec") as HTMLInputElement;
      const previewHeroSec = document.getElementById("previewHeroSec") as HTMLImageElement;
      const btnSaveHeroSec = document.getElementById("btnSaveHeroSec") as HTMLButtonElement;

      fileHeroSec?.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const compressed = await compressImageStrict(file, 1600, 1600, 0.88);
          heroSecBase64 = compressed.base64;
          heroSecFileName = compressed.name;
          previewHeroSec.src = compressed.base64;
        } catch (err: any) {
          showNotice("error", err.message || "Error al procesar foto secundaria.");
        }
      });

      btnSaveHeroSec?.addEventListener("click", async () => {
        if (!heroSecBase64 || !heroSecFileName) {
          showNotice("error", "Por favor seleccioná una nueva foto antes de guardar.");
          return;
        }
        btnSaveHeroSec.disabled = true;
        btnSaveHeroSec.innerText = "Subiendo Portada...";
        try {
          const { data, error } = await actions.uploadBannerImage({
            targetKey: "hero_secondary_image",
            imageBase64: heroSecBase64,
            imageName: heroSecFileName,
            altText: "Atelier Social Catalina Glamur",
          });
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar portada secundaria.");
          } else {
            showNotice("success", "💄 ¡Portada secundaria actualizada con éxito!");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSaveHeroSec.disabled = false;
          btnSaveHeroSec.innerText = "Actualizar Portada Secundaria";
        }
      });

      // 13. GESTIÓN DE CUPONES & DESCUENTOS
      const btnOpenNewCouponModal = document.getElementById("btnOpenNewCouponModal");
      btnOpenNewCouponModal?.addEventListener("click", () => {
        (document.getElementById("newCouponCode") as HTMLInputElement).value = "";
        (document.getElementById("newCouponDesc") as HTMLInputElement).value = "";
        (document.getElementById("newCouponValue") as HTMLInputElement).value = "";
        (document.getElementById("newCouponMin") as HTMLInputElement).value = "0";
        (document.getElementById("newCouponMaxUses") as HTMLInputElement).value = "";
        modalNewCoupon?.classList.remove("hidden");
      });

      document.getElementById("formNewCoupon")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSaveNewCoupon") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Guardando...";

        const code = (document.getElementById("newCouponCode") as HTMLInputElement).value.trim();
        const description = (document.getElementById("newCouponDesc") as HTMLInputElement).value.trim();
        const discountType = (document.getElementById("newCouponType") as HTMLSelectElement).value as "percentage" | "fixed";
        const discountValue = parseInt((document.getElementById("newCouponValue") as HTMLInputElement).value, 10);
        const minOrderAmount = parseInt((document.getElementById("newCouponMin") as HTMLInputElement).value, 10) || 0;
        const maxUsesVal = (document.getElementById("newCouponMaxUses") as HTMLInputElement).value;
        const maxUses = maxUsesVal ? parseInt(maxUsesVal, 10) : null;

        try {
          const { data, error } = await actions.createCoupon({
            code,
            description,
            discountType,
            discountValue,
            minOrderAmount,
            maxUses,
          });
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al crear el cupón.");
          } else {
            showNotice("success", `🎟️ ¡Cupón ${code} creado exitosamente!`);
            modalNewCoupon?.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Crear Cupón";
        }
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-edit-coupon").forEach((btn) => {
        btn.addEventListener("click", () => {
          (document.getElementById("editCouponId") as HTMLInputElement).value = btn.dataset.id || "";
          (document.getElementById("editCouponCode") as HTMLInputElement).value = btn.dataset.code || "";
          (document.getElementById("editCouponDesc") as HTMLInputElement).value = btn.dataset.desc || "";
          (document.getElementById("editCouponType") as HTMLSelectElement).value = btn.dataset.type || "percentage";
          (document.getElementById("editCouponValue") as HTMLInputElement).value = btn.dataset.val || "";
          (document.getElementById("editCouponMin") as HTMLInputElement).value = btn.dataset.min || "0";
          (document.getElementById("editCouponActive") as HTMLSelectElement).value = btn.dataset.active || "1";
          modalEditCoupon?.classList.remove("hidden");
        });
      });

      document.getElementById("formEditCoupon")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btnSave = document.getElementById("btnSaveEditCoupon") as HTMLButtonElement;
        btnSave.disabled = true;
        btnSave.innerText = "Guardando...";

        const id = (document.getElementById("editCouponId") as HTMLInputElement).value;
        const code = (document.getElementById("editCouponCode") as HTMLInputElement).value.trim();
        const description = (document.getElementById("editCouponDesc") as HTMLInputElement).value.trim();
        const discountType = (document.getElementById("editCouponType") as HTMLSelectElement).value as "percentage" | "fixed";
        const discountValue = parseInt((document.getElementById("editCouponValue") as HTMLInputElement).value, 10);
        const minOrderAmount = parseInt((document.getElementById("editCouponMin") as HTMLInputElement).value, 10) || 0;
        const isActive = parseInt((document.getElementById("editCouponActive") as HTMLSelectElement).value, 10);

        try {
          const { data, error } = await actions.updateCoupon({
            id,
            code,
            description,
            discountType,
            discountValue,
            minOrderAmount,
            isActive,
          });
          if (error || !data?.success) {
            showNotice("error", error?.message || "Error al actualizar cupón.");
          } else {
            showNotice("success", `🎟️ Cupón ${code} actualizado exitosamente.`);
            modalEditCoupon?.classList.add("hidden");
            setTimeout(() => window.location.reload(), 600);
          }
        } catch (err: any) {
          showNotice("error", err.message || "Error de conexión.");
        } finally {
          btnSave.disabled = false;
          btnSave.innerText = "Guardar Cambios";
        }
      });

      document.querySelectorAll<HTMLButtonElement>(".btn-delete-coupon").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.id!;
          const code = btn.dataset.code!;
          if (!confirm(`¿Eliminar definitivamente el cupón "${code}"?`)) return;

          try {
            const { data, error } = await actions.deleteCoupon({ id });
            if (error || !data?.success) {
              showNotice("error", error?.message || "Error al eliminar cupón.");
            } else {
              showNotice("success", `🗑️ Cupón ${code} eliminado.`);
              setTimeout(() => window.location.reload(), 600);
            }
          } catch (err: any) {
            showNotice("error", err.message || "Error de conexión.");
          }
        });
      });
    </script>
  </body>
</html>

