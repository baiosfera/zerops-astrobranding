                      <td class="px-4 py-3 font-mono font-semibold text-amber-400">
                        ${prod.basePrice.toLocaleString("es-CO")}
                      </td>
                      <td class="px-4 py-3 font-mono">
                        <span class={(prod.stock || 0) > 0 ? "text-emerald-400" : "text-red-400"}>
                          {prod.stock || 0} uds
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <button
                          type="button"
                          class="btn-toggle-product cursor-pointer transition-transform active:scale-95"
