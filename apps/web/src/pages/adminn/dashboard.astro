          <div class="bg-zinc-900/70 border border-zinc-800 rounded-2xl p-5 space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="font-bold text-white text-sm">🖼️ Portada Principal (Hero)</h3>
                <p class="text-[11px] text-zinc-400">Prenda activa y foto destacada en la cabecera de la tienda.</p>
              </div>
              <span class="text-[11px] font-mono text-amber-400">hero_image</span>
            </div>

            <!-- Preview Grande de Portada con Datos del Producto Vinculado -->
            <div class="relative aspect-[3/4] max-h-80 w-full bg-zinc-950 rounded-xl overflow-hidden border border-amber-500/40 flex items-center justify-center">
              <img id="previewHeroMain" src={heroImage.url} alt="Hero Principal" class="w-full h-full object-cover object-top" />
              <div class="absolute bottom-0 inset-x-0 p-3 bg-gradient-to-t from-black/90 via-black/60 to-transparent">
                <span class="text-[9px] font-mono text-amber-400 uppercase tracking-wider block">Prenda en Portada</span>
                <p id="previewHeroTitle" class="text-sm font-semibold text-white truncate">
                  {catalogItems.find(p => p.slug === heroImage.productSlug)?.name || heroImage.title || "Prenda de Tienda"}
                </p>
                <div class="flex items-center justify-between pt-0.5">
                  <span id="previewHeroSlug" class="text-[10px] font-mono text-zinc-400">
                    /p/{heroImage.productSlug || catalogItems[0]?.slug || ""}
                  </span>
                  <span id="previewHeroPrice" class="text-xs font-mono font-bold text-amber-400">
                    {heroImage.price || (catalogItems.find(p => p.slug === heroImage.productSlug) ? new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(catalogItems.find(p => p.slug === heroImage.productSlug).basePrice) : "")}
                  </span>
                </div>
              </div>
            </div>

            <!-- Elegir Prenda de la Tienda -->
            <div class="space-y-3 pt-1">
              <div class="space-y-1">
                <label class="block text-xs font-semibold text-zinc-200">
                  Seleccionar Prenda de la Tienda para Portada:
                </label>
                <select
                  id="heroProductSelect"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-xs text-amber-400 font-medium focus:outline-none focus:border-amber-500 cursor-pointer"
                >
                  {catalogItems.map((p) => {
                    let pImgs = [];
                    try { pImgs = Array.isArray(p.images) ? p.images : JSON.parse(p.images); } catch (_) {}
                    return (
                      <option
                        value={p.slug}
                        data-name={p.name}
                        data-price={new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(p.basePrice)}
                        data-img={pImgs[0] || ""}
                        data-images={JSON.stringify(pImgs)}
                        selected={heroImage.productSlug === p.slug || (!heroImage.productSlug && p.slug === catalogItems[0]?.slug)}
                      >
                        {p.name} (#{p.displayOrder ?? 0}) • {new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(p.basePrice)}
                      </option>
                    );
                  })}
                </select>
              </div>

              <!-- Fotos de la Prenda Seleccionada para Elegir Cuál Usar de Portada -->
              <div id="heroProductPhotosContainer" class="space-y-1.5 bg-zinc-950/60 p-3 rounded-xl border border-zinc-800/80">
                <span class="block text-[11px] text-zinc-300 font-medium">
                  Fotos disponibles de esta prenda (hacé clic en la que querés de portada):
                </span>
                <div id="heroProductPhotosList" class="flex flex-wrap gap-2 pt-1">
                  <!-- Llenado dinámicamente con JavaScript -->
                </div>
              </div>

              <button
                type="button"
                id="btnSaveHeroMain"
                class="w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold text-xs transition-colors cursor-pointer flex items-center justify-center gap-2 shadow-lg"
              >
                <span>★</span> Fijar esta Prenda y Foto como Portada Principal
              </button>

              <details class="pt-2 text-xs text-zinc-500 border-t border-zinc-800/60">
                <summary class="cursor-pointer hover:text-zinc-300 select-none py-1">
                  Opción secundaria: Subir foto manual externa
                </summary>
                <div class="pt-2 space-y-2">
                  <input
                    type="file"
                    id="fileHeroMain"
                    accept="image/*"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-zinc-400 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-zinc-800 file:text-amber-400 hover:file:bg-zinc-700 cursor-pointer"
                  />
                </div>
              </details>
            </div>
          </div>

          <!-- Hero Lookbook Secundario -->
          <div class="bg-zinc-900/70 border border-zinc-800 rounded-2xl p-5 space-y-4">
            <h3 class="font-bold text-white text-sm flex items-center justify-between">
              <span>💄 Portada Secundaria (Atelier)</span>
              <span class="text-[11px] font-mono text-amber-400">hero_secondary_image</span>
            </h3>

            <div class="aspect-[3/4] max-h-72 w-full bg-zinc-950 rounded-xl overflow-hidden border border-zinc-800 flex items-center justify-center">
              <img id="previewHeroSec" src={heroSecondary.url} alt="Hero Secundario" class="w-full h-full object-cover" />
            </div>

            <div class="space-y-2">
              <label class="block text-xs font-semibold text-zinc-300">Cambiar Foto (Galería o Archivo)</label>
              <input
                type="file"
                id="fileHeroSec"
                accept="image/*"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-zinc-400 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-zinc-800 file:text-amber-400 hover:file:bg-zinc-700 cursor-pointer"
              />
              <button
                type="button"
                id="btnSaveHeroSec"
                class="w-full py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold text-xs transition-colors cursor-pointer"
              >
                Actualizar Portada Secundaria
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- DATALIST PARA CATEGORÍAS DINÁMICAS -->
    
