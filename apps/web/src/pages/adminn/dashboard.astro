                          data-active={prod.isActive}
                          title="Clic para cambiar visibilidad"
                        >
                          {prod.isActive === 1 ? (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-950 text-emerald-400 border border-emerald-800">
                              ● Visible
                            </span>
                          ) : (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">
                              ○ Oculto
                            </span>
                          )}
                        </button>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <div class="flex items-center justify-end space-x-2">
                          {heroImage.productSlug === prod.slug ? (
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[11px] font-semibold" title="Esta prenda está actualmente fijada en la Portada Principal">
                              ★ En Portada
                            </span>
                          ) : (
                            <button
                              type="button"
                              class="btn-set-hero px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-amber-500 hover:text-zinc-950 text-zinc-300 border border-zinc-700/60 transition-colors cursor-pointer text-[11px] inline-flex items-center gap-1"
                              data-slug={prod.slug}
                              data-name={prod.name}
                              data-price={new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(prod.basePrice)}
                              data-img={firstImg}
                              title="Fijar esta prenda y su foto como portada principal de la tienda"
                            >
                              <span>★</span> Portada
