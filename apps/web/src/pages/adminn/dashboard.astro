---
export const prerender = false;

import { getDb, products, productVariants, services, bookings, siteSettings, desc, eq } from "@astrobranding/database";

// Handle direct logout navigation query (?logout=1)
if (Astro.url.searchParams.get("logout") === "1") {
  const sessionToken = Astro.cookies.get("admin_session")?.value;
  if (sessionToken) {
    const { revokeAdminSession } = await import("@astrobranding/database");
    await revokeAdminSession(sessionToken);
  }
  Astro.cookies.delete("admin_session", { path: "/" });
  Astro.cookies.delete("admin_session", { path: "/adminn" });
  return Astro.redirect("/adminn");
}

const adminUser = Astro.locals.adminUser;
if (!adminUser) {
  return Astro.redirect("/adminn");
}

const db = getDb();
const isSuperadmin = adminUser.role === "superadmin";

// 1. Fetch Products with Variants
const catalogItems = await db.select().from(products).orderBy(desc(products.createdAt));
const activeProductsCount = catalogItems.filter((p) => p.isActive === 1).length;

// Collect distinct categories dynamically
const rawCategories = Array.from(new Set(catalogItems.map((p) => p.category).filter(Boolean)));
const defaultCategories = ["activewear", "enterizos", "conjuntos", "tops", "accesorios", "servicio"];
const distinctCategories = Array.from(new Set([...rawCategories, ...defaultCategories]));

// 2. Fetch Services
const serviceItems = await db.select().from(services).orderBy(desc(services.createdAt));
const activeServicesCount = serviceItems.filter((s) => s.isActive === 1).length;

// 3. Fetch Bookings
const bookingItems = await db.select().from(bookings).orderBy(desc(bookings.appointmentDate)).limit(50);

// 4. Fetch Site Settings
const settingsRows = await db.select().from(siteSettings);
const settingsMap: Record<string, any> = {};
for (const row of settingsRows) {
  settingsMap[row.key] = row.value;
}
const heroImage = settingsMap["hero_image"] || { url: "/images/products/product-01.jpg", alt: "Portada Principal" };
const heroSecondary = settingsMap["hero_secondary_image"] || { url: "/images/services/maquillaje-social-1.jpg", alt: "Atelier Social" };
---

<!doctype html>
<html lang="es" class="h-full bg-zinc-950 text-zinc-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Control 360° | Catalina Glamur</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/theme.css" />
    <style>
      .tab-btn.active {
        background-color: #27272a;
        color: #fbbf24;
        border-color: #f59e0b;
      }
      .tab-pane {
        display: none;
      }
      .tab-pane.active {
        display: block;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col selection:bg-amber-500 selection:text-black font-sans antialiased">
    <!-- Top Bar -->
    <header class="border-b border-zinc-800/80 bg-zinc-900/90 backdrop-blur sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-lg font-bold tracking-tight text-white font-serif">Catalina Glamur</span>
          <span class="hidden sm:inline-block text-[11px] font-mono uppercase bg-zinc-800 text-amber-400 px-2 py-0.5 rounded border border-amber-500/20">
            Suite 360°
          </span>
        </div>

        <div class="flex items-center space-x-4">
          <div class="text-right hidden sm:block">
            <div class="text-xs font-semibold text-zinc-200">{adminUser.name}</div>
            <div class="flex items-center justify-end space-x-1.5">
              <span class={`text-[10px] uppercase font-mono px-1.5 py-0.2 rounded font-semibold ${isSuperadmin ? 'bg-purple-950/80 text-purple-300 border border-purple-800/50' : 'bg-emerald-950/80 text-emerald-300 border border-emerald-800/50'}`}>
                {adminUser.role}
              </span>
            </div>
          </div>

          <a
            href="/adminn/dashboard?logout=1"
            id="btnLogout"
            class="text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white px-3 py-1.5 rounded-lg border border-zinc-700/60 transition-all cursor-pointer inline-flex items-center"
          >
            Cerrar Sesión
          </a>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
      <!-- Status Notice -->
      <div id="dashboardNotice" class="hidden p-4 rounded-xl text-sm border transition-all shadow-lg"></div>

      <!-- Header Title & Quick Metrics -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-zinc-800">
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            Panel de Control Soberano
          </h1>
          <p class="text-xs text-zinc-400 mt-1">
            Gestión completa de catálogo, maquillaje, citas y portadas sin código. Sincronización en vivo con PostgreSQL 18.
          </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <button
            id="btnOpenNewProductModal"
            class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-zinc-950 font-semibold text-xs px-3.5 py-2 rounded-xl transition-all shadow-md shadow-amber-500/10 flex items-center space-x-1.5 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <span>Nueva Prenda</span>
          </button>
          <button
            id="btnOpenNewServiceModal"
            class="bg-zinc-800 hover:bg-zinc-700 text-amber-400 border border-amber-500/30 font-semibold text-xs px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <span>Nuevo Servicio</span>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex items-center gap-2 border-b border-zinc-800 pb-3 overflow-x-auto text-xs font-medium">
        <button
          type="button"
          data-target="tab-products"
          class="tab-btn active px-4 py-2 rounded-xl border border-transparent bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <span>👗 Catálogo de Prendas</span>
          <span class="bg-zinc-800 text-amber-400 px-2 py-0.5 rounded-full text-[10px] font-mono border border-amber-500/20">{catalogItems.length}</span>
        </button>

        <button
          type="button"
          data-target="tab-services"
          class="tab-btn px-4 py-2 rounded-xl border border-transparent bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <span>💄 Atelier de Maquillaje</span>
          <span class="bg-zinc-800 text-amber-400 px-2 py-0.5 rounded-full text-[10px] font-mono border border-amber-500/20">{serviceItems.length}</span>
        </button>

        <button
          type="button"
          data-target="tab-bookings"
          class="tab-btn px-4 py-2 rounded-xl border border-transparent bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <span>📅 Citas & Agenda</span>
          <span class="bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded-full text-[10px] font-mono">{bookingItems.length}</span>
        </button>

        <button
          type="button"
          data-target="tab-settings"
          class="tab-btn px-4 py-2 rounded-xl border border-transparent bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <span>🖼️ Portada & Lookbook</span>
        </button>
      </nav>

      <!-- TAB 1: PRENDAS & CATÁLOGO -->
      <section id="tab-products" class="tab-pane active space-y-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-zinc-900/60 p-3 rounded-2xl border border-zinc-800">
          <div class="relative w-full sm:w-80">
            <input
              type="text"
              id="searchProducts"
              placeholder="Buscar prenda por nombre o categoría..."
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-amber-500"
            />
          </div>
          <div class="flex items-center gap-3 text-xs text-zinc-400">
            <span>Activas: <strong class="text-emerald-400">{activeProductsCount}</strong></span>
            <span>•</span>
            <span>Ocultas: <strong class="text-zinc-400">{catalogItems.length - activeProductsCount}</strong></span>
          </div>
        </div>

        <div class="bg-zinc-900/70 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-xl">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-zinc-300">
              <thead class="bg-zinc-950/80 text-zinc-400 uppercase tracking-wider font-mono text-[10px] border-b border-zinc-800">
                <tr>
                  <th class="px-4 py-3.5">Prenda</th>
                  <th class="px-4 py-3.5">Categoría</th>
                  <th class="px-4 py-3.5">Precio (COP)</th>
                  <th class="px-4 py-3.5">Stock</th>
                  <th class="px-4 py-3.5">Estado</th>
                  <th class="px-4 py-3.5 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody id="productsTableBody" class="divide-y divide-zinc-800/60">
                {catalogItems.map((prod) => {
                  let imgs: string[] = [];
                  if (Array.isArray(prod.images)) {
                    imgs = prod.images as string[];
                  } else if (typeof prod.images === "string") {
                    try { imgs = JSON.parse(prod.images); } catch (_) { imgs = []; }
                  }
                  const firstImg = imgs[0] || "/placeholder.jpg";
                  return (
                    <tr class="hover:bg-zinc-800/30 transition-colors product-row" data-name={prod.name.toLowerCase()} data-cat={(prod.category || "").toLowerCase()}>
                      <td class="px-4 py-3">
                        <div class="flex items-center space-x-3">
                          <img
                            src={firstImg}
                            alt={prod.name}
                            class="h-12 w-10 object-cover rounded-lg border border-zinc-800 bg-zinc-950 flex-shrink-0"
                            loading="lazy"
                          />
                          <div>
                            <div class="font-medium text-white">{prod.name}</div>
                            <div class="text-[11px] text-zinc-500 font-mono">/p/{prod.slug}</div>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-mono bg-zinc-800 text-amber-300 border border-amber-500/20">
                          {prod.category}
                        </span>
                      </td>
                      <td class="px-4 py-3 font-mono font-semibold text-amber-400">
                        ${prod.basePrice.toLocaleString("es-CO")}
                      </td>
                      <td class="px-4 py-3 font-mono">
                        <span class={(prod.stock || 0) > 0 ? "text-emerald-400" : "text-red-400"}>
                          {prod.stock || 0} uds
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <button
                          type="button"
                          class="btn-toggle-product cursor-pointer transition-transform active:scale-95"
                          data-id={prod.id}
                          data-active={prod.isActive}
                          title="Clic para cambiar visibilidad"
                        >
                          {prod.isActive === 1 ? (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-950 text-emerald-400 border border-emerald-800">
                              ● Visible
                            </span>
                          ) : (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">
                              ○ Oculto
                            </span>
                          )}
                        </button>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <div class="flex items-center justify-end space-x-2">
                          <button
                            type="button"
                            class="btn-edit-product px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 transition-colors cursor-pointer"
                            data-id={prod.id}
                            data-name={prod.name}
                            data-slug={prod.slug}
                            data-price={prod.basePrice}
                            data-category={prod.category}
                            data-stock={prod.stock || 0}
                            data-description={prod.description || ""}
                            data-image={firstImg}
                          >
                            Editar
                          </button>
                          <a
                            href={`/p/${prod.slug}`}
                            target="_blank"
                            class="px-2 py-1 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors"
                            title="Ver en la tienda"
                          >
                            ↗
                          </a>
                          {isSuperadmin && (
                            <button
                              type="button"
                              class="btn-delete-product px-2 py-1 rounded-lg bg-red-950/60 hover:bg-red-900 text-red-300 border border-red-800/50 transition-colors cursor-pointer"
                              data-id={prod.id}
                              data-name={prod.name}
                              title="Eliminar permanentemente (Superadmin)"
                            >
                              ✕
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 2: ATELIER DE MAQUILLAJE (SERVICIOS) -->
      <section id="tab-services" class="tab-pane space-y-4">
        <div class="flex items-center justify-between bg-zinc-900/60 p-3 rounded-2xl border border-zinc-800">
          <p class="text-xs text-zinc-400">
            Servicios visibles en <a href="/servicios" target="_blank" class="text-amber-400 underline">/servicios</a>. Editá precios, duración, anticipos y fotografías directamente.
          </p>
          <span class="text-xs text-zinc-400">
            Activos: <strong class="text-emerald-400">{activeServicesCount}</strong> / {serviceItems.length}
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {serviceItems.map((serv) => (
            <div class="bg-zinc-900/70 border border-zinc-800 rounded-2xl overflow-hidden flex flex-col justify-between shadow-xl">
              <div class="relative aspect-video bg-zinc-950">
                <img
                  src={serv.imageUrl || "/images/services/maquillaje-social-1.jpg"}
                  alt={serv.name}
                  class="w-full h-full object-cover"
                />
                <span class="absolute top-2.5 right-2.5 bg-black/70 backdrop-blur text-[10px] font-mono text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/30">
                  {serv.badge || "Atelier"}
                </span>
                <span class="absolute bottom-2.5 left-2.5 bg-zinc-900/80 backdrop-blur text-[10px] font-mono text-zinc-300 px-2 py-0.5 rounded">
                  ⏱ {serv.durationMinutes} min
                </span>
              </div>

              <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-bold text-white text-sm">{serv.name}</h3>
                  <p class="text-[11px] text-zinc-400 line-clamp-2 mt-1">{serv.description || "Sin descripción corta."}</p>
                </div>

                <div class="pt-2 border-t border-zinc-800 space-y-1.5 text-xs">
                  <div class="flex justify-between">
                    <span class="text-zinc-500">Precio Base:</span>
                    <strong class="font-mono text-amber-400">${serv.price.toLocaleString("es-CO")}</strong>
                  </div>
                  <div class="flex justify-between text-[11px]">
                    <span class="text-zinc-500">Rango visible:</span>
                    <span class="font-mono text-zinc-300">{serv.priceRange || "Según cotización"}</span>
                  </div>
                  <div class="flex justify-between text-[11px]">
                    <span class="text-zinc-500">Anticipo:</span>
                    <span class="font-mono text-zinc-300">
                      {serv.depositRequired === 1 ? `$${serv.depositAmount.toLocaleString("es-CO")}` : "No requerido"}
                    </span>
                  </div>
                </div>

                <div class="pt-3 border-t border-zinc-800 flex items-center justify-between">
                  <button
                    type="button"
                    class="btn-toggle-service text-[11px] cursor-pointer"
                    data-id={serv.id}
                    data-active={serv.isActive}
                  >
                    {serv.isActive === 1 ? (
                      <span class="px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800">● Activo</span>
                    ) : (
                      <span class="px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400 border border-zinc-700">○ Inactivo</span>
                    )}
                  </button>

                  <div class="flex gap-2">
                    <a
                      href={`/servicios/${serv.slug}`}
                      target="_blank"
                      class="px-2 py-1 text-xs rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors"
                      title="Ver página de servicio"
                    >
                      ↗
                    </a>
                    <button
                      type="button"
                      class="btn-edit-service px-3 py-1 text-xs font-semibold rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30 hover:bg-amber-500/30 transition-colors cursor-pointer"
                      data-id={serv.id}
                      data-name={serv.name}
                      data-slug={serv.slug}
                      data-price={serv.price}
                      data-duration={serv.durationMinutes}
                      data-deposit-req={serv.depositRequired}
                      data-deposit-amt={serv.depositAmount}
                      data-pricerange={serv.priceRange || ""}
                      data-badge={serv.badge || ""}
                      data-image={serv.imageUrl || ""}
                      data-description={serv.description || ""}
                    >
                      Editar
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- TAB 3: CITAS & AGENDA (BOOKINGS) -->
      <section id="tab-bookings" class="tab-pane space-y-4">
        <div class="flex items-center justify-between bg-zinc-900/60 p-3 rounded-2xl border border-zinc-800 text-xs text-zinc-400">
          <span>Registro en vivo de reservas capturadas en el Atelier de Maquillaje.</span>
          <span>Total citas: <strong class="text-white">{bookingItems.length}</strong></span>
        </div>

        {bookingItems.length === 0 ? (
          <div class="bg-zinc-900/40 border border-zinc-800 rounded-2xl p-10 text-center space-y-3">
            <span class="text-3xl block">📅</span>
            <h3 class="text-sm font-semibold text-zinc-300">No hay reservas registradas aún</h3>
            <p class="text-xs text-zinc-500 max-w-sm mx-auto">
              Cuando las clientas agenden citas en <code class="text-amber-400 font-mono">/servicios</code>, aparecerán listadas aquí para gestionar su estado y contactarlas por WhatsApp.
            </p>
          </div>
        ) : (
          <div class="bg-zinc-900/70 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-zinc-300">
                <thead class="bg-zinc-950/80 text-zinc-400 uppercase tracking-wider font-mono text-[10px] border-b border-zinc-800">
                  <tr>
                    <th class="px-4 py-3.5">Fecha & Hora</th>
                    <th class="px-4 py-3.5">Clienta</th>
                    <th class="px-4 py-3.5">Servicio</th>
                    <th class="px-4 py-3.5">Valor / Anticipo</th>
                    <th class="px-4 py-3.5">Estado</th>
                    <th class="px-4 py-3.5 text-right">Contacto</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/60">
                  {bookingItems.map((b) => {
                    const cleanPhone = (b.customerPhone || "").replace(/\D/g, "");
                    const waLink = `https://wa.me/57${cleanPhone}?text=Hola%20${encodeURIComponent(b.customerName)},%20te%20escribimos%20de%20Catalina%20Glamur%20para%20confirmar%20tu%20cita.`;
                    return (
                      <tr class="hover:bg-zinc-800/30 transition-colors">
                        <td class="px-4 py-3 font-mono text-zinc-200">
                          {new Date(b.appointmentDate).toLocaleString("es-CO", { dateStyle: "short", timeStyle: "short" })}
                        </td>
                        <td class="px-4 py-3">
                          <div class="font-medium text-white">{b.customerName}</div>
                          <div class="text-[11px] text-zinc-500 font-mono">{b.customerPhone}</div>
                        </td>
                        <td class="px-4 py-3">
                          <span class="text-amber-300 font-medium">{b.serviceName}</span>
                        </td>
                        <td class="px-4 py-3 font-mono">
                          <div>${b.totalAmount.toLocaleString("es-CO")}</div>
                          {b.depositAmount > 0 && (
                            <div class="text-[10px] text-emerald-400">Anticipo: ${b.depositAmount.toLocaleString("es-CO")}</div>
                          )}
                        </td>
                        <td class="px-4 py-3">
                          <select
                            class="booking-status-select bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-[11px] text-white focus:outline-none focus:border-amber-500 font-mono"
                            data-id={b.id}
                          >
                            <option value="pending" selected={b.status === "pending"}>⏳ Pendiente</option>
                            <option value="confirmed" selected={b.status === "confirmed"}>✅ Confirmada</option>
                            <option value="completed" selected={b.status === "completed"}>✨ Completada</option>
                            <option value="cancelled" selected={b.status === "cancelled"}>❌ Cancelada</option>
                          </select>
                        </td>
                        <td class="px-4 py-3 text-right">
                          <a
                            href={waLink}
                            target="_blank"
                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-950/80 hover:bg-emerald-900 text-emerald-300 border border-emerald-800 text-[11px] transition-colors"
                          >
                            <span>WhatsApp</span>
                            <span>↗</span>
                          </a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </section>

      <!-- TAB 4: PORTADA & LOOKBOOK -->
      <section id="tab-settings" class="tab-pane space-y-6">
        <div class="bg-zinc-900/60 p-4 rounded-2xl border border-zinc-800 text-xs text-zinc-400">
          Modificá las imágenes de portada principal y secundaria que se proyectan en la página de inicio. Podés seleccionar fotos directamente de la galería de tu teléfono.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Hero Banner Principal -->
          <div class="bg-zinc-900/70 border border-zinc-800 rounded-2xl p-5 space-y-4">
            <h3 class="font-bold text-white text-sm flex items-center justify-between">
