    <script>
      import { actions } from "astro:actions";

      const notice = document.getElementById("dashboardNotice") as HTMLDivElement;
      const btnLogout = document.getElementById("btnLogout") as HTMLAnchorElement;

      // Edit Modal Elements
      const editModal = document.getElementById("editModal") as HTMLDivElement;
      const editForm = document.getElementById("editForm") as HTMLFormElement;
      const btnCancelEdit = document.getElementById("btnCancelEdit") as HTMLButtonElement;
      const btnSaveEdit = document.getElementById("btnSaveEdit") as HTMLButtonElement;
      const editModalAlert = document.getElementById("editModalAlert") as HTMLDivElement;
      const editImageCurrent = document.getElementById("editImageCurrent") as HTMLImageElement;
      const editImageFile = document.getElementById("editImageFile") as HTMLInputElement;
      const editImageNewPreview = document.getElementById("editImageNewPreview") as HTMLImageElement;
      const editImageNewPreviewContainer = document.getElementById("editImageNewPreviewContainer") as HTMLDivElement;

      // Create Modal Elements
      const createModal = document.getElementById("createModal") as HTMLDivElement;
      const createForm = document.getElementById("createForm") as HTMLFormElement;
      const btnOpenNewProductModal = document.getElementById("btnOpenNewProductModal") as HTMLButtonElement;
      const btnCancelCreate = document.getElementById("btnCancelCreate") as HTMLButtonElement;
      const btnSaveCreate = document.getElementById("btnSaveCreate") as HTMLButtonElement;
      const createModalAlert = document.getElementById("createModalAlert") as HTMLDivElement;
      const createImageFile = document.getElementById("createImageFile") as HTMLInputElement;
      const imagePreview = document.getElementById("imagePreview") as HTMLImageElement;
      const imagePreviewContainer = document.getElementById("imagePreviewContainer") as HTMLDivElement;

      let editBase64 = "";
      let editFileName = "";
      let createBase64 = "";
      let createFileName = "";

      // Client-Side Image Resizer & Optimizer (Compresses high-res phone photos to ~200KB)
      async function compressImage(file: File, maxWidth = 1200, maxHeight = 1200, quality = 0.85): Promise<{ base64: string; name: string }> {
        if (!file.type.startsWith("image/")) {
          throw new Error("El archivo seleccionado no es una imagen válida.");
        }
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              let width = img.width;
              let height = img.height;
              if (width > maxWidth || height > maxHeight) {
                if (width / height > maxWidth / maxHeight) {
                  height = Math.round((height * maxWidth) / width);
                  width = maxWidth;
                } else {
                  width = Math.round((width * maxHeight) / height);
                  maxHeight = height;
                }
              }
              const canvas = document.createElement("canvas");
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              if (!ctx) {
                return resolve({ base64: e.target?.result as string, name: file.name });
              }
              ctx.drawImage(img, 0, 0, width, height);
              const compressedBase64 = canvas.toDataURL("image/jpeg", quality);
              resolve({ base64: compressedBase64, name: file.name.replace(/\.[^.]+$/, ".jpg") });
            };
            img.onerror = () => reject(new Error("No se pudo cargar la imagen para procesarla."));
            img.src = e.target?.result as string;
          };
          reader.onerror = () => reject(new Error("Error al leer el archivo desde el dispositivo."));
          reader.readAsDataURL(file);
        });
      }

      function showNotice(type: "success" | "error", msg: string) {
        notice.classList.remove("hidden", "bg-emerald-950/50", "border-emerald-800", "text-emerald-200", "bg-red-950/50", "border-red-800", "text-red-200");
        if (type === "success") {
          notice.classList.add("bg-emerald-950/50", "border-emerald-800", "text-emerald-200");
        } else {
          notice.classList.add("bg-red-950/50", "border-red-800", "text-red-200");
        }
        notice.innerHTML = msg;
        setTimeout(() => {
          notice.classList.add("hidden");
        }, 5000);
      }

      // Logout handler (Destructive multi-tier clean)
      btnLogout?.addEventListener("click", async (e) => {
        e.preventDefault();
        try {
          await actions.logout();
        } catch (err) {
          console.warn("Logout action notice:", err);
        }
        document.cookie = "admin_session=; path=/adminn; max-age=0; SameSite=Lax; Secure";
        window.location.href = "/adminn/dashboard?logout=1";
      });

      // Status Toggle Handler
      document.querySelectorAll("[data-action='toggle-status']").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const productId = target.dataset.id!;
          const currentActive = parseInt(target.dataset.active || "1", 10);
          const nextActive = currentActive === 1 ? 0 : 1;

          try {
            const { data, error } = await actions.toggleProductStatus({
              productId,
              isActive: nextActive,
            });

            if (error) {
              showNotice("error", error.message);
              return;
            }

            if (data?.success) {
              target.dataset.active = nextActive.toString();
              window.location.reload();
            }
          } catch (err: any) {
            showNotice("error", err?.message || "Error al actualizar estado.");
          }
        });
      });

      // Edit Button Click (Populates fields and photo for both Superadmin & Merchant)
      document.querySelectorAll("[data-action='edit-product']").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          (document.getElementById("editId") as HTMLInputElement).value = target.dataset.id || "";
          (document.getElementById("editName") as HTMLInputElement).value = target.dataset.name || "";
          (document.getElementById("editDescription") as HTMLTextAreaElement).value = target.dataset.description || "";
          (document.getElementById("editPrice") as HTMLInputElement).value = target.dataset.price || "";
          (document.getElementById("editCategory") as HTMLInputElement).value = target.dataset.category || "";
          const slugInput = document.getElementById("editSlug") as HTMLInputElement;
          if (slugInput) slugInput.value = target.dataset.slug || "";

          // Populate current photo
          editImageCurrent.src = target.dataset.image || "/placeholder.jpg";
          editImageNewPreviewContainer.classList.add("hidden");
          editImageFile.value = "";
          editBase64 = "";
          editFileName = "";
          editModalAlert.classList.add("hidden");

          editModal.classList.remove("hidden");
        });
      });

      btnCancelEdit?.addEventListener("click", () => {
        editModal.classList.add("hidden");
      });

      // Edit Photo File Selection & Client-Side Compression
      editImageFile?.addEventListener("change", async (e: any) => {
        const file = e.target.files?.[0];
        if (file) {
          try {
            editModalAlert.classList.add("hidden");
            const res = await compressImage(file);
            editBase64 = res.base64;
            editFileName = res.name;
            editImageNewPreview.src = editBase64;
            editImageNewPreviewContainer.classList.remove("hidden");
          } catch (err: any) {
            editModalAlert.textContent = err?.message || "Error al procesar la foto.";
            editModalAlert.classList.remove("hidden");
          }
        }
      });

      // Save Edit Form
      editForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        editModalAlert.classList.add("hidden");
        btnSaveEdit.disabled = true;
        btnSaveEdit.textContent = "Guardando cambios...";

        const id = (document.getElementById("editId") as HTMLInputElement).value;
        const name = (document.getElementById("editName") as HTMLInputElement).value;
        const description = (document.getElementById("editDescription") as HTMLTextAreaElement).value;
        const basePrice = parseInt((document.getElementById("editPrice") as HTMLInputElement).value, 10);
        const category = (document.getElementById("editCategory") as HTMLInputElement).value;
        const slug = (document.getElementById("editSlug") as HTMLInputElement)?.value;

        try {
          const { data, error } = await actions.updateProduct({
            id,
            name,
            description,
            basePrice,
            category,
            slug: slug || undefined,
            imageBase64: editBase64 || undefined,
            imageName: editFileName || undefined,
          });

          if (error) {
            editModalAlert.textContent = error.message || "Error al guardar cambios.";
            editModalAlert.classList.remove("hidden");
            btnSaveEdit.disabled = false;
            btnSaveEdit.textContent = "Guardar Cambios";
            return;
          }

          if (data?.success) {
            editModal.classList.add("hidden");
            window.location.reload();
          }
        } catch (err: any) {
          editModalAlert.textContent = err?.message || "Error de conexión al guardar cambios.";
          editModalAlert.classList.remove("hidden");
        } finally {
          btnSaveEdit.disabled = false;
          btnSaveEdit.textContent = "Guardar Cambios";
        }
      });

      // Hard Delete Handler (Superadmin only)
      document.querySelectorAll("[data-action='delete-hard']").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const productId = target.dataset.id!;
          const name = target.dataset.name!;

          if (!confirm(`¿Eliminar permanentemente "${name}"?\nEsta acción no se puede deshacer.`)) {
            return;
          }

          try {
            const { data, error } = await actions.deleteProductHard({ productId });
            if (error) {
              showNotice("error", error.message);
              return;
            }
            if (data?.success) {
              window.location.reload();
            }
          } catch (err: any) {
            showNotice("error", err?.message || "Error al eliminar.");
          }
        });
      });

      // Create Product Modal Handlers
      btnOpenNewProductModal?.addEventListener("click", () => {
        createModalAlert.classList.add("hidden");
        createImageFile.value = "";
        createBase64 = "";
        createFileName = "";
        imagePreviewContainer.classList.add("hidden");
        createModal.classList.remove("hidden");
      });

      btnCancelCreate?.addEventListener("click", () => {
        createModal.classList.add("hidden");
      });

      createImageFile?.addEventListener("change", async (e: any) => {
        const file = e.target.files?.[0];
        if (file) {
          try {
            createModalAlert.classList.add("hidden");
            const res = await compressImage(file);
            createBase64 = res.base64;
            createFileName = res.name;
            imagePreview.src = createBase64;
            imagePreviewContainer.classList.remove("hidden");
          } catch (err: any) {
            createModalAlert.textContent = err?.message || "Error al procesar la foto.";
            createModalAlert.classList.remove("hidden");
          }
        }
      });

      createForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        createModalAlert.classList.add("hidden");
        btnSaveCreate.disabled = true;
        btnSaveCreate.textContent = "Publicando producto...";

        const name = (document.getElementById("createName") as HTMLInputElement).value;
        const basePrice = parseInt((document.getElementById("createPrice") as HTMLInputElement).value, 10);
        const category = (document.getElementById("createCategory") as HTMLSelectElement).value;
        const description = (document.getElementById("createDescription") as HTMLTextAreaElement).value;

        try {
          const { data, error } = await actions.createProduct({
            name,
            basePrice,
            category,
            description,
            imageBase64: createBase64 || undefined,
            imageName: createFileName || undefined,
          });

          if (error) {
            createModalAlert.textContent = error.message || "Error al crear producto.";
            createModalAlert.classList.remove("hidden");
            btnSaveCreate.disabled = false;
            btnSaveCreate.textContent = "Publicar Producto";
            return;
          }

          if (data?.success) {
            createModal.classList.add("hidden");
            window.location.reload();
          }
        } catch (err: any) {
          createModalAlert.textContent = err?.message || "Error de conexión al crear producto.";
          createModalAlert.classList.remove("hidden");
        } finally {
          btnSaveCreate.disabled = false;
          btnSaveCreate.textContent = "Publicar Producto";
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../../styles/theme.css";
</style>
