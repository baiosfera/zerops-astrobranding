            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btnSubmitService"
              class="px-4 py-2 rounded-xl bg-amber-500 text-zinc-950 font-bold hover:bg-amber-400 transition-colors cursor-pointer"
