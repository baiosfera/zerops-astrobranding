                        <td class="px-4 py-3 font-mono text-zinc-400 whitespace-nowrap">
                          {usesDisplay}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                          {c.isActive === 1 ? (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                              Activo
                            </span>
                          ) : (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-zinc-800 text-zinc-500 border border-zinc-700">
                              Inactivo
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                          <div class="inline-flex items-center gap-2">
                            <button
                              type="button"
                              class="btn-copy-quick-coupon px-2.5 py-1 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 rounded-lg border border-amber-500/30 transition-colors text-xs cursor-pointer inline-flex items-center gap-1"
                              data-code={c.code}
                              title="Copiar enlace directo a la tienda con este cupón"
                            >
                              <span>🔗</span> Link
                            </button>
                            <button
                              type="button"
                              class="btn-edit-coupon px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white rounded-lg border border-zinc-700 transition-colors text-xs cursor-pointer"
                              data-id={c.id}
                              data-code={c.code}
                              data-desc={c.description || ""}
                              data-type={c.discountType}
                              data-val={c.discountValue}
                              data-min={c.minOrderAmount}
                              data-uses={c.maxUses || ""}
                              data-active={c.isActive}
                            >
                              Editar
                            </button>
                            <button
                              type="button"
                              class="btn-delete-coupon px-2.5 py-1 bg-red-950/40 hover:bg-red-900/60 text-red-300 rounded-lg border border-red-800/50 transition-colors text-xs cursor-pointer"
                              data-id={c.id}
                              data-code={c.code}
                            >
                              Eliminar
                            </button>
                          </div>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>
