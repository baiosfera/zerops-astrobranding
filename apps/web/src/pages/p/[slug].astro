---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SEO from "../../components/SEO.astro";
import { getQueryClient } from "@astrobranding/database";

export const prerender = false;

const { slug } = Astro.params;

let product: any = null;
let variants: any[] = [];

if (slug) {
  try {
    const sql = getQueryClient();
    const prods = await sql`SELECT * FROM products WHERE slug = ${slug} AND is_active = 1 LIMIT 1`;
    if (prods.length > 0) {
      product = prods[0];
      variants = await sql`SELECT * FROM product_variants WHERE product_id = ${product.id} ORDER BY size`;
    }
  } catch (err) {
    console.warn("DB lookup in /p/[slug]:", err);
  }
}

// Fallback catalog mapping with real verified photos from studio photoshoot
const productCatalogFallbacks: Record<string, any> = {
  "enterizo-escultor-blanco": {
    id: "cg-prod-01",
    name: "Enterizo Escultor Blanco Studio",
    slug: "enterizo-escultor-blanco",
    tagline: "Compresión Anatómica Inteligente • Cero Transparencias • Moldeo 360°",
    description: "Enterizo corto de compresión anatómica inteligente. Escote halter con soporte interno, tejido seamless de alta densidad 320g que moldea la silueta con elegancia y confort sin transparencias.",
    base_price: 80000,
    original_price: 115000,
    images: [
      "/images/products/product-01.jpg",
      "/images/products/product-02.jpg",
      "/images/products/product-03.jpg",
      "/images/products/product-04.jpg"
    ],
    variants: [
      { id: "v-uni", sku: "CG-BLA-UNI", size: "Talla Única", price: 80000, stock: 24 },
    ],
  },
  "enterizo-azul-backless": {
    id: "cg-prod-02",
    name: "Enterizo Deportivo Azul Royal Espalda Abierta",
    slug: "enterizo-azul-backless",
    tagline: "Espalda Abierta Ergonómica • Ajuste Escultor • Alto Rendimiento",
    description: "Enterizo biker con escote de gota profunda en espalda y detalles micro-calados. Fibras elásticas de secado rápido que brindan ajuste anatómico y total libertad de movimiento.",
    base_price: 85000,
    original_price: 120000,
    images: [
      "/images/products/product-05.jpg",
      "/images/products/product-06.jpg",
      "/images/products/product-07.jpg",
      "/images/products/product-08.jpg"
    ],
    variants: [
      { id: "v-uni", sku: "CG-AZU-UNI", size: "Talla Única", price: 85000, stock: 30 },
    ],
  },
  "enterizo-celeste-zipper": {
    id: "cg-prod-03",
    name: "Enterizo Manga Corta Celeste con Cremallera",
    slug: "enterizo-celeste-zipper",
    tagline: "Cremallera Frontal Ajustable • Textura Micro-Canesú • Máxima Firmeza",
    description: "Enterizo anatómico acanalado con cuello alto y cremallera frontal ajustable. Textura de micro-canesú que ofrece compresión firme, máxima elasticidad y frescura.",
    base_price: 90000,
    original_price: 130000,
    images: [
      "/images/products/product-15.jpg",
      "/images/products/product-21.jpg",
      "/images/products/product-17.jpg",
      "/images/products/product-18.jpg"
    ],
    variants: [
      { id: "v-uni", sku: "CG-CEL-UNI", size: "Talla Única", price: 90000, stock: 23 },
    ],
  },
  "conjunto-obsidiana-gold": {
    id: "cg-prod-04",
    name: "Conjunto Deportivo Obsidiana Gold",
    slug: "conjunto-obsidiana-gold",
    tagline: "Set 2 Piezas • Top Soporte Firme + Biker Moldeador • Acabado de Lujo",
    description: "Set de dos piezas de compresión inteligente. Elaborado con fibras de secado rápido y tecnología seamless que esculpe y sostiene la silueta en cada movimiento.",
    base_price: 95000,
    original_price: 135000,
    images: [
      "/images/products/product-16.jpg",
      "/images/products/product-20.jpg",
      "/images/products/product-19.jpg",
      "/images/products/product-22.jpg"
    ],
    variants: [
      { id: "v-uni", sku: "CG-OBS-UNI", size: "Talla Única", price: 95000, stock: 27 },
    ],
  },
};

if (!product) {
  const fallback = productCatalogFallbacks[slug || ""] || productCatalogFallbacks["enterizo-escultor-blanco"];
  product = fallback;
  variants = fallback.variants;
}

const originalPrice = product.original_price || Math.round(product.base_price * 1.35);
const discountAmount = originalPrice - product.base_price;

const formattedPrice = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(product.base_price);

const formattedOriginalPrice = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(originalPrice);

const formattedDiscount = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(discountAmount);

const orderBumpPrice = 45000;
const formattedOrderBump = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(orderBumpPrice);

const rawImages = Array.isArray(product.images)
  ? product.images
  : (typeof product.images === "string" ? JSON.parse(product.images) : ["/images/products/product-01.jpg"]);

const mainImage = rawImages[0] || "/images/products/product-01.jpg";
const galleryImages = rawImages.slice(0, 4);

// Schema.org JSON-LD Structured Data for AEO & Google Search
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": product.name,
      "description": product.description,
      "image": `https://catalinaglamur.com${mainImage}`,
      "brand": {
        "@type": "Brand",
        "name": "Catalina Glamur"
      },
      "offers": {
        "@type": "Offer",
        "price": product.base_price,
        "priceCurrency": "COP",
        "availability": "https://schema.org/InStock",
        "url": `https://catalinaglamur.com/p/${product.slug}`
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "142"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://catalinaglamur.com" },
        { "@type": "ListItem", "position": 2, "name": "Activewear", "item": "https://catalinaglamur.com/shop" },
        { "@type": "ListItem", "position": 3, "name": product.name, "item": `https://catalinaglamur.com/p/${product.slug}` }
      ]
    }
  ]
};
---

<BaseLayout
  title={`${product.name} — Catalina Glamur`}
  description={product.description}
  image={mainImage}
>
  <SEO
    slot="head"
    title={`${product.name} — Catalina Glamur Activewear`}
    description={product.description}
    canonicalUrl={`https://catalinaglamur.com/p/${product.slug}`}
    type="product"
  />

  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} slot="head" />

  <!-- BARRA DE URGENCIA & CONVERSIÓN DIRECTA -->
  <aside aria-label="Aviso de despacho y disponibilidad" class="bg-gradient-to-r from-[#D4AF37] via-[#F5E08B] to-[#D4AF37] text-[#07080A] py-2.5 px-4 text-center text-xs font-bold uppercase tracking-wider shadow-lg flex items-center justify-center gap-2">
    <span>⚡ EDICIÓN LIMITADA MEDELLÍN • QUEDAN POCAS UNIDADES • DESPACHO INMEDIATO</span>
  </aside>

  <main class="min-h-screen bg-[#07080A] text-[#F7F3FA] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-16">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#8E98A8] font-mono">
        <a href="/" class="hover:text-[#D4AF37] transition-colors">Inicio</a>
        <span>/</span>
        <a href="/shop" class="hover:text-[#D4AF37] transition-colors">Activewear</a>
        <span>/</span>
        <span class="text-[#D4AF37] truncate">{product.name}</span>
      </nav>

      <!-- HITO 1: ABOVE THE FOLD — DIRECT-RESPONSE HERO & BUY BOX -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <!-- Galería Fotográfica Real con Thumbnails -->
        <div class="space-y-4 lg:sticky lg:top-24">
          <div class="aspect-[3/4] bg-[#0E1015] border border-[#232833] overflow-hidden relative group">
            <img
              id="mainProductImg"
              src={mainImage}
              alt={product.name}
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
              onerror="this.src='/images/products/product-01.jpg'"
            />
            <div class="absolute top-3 left-3 flex flex-col gap-1.5">
              <span class="px-2.5 py-1 text-[9px] font-mono uppercase tracking-[0.2em] bg-[#07080A]/90 border border-[#D4AF37]/40 text-[#D4AF37]">
                Edición Limitada
              </span>
              <span class="px-2.5 py-1 text-[9px] font-mono uppercase tracking-[0.2em] bg-[#07080A]/90 border border-[#232833] text-[#A6B0BF]">
                100% Cero Transparencias
              </span>
            </div>
            <span class="absolute bottom-3 right-3 px-2.5 py-1 text-[9px] font-mono uppercase tracking-[0.2em] bg-[#07080A]/90 text-[#F7F3FA] border border-[#232833]">
              Envío Incluido
            </span>
          </div>

          <!-- Thumbnails interactivos -->
          {galleryImages.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {galleryImages.map((imgUrl: string, idx: number) => (
                <button
                  type="button"
                  class={`aspect-square border overflow-hidden bg-[#0E1015] cursor-pointer transition-all ${
                    idx === 0 ? "border-[#D4AF37]" : "border-[#232833] opacity-60 hover:opacity-100"
                  }`}
                  onclick={`document.getElementById('mainProductImg').src='${imgUrl}'; document.querySelectorAll('.grid-cols-4 button').forEach(b => b.classList.remove('border-[#D4AF37]')); this.classList.add('border-[#D4AF37]');`}
                >
                  <img src={imgUrl} alt={`Detalle ${idx + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Buy Box & Oferta Irresistible -->
        <div class="space-y-6 bg-[#0E1015] p-6 sm:p-10 border border-[#232833]">
          <!-- Valoración y Titular -->
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-xs font-mono text-[#8E98A8]">
              <span class="text-[#D4AF37]">★★★★★</span>
              <span>4.9 / 5 (142 clientas verificadas en Medellín)</span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-['Monas'] text-[#F7F3FA] leading-tight font-medium">
              {product.name}
            </h1>

            <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#D4AF37]">
              {product.tagline || "Compresión Anatómica Inteligente • Cero Transparencias"}
            </p>

            <!-- Precios y Ahorro -->
            <div class="pt-2 flex items-baseline gap-4 flex-wrap">
              <span class="text-3xl sm:text-4xl font-bold text-[#D4AF37] font-mono">
                {formattedPrice}
              </span>
              <span class="text-base text-[#8E98A8] line-through font-light font-mono">
                {formattedOriginalPrice}
              </span>
              <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-[#D4AF37] border border-[#D4AF37]/40">
                Ahorras {formattedDiscount}
              </span>
            </div>

            <p class="text-xs text-[#8E98A8] font-light leading-relaxed pt-2">
              {product.description}
            </p>
          </div>

          <!-- Especificación de Talla y Calce Anatómico -->
          <div class="space-y-3 pt-4 border-t border-[#232833]">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="uppercase tracking-wider text-[#F7F3FA]">
                Talla:
              </span>
              <span class="text-[#D4AF37] text-[10px] uppercase tracking-wider">
                Compresión Seamless Adaptable
              </span>
            </div>

            <div class="p-3.5 border border-[#D4AF37]/50 bg-[#0E1015] rounded-xl flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-lg bg-[#D4AF37]/15 border border-[#D4AF37]/40 flex items-center justify-center text-[#D4AF37] font-mono font-bold text-xs">
                  U
                </span>
                <div>
                  <span class="text-sm font-bold uppercase tracking-wider text-[#F7F3FA] block font-mono">Talla Única</span>
                  <span class="text-[11px] text-[#8E98A8] font-light">Tejido seamless 380g con memoria elástica de adaptación anatómica</span>
                </div>
              </div>
              <span class="text-[10px] font-mono text-emerald-400 border border-emerald-500/30 bg-emerald-950/30 px-2.5 py-1 rounded-md">
                Disponible
              </span>
            </div>
            <input type="hidden" id="selectedSku" value={variants[0]?.sku || "CG-BLA-UNI"} />
            <input type="hidden" id="selectedSize" value="Talla Única" />
          </div>

          <!-- Botón de Salto Directo al Checkout del Funnel -->
          <div class="pt-2 space-y-3">
            <a
              href="#checkout-funnel"
              class="w-full py-4 text-center bg-[#D4AF37] text-[#07080A] text-xs font-mono tracking-[0.2em] uppercase font-bold hover:bg-[#F5E08B] transition-colors flex items-center justify-center gap-3 block"
            >
              <span>Comprar Prenda &bull; Despacho Inmediato &rarr;</span>
            </a>
            
            <p class="text-[10px] font-mono uppercase tracking-wider text-center text-[#8E98A8] flex items-center justify-center gap-3">
              <span>Compra 100% Segura</span>
              <span>&bull;</span>
              <span>Despacho Nacional</span>
              <span>&bull;</span>
              <span>Contra Entrega Valle del Aburrá Sur</span>
            </p>
          </div>

          <!-- Badges de Confianza Técnicos -->
          <div class="grid grid-cols-3 gap-2 pt-4 border-t border-[#232833] text-center text-[10px] font-mono uppercase tracking-wider text-[#8E98A8]">
            <div class="p-2.5 border border-[#232833] bg-[#07080A]">
              <span class="block text-[#D4AF37] font-bold text-xs mb-0.5">380g/m²</span>
              Seamless Denso
            </div>
            <div class="p-2.5 border border-[#232833] bg-[#07080A]">
              <span class="block text-[#D4AF37] font-bold text-xs mb-0.5">Push-Up</span>
              Moldeo Anatómico
            </div>
            <div class="p-2.5 border border-[#232833] bg-[#07080A]">
              <span class="block text-[#D4AF37] font-bold text-xs mb-0.5">Garantía</span>
              Ajuste y Satisfacción
            </div>
          </div>
        </div>
      </section>

      <!-- HITO 2: EL PROBLEMA / SOLUCIÓN (Editorial Architecture) -->
      <section class="bg-[#0E1015] border border-[#232833] p-8 sm:p-14 space-y-10">
        <div class="max-w-3xl space-y-3">
          <h2 class="font-['Monas'] text-3xl sm:text-5xl text-[#F7F3FA] font-medium leading-tight">
            Estructura Textil Forjada sin Concesiones
          </h2>
          <p class="text-xs sm:text-sm text-[#A6B0BF] font-light leading-relaxed">
            Eliminamos los defectos comunes del mercado masivo: telas delgadas que se transparentan bajo flexión, pretinas inestables y costuras frágiles. Cada filamento está calibrado para durar y sostener.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4 border-t border-[#232833]/80">
          <div class="border-l border-[#D4AF37]/50 pl-5 space-y-2">
            <span class="text-[9px] font-mono text-[#D4AF37] block tracking-[0.2em] uppercase">ESTRUCTURA ANATÓMICA</span>
            <h3 class="font-medium text-sm text-[#F7F3FA] font-sans">Compresión Anatómica 360°</h3>
            <p class="text-xs text-[#8E98A8] font-light leading-relaxed">
              Recoge el abdomen y modela la cintura mediante tensiones multidireccionales calculadas para brindar firmeza sin asfixiar.
            </p>
          </div>

          <div class="border-l border-[#D4AF37]/50 pl-5 space-y-2">
            <span class="text-[9px] font-mono text-[#D4AF37] block tracking-[0.2em] uppercase">BLINDAJE TOTAL</span>
            <h3 class="font-medium text-sm text-[#F7F3FA] font-sans">100% Cero Transparencias</h3>
            <p class="text-xs text-[#8E98A8] font-light leading-relaxed">
              Tejido de telar continuo de 380g de densidad. Podés agacharte y entrenar bajo focos de luz blanca con absoluta seguridad.
            </p>
          </div>

          <div class="border-l border-[#D4AF37]/50 pl-5 space-y-2">
            <span class="text-[9px] font-mono text-[#D4AF37] block tracking-[0.2em] uppercase">TERMO-REGULACIÓN</span>
            <h3 class="font-medium text-sm text-[#F7F3FA] font-sans">Termo-Regulación Dry-Fit</h3>
            <p class="text-xs text-[#8E98A8] font-light leading-relaxed">
              Fibras técnicas transpirables que evacúan la humedad rápidamente y evitan manchas oscuras de sudor durante tu sesión.
            </p>
          </div>
        </div>
      </section>

      <!-- HITO 3: TABLA COMPARATIVA — CATALINA GLAMUR VS ACTIVEWEAR COMÚN -->
      <section class="max-w-4xl mx-auto space-y-8 pt-6">
        <div>
          <h2 class="font-['Monas'] text-2xl sm:text-4xl text-[#F7F3FA] font-medium">
            La Diferencia en Cada Detalle
          </h2>
        </div>

        <div class="overflow-x-auto border border-[#232833] bg-[#0E1015]">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-[#232833] bg-[#161A22]/80 text-[#8E98A8] uppercase tracking-wider text-[10px]">
                <th class="p-4 sm:p-5">Parámetro</th>
                <th class="p-4 sm:p-5 text-[#D4AF37] font-bold">Catalina Glamur</th>
                <th class="p-4 sm:p-5 text-neutral-400">Activewear Promedio</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#232833]/60 text-[#F7F3FA]">
              <tr>
                <td class="p-4 sm:p-5 font-sans font-medium text-xs">Densidad Textil</td>
                <td class="p-4 sm:p-5 text-[#D4AF37]">380g/m² de alta densidad</td>
                <td class="p-4 sm:p-5 text-neutral-400">160-200g (delgado)</td>
              </tr>
              <tr>
                <td class="p-4 sm:p-5 font-sans font-medium text-xs">Prueba de Sentadilla</td>
                <td class="p-4 sm:p-5 text-[#D4AF37]">100% Cero Transparencias</td>
                <td class="p-4 sm:p-5 text-neutral-400">Se transparenta</td>
              </tr>
              <tr>
                <td class="p-4 sm:p-5 font-sans font-medium text-xs">Sujeción de Pretina</td>
                <td class="p-4 sm:p-5 text-[#D4AF37]">Pretina ancha fija sin enrollarse</td>
                <td class="p-4 sm:p-5 text-neutral-400">Se dobla y corta circulación</td>
              </tr>
              <tr>
                <td class="p-4 sm:p-5 font-sans font-medium text-xs">Cobertura y Despacho</td>
                <td class="p-4 sm:p-5 text-[#D4AF37]">Pago Contra Entrega en Valle del Aburrá</td>
                <td class="p-4 sm:p-5 text-neutral-400">Solo pago anticipado</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- HITO 4: RESEÑAS VERIFICADAS Y PRUEBA SOCIAL -->
      <section class="space-y-8 pt-8">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#D4AF37] block mb-1">
            EXPERIENCIAS REALES DE CLIENTAS
          </span>
          <h2 class="font-['Monas'] text-2xl sm:text-4xl text-[#F7F3FA] font-medium">
            Testimonios de Clientas en Medellín
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 bg-[#0E1015] border border-[#232833] space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-[#F7F3FA] font-sans">Valentina Gómez</span>
              <span class="text-[9px] font-mono text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5">Verificada</span>
            </div>
            <div class="text-[#D4AF37] text-xs">★★★★★</div>
            <p class="text-xs text-[#8E98A8] font-light leading-relaxed">
              "El enterizo blanco me daba miedo por transparencias pero es PERFECTO. La tela es gruesa, no se marca nada y la figura queda esculpida. Me llegó a Envigado y pagué contra entrega."
            </p>
          </div>

          <div class="p-6 bg-[#0E1015] border border-[#232833] space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-[#F7F3FA] font-sans">Mariana Restrepo</span>
              <span class="text-[9px] font-mono text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5">Verificada</span>
            </div>
            <div class="text-[#D4AF37] text-xs">★★★★★</div>
            <p class="text-xs text-[#8E98A8] font-light leading-relaxed">
              "La calidad supera por lejos a marcas internacionales de precio doble. La compresión en el abdomen es real y la espalda abierta es hermosa para entrenar."
            </p>
          </div>

          <div class="p-6 bg-[#0E1015] border border-[#232833] space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-[#F7F3FA] font-sans">Camila Serna</span>
              <span class="text-[9px] font-mono text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5">Verificada</span>
            </div>
            <div class="text-[#D4AF37] text-xs">★★★★★</div>
            <p class="text-xs text-[#8E98A8] font-light leading-relaxed">
              "El tejido se amolda con total precisión anatómica. La compresión es firme pero sumamente cómoda, no marca y cero transparencias. 10 de 10."
            </p>
          </div>
        </div>
      </section>

      <!-- HITO 5: EMBEDDED 1-STEP DIRECT-RESPONSE CHECKOUT FUNNEL -->
      <section id="checkout-funnel" class="bg-[#0E1015] border border-[#D4AF37]/50 p-6 sm:p-14 space-y-10 relative">
        <div class="space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#D4AF37] block">
            05 / CONFIRMACIÓN DE PEDIDO
          </span>
