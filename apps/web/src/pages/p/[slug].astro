    function updateCityOptions(dept) {
      const citySelect = document.getElementById("shippingCity");
      if (!citySelect) return;
      citySelect.innerHTML = "";
      const cities = COLOMBIA_REGIONS[dept] || COLOMBIA_REGIONS["Otro"];
      cities.forEach(c => {
