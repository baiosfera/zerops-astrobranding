    }

    const VALLE_ABURRA_MUNICIPALITIES = [
      "envigado",
      "sabaneta",
      "itagui",
      "itagüí",
      "la estrella"
    ];
    const basePrice = parseInt(document.getElementById("formBasePrice").value, 10);
    const orderBumpPrice = 45000;
    let currentTotal = basePrice;
    let hasOrderBump = false;

    function formatCop(amount) {
      return new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: "COP",
        maximumFractionDigits: 0,
      }).format(amount);
    }

    function selectSize(btn) {
      document.querySelectorAll("#sizeSelectorGrid button").forEach((b) => {
        b.classList.remove("border-[#D4AF37]", "bg-[#D4AF37]/20", "text-[#F7F3FA]", "shadow-md");
        b.classList.add("border-[#232833]", "bg-[#161A22]", "text-[#8E98A8]");
      });
      btn.classList.add("border-[#D4AF37]", "bg-[#D4AF37]/20", "text-[#F7F3FA]", "shadow-md");
      btn.classList.remove("border-[#232833]", "bg-[#161A22]", "text-[#8E98A8]");

      const size = btn.getAttribute("data-size");
      const sku = btn.getAttribute("data-sku");
      document.getElementById("selectedSize").value = size;
      document.getElementById("selectedSku").value = sku;
      document.getElementById("summarySelectedSize").innerText = size;
    }

        let activeCoupon = null;

    function recalculateTotal() {
      let subtotal = basePrice + (hasOrderBump ? orderBumpPrice : 0);
      let discount = 0;
      if (activeCoupon) {
        if (activeCoupon.discountType === "percentage") {
          discount = Math.round((subtotal * activeCoupon.discountValue) / 100);
        } else {
          discount = Math.min(subtotal, activeCoupon.discountValue);
        }
      }
      currentTotal = Math.max(0, subtotal - discount);
      document.getElementById("summaryTotalAmount").innerText = formatCop(currentTotal);

      const couponRow = document.getElementById("summaryCouponRow");
      if (couponRow) {
        if (activeCoupon && discount > 0) {
          couponRow.classList.remove("hidden");
          document.getElementById("summaryCouponLabel").innerText = "Descuento (" + activeCoupon.code + "):";
          document.getElementById("summaryCouponValue").innerText = "-" + formatCop(discount);
        } else {
          couponRow.classList.add("hidden");
        }
      }
    }

    async function applyCoupon(codeToApply) {
      const code = (codeToApply || "").trim().toUpperCase();
      const msgEl = document.getElementById("couponMessage");
      const btn = document.getElementById("btnApplyCoupon");
      const subtotal = basePrice + (hasOrderBump ? orderBumpPrice : 0);
      if (!code) {
        if (msgEl) {
          msgEl.className = "text-xs font-mono text-rose-400 block";
          msgEl.innerText = "Por favor ingresa un código de cupón.";
          msgEl.classList.remove("hidden");
        }
        return;
      }
      if (btn) {
        btn.disabled = true;
        btn.innerText = "...";
      }
      try {
        const res = await fetch("/api/checkout/coupon", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, orderTotal: subtotal }),
        });
        const data = await res.json();
        if (data.valid) {
          activeCoupon = {
            code: data.code,
            discountType: data.discountType,
            discountValue: data.discountValue,
          };
          recalculateTotal();
          if (msgEl) {
            msgEl.className = "text-xs font-mono text-emerald-400 block font-semibold";
            msgEl.innerText = "✓ " + data.message;
            msgEl.classList.remove("hidden");
          }
        } else {
          activeCoupon = null;
          recalculateTotal();
          if (msgEl) {
            msgEl.className = "text-xs font-mono text-rose-400 block";
            msgEl.innerText = "✕ " + (data.message || "Cupón no válido.");
            msgEl.classList.remove("hidden");
          }
        }
      } catch (e) {
        if (msgEl) {
          msgEl.className = "text-xs font-mono text-rose-400 block";
          msgEl.innerText = "Error al verificar el cupón.";
          msgEl.classList.remove("hidden");
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerText = "Aplicar";
        }
      }
    }

    function handleApplyCouponClick() {
      const input = document.getElementById("inputCouponCode");
      applyCoupon(input ? input.value : "");
    }

    // Auto-apply coupon from URL params (?cupon=... or ?coupon=...)
    window.addEventListener("DOMContentLoaded", () => {
      const urlParams = new URLSearchParams(window.location.search);
      const urlCoupon = urlParams.get("cupon") || urlParams.get("coupon");
      if (urlCoupon) {
        const input = document.getElementById("inputCouponCode");
        if (input) input.value = urlCoupon.toUpperCase();
        applyCoupon(urlCoupon);
      }
    });

    function toggleOrderBump(checked) {
      hasOrderBump = checked;
      const row = document.getElementById("summaryOrderBumpRow");
      if (checked) {
        row.classList.remove("hidden");
      } else {
        row.classList.add("hidden");
      }
      recalculateTotal();
    }

    function checkCodEligibility() {
      const city = document.getElementById("shippingCity")?.value || "";
      const address = document.getElementById("shippingAddress")?.value?.trim() || "";
      const clean = city.trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      const dept = document.getElementById("shippingDepartment")?.value || "";
      const isAburra = dept === "Antioquia" && VALLE_ABURRA_MUNICIPALITIES.some((m) => {
        const cleanM = m.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        return clean.includes(cleanM);
      });

      const codRadio = document.getElementById("paymentCod");
      const onlineRadio = document.getElementById("paymentOnline");
      const codLabel = document.getElementById("codOptionLabel");
      const onlineLabel = document.getElementById("onlineOptionLabel");
      const noticeBox = document.getElementById("codNoticeBox");
      const noticeText = document.getElementById("codNoticeText");

      // Solo visible si el usuario colocó dirección (>= 5 caracteres) Y es Medellín o Valle del Aburrá
      const hasAddress = address.length >= 5;

      if (hasAddress && isAburra) {
        codLabel.classList.remove("hidden");
        noticeBox.classList.remove("hidden");
        noticeBox.className = "p-3.5 rounded-xl bg-emerald-950/40 border border-emerald-500/30 text-emerald-300 text-[11px] flex items-center gap-2";
        noticeText.innerText = "✓ Pago Contra Entrega habilitado para tu dirección en " + city + " (Valle del Aburrá Sur). Pagas en efectivo al recibir tu pedido en casa.";
      } else {
        codLabel.classList.add("hidden");
        noticeBox.classList.add("hidden");

        if (codRadio.checked) {
          codRadio.checked = false;
          onlineRadio.checked = true;
          handlePaymentChange("online");
        }
      }
    }

    function handlePaymentChange(option) {
      const codLabel = document.getElementById("codOptionLabel");
      const onlineLabel = document.getElementById("onlineOptionLabel");

      if (option === "cod") {
        codLabel.classList.add("border-[#D4AF37]", "bg-[#161A22]");
        codLabel.classList.remove("border-[#232833]", "bg-[#0E1015]");
        onlineLabel.classList.remove("border-[#D4AF37]", "bg-[#161A22]");
        onlineLabel.classList.add("border-[#232833]", "bg-[#0E1015]");
      } else {
        onlineLabel.classList.add("border-[#D4AF37]", "bg-[#161A22]");
        onlineLabel.classList.remove("border-[#232833]", "bg-[#0E1015]");
        codLabel.classList.remove("border-[#D4AF37]", "bg-[#161A22]");
        codLabel.classList.add("border-[#232833]", "bg-[#0E1015]");
      }
    }

    async function captureAbandonedLead(phone) {
      if (!phone || phone.length < 7) return;
      try {
        const name = document.getElementById("customerName")?.value || "";
        const slug = document.getElementById("formProductSlug")?.value || "";
        await fetch("/api/checkout/abandoned", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ phone, name, productSlug: slug }),
        });
      } catch (e) {
        // silent capture
      }
    }

    async function requestWhatsAppOtp() {
      const phone = document.getElementById("customerPhone").value;
      if (!phone) {
        alert("Por favor ingresa primero tu número de WhatsApp");
        return;
      }
      const btn = document.getElementById("btnSendOtp");
      btn.innerText = "Enviando...";
      btn.disabled = true;

      try {
        const res = await fetch("/api/auth/otp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "send", phone }),
        });
        const data = await res.json();
        const drawer = document.getElementById("otpDrawer");
        drawer.classList.remove("hidden");
        const statusMsg = document.getElementById("otpStatusMsg");

        if (data.devCode) {
          statusMsg.className = "text-[10px] text-[#D4AF37]";
          statusMsg.innerText = "Código OTP: " + data.devCode + " (Simulación de envío a " + data.phone + ")";
        } else {
          statusMsg.className = "text-[10px] text-emerald-400";
          statusMsg.innerText = "Código enviado a tu WhatsApp.";
        }
      } catch (err) {
        alert("No se pudo enviar el código de verificación");
      } finally {
        btn.innerText = "Reenviar código";
        btn.disabled = false;
      }
    }

    async function confirmWhatsAppOtp() {
      const phone = document.getElementById("customerPhone").value;
      const code = document.getElementById("otpCodeInput").value;
      const statusMsg = document.getElementById("otpStatusMsg");

      if (!code) {
        statusMsg.className = "text-[10px] text-rose-400";
        statusMsg.innerText = "Ingresa el código de 4 dígitos";
        return;
      }

      try {
        const res = await fetch("/api/auth/otp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "verify", phone, code }),
        });
        const data = await res.json();
        if (data.verified) {
          statusMsg.className = "text-[10px] text-emerald-400 font-bold";
          statusMsg.innerText = "✓ WhatsApp verificado con éxito";
          document.getElementById("btnSendOtp").innerText = "✓ Verificado";
          document.getElementById("btnSendOtp").classList.add("bg-emerald-950", "text-emerald-300", "border-emerald-500");
        } else {
          statusMsg.className = "text-[10px] text-rose-400";
          statusMsg.innerText = data.error || "Código incorrecto";
        }
      } catch (err) {
        statusMsg.className = "text-[10px] text-rose-400";
        statusMsg.innerText = "Error al validar el código";
      }
    }

    document.getElementById("funnelOrderForm").addEventListener("submit", async function (e) {
      e.preventDefault();

      const btn = document.getElementById("btnSubmitOrder");
      const btnText = document.getElementById("btnSubmitText");
      const btnSpinner = document.getElementById("btnSpinner");

      btn.disabled = true;
      btnText.innerText = "Procesando Orden...";
      btnSpinner.classList.remove("hidden");

      const name = document.getElementById("customerName").value;
      const phone = document.getElementById("customerPhone").value;
      const email = document.getElementById("customerEmail").value;
      const department = document.getElementById("shippingDepartment").value;
      const city = document.getElementById("shippingCity").value;
      const address = document.getElementById("shippingAddress").value;
      const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || "online";
      const size = document.getElementById("selectedSize").value;
      const sku = document.getElementById("selectedSku").value;

      try {
        const res = await fetch("/api/checkout/order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            customerName: name,
            customerPhone: phone,
            customerEmail: email,
            shippingDepartment: department,
            shippingCity: city,
            shippingAddress: address,
            paymentMethod: paymentMethod,
            totalAmount: currentTotal,
            hasOrderBump: hasOrderBump,
            couponCode: activeCoupon ? activeCoupon.code : undefined,
            items: [
              {
                productId: document.getElementById("formProductSlug").value,
                sku: sku,
                size: size,
                quantity: 1,
                unitPrice: basePrice,
              },
            ],
          }),
        });

        const data = await res.json();

        if (!res.ok) {
          alert(data.error || "Ocurrió un error al procesar tu pedido.");
          btn.disabled = false;
          btnText.innerText = "Confirmar Pedido Ahora";
          btnSpinner.classList.add("hidden");
          return;
        }

        if (data.mode === "cod") {
          document.getElementById("orderSuccessMessage").innerText =
            "¡Gracias " + name + "! Tu pedido contra entrega ha sido confirmado para " + city + ". Prepararemos tu paquete inmediatamente y te contactaremos por WhatsApp con el número de guía.";
          const waText = encodeURIComponent(
            "Hola Catalina, acabo de pedir contra entrega el " +
              document.getElementById("formProductSlug").value +
              " (Talla Única) para " +
              city +
              ". Mi orden es #" +
              data.reference
          );
          document.getElementById("waDirectLink").href = "https://wa.me/573045781032?text=" + waText;
          document.getElementById("orderSuccessModal").classList.remove("hidden");
        } else if (data.mode === "online") {
          // Redirigir a pasarela o abrir checkout seguro
          if (data.wompiData?.signature) {
            const redirectParam = data.wompiData.redirectUrl ? "&redirect-url=" + encodeURIComponent(data.wompiData.redirectUrl) : "";
            const checkoutUrl =
              "https://checkout.wompi.co/p/?public-key=" +
              data.wompiData.publicKey +
              "&currency=COP&amount-in-cents=" +
              data.wompiData.amountInCents +
              "&reference=" +
              data.reference +
              "&signature:integrity=" +
              data.wompiData.signature +
              redirectParam;
            window.location.href = checkoutUrl;
          } else {
            document.getElementById("orderSuccessMessage").innerText =
              "¡Gracias " + name + "! Tu orden #" + data.reference + " ha sido registrada. Te redirigiremos para completar el pago seguro.";
            document.getElementById("orderSuccessModal").classList.remove("hidden");
          }
        }
      } catch (err) {
        alert("Error de conexión al registrar la orden. Por favor intenta nuevamente.");
      } finally {
        btn.disabled = false;
        btnText.innerText = "Confirmar Pedido Ahora";
        btnSpinner.classList.add("hidden");
      }
    });

    // Check initial city eligibility on load
    checkCodEligibility(document.getElementById("shippingCity").value);
  </script>
</BaseLayout>
