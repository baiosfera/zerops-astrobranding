{
  "proactive-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|call_mcp_tool|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /var/www/.bin/hooks/tool-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /var/www/.bin/hooks/tool-guard.py --post-tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
