{
  "name": "zerops-astrobranding",
  "version": "2.0.0",
  "private": true,
  "description": "Zerops AstroBranding sovereign catalog, recipes, blueprints and ZCP tooling hub",
  "scripts": {
    "setup": "./iniciar.sh",
    "bootstrap": "bun scripts/bootstrap.mjs",
    "check": "tsc --noEmit",
    "check:arch": "bun scripts/architecture-check.mjs",
    "check:parity": "bash scripts/ssot-parity-check.sh",
    "validate:skills": "bash scripts/skills-suite-validate.sh -q",
    "test:hooks": "python3 -B scripts/hooks/tool-guard.py --test"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
