#!/usr/bin/env bash
# ==============================================================================
# Sovereign Zerops Environment Helper & Autonomous Sync (zeropsenv v3.0)
# Uses shared scripts/lib/vault_env.py for safe quoting, comment stripping,
# and Zerops Project Shared Vault synchronization via /usr/local/bin/zcp serve.
# ==============================================================================
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

DO_SYNC=false
OUTPUT_JSON=false
SKIP_RESTART=true
PROJECT_OVERRIDE=""
ENV_FILE=""

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        sync|--sync)
            DO_SYNC=true
            shift
            ;;
        --restart)
            SKIP_RESTART=false
            shift
            ;;
        --project|-p)
            PROJECT_OVERRIDE="${2:-}"
            shift 2
            ;;
        -j|--json)
            OUTPUT_JSON=true
            shift
            ;;
        -h|--help)
            echo "Uso: zeropsenv [sync|--sync] [--restart] [--project <nombre>] [-j|--json] [/path/to/keys.md|.env]"
            echo "  (sin args)    : Muestra variables detectadas con valores enmascarados."
            echo "  sync          : Sube claves parseadas al Vault Compartido del proyecto (zerops_env project=true)."
            echo "  --restart     : Reinicia servicios lectores tras actualizar el Vault."
            echo "  --project     : Define PROJECT_NAME / ENGRAM_PROJECT explicitamente."
            echo "  -j, --json    : Imprime resumen estructural en JSON (sin exponer secretos)."
            exit 0
            ;;
        *)
            if [ -f "$1" ]; then
                ENV_FILE="$1"
            fi
            shift
            ;;
    esac
done

if [ -z "$ENV_FILE" ]; then
    for cand in \
        "/var/www/baiosfera/0ZEROPS-AGY/users-apis/api_keys_global" \
        "/etc/environment" \
        "/var/www/.env"; do
        if [ -f "$cand" ]; then
            ENV_FILE="$cand"
            break
        fi
    done
fi

if [ -z "$ENV_FILE" ] || [ ! -f "$ENV_FILE" ]; then
    echo "❌ Error: No se encontró archivo de variables." >&2
    exit 1
fi

PYTHONPATH="$LIB_DIR" python3 - "$ENV_FILE" "$DO_SYNC" "$OUTPUT_JSON" "$SKIP_RESTART" "$PROJECT_OVERRIDE" << 'EOF_PY'
import json
import os
import sys
from pathlib import Path
from vault_env import ZcpVaultClient, parse_kv_file

env_path = sys.argv[1]
do_sync = sys.argv[2] == "true"
output_json = sys.argv[3] == "true"
skip_restart = sys.argv[4] == "true"
project_override = sys.argv[5].strip()

vars_dict = parse_kv_file(env_path)

if project_override:
    vars_dict["PROJECT_NAME"] = project_override
    vars_dict.setdefault("ENGRAM_PROJECT", project_override)
elif os.getenv("PROJECT_NAME"):
    vars_dict.setdefault("PROJECT_NAME", os.environ["PROJECT_NAME"].strip())
    vars_dict.setdefault("ENGRAM_PROJECT", os.getenv("ENGRAM_PROJECT", vars_dict["PROJECT_NAME"]).strip())

if do_sync:
    print("============================================================")
    print("  🚀 Sincronizando Vault Compartido en Zerops (zeropsenv v3.0)")
    print("============================================================")
    print(f"• Archivo origen: {env_path}")
    with ZcpVaultClient() as zcp:
        live_project, _ = zcp.get_project_envs()
        effective_proj = vars_dict.get("PROJECT_NAME") or live_project
        if effective_proj:
            vars_dict["PROJECT_NAME"] = effective_proj
            vars_dict.setdefault("ENGRAM_PROJECT", os.getenv("ENGRAM_PROJECT") or effective_proj)
        summary = zcp.upsert_project_envs(vars_dict, skip_restart=skip_restart)
    print(f"• Variables procesadas: {len(vars_dict)} (sensibles existentes={summary['existing_sensitive']}, planas={summary['existing_plain']}, nuevas={summary['new_auto']})")
    print("✅ Sincronización exitosa hacia Zerops Project Shared Vault.")
    print("============================================================")
elif output_json:
    print(json.dumps({
        "action": "set",
        "project": True,
        "source": env_path,
        "count": len(vars_dict),
        "keys": sorted(vars_dict.keys()),
    }, indent=2))
else:
    print("============================================================")
    print("  🌐 Zerops Environment Helper (zeropsenv v3.0)")
    print("============================================================")
    print(f"• Archivo origen: {env_path}")
    print(f"• Total variables válidas: {len(vars_dict)}\n")
    print("Variables detectadas (valores enmascarados):")
    for k in sorted(vars_dict.keys()):
        v = vars_dict[k]
        masked = f"{v[:3]}...{v[-3:]}" if len(v) > 8 else "<set>"
        print(f"  🔑 {k:<32} : {masked}")
    print("\n💡 Para sincronizar al Vault Compartido del proyecto:")
    print(f"   zeropsenv sync {env_path}")
    print("============================================================")
EOF_PY
