# ==============================================================================
# Google Drive OAuth Configuration for Zerops ZCP & rclone (Template)
# ==============================================================================
# Para configurar en un nuevo ZCP, podés:
# 1. Copiar este archivo a /var/www/.env o exportar las variables
# 2. O configurarlas en Zerops GUI (Project Settings -> Environment Variables)
# ==============================================================================

# OAuth Client ID de Google Cloud Console (Drive API habilitada)
GDRIVE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"

# OAuth Client Secret de Google Cloud Console
GDRIVE_CLIENT_SECRET="GOCSPX-tu-client-secret"

# OAuth Refresh Token (generado con: rclone authorize "drive")
GDRIVE_REFRESH_TOKEN="1//tu-refresh-token"

# Nombre del remote en rclone.conf (opcional, default: baiosfera)
GDRIVE_REMOTE_NAME="baiosfera"

# Directorio de montaje local en ZCP (opcional, default: /var/www/baiosfera)
GDRIVE_MOUNT_DIR="/var/www/baiosfera"
