#!/usr/bin/env python3
"""
brand-play — Sovereign Downstream Playbook Transmutation & Slot Hydration Engine (v2.1)
Standard: TYM (Type-YAML-Markdown) v1.0 & W3C DTCG Token Ingestion
Governed by meta-script & 00-SUPREME-DIRECTIVE.md (v10.0).
Features:
- Case-insensitive project + workspace/vertical discovery (dev/workspaces/<vertical>)
- Vertical spec ingestion (dev/verticals/<vertical>.json) + real brandbook.json node mapping
- Neutral Spanish client templates (zero Rioplatense voseo, zero hardcoded fake prices)
- Optional Bifrost synthesis (--bifrost) & Client-Facing Zero-Jargon / Orthography Gate
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
import urllib.request
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

try:
    import yaml
except ImportError:
    yaml = None

PLAYBOOK_SEARCH_DIRS = [
    Path("/mnt/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"),
    Path("/var/www/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"),
]

STORAGE_ROOTS = [
    Path("/mnt/localstorage"),
    Path("/var/www/localstorage"),
    Path("/var/www/baiosfera/PROYECTOS"),
]

PROHIBITED_WORDS = [
    "fórmula mágica",
    "revolucionario",
    "sin precedentes",
    "garantizado al 100%",
    "secreto millonario",
    "hacks definitivos",
    "fórmula infalible",
]

CLIENT_JARGON_RE = re.compile(r"\b(OPB|CO1|BANT|AEO|GEO|PWYW|Order Bump|Context Vault|Break-Even CPA|server-side)\b")
VOSEO_CLIENT_RE = re.compile(r"\b(Leé|Descubrí|Explorá|Agendá|Elegí|Revisá|Aprovechá|Mirá|Dejá)\b")


def resolve_json_pointer(obj: Any, pointer: str) -> Any:
    if not pointer or pointer in ("/", ""):
        return obj
    parts = pointer.lstrip("/").split("/")
    current = obj
    for part in parts:
        part = part.replace("~1", "/").replace("~0", "~")
        if current is None or not isinstance(current, (dict, list)):
            return None
        if isinstance(current, dict):
            current = current.get(part)
        elif isinstance(current, list):
            try:
                idx = int(part)
                current = current[idx] if 0 <= idx < len(current) else None
            except ValueError:
                return None
    if isinstance(current, dict) and "$value" in current:
        return current["$value"]
    return current


def deep_merge(target: Dict[str, Any], source: Dict[str, Any]) -> None:
    for key, value in source.items():
        if key in target and isinstance(target[key], dict) and isinstance(value, dict):
            deep_merge(target[key], value)
        else:
            target[key] = value


def discover_workspace_dir(brand_or_vertical: str, project_name: Optional[str] = None) -> Tuple[Path, Optional[Path]]:
    """
    Discovers (workspace_dir, vertical_json_path) across:
    1) <ROOT>/<PROJECT>/dev/workspaces/<brand_or_vertical>
    2) <ROOT>/<brand_or_vertical>/dev
    3) <ROOT>/workspaces/<brand_or_vertical>
    Case-insensitive on <PROJECT>.
    """
    slug = brand_or_vertical.strip()
    slug_low = slug.lower()
    proj = (project_name or os.getenv("PROJECT_NAME") or os.getenv("ENGRAM_PROJECT") or "").strip()

    for root in STORAGE_ROOTS:
        if not root.exists():
            continue
        # 1. Explicit project workspace: <ROOT>/<Project>/dev/workspaces/<vertical>
        try:
            children = [c for c in root.iterdir() if c.is_dir() and not c.name.startswith(".")]
        except Exception:
            children = []
        ordered = sorted(children, key=lambda c: 0 if (proj and c.name.lower() == proj.lower()) else 1)
        for ch in ordered:
            ws = ch / "dev" / "workspaces" / slug_low
            vjson = ch / "dev" / "verticals" / f"{slug_low}.json"
            if ws.is_dir():
                return ws, (vjson if vjson.is_file() else None)
            if proj and ch.name.lower() == proj.lower() and ch.name.lower() == slug_low and (ch / "dev").is_dir():
                return ch / "dev", (vjson if vjson.is_file() else None)

        # 2. Direct <ROOT>/workspaces/<slug> or <ROOT>/<slug>/dev
        for cand in (root / "workspaces" / slug_low, root / slug / "dev", root / slug.upper() / "dev"):
            if cand.is_dir():
                vjson = cand.parent / "dev" / "verticals" / f"{slug_low}.json"
                return cand, (vjson if vjson.is_file() else None)

    return STORAGE_ROOTS[0] / slug_low, None


def load_brandbook_bundle(brand_slug: str, vertical_json: Optional[Path] = None, explicit_ws: Optional[Path] = None) -> Tuple[Dict[str, Any], Path]:
    if explicit_ws:
        workspace_dir = explicit_ws
        v_path = vertical_json
    else:
        workspace_dir, v_path = discover_workspace_dir(brand_slug)

    brand_dir = next((d for d in (workspace_dir / "brand", workspace_dir / "dev", workspace_dir) if (d / "brandbook.json").exists()), workspace_dir / "brand")
    display_default = brand_slug.replace("-", " ").title()
    bundle: Dict[str, Any] = {
        "brand": {
            "name": display_default,
            "vertical": brand_slug,
            "category_name": "Propuesta Diferenciada",
            "entity_name": display_default,
            "signature_mechanism": "Método Propietario",
            "paid_discovery": {"title": "Sesión de Diagnóstico Inicial", "price": "Según alcance"},
            "insignia_offer": {"title": f"Programa Principal {display_default}"},
            "backend_retainer": {"title": "Operación Continua"},
            "value_equation": {"promise": "Resultados medibles con procesos claros y automatizados."},
            "epoch_moat": {"primary": "Criterio profesional y sistemas propios"},
        },
        "metadata": {"cta_url": "/diagnostico", "brand_slug": brand_slug},
        "color": {},
        "typography": {},
    }

    bb_path = brand_dir / "brandbook.json"
    if bb_path.is_file():
        try:
            primary_bb = json.loads(bb_path.read_text(encoding="utf-8"))
            if isinstance(primary_bb, dict):
                deep_merge(bundle, primary_bb)
        except Exception as e:
            sys.stderr.write(f"⚠️ Warning loading {bb_path}: {e}\n")

    # Map standard Astrobranding Brandbook schema fields into bundle["brand"]
    meta_name = bundle.get("metadata", {}).get("brand_name")
    if meta_name:
        bundle["brand"]["name"] = meta_name
        bundle["brand"]["entity_name"] = meta_name
    arch = bundle.get("brand_architecture", {})
    if arch.get("core_promise"):
        bundle["brand"]["value_equation"]["promise"] = arch["core_promise"]
    if arch.get("brand_essence"):
        bundle["brand"]["category_name"] = arch["brand_essence"]

    # Merge verticals/<vertical>.json when present
    if v_path and v_path.is_file():
        try:
            vdata = json.loads(v_path.read_text(encoding="utf-8"))
            bundle["vertical_spec"] = vdata
            cat = vdata.get("category_and_positioning", {})
            if cat.get("category_name"):
                bundle["brand"]["category_name"] = cat["category_name"]
            um = vdata.get("unique_mechanism", {})
            if um.get("name"):
                bundle["brand"]["signature_mechanism"] = um["name"]
            po = vdata.get("primary_offer", {})
            if po.get("structure"):
                bundle["brand"]["insignia_offer"]["title"] = po["structure"]
            pricing = po.get("pricing", {})
            cur = pricing.get("currency", "COP")
            if pricing.get("pwyw_default_cop"):
                bundle["brand"]["paid_discovery"]["price"] = f"${pricing['pwyw_default_cop']:,} {cur}".replace(",", ".")
            elif pricing.get("amount"):
                bundle["brand"]["paid_discovery"]["price"] = f"${pricing['amount']} {cur}"
            slo = vdata.get("funnel_architecture", {}).get("unqualified_branch_slo", {})
            if slo.get("product_name"):
                bundle["brand"]["paid_discovery"]["title"] = slo["product_name"]
            if slo.get("route"):
                bundle["metadata"]["cta_url"] = slo["route"]
            icp = vdata.get("target_avatar", {}).get("icp")
            if icp:
                bundle.setdefault("target_audience", {}).setdefault("primary_persona", {})["archetype"] = icp
            for taboo in (cat.get("excluded_terms", []) or []) + (cat.get("client_facing_jargon_ban", []) or []):
                if taboo and taboo.lower() not in [w.lower() for w in PROHIBITED_WORDS]:
                    bundle.setdefault("dynamic_taboos", []).append(taboo)
        except Exception as e:
            sys.stderr.write(f"⚠️ Warning loading {v_path}: {e}\n")

    for sf_path in brand_dir.glob("brandbook_superfull_*.json"):
        try:
            sf_data = json.loads(sf_path.read_text(encoding="utf-8"))
            if isinstance(sf_data, dict):
                deep_merge(bundle, sf_data)
        except Exception:
            pass

    for cname, target_key in (("chroma_manifest.json", "color"), ("font_manifest.json", "typography")):
        cpath = brand_dir / cname
        if cpath.is_file():
            try:
                bundle[target_key]["manifest"] = json.loads(cpath.read_text(encoding="utf-8"))
            except Exception:
                pass

    return bundle, workspace_dir


def resolve_playbook_path(playbook_name: str) -> Optional[Path]:
    cleaned = playbook_name.strip()
    candidates = [cleaned]
    if not cleaned.endswith(".md"):
        candidates.append(f"{cleaned}.md")
        candidates.append(f"{cleaned}_playbook.md")
    if not cleaned.startswith("00_") and "category" in cleaned:
        candidates.append("00_category_of_one.md")
    for p_dir in PLAYBOOK_SEARCH_DIRS:
        if not p_dir.exists():
            continue
        for cand in candidates:
            p_file = p_dir / cand
            if p_file.is_file():
                return p_file
            for actual in p_dir.glob("*.md"):
                if actual.name.lower() == cand.lower():
                    return actual
    return None


def parse_playbook_file(playbook_path: Path) -> Dict[str, Any]:
    content = playbook_path.read_text(encoding="utf-8")
    frontmatter: Dict[str, Any] = {}
    body = content
    raw_fm = ""
    if content.startswith("---"):
        parts = content.split("---", 2)
        if len(parts) >= 3:
            raw_fm, body = parts[1], parts[2].strip()
    else:
        fm_m = re.search(r"```yaml\s*\n---\s*\n(.*?)\n---\s*\n```", content, re.DOTALL)
        if fm_m:
            raw_fm = fm_m.group(1)
            body = content.replace(fm_m.group(0), "", 1).strip()

    if raw_fm and yaml:
        try:
            parsed = yaml.safe_load(raw_fm)
            if isinstance(parsed, dict):
                frontmatter = parsed
        except Exception:
            frontmatter = {}

    return {
        "path": playbook_path,
        "slug": playbook_path.stem.replace("_playbook", ""),
        "frontmatter": frontmatter,
        "slots_contract": frontmatter.get("slots_contract", {}),
        "modular_blocks": frontmatter.get("modular_blocks", []),
        "body": body,
        "raw_content": content,
    }


def hydrate_slot_value(slot_key: str, slot_def: Dict[str, Any], brandbook: Dict[str, Any]) -> Tuple[str, bool]:
    pointer = slot_def.get("json_pointer", "")
    fallback = slot_def.get("fallback_value", "")
    if isinstance(fallback, list):
        fallback = ", ".join(str(x) for x in fallback)
    fallback = str(fallback) if fallback is not None else ""

    val = resolve_json_pointer(brandbook, pointer) if pointer else None
    if val is None or val == "":
        alias_map = {
            "SLOT_PERSONAL_MONOPOLY_ENTITY": "/brand/name",
            "SLOT_CATEGORY_NAME": "/brand/category_name",
            "SLOT_SIGNATURE_MECHANISM": "/brand/signature_mechanism",
            "SLOT_PAID_DISCOVERY_TITLE": "/brand/paid_discovery/title",
            "SLOT_PAID_DISCOVERY_PRICE": "/brand/paid_discovery/price",
            "SLOT_INSIGNIA_OFFER_NAME": "/brand/insignia_offer/title",
            "SLOT_BACKEND_RETAINER_NAME": "/brand/backend_retainer/title",
            "SLOT_VALUE_EQUATION_PROMISE": "/brand/value_equation/promise",
            "SLOT_EPOCH_PRIMARY_MOAT": "/brand/epoch_moat/primary",
            "SLOT_CTA_URL": "/metadata/cta_url",
            "SLOT_MARCA": "/brand/name",
            "SLOT_PERFIL_EXPERTO": "/brand/entity_name",
            "SLOT_NICHO": "/brand/category_name",
            "SLOT_CATEGORIA_PROPIA": "/brand/category_name",
            "SLOT_MECANISMO": "/brand/signature_mechanism",
            "SLOT_MECANISMO_UNICO": "/brand/signature_mechanism",
            "SLOT_OFERTA_INSIGNIA": "/brand/insignia_offer/title",
            "SLOT_PRODUCTO_ENTRADA": "/brand/paid_discovery/title",
            "SLOT_PRECIO_ENTRADA": "/brand/paid_discovery/price",
            "SLOT_PROMESA": "/brand/value_equation/promise",
            "SLOT_CTA": "/metadata/cta_url",
            "SLOT_AVATAR": "/target_audience/primary_persona/archetype",
            "SLOT_BRAND_NAME": "/brand/name",
            "SLOT_GARANTIA": "Garantía de satisfacción incondicional de 30 días",
        }
        cand_pointer = alias_map.get(slot_key)
        if cand_pointer:
            val = resolve_json_pointer(brandbook, cand_pointer) if cand_pointer.startswith("/") else cand_pointer

    if val is not None and val != "":
        if isinstance(val, list):
            val = ", ".join(str(x) for x in val)
        return str(val), False
    return fallback, True


def hydrate_playbook(parsed_playbook: Dict[str, Any], brandbook: Dict[str, Any]) -> Dict[str, Any]:
    slots_contract = parsed_playbook.get("slots_contract", {})
    brand_slots_list = []
    if isinstance(slots_contract, dict):
        if isinstance(slots_contract.get("brand_slots"), list):
            brand_slots_list = slots_contract["brand_slots"]
        else:
            for k, v in slots_contract.items():
                if isinstance(v, dict):
                    brand_slots_list.append({"key": k, "json_pointer": f"/brand/{k}", "required": False, "fallback_value": v.get("description", k)})

    slot_map: Dict[str, Dict[str, Any]] = {s["key"]: s for s in brand_slots_list if isinstance(s, dict) and s.get("key")}
    for tag in sorted(set(re.findall(r"\{\{([A-Za-z0-9_]+)\}\}", parsed_playbook.get("body", "")))):
        if tag.startswith("SLOT_") and tag not in slot_map:
            slot_map[tag] = {"key": tag, "json_pointer": f"/brand/{tag.lower()}", "required": False, "fallback_value": ""}

    resolved_slots: Dict[str, str] = {}
    fallback_slots: List[str] = []
    unresolved_required: List[str] = []
    for key, s_def in slot_map.items():
        val, is_fb = hydrate_slot_value(key, s_def, brandbook)
        if val != "":
            resolved_slots[key] = val
            if is_fb:
                fallback_slots.append(key)
        elif s_def.get("required", False):
            unresolved_required.append(key)

    slot_pattern = re.compile(r"\{\{([A-Za-z0-9_]+)\}\}")

    def _repl(match):
        sk = match.group(1)
        if sk in resolved_slots:
            return resolved_slots[sk]
        direct = resolve_json_pointer(brandbook, f"/brand/{sk.lower()}")
        return str(direct) if (direct is not None and direct != "") else match.group(0)

    hydrated_body = slot_pattern.sub(_repl, parsed_playbook["body"])
    hydrated_blocks = []
    for block in parsed_playbook.get("modular_blocks", []):
        if isinstance(block, str):
            hydrated_blocks.append({"block_id": block, "title": block, "hydrated_content": ""})
        else:
            bc = dict(block)
            bc["hydrated_content"] = slot_pattern.sub(_repl, block.get("unhydrated_template", ""))
            hydrated_blocks.append(bc)

    remaining_tags = list(set(slot_pattern.findall(hydrated_body)))
    prohibited = [w for w in PROHIBITED_WORDS + brandbook.get("dynamic_taboos", []) if w.lower() in hydrated_body.lower()]

    return {
        "slug": parsed_playbook["slug"],
        "path": parsed_playbook["path"],
        "hydrated_body": hydrated_body,
        "hydrated_blocks": hydrated_blocks,
        "resolved_slots": resolved_slots,
        "fallback_slots": fallback_slots,
        "unresolved_required": unresolved_required,
        "remaining_tags": remaining_tags,
        "prohibited_words": prohibited,
    }


def _bifrost_synthesize(prompt: str, bifrost_url: str = "http://bifrost:8080/v1/chat/completions") -> Optional[str]:
    vk = os.getenv("BIFROST_VIRTUAL_KEY") or os.getenv("VK_AGENT_ORCHESTRATOR") or ""
    if not vk:
        return None
    payload = json.dumps({
        "model": "auto",
        "temperature": 0.3,
        "messages": [
            {"role": "system", "content": "Redacta en español neutro claro (tú), con ortografía completa (tildes y ñ), sin siglas de marketing ni jerga técnica."},
            {"role": "user", "content": prompt},
        ],
    }).encode("utf-8")
    req = urllib.request.Request(bifrost_url, data=payload, headers={"Content-Type": "application/json", "Authorization": f"Bearer {vk}"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["choices"][0]["message"]["content"]
    except Exception:
        return None


def transmute_to_targets(hydrated_data: Dict[str, Any], brand_slug: str, target: str, output_dir: Path, use_bifrost: bool = False) -> List[Path]:
    output_dir.mkdir(parents=True, exist_ok=True)
    generated_files: List[Path] = []
    slug = hydrated_data["slug"]
    slots = hydrated_data["resolved_slots"]
    entity = slots.get("SLOT_PERSONAL_MONOPOLY_ENTITY", brand_slug.replace("-", " ").title())
    cat = slots.get("SLOT_CATEGORY_NAME", "Propuesta Diferenciada")
    mech = slots.get("SLOT_SIGNATURE_MECHANISM", "Método Propietario")
    price = slots.get("SLOT_PAID_DISCOVERY_PRICE", "Valor por alcance")
    diag_title = slots.get("SLOT_PAID_DISCOVERY_TITLE", "Diagnóstico Inicial")
    cta_url = slots.get("SLOT_CTA_URL", "/diagnostico")

    if target in ("all", "growth-engine", "copy"):
        md_file = output_dir / f"{slug}.md"
        body_out = hydrated_data["hydrated_body"]
        if use_bifrost:
            syn = _bifrost_synthesize(f"Sintetiza en español claro para cliente final el mecanismo '{mech}' de '{entity}' sobre esta base:\n{body_out[:4000]}")
            if syn:
                body_out = syn
        md_file.write_text(f"# {slug.replace('_', ' ').title()} — {entity}\n\n{body_out}\n", encoding="utf-8")
        generated_files.append(md_file)

        manifest_file = output_dir / f"{slug}_copy_manifest.json"
        manifest_file.write_text(json.dumps({
            "brand_slug": brand_slug,
            "playbook_slug": slug,
            "resolved_slots": slots,
            "anti_slop_attestation": {
                "remaining_unresolved_tags": hydrated_data["remaining_tags"],
                "prohibited_words_count": len(hydrated_data["prohibited_words"]),
            },
        }, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        generated_files.append(manifest_file)

    if target in ("all", "whatsapp-engine"):
        wa_file = output_dir / f"{slug}_whatsapp_flow.md"
        wa_text = (
            f"# Flujo WhatsApp: {entity}\n"
            f"**Mecanismo:** {mech} | **Paso Inicial:** {diag_title} ({price})\n\n"
            "## Fase 1: Saludo y contexto\n"
            f"Hola. Soy del equipo de {entity}. ¿Quieres revisar cómo aplicar {mech} en tu actividad actual?\n\n"
            "## Fase 2: Preguntas breves de encaje\n"
            "1. ¿Qué tarea te quita más horas operativas cada semana?\n"
            "2. ¿Has trabajado antes con agencias o herramientas sueltas que no te dieron resultados?\n\n"
            "## Fase 3: Siguiente paso claro\n"
            f"Puedes iniciar con {diag_title} ({price}) y llevarte una hoja de ruta concreta.\n\n"
            "## Fase 4: Enlace directo\n"
            f"Accede aquí cuando estés listo: {cta_url}\n"
        )
        assert not CLIENT_JARGON_RE.search(wa_text) and not VOSEO_CLIENT_RE.search(wa_text)
        wa_file.write_text(wa_text, encoding="utf-8")
        generated_files.append(wa_file)

    if target in ("all", "email-marketing"):
        email_file = output_dir / f"{slug}_email_sequence.md"
        email_text = (
            f"# Secuencia de Correo: {entity}\n"
            "<!-- Anti-SPAM: asunto 30-50 caracteres, enlace único, HTML < 85KB -->\n\n"
            "## Correo 1: Enfoque práctico\n"
            "**Asunto:** Por qué competir por precio desgasta\n"
            f"**Previsualización:** La diferencia real de {entity} con {mech}.\n\n"
            f"La mayoría intenta ganar clientes bajando tarifas. En {entity} ordenamos tu operación con {mech}.\n\n"
            f"Revisa la guía completa en {cta_url}.\n"
        )
        assert not CLIENT_JARGON_RE.search(email_text) and not VOSEO_CLIENT_RE.search(email_text)
        email_file.write_text(email_text, encoding="utf-8")
        generated_files.append(email_file)

    if target in ("all", "astro-web"):
        web_file = output_dir / f"{slug}_web_tokens.json"
        web_file.write_text(json.dumps({
            "brand": brand_slug,
            "playbook": slug,
            "theme_vars": {
                "--color-brand-primary": slots.get("SLOT_PRIMARY_COLOR", "var(--brand-primary)"),
                "--font-brand-display": slots.get("SLOT_FONT_DISPLAY", "var(--font-display)"),
                "--font-brand-body": slots.get("SLOT_FONT_BODY", "var(--font-body)"),
            },
            "hero_props": {
                "headline": cat,
                "subheadline": slots.get("SLOT_VALUE_EQUATION_PROMISE", "Resultados medibles."),
                "mechanism": mech,
                "cta_url": cta_url,
            },
        }, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        generated_files.append(web_file)

    return generated_files


def run_transmute(args: argparse.Namespace) -> int:
    brand_slug = args.brand.strip()
    target = args.target.strip().lower()
    explicit_ws = Path(args.workspace_dir).resolve() if args.workspace_dir else None
    ws_dir, vjson = (explicit_ws, None) if explicit_ws else discover_workspace_dir(brand_slug)
    brandbook, workspace_dir = load_brandbook_bundle(brand_slug, vertical_json=vjson, explicit_ws=ws_dir)
    output_dir = Path(args.output_dir) if args.output_dir else (workspace_dir / "copy")

    playbook_paths: List[Path] = []
    if args.all:
        seen: set[str] = set()
        for p_dir in PLAYBOOK_SEARCH_DIRS:
            if p_dir.exists():
                for p in sorted(p_dir.glob("*.md")):
                    if p.name not in seen:
                        seen.add(p.name)
                        playbook_paths.append(p)
    else:
        if not args.playbook:
            print("❌ Error: Must specify --playbook <name> or --all")
            return 1
        p_path = resolve_playbook_path(args.playbook)
        if not p_path:
            print(f"❌ Error: Playbook '{args.playbook}' not found.")
            return 1
        playbook_paths.append(p_path)

    total_files = 0
    total_violations = 0
    for p_path in playbook_paths:
        hydrated = hydrate_playbook(parse_playbook_file(p_path), brandbook)
        if hydrated["unresolved_required"] and not args.force:
            total_violations += 1
            continue
        if not args.dry_run:
            files = transmute_to_targets(hydrated, brand_slug, target, output_dir, use_bifrost=args.bifrost)
            total_files += len(files)

    print(f"✅ brand-play: {len(playbook_paths)} playbooks -> {total_files} files in {output_dir}")
    return 1 if total_violations > 0 else 0


def run_list(args: argparse.Namespace) -> int:
    if args.playbooks or (not args.brands and not args.playbooks):
        for p_dir in PLAYBOOK_SEARCH_DIRS:
            if p_dir.exists():
                for idx, p in enumerate(sorted(p_dir.glob("*.md")), 1):
                    print(f"{idx:02d}. {p.name}")
                break
    if args.brands or not args.playbooks:
        for root in STORAGE_ROOTS:
            if not root.exists():
                continue
            for d in sorted(root.iterdir()):
                if d.is_dir() and (d / "dev").is_dir():
                    print(f"• {d.name}")
                    ws = d / "dev" / "workspaces"
                    if ws.is_dir():
                        for w in sorted(ws.iterdir()):
                            if w.is_dir():
                                print(f"  - workspace: {d.name}/workspaces/{w.name}")
    return 0


def run_test() -> int:
    print("Testing brand-play v2.1 deterministic slot hydration & zero-jargon gate...")
    test_obj = {
        "brand": {"name": {"$value": "Aura Studio Demo"}, "category": "Estudio Editorial"},
        "color": {"primary": {"$value": "#0f172a"}},
    }
    assert resolve_json_pointer(test_obj, "/brand/name") == "Aura Studio Demo"
    assert resolve_json_pointer(test_obj, "/brand/category") == "Estudio Editorial"

    dummy_playbook = {
        "slug": "test_playbook",
        "path": Path("/tmp/dummy.md"),
        "body": "Bienvenido a {{SLOT_PERSONAL_MONOPOLY_ENTITY}}. {{SLOT_CATEGORY_NAME}} con {{SLOT_SIGNATURE_MECHANISM}}.",
        "slots_contract": {
            "brand_slots": [
                {"key": "SLOT_PERSONAL_MONOPOLY_ENTITY", "json_pointer": "/brand/name", "required": True, "fallback_value": "Experto"},
                {"key": "SLOT_CATEGORY_NAME", "json_pointer": "/brand/category", "required": True, "fallback_value": "Consultoría"},
                {"key": "SLOT_SIGNATURE_MECHANISM", "json_pointer": "/brand/missing", "required": False, "fallback_value": "Método Claro"},
            ]
        },
        "modular_blocks": [],
    }
    hydrated = hydrate_playbook(dummy_playbook, test_obj)
    assert "Aura Studio Demo" in hydrated["hydrated_body"] and "Método Claro" in hydrated["hydrated_body"]

    with tempfile.TemporaryDirectory(prefix="brandplay_test_") as tmp:
        tp = Path(tmp)
        ws = tp / "ws"
        vfile = tp / "vertical.json"
        vfile.write_text(json.dumps({
            "unique_mechanism": {"name": "Sistema Alpha"},
            "category_and_positioning": {"category_name": "Asesoría Directa"},
            "primary_offer": {"pricing": {"currency": "COP", "pwyw_default_cop": 30000}},
        }), encoding="utf-8")
        (ws / "brand").mkdir(parents=True, exist_ok=True)
        (ws / "brand" / "brandbook.json").write_text(json.dumps({"metadata": {"brand_name": "Aurelius Studio"}}), encoding="utf-8")
        bundle, _ = load_brandbook_bundle("alpha-line", vertical_json=vfile, explicit_ws=ws)
        assert bundle["brand"]["signature_mechanism"] == "Sistema Alpha"
        assert "$30.000 COP" in bundle["brand"]["paid_discovery"]["price"]
        h2 = hydrate_playbook(dummy_playbook, bundle)
        files = transmute_to_targets(h2, "alpha-line", "all", tp / "out", use_bifrost=False)
        for f in files:
            txt = f.read_text(encoding="utf-8")
            assert not VOSEO_CLIENT_RE.search(txt), f"Voseo leak in {f.name}"
            assert "USD 150" not in txt, f"Hardcoded price leak in {f.name}"

    print("✅ ALL BRAND-PLAY v2.1 UNIT TESTS PASSED (exit 0)")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="brand-play v2.1: Sovereign Downstream Playbook Transmutation Engine")
    sub = parser.add_subparsers(dest="subcommand")

    t_p = sub.add_parser("transmute", help="Hidrata playbooks universales con tokens de marca")
    t_p.add_argument("--brand", "-b", required=True)
    t_p.add_argument("--playbook", "-p")
    t_p.add_argument("--all", "-a", action="store_true")
    t_p.add_argument("--target", "-t", default="all", choices=["all", "growth-engine", "astro-web", "whatsapp-engine", "email-marketing", "copy"])
    t_p.add_argument("--workspace-dir", default=None)
    t_p.add_argument("--output-dir", "-o")
    t_p.add_argument("--bifrost", action="store_true", help="Sintetizar copy mediante Bifrost LLM Gateway")
    t_p.add_argument("--dry-run", action="store_true")
    t_p.add_argument("--force", action="store_true")

    l_p = sub.add_parser("list", help="Lista playbooks o marcas/workspaces")
    l_p.add_argument("--playbooks", action="store_true")
    l_p.add_argument("--brands", action="store_true")

    sub.add_parser("test", help="Ejecuta pruebas unitarias")
    args = parser.parse_args()

    if args.subcommand == "transmute":
        return run_transmute(args)
    if args.subcommand == "list":
        return run_list(args)
    if args.subcommand == "test":
        return run_test()
    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
