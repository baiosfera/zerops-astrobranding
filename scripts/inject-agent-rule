#!/usr/bin/env python3
import sys
import os
import re

def main():
    args = sys.argv[1:]
    prepend = False
    if "--prepend" in args:
        prepend = True
        args.remove("--prepend")
        
    if len(args) < 2:
        print("Uso: inject-agent-rule [--prepend] <Titulo_Seccion> <Cuerpo_Markdown> [ruta_AGENTS.md]")
        sys.exit(1)
        
    title = args[0].strip()
    rule_body = args[1].strip()
    agents_file = args[2] if len(args) > 2 else "/var/www/AGENTS.md"
    
    if not os.path.exists(agents_file):
        print(f"Error: {agents_file} no existe.")
        sys.exit(1)
        
    with open(agents_file, "r", encoding="utf-8") as f:
        content = f.read()
        
    custom_begin = "<!-- CUSTOM:BEGIN -->"
    custom_end = "<!-- CUSTOM:END -->"
    
    if custom_begin not in content:
        content = content.rstrip() + f"\n\n{custom_begin}\n{custom_end}\n"
        
    content = re.sub(r"(<!-- CUSTOM:BEGIN -->\s*)+", "<!-- CUSTOM:BEGIN -->\n\n", content)
    content = re.sub(r"(<!-- CUSTOM:END -->\s*)+", "\n<!-- CUSTOM:END -->\n", content)

    parts = content.split(custom_begin)
    pre = parts[0].rstrip()
    post_parts = parts[1].split(custom_end)
    custom_body = post_parts[0]
    post = custom_end + post_parts[1] if len(post_parts) > 1 else f"\n{custom_end}\n"
    
    section_pattern = re.compile(r"## " + re.escape(title) + r"\n.*?(?=(\n## |$))", re.DOTALL)
    custom_body = section_pattern.sub("", custom_body).strip()
    new_section = f"## {title}\n{rule_body}"
    if prepend:
        custom_body = (new_section + "\n\n" + custom_body) if custom_body else new_section
    else:
        custom_body = (custom_body + "\n\n" + new_section) if custom_body else new_section
    
    final_output = f"{pre}\n\n{custom_begin}\n\n{custom_body}\n\n{post.strip()}\n"
    final_output = re.sub(r'\n{3,}', '\n\n', final_output)
    
    with open(agents_file, "w", encoding="utf-8") as f:
        f.write(final_output)

    # Dual-Target SSoT Mirroring (Google Drive SSoT parity)
    drive_ssot = "/var/www/baiosfera/0ZEROPS-AGY/0zcp-123/AGENTS.md"
    if agents_file == "/var/www/AGENTS.md" and os.path.isdir(os.path.dirname(drive_ssot)):
        try:
            with open(drive_ssot, "w", encoding="utf-8") as f:
                f.write(final_output)
        except Exception as e:
            print(f"Aviso SSoT Mirror: No se pudo replicar en {drive_ssot}: {e}", file=sys.stderr)

if __name__ == "__main__":
    main()
