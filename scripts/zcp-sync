#!/usr/bin/env bash
# ==============================================================================
# ZCP Universal Project & Ecosystem Storage Synchronizer (zcp-sync v2.0)
# Bi-directional Safe Synchronization between Google Drive SSoT and Zerops Local Storage
# SSoT Canonical Path: /var/www/baiosfera/PROYECTOS/<PROJECT>
# Local Storage Path:  /var/www/localstorage/<PROJECT>
# Core Artifacts:      Playbooks, Templates, CLIs and Sovereign Skills
# ==============================================================================
set -euo pipefail

DRIVE_BASE="/var/www/baiosfera/PROYECTOS"
STORAGE_BASE="/var/www/localstorage"

check_mounts() {
    if ! mountpoint -q /var/www/baiosfera 2>/dev/null; then
        echo "❌ Error: Google Drive no está montado en /var/www/baiosfera (rclone)."
        exit 1
    fi
    if ! mountpoint -q /var/www/localstorage 2>/dev/null && ! mountpoint -q /mnt/localstorage 2>/dev/null; then
        echo "❌ Error: Zerops Local Storage no está montado en /var/www/localstorage."
        exit 1
    fi
    if [ ! -d "$DRIVE_BASE" ]; then
        echo "❌ Error: No existe el directorio de proyectos en Drive ($DRIVE_BASE)."
        exit 1
    fi
    if [ ! -d "$STORAGE_BASE" ]; then
        echo "❌ Error: No existe el directorio de almacenamiento local ($STORAGE_BASE)."
        exit 1
    fi
}

sync_ecosystem_core() {
    echo "============================================================"
    echo "  🌐 Sincronizando Núcleo Universal (Playbooks, Templates, Binarios)"
    echo "============================================================"
    
    # 1. Playbooks Universales (Drive -> Storage)
    local playbooks_src="/var/www/baiosfera/PLAYBOOKS"
    if [ -d "$playbooks_src" ]; then
        echo "• [Core 1/3] Sincronizando Playbooks Universales desde Drive..."
        mkdir -p "$STORAGE_BASE/playbooks"
        cp -u "$playbooks_src"/*.md "$STORAGE_BASE/playbooks/" 2>/dev/null || true
        echo "  ✓ Playbooks universales asegurados en $STORAGE_BASE/playbooks"
    fi

    # 2. Plantillas Operacionales y Componentes Lego Astro (Repo -> Storage)
    local templates_src="/var/www/zerops-astrobranding/templates"
    if [ -d "$templates_src" ]; then
        echo "• [Core 2/3] Sincronizando Plantillas Operacionales y Componentes Astro..."
        mkdir -p "$STORAGE_BASE/templates/platform"
        # Sincronizar blueprints operacionales y componentes Lego Astro a la raíz de templates
        rsync -au --delete \
            --exclude 'plantilla-universal-web-zerops-v4.md' \
            --exclude 'prompt-universal-despliegue-zerops.md' \
            "$templates_src/" "$STORAGE_BASE/templates/"
        # Preservar el Master Blueprint de plataforma en subcarpeta platform/ para AGY
        if [ -f "$templates_src/plantilla-universal-web-zerops-v4.md" ]; then
            cp -f "$templates_src/plantilla-universal-web-zerops-v4.md" "$STORAGE_BASE/templates/platform/"
        fi
        echo "  ✓ Plantillas y componentes Lego Astro sincronizados en $STORAGE_BASE/templates"
    fi

    # 3. Binarios Soberanos (PATH Clúster)
    echo "• [Core 3/3] Sincronizando Binarios y CLIs Soberanos..."
    mkdir -p "$STORAGE_BASE/bin"
    for bin in apotelos brand-play; do
        if [ -f "/var/www/zerops-astrobranding/scripts/$bin" ]; then
            cp -fp "/var/www/zerops-astrobranding/scripts/$bin" "$STORAGE_BASE/bin/$bin"
            chmod 755 "$STORAGE_BASE/bin/$bin"
        fi
    done
    if [ -f "/var/www/zerops-astrobranding/bin/orchesbrand" ]; then
        cp -fp "/var/www/zerops-astrobranding/bin/orchesbrand" "$STORAGE_BASE/bin/orchesbrand"
        chmod 755 "$STORAGE_BASE/bin/orchesbrand"
    fi
    if [ -f "/usr/local/bin/zcp" ]; then
        cp -fp "/usr/local/bin/zcp" "$STORAGE_BASE/bin/zcp"
        chmod 755 "$STORAGE_BASE/bin/zcp"
    fi
    if [ -f "/usr/local/bin/zcp-sync" ]; then
        cp -fp "/usr/local/bin/zcp-sync" "$STORAGE_BASE/bin/zcp-sync"
        chmod 755 "$STORAGE_BASE/bin/zcp-sync"
    fi
    echo "  ✓ Binarios asegurados en $STORAGE_BASE/bin (apotelos, brand-play, orchesbrand, zcp, bun)"
    echo "============================================================"
}

list_projects() {
    check_mounts
    echo "============================================================"
    echo "  📦 Proyectos detectados en Google Drive y Local Storage"
    echo "============================================================"
    echo "• Google Drive ($DRIVE_BASE):"
    for d in "$DRIVE_BASE"/*; do
        [ -d "$d" ] && echo "  - $(basename "$d")"
    done
    echo ""
    echo "• Local Storage ($STORAGE_BASE):"
    for d in "$STORAGE_BASE"/*; do
        [ -d "$d" ] && echo "  - $(basename "$d")"
    done
}

sync_project() {
    local proj="$1"
    local dest_proj="${2:-$proj}"
    local drive_dir="$DRIVE_BASE/$proj"
    local storage_dir="$STORAGE_BASE/$dest_proj"

    # Resolver coincidencia insensible a mayúsculas y subcadenas si no coincide exacto
    if [ ! -d "$drive_dir" ]; then
        local p_norm="$(echo "$proj" | tr '[:lower:]' '[:upper:]' | tr -cd '[:alnum:]')"
        for d in "$DRIVE_BASE"/*; do
            [ -d "$d" ] || continue
            local d_norm="$(basename "$d" | tr '[:lower:]' '[:upper:]' | tr -cd '[:alnum:]')"
            if [ "$d_norm" = "$p_norm" ] || [[ "$d_norm" == *"$p_norm"* ]] || [[ "$p_norm" == *"$d_norm"* ]]; then
                drive_dir="$d"
                proj="$(basename "$d")"
                if [ -z "${2:-}" ]; then
                    dest_proj="$proj"
                fi
                storage_dir="$STORAGE_BASE/$dest_proj"
                break
            fi
        done
    fi

    echo "------------------------------------------------------------"
    echo "  🔄 Sincronizando proyecto: Drive [$proj] <---> Storage [$dest_proj]"
    echo "  📁 Drive:   $drive_dir"
    echo "  💾 Storage: $storage_dir"
    echo "------------------------------------------------------------"

    mkdir -p "$drive_dir" "$storage_dir"

    # 1. Drive -> Local Storage (traer novedades de Drive)
    echo "• [1/2] Trayendo cambios desde Google Drive hacia Local Storage..."
    rsync -au "$drive_dir/" "$storage_dir/"

    # 2. Local Storage -> Drive (empujar novedades locales a Drive)
    echo "• [2/2] Respaldando cambios de Local Storage hacia Google Drive..."
    rsync -au "$storage_dir/" "$drive_dir/"

    echo "✅ Sincronización exitosa: Drive [$proj] <---> Storage [$dest_proj]."
}

sync_all() {
    check_mounts
    sync_ecosystem_core
    local projects=()
    for d in "$DRIVE_BASE"/*; do
        [ -d "$d" ] && projects+=("$(basename "$d")")
    done
    for d in "$STORAGE_BASE"/*; do
        if [ -d "$d" ]; then
            local name="$(basename "$d")"
            [[ "$name" =~ ^(bifrost|freellmapi|engram|lost\+found|bin|skills|playbooks|templates)$ ]] && continue
            local found=false
            for p in "${projects[@]}"; do
                [ "$p" = "$name" ] && found=true && break
            done
            [ "$found" = false ] && projects+=("$name")
        fi
    done

    echo "🔄 Sincronizando todos los proyectos detectados (${#projects[@]}): ${projects[*]}"
    for p in "${projects[@]}"; do
        sync_project "$p"
    done
    echo "✅ Sincronización masiva de todos los proyectos completada."
}

check_mounts

case "${1:-}" in
    --list|-l|list)
        list_projects
        ;;
    --core|-c|core)
        sync_ecosystem_core
        ;;
    --all|-a|all)
        sync_all
        ;;
    --help|-h|help)
        echo "Uso: zcp-sync [PROYECTO_DRIVE [DESTINO_STORAGE]|--all|--core|--list]"
        echo "Ejemplos:"
        echo "  zcp-sync                        # Sincroniza núcleo + proyecto activo (\$PROJECT_NAME)"
        echo "  zcp-sync --core                 # Sincroniza exclusivamente núcleo (Playbooks, Templates, Binarios)"
        echo "  zcp-sync ELPLACERDC             # Sincroniza núcleo + proyecto ELPLACERDC"
        echo "  zcp-sync DAMAREN MentorIA       # Sincroniza núcleo + Drive (DAMAREN) <-> Storage (MentorIA)"
        echo "  zcp-sync DAMAREN:MentorIA      # Sintaxis alternativa origen:destino"
        echo "  zcp-sync --list                 # Lista todos los proyectos disponibles"
        echo "  zcp-sync --all                  # Sincroniza núcleo + todos los proyectos"
        ;;
    *)
        # En cualquier sincronización de proyecto, asegurar primero el núcleo universal
        sync_ecosystem_core

        TARGET="${1:-}"
        DEST_TARGET="${2:-}"
        if [[ "$TARGET" == *":"* ]]; then
            DEST_TARGET="${TARGET#*:}"
            TARGET="${TARGET%%:*}"
        fi

        if [ -z "$TARGET" ]; then
            if [ -n "${CLIENT_NAME:-}" ] && [ -n "${PROJECT_NAME:-}" ] && [ "$CLIENT_NAME" != "$PROJECT_NAME" ]; then
                TARGET="$CLIENT_NAME"
                DEST_TARGET="$PROJECT_NAME"
            else
                TARGET="${PROJECT_NAME:-${CLIENT_NAME:-${ENGRAM_PROJECT:-}}}"
            fi
        fi
        if [ -z "$TARGET" ]; then
            echo "ℹ️ No se especificó proyecto ni existe \$PROJECT_NAME en el entorno."
            echo "   Proyectos disponibles:"
            list_projects
            exit 1
        fi

        ACTIVE_PROJ="${PROJECT_NAME:-${CLIENT_NAME:-${ENGRAM_PROJECT:-}}}"
        if [ -n "$DEST_TARGET" ]; then
            sync_project "$TARGET" "$DEST_TARGET"
        else
            if [ -n "$ACTIVE_PROJ" ] && [ "$(echo "$TARGET" | tr '[:lower:]' '[:upper:]')" != "$(echo "$ACTIVE_PROJ" | tr '[:lower:]' '[:upper:]')" ]; then
                echo "ℹ️ Aviso de Gobernanza: El proyecto solicitado [$TARGET] difiere de la marca activa en este runtime [$ACTIVE_PROJ]."
                echo "   (Prioridad arquitectónica: una marca activa por localstorage. Procediendo por solicitud explícita sin bloqueo...)"
            fi
            sync_project "$TARGET" "$TARGET"
        fi
        ;;
esac
