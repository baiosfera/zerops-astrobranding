#!/usr/bin/env python3
"""
Apotelos Universal CLI — Sovereign Reverse Causality & Multi-Agent Mesh
Part of Zerops Astrobranding & Universal Upstream Tooling.
"""

import os
import sys
import json
import re
import zipfile
import xml.etree.ElementTree as ET
import argparse
import urllib.request
import urllib.error
from pathlib import Path
from typing import Dict, Any, Optional

try:
    from pydantic import BaseModel, Field
except ImportError:
    print("❌ Error: pydantic is required for apotelos CLI. Run 'pip install pydantic' or execute inside container.")
    sys.exit(1)

# --- MODELS & SCHEMAS ---

class CommercialFunnelType:
    DIRECT_CHECKOUT = "direct_checkout"
    LEAD_GENERATION = "lead_generation"
    BOOKING_CALENDAR = "booking_calendar"
    SUBSCRIPTION = "subscription"
    CONTENT_COMMUNITY = "content_community"

class DynamicVerticalSpec(BaseModel):
    vertical_slug: str
    display_name: str
    funnel_type: str = CommercialFunnelType.DIRECT_CHECKOUT
    target_avatar: Dict[str, Any] = Field(default_factory=dict)
    unique_mechanism: Dict[str, Any] = Field(default_factory=dict)
    primary_offer: Dict[str, Any] = Field(default_factory=dict)
    conversion_events: list = Field(default_factory=list)
    metadata: Dict[str, Any] = Field(default_factory=dict)

class UniversalBrandEcosystem(BaseModel):
    brand_slug: str
    umbrella_name: Optional[str] = None
    design_tokens_ref: Optional[str] = "brandbook.json"
    verticals: Dict[str, DynamicVerticalSpec] = Field(default_factory=dict)

# --- CASCADING DISCOVERY ---

def get_workspace_root() -> Path:
    # Priority: current dir or standard /var/www / repo paths
    candidates = [Path.cwd(), Path("/var/www/zerops-astrobranding"), Path("/var/www")]
    for c in candidates:
        if (c / "brandbook.json").exists() or (c / ".apotelos").exists() or (c / "zerops.yaml").exists():
            return c
    return Path.cwd()

def get_local_storage_path() -> Path:
    env_path = os.getenv("LOCAL_STORAGE_PATH")
    if env_path and Path(env_path).exists():
        return Path(env_path)
    if Path("/mnt/localstorage").exists():
        return Path("/mnt/localstorage")
    if Path("/var/www/localstorage").exists():
        return Path("/var/www/localstorage")
    return Path("/tmp/localstorage")

def extract_verticals_from_files(v_dir: Path):
    verticals = {}
    brand_name = None
    source_files = []

    # Check parent hierarchy for brandbook.json
    for p in [v_dir, v_dir.parent, v_dir.parent.parent]:
        bb = p / "brandbook.json"
        if bb.exists():
            try:
                bd = json.loads(bb.read_text("utf-8"))
                brand_name = bd.get("metadata", {}).get("brand_name") or bd.get("identity", {}).get("brandName")
                if brand_name:
                    break
            except Exception:
                pass
    if not brand_name:
        brand_name = v_dir.parent.parent.name if v_dir.name in ("verticals", "dev") else v_dir.name

    ignore_words = {"tierra", "agua", "fuego", "aire", "éter", "eter", "material", "mental", "espiritual", "social", "emocional", "intelectual", "faceta", "firma", "elemento", "plano", "vibracion", "vibración", "proyecto"}

    for f in sorted(v_dir.iterdir()):
        if f.name.startswith("."):
            continue
        if f.suffix == ".docx":
            try:
                with zipfile.ZipFile(f) as z:
                    txt = "".join(ET.fromstring(z.read("word/document.xml")).itertext())
                source_files.append(f.name)
                # Table rows: | col1 | col2 | col3 | col4 |
                rows = re.findall(r'\|\s*([^|\n]+)\s*\|\s*([^|\n]+)\s*\|\s*([^|\n]+)\s*\|\s*([^|\n]+)\s*\|', txt)
                for r in rows:
                    c1, c2, c3, c4 = [c.strip() for c in r]
                    for cand in [c3, c2, c1]:
                        cand_clean = cand.split("(")[0].strip()
                        words = [w.lower() for w in re.findall(r'\w+', cand_clean)]
                        if not words or all(w in ignore_words for w in words):
                            continue
                        if "/" in cand_clean or any(k in cand_clean for k in ["Damaren", "Kreiss", "Sankana", "Bioenka", "Exhalah"]):
                            if any(bad in cand_clean.lower() for bad in ["escritor", "cantante", "tierra", "eter"]):
                                continue
                            slug = re.sub(r'[^a-z0-9]+', '-', cand_clean.lower().split('/')[0].strip()).strip('-')
                            if slug and slug not in verticals and len(slug) > 2 and slug not in ignore_words:
                                fn = CommercialFunnelType.BOOKING_CALENDAR if any(k in cand_clean for k in ["Damaren", "Mentor"]) else (CommercialFunnelType.CONTENT_COMMUNITY if any(k in cand_clean for k in ["Kreiss", "Bioenka"]) else CommercialFunnelType.LEAD_GENERATION)
                                verticals[slug] = DynamicVerticalSpec(
                                    vertical_slug=slug,
                                    display_name=cand_clean,
                                    funnel_type=fn,
                                    target_avatar={"source_document": f.name},
                                    unique_mechanism={"name": f"Firma {cand_clean}"},
                                    primary_offer={"structure": f"Oferta {cand_clean}"},
                                    conversion_events=["Purchase" if fn == CommercialFunnelType.DIRECT_CHECKOUT else ("Schedule" if fn == CommercialFunnelType.BOOKING_CALENDAR else "Lead")]
                                )
                                break
            except Exception as e:
                print(f"⚠️ Warning reading docx {f.name}: {e}")
        elif f.suffix == ".pdf":
            source_files.append(f.name)
            title = f.stem.replace("Que es ", "").replace("que es ", "").strip().title()
            slug = re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-')
            if slug and slug not in verticals:
                verticals[slug] = DynamicVerticalSpec(
                    vertical_slug=slug,
                    display_name=title,
                    funnel_type=CommercialFunnelType.LEAD_GENERATION,
                    target_avatar={"source_document": f.name},
                    unique_mechanism={"name": f"Tesis {title}"},
                    primary_offer={"structure": f"Programa {title}"},
                    conversion_events=["Lead"]
                )
        elif f.suffix in (".md", ".txt"):
            source_files.append(f.name)
            title = f.stem.replace("-", " ").replace("_", " ").title()
            slug = re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-')
            if slug and slug not in verticals:
                verticals[slug] = DynamicVerticalSpec(
                    vertical_slug=slug,
                    display_name=title,
                    funnel_type=CommercialFunnelType.LEAD_GENERATION,
                    target_avatar={"source_document": f.name},
                    unique_mechanism={"name": f"Metodología {title}"},
                    primary_offer={"structure": f"Oferta {title}"},
                    conversion_events=["Lead"]
                )

    if verticals:
        return UniversalBrandEcosystem(
            brand_slug=brand_name.lower().replace(" ", "-"),
            umbrella_name=brand_name,
            verticals=verticals
        ), f"{v_dir} ({', '.join(source_files)})"
    return None, None

def discover_ecosystem(target: Optional[str] = None) -> tuple[UniversalBrandEcosystem, Optional[str]]:
    root = get_workspace_root()
    ls_path = get_local_storage_path()
    project_env = os.getenv("PROJECT_NAME", "")
    
    # 0. Explicit Target Path or Project Name (Priority 1)
    if target:
        tp = Path(target)
        if tp.exists() and tp.is_dir():
            eco, sinfo = extract_verticals_from_files(tp)
            if eco:
                return eco, sinfo
        # Try resolving as project name
        for base in [Path("/var/www/baiosfera/PROYECTOS"), ls_path]:
            for candidate_dir in [
                base / target / "dev" / "verticals",
                base / target / "verticals",
                base / target.upper() / "dev" / "verticals",
                base / target.upper() / "verticals"
            ]:
                if candidate_dir.exists() and candidate_dir.is_dir():
                    eco, sinfo = extract_verticals_from_files(candidate_dir)
                    if eco:
                        return eco, sinfo

    # 0b. Auto-detect verticals/ directory in active project
    if project_env:
        for base in [Path("/var/www/baiosfera/PROYECTOS"), ls_path]:
            for c_dir in [
                base / project_env / "dev" / "verticals",
                base / project_env / "verticals",
                base / project_env.upper() / "dev" / "verticals",
                base / project_env.upper() / "verticals"
            ]:
                if c_dir.exists() and c_dir.is_dir():
                    eco, sinfo = extract_verticals_from_files(c_dir)
                    if eco:
                        return eco, sinfo

    # 1. Native .apotelos/ecosystem.json or .yaml
    p1_json = root / ".apotelos" / "ecosystem.json"
    if p1_json.exists():
        try:
            data = json.loads(p1_json.read_text(encoding="utf-8"))
            return UniversalBrandEcosystem.model_validate(data), str(p1_json)
        except Exception as e:
            print(f"⚠️ Warning: Error parsing {p1_json}: {e}")

    # 2. brandbook.json in workspace or localstorage (Dynamic Project Resolution)
    project_env = os.getenv("PROJECT_NAME", "")
    bb_candidates = [
        root / "brandbook.json",
        ls_path / project_env / "dev" / "brandbook.json",
        ls_path / project_env / "brandbook.json",
        ls_path / "CATALINAGLAMUR" / "dev" / "brandbook.json",
        ls_path / "brand" / "brandbook.json"
    ]
    # Scan localstorage subdirs if not found yet
    if ls_path.exists():
        for sub in ls_path.iterdir():
            if sub.is_dir() and (sub / "dev" / "brandbook.json").exists():
                bb_candidates.append(sub / "dev" / "brandbook.json")

    for bb_path in bb_candidates:
        if bb_path and bb_path.exists():
            try:
                bb_data = json.loads(bb_path.read_text(encoding="utf-8"))
                brand_name = bb_data.get("metadata", {}).get("brand_name") or bb_data.get("identity", {}).get("brandName", bb_data.get("brand_name", ""))
                if not brand_name and project_env:
                    brand_name = project_env
                if brand_name:
                    brand_slug = brand_name.lower().replace(" ", "-")
                    verticals_dict = {}
                    if "verticals" in bb_data and isinstance(bb_data["verticals"], dict):
                        for vslug, vdata in bb_data["verticals"].items():
                            vdata["vertical_slug"] = vslug
                            if "display_name" not in vdata:
                                vdata["display_name"] = vslug.replace("-", " ").title()
                            verticals_dict[vslug] = DynamicVerticalSpec.model_validate(vdata)
                    else:
                        # Auto-infer root vertical for the actual identified brand
                        verticals_dict["root_vertical"] = DynamicVerticalSpec(
                            vertical_slug="root_vertical",
                            display_name=f"{brand_name} Principal",
                            funnel_type=CommercialFunnelType.DIRECT_CHECKOUT,
                            target_avatar={"pain_points": ["Dolor de avatar no registrado"], "desires": ["Transformación de marca"]},
                            unique_mechanism={"name": f"Mecanismo {brand_name}", "contrast": "Alternativas convencionales"},
                            primary_offer={"structure": "Catálogo Directo", "pricing": {"currency": "COP", "amount": 0}},
                            conversion_events=["Purchase", "InitiateCheckout"]
                        )
                    return UniversalBrandEcosystem(brand_slug=brand_slug, umbrella_name=brand_name, verticals=verticals_dict), str(bb_path)
            except Exception as e:
                print(f"⚠️ Warning: Error reading brandbook from {bb_path}: {e}")

    # 3. Persistent LocalStorage NVMe
    p3 = ls_path / "brand" / "ecosystem.json"
    if p3.exists():
        try:
            data = json.loads(p3.read_text(encoding="utf-8"))
            return UniversalBrandEcosystem.model_validate(data), str(p3)
        except Exception:
            pass

    # 4. Zero-Config Fallback (Auto-Inferred root_vertical)
    default_name = root.name if root.name not in ("www", "var") else "default-brand"
    return UniversalBrandEcosystem(
        brand_slug=default_name.lower().replace(" ", "-"),
        umbrella_name=default_name.title(),
        verticals={
            "root_vertical": DynamicVerticalSpec(
                vertical_slug="root_vertical",
                display_name=f"{default_name.title()} Principal",
                funnel_type=CommercialFunnelType.DIRECT_CHECKOUT,
                target_avatar={"pain_points": ["Genérico / Auto-inferido"], "desires": ["Solución directa"]},
                unique_mechanism={"name": "Mecanismo Central", "contrast": "Alternativas genéricas"},
                primary_offer={"structure": "Oferta Base", "pricing": {"currency": "COP", "amount": 0}},
                conversion_events=["Purchase"]
            )
        }
    ), "Zero-config fallback (directorio local)"

# --- SUBCOMMAND IMPLEMENTATIONS ---

def cmd_list(args):
    target = getattr(args, "target", None) or getattr(args, "path_opt", None)
    eco, sinfo = discover_ecosystem(target=target)
    print(f"\n🏛️ Ecosistema Activo: [{eco.brand_slug}] — Matriz: {eco.umbrella_name or 'Mono-marca'}")
    if sinfo:
        print(f"📁 Fuente Primaria: {sinfo}")
    print("=" * 70)
    print(f"{'SLUG':<20} | {'DISPLAY NAME':<25} | {'FUNNEL TYPE':<18}")
    print("-" * 70)
    for slug, vert in eco.verticals.items():
        print(f"{slug:<20} | {vert.display_name:<25} | {vert.funnel_type:<18}")
    print("=" * 70)
    print(f"Total: {len(eco.verticals)} vertical(es) descubierta(s) en cascada.\n")

def cmd_add_vertical(args):
    root = get_workspace_root()
    apotelos_dir = root / ".apotelos"
    apotelos_dir.mkdir(parents=True, exist_ok=True)
    eco_file = apotelos_dir / "ecosystem.json"

    eco, _ = discover_ecosystem()
    slug = args.slug.lower().strip()
    name = args.name or slug.replace("-", " ").title()
    funnel = args.funnel or CommercialFunnelType.DIRECT_CHECKOUT

    new_vert = DynamicVerticalSpec(
        vertical_slug=slug,
        display_name=name,
        funnel_type=funnel,
        target_avatar={"pain_points": ["Definir dolor raíz"], "desires": ["Definir transformación"]},
        unique_mechanism={"name": f"Mecanismo {name}", "contrast": "Frente a competidores"},
        primary_offer={"structure": f"Oferta {name}", "pricing": {"currency": "COP", "amount": 100000}},
        conversion_events=["Purchase" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else "Lead"]
    )
    eco.verticals[slug] = new_vert
    
    with open(eco_file, "w", encoding="utf-8") as f:
        json.dump(eco.model_dump(), f, indent=2, ensure_ascii=False)
    
    print(f"✅ Vertical '{slug}' ({name}) registrada con éxito en: {eco_file}")

def cmd_audit(args):
    target = getattr(args, "brand", None) or getattr(args, "target", None)
    eco, sinfo = discover_ecosystem(target=target)
    target_v = args.vertical
    if not target_v:
        target_v = list(eco.verticals.keys())[0] if eco.verticals else "root_vertical"
    
    if target_v not in eco.verticals:
        print(f"❌ Error: Vertical '{target_v}' no encontrada en el ecosistema. Disponibles: {list(eco.verticals.keys())}")
        sys.exit(1)

    vert = eco.verticals[target_v]
    print(f"\n🔍 Auditando Contrato Estático Pydantic para: [{eco.brand_slug}] -> [{vert.vertical_slug}]")
    if sinfo:
        print(f"📁 Fuente: {sinfo}")
    print("-" * 60)
    
    # Assertions
    errors = []
    if not vert.unique_mechanism.get("name"):
        errors.append("unique_mechanism.name está vacío o no definido")
    if not vert.primary_offer.get("structure"):
        errors.append("primary_offer.structure está vacío")
    if not vert.target_avatar.get("pain_points"):
        errors.append("target_avatar.pain_points no contiene dolores listados")

    if errors:
        print("❌ Fallas de contrato detectadas:")
        for err in errors:
            print(f"  • {err}")
        sys.exit(1)
    
    print("✅ Contrato Pydantic v2 validado al 100% (exit code 0)")
    print(f"  • Display Name: {vert.display_name}")
    print(f"  • Funnel Type:  {vert.funnel_type}")
    print(f"  • Mecanismo:    {vert.unique_mechanism.get('name')}")
    print(f"  • Eventos Tele: {vert.conversion_events}\n")

def cmd_plan(args):
    target = getattr(args, "brand", None) or getattr(args, "target", None)
    eco, sinfo = discover_ecosystem(target=target)
    target_v = args.vertical or (list(eco.verticals.keys())[0] if eco.verticals else "root_vertical")
    vert = eco.verticals.get(target_v)
    if not vert:
        print(f"❌ Vertical '{target_v}' no existe.")
        sys.exit(1)

    print(f"\n🗺️ Árbol de Regresión Causal Inversa (Apoτέlοs): [{eco.brand_slug}:{vert.vertical_slug}]")
    print("=" * 65)
    print("Dominó 4 (τε-Final): Conversión y Cobro")
    print(f"  └── Funnel: {vert.funnel_type} | Oferta: {vert.primary_offer.get('structure')}")
    print("Dominó 3 (τε-1): Telemetría y Atribución")
    print(f"  └── Eventos: {vert.conversion_events} | CAPI, TikTok & GTM 1st-party cookies")
    print("Dominó 2 (τε-2): Descubrimiento AI-First & SEO Semántico")
    print(f"  └── /llms.txt + Schema.org @graph ({'Product' if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT else 'LocalBusiness'})")
    print("Dominó 1 (τε-3): Copywriting Neuro-persuasivo & Ganchos de 3s")
    print(f"  └── Avatar: {vert.target_avatar.get('pain_points', ['Dolor base'])[0]}")
    print("Dominó 0 (τε-0): El Primer Dominó — Mecanismo Único Monopolístico")
    print(f"  └── Monopolio: {vert.unique_mechanism.get('name')}")
    print("=" * 65 + "\n")

def check_service_health(url: str, timeout_sec: float = 2.0) -> bool:
    try:
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=timeout_sec) as response:
            return response.status in (200, 204)
    except Exception:
        return False

def cmd_run(args):
    target = getattr(args, "brand", None) or getattr(args, "target", None)
    eco, _ = discover_ecosystem(target=target)
    target_v = args.vertical or (list(eco.verticals.keys())[0] if eco.verticals else "root_vertical")
    vert = eco.verticals.get(target_v)
    if not vert:
        print(f"❌ Vertical '{target_v}' no existe.")
        sys.exit(1)

    hermes_url = os.getenv("HERMES_API_URL", "http://hermes:8000")
    bifrost_url = os.getenv("BIFROST_API_URL", "http://bifrost:8080")

    print(f"\n🚀 Despachando Pipeline Apotelos para: [{eco.brand_slug}:{vert.vertical_slug}]")
    print(f"🔍 Verificando salud de runtimes en Zerops ({hermes_url}, {bifrost_url})...")

    hermes_alive = check_service_health(f"{hermes_url}/healthz")
    bifrost_alive = check_service_health(f"{bifrost_url}/health") or check_service_health(f"{bifrost_url}/")

    if not hermes_alive or not bifrost_alive:
        print("⚠️ Advertencia: Uno o más runtimes requeridos se encuentran detenidos o inaccesibles:")
        if not hermes_alive:
            print(f"  • hermes ({hermes_url}): NO RESPONDE (STOPPED)")
        if not bifrost_alive:
            print(f"  • bifrost ({bifrost_url}): NO RESPONDE (STOPPED)")
        print("\n💡 Remediación Autónoma:")
        print("  Como plano de control ZCP, ejecutá:")
        print("  zerops_manage(action='start', serviceHostname='bifrost')")
        print("  zerops_manage(action='start', serviceHostname='hermes')\n")
        sys.exit(1)

    # Dispatch to Hermes /v1/runs
    run_payload = {
        "crew_name": "apotelos",
        "input": f"Ejecutar protocolo Apotelos inverso para la vertical '{vert.vertical_slug}' de la marca '{eco.brand_slug}'.",
        "tier": args.tier or "free",
        "context": {
            "brand_slug": eco.brand_slug,
            "vertical": vert.model_dump(),
            "linear_issue": args.linear_issue
        }
    }
    
    try:
        req = urllib.request.Request(
            f"{hermes_url}/v1/runs",
            data=json.dumps(run_payload).encode("utf-8"),
            headers={"Content-Type": "application/json", "X-Crew-Name": "apotelos"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=10.0) as resp:
            res_data = json.loads(resp.read().decode("utf-8"))
            print(f"✅ Run despachado exitosamente a Hermes!")
            print(f"  • Run ID:  {res_data.get('id', res_data.get('run_id'))}")
            print(f"  • Status:  {res_data.get('status')}")
            print(f"  • Monitor: {hermes_url}/v1/runs/{res_data.get('id')}/events\n")
    except Exception as ex:
        print(f"❌ Error despachando run a Hermes: {ex}")
        sys.exit(1)

# --- CLI ENTRYPOINT ---

def main():
    parser = argparse.ArgumentParser(
        prog="apotelos",
        description="Apotelos CLI: Sovereign Reverse Causality & Multi-Agent Mesh for Zerops"
    )
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # list
    p_list = subparsers.add_parser("list", help="Lista las marcas y verticales descubiertas en cascada")
    p_list.add_argument("target", nargs="?", default=None, help="Ruta específica o proyecto a inspeccionar")
    p_list.add_argument("--path", "-p", dest="path_opt", default=None, help="Ruta explícita al directorio de verticales")
    p_list.set_defaults(func=cmd_list)

    # add-vertical
    p_add = subparsers.add_parser("add-vertical", help="Agrega una nueva vertical al ecosistema")
    p_add.add_argument("slug", help="Slug único de la vertical (kebab-case)")
    p_add.add_argument("--name", help="Nombre descriptivo de la vertical")
    p_add.add_argument("--funnel", choices=[
        CommercialFunnelType.DIRECT_CHECKOUT,
        CommercialFunnelType.LEAD_GENERATION,
        CommercialFunnelType.BOOKING_CALENDAR,
        CommercialFunnelType.SUBSCRIPTION,
        CommercialFunnelType.CONTENT_COMMUNITY
    ], default=CommercialFunnelType.DIRECT_CHECKOUT)
    p_add.set_defaults(func=cmd_add_vertical)

    # audit
    p_audit = subparsers.add_parser("audit", help="Audita el contrato estático Pydantic de una vertical")
    p_audit.add_argument("--brand", help="Slug de la marca (opcional)")
    p_audit.add_argument("--vertical", help="Slug de la vertical a auditar")
    p_audit.set_defaults(func=cmd_audit)

    # plan
    p_plan = subparsers.add_parser("plan", help="Muestra el árbol de regresión causal inverso")
    p_plan.add_argument("--brand", help="Slug de la marca (opcional)")
    p_plan.add_argument("--vertical", help="Slug de la vertical a planificar")
    p_plan.set_defaults(func=cmd_plan)

    # run
    p_run = subparsers.add_parser("run", help="Despacha el pipeline causal hacia Hermes/CrewAI")
    p_run.add_argument("--brand", help="Slug de la marca (opcional)")
    p_run.add_argument("--vertical", help="Slug de la vertical a ejecutar")
    p_run.add_argument("--tier", choices=["free", "pro"], default="free", help="Tier de inferencia en Bifrost")
    p_run.add_argument("--linear-issue", help="ID del ticket Linear (ej: BAI-439)")
    p_run.add_argument("--headless", action="store_true", help="Ejecución desatendida sin prompts interactivos")
    p_run.set_defaults(func=cmd_run)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
