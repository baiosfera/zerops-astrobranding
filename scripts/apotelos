                {"cluster_id": "c2", "search_intent": "i2", "primary_keyword": "k2", "landing_route": "/", "funnel_stage": "bofu"},
            ],
            "links": [{
                "link_id": "l1", "cluster_id": "missing", "ad_angle": "x",
