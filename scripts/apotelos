        if "metodologia-nexus" in eco.verticals:
            errors.append("Error de jerarquía: 'metodologia-nexus' fue tratada como vertical en vez de subtema")

        av = eco.verticals.get("aurelius-vance")
        if av:
            if not getattr(av, "subthemes", None) or "Metodologia Nexus" not in av.subthemes:
                errors.append(f"Subtemas no detectados en aurelius-vance: {getattr(av, 'subthemes', [])}")

        srv = eco.verticals.get("cloud-y-optimizacion")
        if srv:
            tiers = srv.primary_offer.get("pricing_tiers", [])
            if not tiers:
                errors.append("No se extrajeron los pricing tiers agnósticos del servicio")

        cs = eco.verticals.get("cloudsphere")
        if cs:
            if cs.custom_domain != "cloudsphere.io":
                errors.append(f"Dominio incorrecto para cloudsphere: {cs.custom_domain}")

        ok_chain, chain_errs = validate_concatenation_matrix({
