def compile_blackboard_manifest(eco: UniversalBrandEcosystem, vert: DynamicVerticalSpec) -> ApotelosManifest:
    """Compile the authoritative Reverse Causality Blackboard Manifest (τε-Final -> τε-0)."""
    ts = datetime.now(timezone.utc).isoformat()
    currency = vert.primary_offer.get("pricing", {}).get("currency") or os.getenv("DEFAULT_CURRENCY", "USD")

    # Polymorphic Messaging Ecosystem (TOFU / MOFU / BOFU / Post-Conversion)
    messaging_obj = vert.messaging_flows or build_default_messaging_spec(vert.funnel_type, currency=currency)
    messaging = messaging_obj.model_dump()

    # Domino 4 (τε-Final): Conversión y Cobro
    if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT:
        gateways = ["wompi", "cod_otp"]
        webhook_path = "/api/webhooks/orders"
    elif vert.funnel_type == CommercialFunnelType.READY_NOW_BIFURCATED_SLO_APPLICATION:
        gateways = ["iionpay", "dlocalgo", "booking_calendar"]
        webhook_path = "/api/webhooks/orders"
    else:
        gateways = ["booking_calendar", "whatsapp_direct"]
        webhook_path = "/api/webhooks/leads"

    deployment = {
        "funnel_type": vert.funnel_type,
        "offer_structure": vert.primary_offer.get("structure", f"Oferta {vert.display_name}"),
        "currency": currency,
        "gateways": gateways,
        "post_purchase_webhook": webhook_path
    }

    # Domino 3 (τε-1): Telemetría y Atribución
    telemetry = {
        "funnel_type": vert.funnel_type,
        "events": vert.conversion_events,
        "capi_enabled": True,
        "hash_algorithm": "SHA-256",
        "cookie_1st_party": "__attr_session",
        "cookie_ttl_days": 90,
        "consent_mode_v2": "default_denied"
    }

    # Domino 2 (τε-2): Descubrimiento AI-First & SEO
    schema_type = (
        "Product"
        if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT
        else ("LocalBusiness" if vert.funnel_type == CommercialFunnelType.LOCAL_SERVICE else "ProfessionalService")
    )
    seo_aeo = {
        "llms_txt": {
            "entity_name": vert.display_name,
            "category": "Servicios Profesionales y Sistemas Digitales",
            "url_slug": f"/{vert.vertical_slug}"
        },
        "schema_org": {
            "@context": "https://schema.org",
            "@type": schema_type,
            "name": vert.display_name,
            "description": vert.unique_mechanism.get("name", f"Metodología {vert.display_name}")
        }
    }

    # Domino 1 (τε-3): Copywriting & Oferta Irresistible
    avatar_pain = vert.target_avatar.get("pain_points", ["Frustración con alternativas genéricas"])[0]
    copy_m = {
        "hook_3s": f"¿Cansado de {avatar_pain.lower()}? Descubre cómo resolverlo con sistemas propios.",
        "hormozi_equation": {
            "dream_outcome": f"Dominio absoluto y transformación con {vert.display_name}",
            "perceived_likelihood": "Validado con metodología de categoría única",
            "time_delay": "Implementación inmediata",
            "effort_and_sacrifice": "Cero fricción y acompañamiento directo"
        },
        "risk_reversal_guarantee": "Garantía de satisfacción incondicional de 30 días"
    }

    # Domino 0 (τε-0): Mecanismo Único Monopolístico
    coo_path = resolve_playbook_path("00_category_of_one.md")
    p_dir = resolve_playbooks_dir()
    grounding = {
        "brand_slug": eco.brand_slug,
        "umbrella_name": eco.umbrella_name,
        "vertical_slug": vert.vertical_slug,
        "mechanism_name": vert.unique_mechanism.get("name", f"Mecanismo {vert.display_name}"),
        "contrast": vert.unique_mechanism.get("contrast", "Frente a soluciones genéricas del mercado"),
        "category_of_one_playbook": str(coo_path) if coo_path else None,
        "playbooks_dir": str(p_dir) if p_dir else None
    }

    # Domain & Infrastructure Spec (Zerops L7 Balancer Shared IP Architecture)
    domain_strat = getattr(vert, "domain_strategy", "subroute")
    custom_dom = getattr(vert, "custom_domain", None)
    domain_spec = {
        "strategy": domain_strat,
        "custom_domain": custom_dom or f"{vert.vertical_slug}.{eco.brand_slug}.com",
        "zerops_ip_sharing": "L7_HTTP_BALANCER_SHARED_IP",
        "ip_cost_delta": "$0",
        "cloudflare_ssl_mode": "Full (strict)",
        "routing_mechanism": "Host-header middleware rewrite" if domain_strat == "multi_tenant_astro" else ("Independent Zerops LXC runtime" if domain_strat == "isolated_runtime" else "Standard Astro route")
    }

    return ApotelosManifest(
        brand_slug=eco.brand_slug,
        vertical_slug=vert.vertical_slug,
        timestamp=ts,
        grounding=grounding,
        copy_manifest=copy_m,
        seo_aeo_spec=seo_aeo,
        telemetry_spec=telemetry,
        deployment_spec=deployment,
        messaging_spec=messaging,
        domain_spec=domain_spec
    )


def generate_markdown_dossier(eco: UniversalBrandEcosystem, output_path: Optional[Path] = None) -> Path:
    """
    Compiles an exhaustive SSoT Markdown Dossier of approved verticals, mechanisms,
    offers, and domain routing topology. Persisted so other agents (Hermes, CrewAI, Pidev)
    and human architects have an immutable reference with zero exploratory token burn.
    """
    ts = datetime.now(timezone.utc).isoformat()
    brand_title = eco.umbrella_name or eco.brand_slug.replace("-", " ").title()

    if not output_path:
        root = get_workspace_root()
        dossier_dir = root / ".apotelos" / "dossiers"
        dossier_dir.mkdir(parents=True, exist_ok=True)
        output_path = dossier_dir / f"{eco.brand_slug}_approved_dossier.md"

    # Mirror to persistent localstorage if available
    ls_path = get_local_storage_path()
    ls_mirror_path = None
    if ls_path.exists():
        ls_dossier_dir = ls_path / "dossiers"
        try:
            ls_dossier_dir.mkdir(parents=True, exist_ok=True)
            ls_mirror_path = ls_dossier_dir / f"{eco.brand_slug}_approved_dossier.md"
        except Exception:
            pass

    md_lines = [
        f"# DOSSIER SSoT: {brand_title} (`{eco.brand_slug}`)",
        "> **Compilado por Protocolo Apotelos (Reversa Causal τε-Final -> τε-0)**",
        f"> **Timestamp UTC:** `{ts}` | **Estado:** `APPROVED (SSoT)` | **Matriz:** `{brand_title}`",
        "",
        "---",
        "",
        "## 1. Topología de Infraestructura y Dominios (Zerops + Cloudflare)",
        "",
        "| Parámetro | Configuración Canónica | Justificación Técnica |",
        "|---|---|---|",
        "| **Política de IP Zerops** | **1 sola IP L7 Balancer ($3 USD/mes)** | El L7 Balancer de Zerops (Nginx HA) rutea múltiples dominios por SNI/Host. Cero costo de IP extra. |",
        "| **Modo SSL Cloudflare** | **Full (strict)** | Cifra extremo a extremo (Edge Cloudflare <-> L7 Balancer Zerops) evitando bucles de redirección. |",
        "| **Impacto en SEO** | **CERO (Neutro / Aislado)** | Cada dominio tiene su propio `canonical`, `sitemap.xml` y `robots.txt`. IP compartida es estándar universal. |",
        "",
        "### Matriz de Dominios por Vertical:",
        "| Vertical Slug | Display Name | Estrategia de Dominio | Dominio Asignado / FQDN | Mecanismo de Enrutamiento |",
        "|---|---|---|---|---|"
    ]

    for slug, v in eco.verticals.items():
        dom_strat = getattr(v, "domain_strategy", "subroute")
        c_dom = getattr(v, "custom_domain", None) or f"{slug}.{eco.brand_slug}.com"
        mech_route = "Astro `middleware.ts` host rewrite" if dom_strat == "multi_tenant_astro" else ("Runtime Bun LXC dedicado" if dom_strat == "isolated_runtime" else "Subruta estándar")
        md_lines.append(f"| `{slug}` | {v.display_name} | `{dom_strat}` | `{c_dom}` | {mech_route} |")

    md_lines.extend([
        "",
        "---",
        "",
        "## 2. Registro Maestro de Verticales de Negocio Aprobadas",
        "",
        "| Slug | Funnel Type | Mecanismo Único (τε-0) | Oferta Irresistible (τε-Final) | Eventos Telemetría (τε-1) | Schema.org (τε-2) |",
        "|---|---|---|---|---|---|"
    ])

    for slug, v in eco.verticals.items():
        funnel = v.funnel_type
        mech = v.unique_mechanism.get("name", f"Mecanismo {v.display_name}")
        offer = v.primary_offer.get("structure", f"Oferta {v.display_name}")
        events = ", ".join(v.conversion_events) if v.conversion_events else "Lead"
        schema_t = "Product" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else "LocalBusiness"
        md_lines.append(f"| `{slug}` | `{funnel}` | **{mech}** | {offer} | `{events}` | `{schema_t}` |")

    md_lines.extend([
        "",
        "---",
        "",
        "## 3. Descomposición Causal Inversa (Los 5 Dominós)",
        "",
        "El alcance técnico de cada vertical se descompone según la regresión causal inmutable (τε-Final -> τε-0).",
        "Los tickets en Linear se generan dinámicamente según la necesidad real de la iniciativa, sin plantillas rígidas:",
        "",
        "```mermaid",
        "flowchart RL",
        "    D4[\"Dominó 4 (τε-Final): Conversión & Cobro<br>Checkout, pasarelas o booking calendar\"] --> D3[\"Dominó 3 (τε-1): Telemetría & Atribución<br>CAPI SHA-256 + 1st-party cookie 90d\"]",
        "    D3 --> D2[\"Dominó 2 (τε-2): Descubrimiento AI/SEO<br>/llms.txt + Schema.org @graph\"]",
        "    D2 --> D1[\"Dominó 1 (τε-3): Copywriting & Oferta<br>Hook 3s + Hormozi Equation\"]",
        "    D1 --> D0[\"Dominó 0 (τε-0): Mecanismo Único<br>00_category_of_one.md\"]",
        "```",
        "",
        "- **Dominó 0 (τε-0)**: Mecanismo Único Monopolístico y Category of One (`grounding`).",
        "- **Dominó 1 (τε-3)**: Ganchos de 3 segundos, desglose de objeciones y ecuación de valor de Hormozi.",
        "- **Dominó 2 (τε-2)**: Grafo Schema.org tipado, endpoints `/llms.txt` y metadatos semánticos.",
        "- **Dominó 3 (τε-1)**: Dispatcher CAPI, Google Consent Mode v2 y cookie `__attr_session` a 90 días.",
        "- **Dominó 4 (τε-Final)**: Maquetación de página Astro 5 SSR (`scaffold`), Server Actions y pasarelas.",
        "",
        "---",
        "",
        "## 4. Handover para Hermes-Agent, CrewAI y Pidev",
        "",
        "> [!IMPORTANT]",
        "> **Directiva Anti-Token Burn para Agentes**: Los agentes en runtimes secundarios (`hermes`, `pidev`) NO deben",
        "> volver a analizar archivos DOCX/PDF ni redescubrir verticales. Este documento y los manifiestos en",
        "> `/.apotelos/manifests/*.json` son la Verdad Inmutable Aprobada por el Arquitecto.",
        "",
        "- **Hermes-Agent (Python)**: Leer `/var/www/localstorage/manifests/{brand}_{vertical}.json`. Usar `pydantic-ai` para gobernar las cuadrillas CrewAI conectadas a Bifrost / FreeLLMAPI ($0 tokens) y validar mutaciones GraphQL en Linear.",
        "- **Pidev (Astro / Gentle-Pi)**: Leer `deployment_spec` y materializar componentes en `src/pages/` usando Astro Actions con validación Zod nativa (`import { z } from 'astro/zod'`) e hidratando `templates/astro/`.",
        ""
    ])

    content = "\n".join(md_lines)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(content, encoding="utf-8")

    if ls_mirror_path:
        try:
            ls_mirror_path.write_text(content, encoding="utf-8")
        except Exception:
            pass

    return output_path


# =====================================================================
# 5b. ASTRO 5 SSR CODE SCAFFOLDING & MATERIALIZATION (No Bare Skeletons)
# =====================================================================

def resolve_scaffold_target_dir(brand_slug: str, custom_output_dir: Optional[str] = None, vertical_slug: Optional[str] = None) -> Path:
    """
    Resolve the target directory for Astro 5 SSR scaffolding.
    Never writes into upstream chassis (/var/www/zerops-astrobranding) or creates
    unrequested global apps/ folders when a workspace web/ folder exists.
    """
    if custom_output_dir:
        p = Path(custom_output_dir)
        p.mkdir(parents=True, exist_ok=True)
        return p

    # 1. Active application runtime mount in Zerops
    for runtime_cand in [
        Path("/var/www/webdev/src/pages"),
        Path("/var/www/web/src/pages"),
        Path(f"/var/www/{brand_slug}-web/src/pages"),
        Path(f"/var/www/{brand_slug}/src/pages")
    ]:
        if runtime_cand.exists() and runtime_cand.is_dir():
            return runtime_cand

    # 2. Workspace web scaffold folder if project dev/workspaces/<vertical> exists
    ls_root = get_local_storage_path()
    proj = (os.getenv("PROJECT_NAME") or brand_slug).strip()
    if ls_root.exists():
        for ch in ls_root.iterdir():
            if ch.is_dir() and ch.name.lower() in (proj.lower(), brand_slug.lower()):
                vslug = (vertical_slug or brand_slug).lower()
                ws_web = ch / "dev" / "workspaces" / vslug / "web" / "scaffold" / "src" / "pages"
                if (ch / "dev" / "workspaces" / vslug).is_dir():
                    ws_web.mkdir(parents=True, exist_ok=True)
                    return ws_web

    # 3. Dedicated brand app workspace outside chassis
    brand_app_pages = Path(f"/var/www/apps/{brand_slug}/src/pages")
    if brand_app_pages.parent.exists():
        brand_app_pages.mkdir(parents=True, exist_ok=True)
        return brand_app_pages

    # 4. Persistent LocalStorage fallback (outside git chassis)
    ls_pages = ls_root / "apps" / brand_slug / "src" / "pages"
    ls_pages.mkdir(parents=True, exist_ok=True)
    return ls_pages


def scaffold_astro_page(
    manifest: ApotelosManifest,
    target_file: Path,
    route_mode: str = "subroute",
    as_root: bool = False
) -> Path:
    """Materialize production-ready Astro 5 SSR code from an Apotelos Blackboard manifest."""
    # Invariant: Block contamination of upstream chassis
    chassis_root = Path("/var/www/zerops-astrobranding")
    try:
        resolved_target = target_file.resolve()
        if chassis_root in resolved_target.parents and "apps/astrobranding" in str(resolved_target):
            raise ValueError(
                f"CONTAMINATION HAZARD: Cannot write brand page to upstream chassis '{target_file}'. "
                f"Use a dedicated app workspace (/var/www/webdev, /var/www/apps/{manifest.brand_slug}) or --output-dir."
            )
    except Exception as e:
        if "CONTAMINATION HAZARD" in str(e):
            raise

    target_file.parent.mkdir(parents=True, exist_ok=True)

    # Hydrate modular templates from templates/astro into target app workspace
    templates_astro = None
    for cand_t in [Path("/var/www/artifacts/templates/astro"), Path("/var/www/zerops-astrobranding/templates/astro")]:
        if cand_t.exists() and cand_t.is_dir():
            templates_astro = cand_t
            break

    app_src = None
    if target_file.parent.name == "pages" and target_file.parent.parent.name == "src":
        app_src = target_file.parent.parent
    elif "src" in [p.name for p in target_file.parents]:
        for p in target_file.parents:
            if p.name == "src":
                app_src = p
                break

    if templates_astro and app_src:
        comp_dir = app_src / "components"
        actions_dir = app_src / "actions"
        lib_dir = app_src / "lib"
        comp_dir.mkdir(parents=True, exist_ok=True)
        actions_dir.mkdir(parents=True, exist_ok=True)
        lib_dir.mkdir(parents=True, exist_ok=True)

        for comp in ["SeoHead.astro", "CookieConsent.astro"]:
            src_f = templates_astro / comp
            dst_f = comp_dir / comp
            if src_f.exists() and not dst_f.exists():
                shutil.copy2(src_f, dst_f)
        for act in ["ContactAction.ts"]:
            src_f = templates_astro / act
            dst_f = actions_dir / "contact.ts"
            if src_f.exists() and not dst_f.exists():
                shutil.copy2(src_f, dst_f)
        for lib in ["phone.ts", "discountStrategy.ts"]:
            src_f = templates_astro / lib
            dst_f = lib_dir / lib
            if src_f.exists() and not dst_f.exists():
                shutil.copy2(src_f, dst_f)

    brand_title = manifest.grounding.get("umbrella_name") or manifest.brand_slug.replace("-", " ").title()
    vert_title = manifest.seo_aeo_spec.get("schema_org", {}).get("name") or manifest.vertical_slug.replace("-", " ").title()
    page_title = f"{vert_title} — {brand_title}"
    page_desc = manifest.copy_manifest.get("hook_3s", f"Propuesta de {vert_title}")

    mechanism = manifest.grounding.get("mechanism_name", f"Mecanismo {vert_title}")
    contrast = manifest.grounding.get("contrast", "Frente a alternativas convencionales del mercado")

    funnel = manifest.deployment_spec.get("funnel_type", CommercialFunnelType.LEAD_GENERATION)
    offer_struct = manifest.deployment_spec.get("offer_structure", f"Oferta {vert_title}")
    guarantee = manifest.copy_manifest.get("risk_reversal_guarantee", "Garantía de satisfacción incondicional")
    dream_outcome = manifest.copy_manifest.get("hormozi_equation", {}).get("dream_outcome", f"Transformación completa con {vert_title}")
    hook_3s = manifest.copy_manifest.get("hook_3s", f"Descubre la solución definitiva con {vert_title}")

    cta_primary = "Comprar Ahora (Pago Seguro)" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else ("Agendar Cita en Calendario" if funnel == CommercialFunnelType.BOOKING_CALENDAR else "Iniciar Consulta por WhatsApp")
    checkout_url = f"/checkout?vertical={manifest.vertical_slug}" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else ("#agendar" if funnel == CommercialFunnelType.BOOKING_CALENDAR else "#whatsapp")

    schema_data = manifest.seo_aeo_spec.get("schema_org", {
        "@context": "https://schema.org",
        "@type": "Product" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else "LocalBusiness",
        "name": vert_title,
        "description": mechanism
    })
    schema_json = json.dumps(schema_data, indent=2, ensure_ascii=False)
    events_json = json.dumps(manifest.telemetry_spec.get("events", ["Lead"]))

    astro_content = f"""---
// =====================================================================
// Auto-generated by Apotelos Protocol (Reverse Causality τε-Final -> τε-0)
// Brand: {manifest.brand_slug} | Vertical: {manifest.vertical_slug}
// Route Mode: {route_mode} | Timestamp: {manifest.timestamp}
// =====================================================================

import BaseLayout from "../layouts/BaseLayout.astro";

const title = "{page_title}";
const description = "{page_desc.replace('"', '\\"')}";
const schemaData = {schema_json};
---

<BaseLayout title={{title}} description={{description}}>
  <!-- Domino 2: SEO Semántico & Knowledge Graph Schema.org -->
  <script type="application/ld+json" is:inline set:html={{JSON.stringify(schemaData)}} />

  <!-- Domino 3: Telemetría de Primera Parte (__attr_session & CAPI) -->
  <script is:inline define:vars={{{{ funnelType: "{funnel}", events: {events_json}, verticalSlug: "{manifest.vertical_slug}" }}}}>
    (function() {{
      const cookieKey = '__attr_session';
      if (!document.cookie.includes(cookieKey)) {{
        const sessId = 'sess_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now();
        document.cookie = `${{cookieKey}}=${{sessId}}; path=/; max-age=7776000; SameSite=Lax`;
      }}
      console.log(`[Apotelos Telemetry] Active on ${{verticalSlug}} (${{funnelType}}). Monitored events:`, events);
    }})();
  </script>

  <div class="relative overflow-hidden min-h-screen bg-[var(--brand-bg)] text-[var(--brand-text)]">
    <!-- Navbar -->
    <nav class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between border-b border-white/10">
      <div class="flex items-center gap-3">
        <a href="/" class="font-extrabold text-lg tracking-tight hover:text-[var(--brand-primary)] transition-colors">
          {brand_title}
        </a>
        <span class="opacity-40">/</span>
        <span class="text-[var(--brand-primary)] text-sm font-semibold">{vert_title}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="#conversion" class="px-4 py-2 text-xs font-semibold rounded-[var(--radius-control,0px)] bg-[var(--brand-primary)] text-[var(--brand-on-primary,var(--brand-bg))] transition-all">
          {cta_primary}
        </a>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 pt-20 pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-control,0px)] bg-[var(--brand-surface)] border border-white/15 text-[var(--brand-primary)] text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-[var(--radius-control,0px)] bg-[var(--brand-accent)]"></span>
        {mechanism}
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight sm:leading-none">
        {hook_3s}
      </h1>

      <p class="mt-6 text-lg sm:text-xl opacity-80 max-w-3xl mx-auto leading-relaxed">
        {dream_outcome}
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#conversion" class="w-full sm:w-auto px-8 py-4 text-base font-bold rounded-[var(--radius-control,0px)] bg-[var(--brand-primary)] text-[var(--brand-on-primary,var(--brand-bg))] transition-all">
          {cta_primary}
        </a>
        <a href="#mecanismo" class="w-full sm:w-auto px-6 py-4 text-base font-medium rounded-[var(--radius-control,0px)] border border-white/15 opacity-90 hover:opacity-100 transition-all">
          Cómo funciona
        </a>
      </div>
    </section>

    <!-- Propuesta Diferenciada -->
    <section id="mecanismo" class="max-w-5xl mx-auto px-6 py-20 border-t border-white/10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-primary)]">Método de trabajo</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight">
          {mechanism}
        </h2>
        <p class="mt-4 text-base sm:text-lg opacity-80 leading-relaxed">
          {contrast}
        </p>
      </div>
    </section>

    <!-- Oferta y Siguiente Paso -->
    <section id="conversion" class="max-w-4xl mx-auto px-6 py-20 border-t border-white/10">
      <div class="rounded-[var(--radius-card,0px)] bg-[var(--brand-surface)] border border-white/15 p-8 sm:p-12 text-center shadow-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-accent)]">Siguiente paso</span>
        <h3 class="mt-2 text-3xl font-bold tracking-tight">
          {offer_struct}
        </h3>
        <p class="mt-4 text-sm opacity-80 max-w-xl mx-auto">
          {guarantee}
        </p>
        <div class="mt-8">
          <a href="{checkout_url}" class="inline-block w-full sm:w-auto px-10 py-5 text-lg font-bold rounded-[var(--radius-control,0px)] bg-[var(--brand-primary)] text-[var(--brand-on-primary,var(--brand-bg))] transition-all">
            {cta_primary}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
"""
    target_file.write_text(astro_content, encoding="utf-8")
    return target_file


# =====================================================================
# 6. SUBCOMMAND IMPLEMENTATIONS
# =====================================================================

def cmd_list(args):
    target = getattr(args, "target", None) or getattr(args, "path_opt", None)
    eco, sinfo = discover_ecosystem(target=target)

    print(f"\n🏛️ Ecosistema Activo: [{eco.brand_slug}] — Matriz: {eco.umbrella_name or 'Mono-marca'}")
    if sinfo:
        print(f"📁 Fuente Primaria: {sinfo}")
    print("=" * 105)

    if not eco.verticals:
        print("⚠️ No se encontraron verticales configuradas en este proyecto.")
        print("💡 Para registrar una nueva vertical ejecutá:")
        print("   apotelos add-vertical <slug> --name \"Nombre de la Vertical\" --funnel direct_checkout")
        print("   O especificá una ruta: apotelos list /ruta/a/verticals/")
        print("=" * 105 + "\n")
        return

    print(f"{'SLUG':<16} | {'DOMINIO / RUTA':<28} | {'DISPLAY NAME':<32} | {'SUBTEMAS'}")
    print("-" * 105)
    for slug, vert in eco.verticals.items():
        dom = vert.custom_domain or vert.domain_strategy
        sub = ", ".join(vert.subthemes) if getattr(vert, "subthemes", None) else "-"
        print(f"{slug:<16} | {dom:<28} | {vert.display_name:<32} | {sub}")
    print("=" * 105)
    print(f"Total: {len(eco.verticals)} vertical(es) descubierta(s) en cascada.\n")


def cmd_test(args):
    """Agnostic physical behavior verification sensor for Apotelos extraction integrity."""
    import tempfile

    with tempfile.TemporaryDirectory(prefix="apotelos_test_") as tmp_dir:
        t_path = Path(tmp_dir)

        # 1. Monograph file (Framework thesis with subthemes, zero sales offers)
        (t_path / "Que es Metodologia Nexus.md").write_text(
            "# Qué es Metodología Nexus\n\n"
            "La Metodología Nexus integra tres dimensiones fundamentales:\n"
            "- Resonancia Cuántica\n"
            "- Malla Óntica\n"
            "- Sintaxis Causal\n\n"
            "Doctrina teórica sin venta directa.\n",
            encoding="utf-8"
        )

        # 2. Portfolio table (Umbrella brand with offering format + secondary platform)
        (t_path / "Portafolio de Marcas.md").write_text(
            "# Marcas y Proyectos\n\n"
            "| Marca / Línea | Descripción |\n"
            "|---|---|\n"
            "| Aurelius Vance / Consultoría | Consultoría estratégica de monopolio de categoría. Web: aureliusvance.com |\n"
            "| CloudSphere | Plataforma B2B de automatización cloud. Web: cloudsphere.io |\n",
            encoding="utf-8"
        )

        # 3. Dedicated Service Landing with Pricing Tiers
        (t_path / "Servicio-Auditoria-Cloud.md").write_text(
            "# Auditoría Cloud y Optimización\n\n"
            "Servicio para empresas con problemas de rendimiento.\n"
            "Ruta: aureliusvance.com/auditoria-cloud\n\n"
            "Estructura de precios:\n"
            "- Diagnóstico gratuito: $0 USD (revisión preliminar)\n"
            "- Paquete Básico: $200 - $400 USD (optimización inicial)\n"
            "- Configuración Completa: $600 - $1500 USD (migración y CDN)\n\n"
            "Problema: Latencia alta y sobrecostos en servidores.\n",
            encoding="utf-8"
        )

        eco, sinfo = discover_ecosystem(target=str(t_path))

        errors = []
        if not eco or not eco.verticals:
            print("❌ APOTELOS AGNOSTIC INTEGRITY SENSOR FAILED: No verticals discovered.")
            sys.exit(1)

        if "aurelius-vance" not in eco.verticals:
            errors.append("Falta vertical umbrella 'aurelius-vance'")
        if "cloud-y-optimizacion" not in eco.verticals:
