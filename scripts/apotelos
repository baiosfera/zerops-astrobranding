try:
    from pydantic import BaseModel, Field
except ImportError:
    print("❌ Error: pydantic is required for apotelos CLI. Run 'pip install pydantic' or execute inside container.")
    sys.exit(1)


# =====================================================================
# 1. MODELS & POLYMORPHIC SCHEMAS (Pydantic v2)
# =====================================================================

class CommercialFunnelType:
    DIRECT_CHECKOUT = "direct_checkout"      # Physical e-commerce, shopping carts, COD
    LEAD_GENERATION = "lead_generation"      # WhatsApp conversational, inbound forms
    BOOKING_CALENDAR = "booking_calendar"    # Aesthetic clinics, professional consults
    SUBSCRIPTION = "subscription"            # SaaS, recurring memberships, box delivery
    CONTENT_COMMUNITY = "content_community"  # Paid newsletter, digital courses, academy


class MessagingChannel(str, Enum):
    EMAIL = "email"
    WHATSAPP = "whatsapp"
    SMS = "sms"
    WEBHOOK = "webhook"
    PUSH = "push"


class MessagePriority(str, Enum):
    P1_TRANSACTIONAL = "P1_TRANSACTIONAL"
    P2_LIFECYCLE = "P2_LIFECYCLE"
    P3_PROMOTIONAL = "P3_PROMOTIONAL"


class MessagingSequenceStep(BaseModel):
    step_order: int = Field(..., description="1-indexed sequence order")
    channel: str = Field(default=MessagingChannel.EMAIL.value, description="Delivery channel")
    delay_minutes: int = Field(default=0, description="Trigger offset delay in minutes")
    priority: str = Field(default=MessagePriority.P2_LIFECYCLE.value, description="Message priority")
    template_ref: str = Field(..., description="Semantic template identifier (e.g. welcome_email, cart_recovery)")
    condition: Optional[str] = Field(default=None, description="Optional condition rule (e.g. unconverted, opt_in)")


class AntiCollisionPolicy(BaseModel):
    cross_channel_suppression: bool = Field(default=True, description="Suppress promotional email if conversational channel active")
    frequency_cap_hours: int = Field(default=24, description="Max promotional dispatches per contact per window")
    quiet_hours_start: Optional[int] = Field(default=21, description="Local quiet hours start (e.g. 21 = 9 PM)")
    quiet_hours_end: Optional[int] = Field(default=8, description="Local quiet hours end (e.g. 8 = 8 AM)")
    fencing_ttl_seconds: int = Field(default=86400, description="Valkey lock TTL in seconds")


class MessagingEcosystemSpec(BaseModel):
    enabled_channels: List[str] = Field(default_factory=lambda: ["email", "whatsapp"])
    tofu: List[MessagingSequenceStep] = Field(default_factory=list, description="Top of funnel awareness & capture")
    mofu: List[MessagingSequenceStep] = Field(default_factory=list, description="Middle of funnel consideration & nurture")
    bofu: List[MessagingSequenceStep] = Field(default_factory=list, description="Bottom of funnel decision & closing")
    post_conversion: List[MessagingSequenceStep] = Field(default_factory=list, description="Post conversion onboarding & retention")
    anti_collision: AntiCollisionPolicy = Field(default_factory=AntiCollisionPolicy)
    currency: str = Field(default="USD")


class DynamicVerticalSpec(BaseModel):
    vertical_slug: str = Field(..., description="Unique kebab-case slug for this business vertical")
    display_name: str = Field(..., description="Public human-readable title of the unit")
    funnel_type: str = Field(default=CommercialFunnelType.DIRECT_CHECKOUT)
    target_avatar: Dict[str, Any] = Field(default_factory=dict, description="Core pain points and desires")
    unique_mechanism: Dict[str, Any] = Field(default_factory=dict, description="Proprietary mechanism and contrast")
    primary_offer: Dict[str, Any] = Field(default_factory=dict, description="Value proposition structure and pricing")
    conversion_events: List[str] = Field(default_factory=list, description="Telemetry conversion events")
    messaging_flows: Optional[MessagingEcosystemSpec] = Field(default=None, description="Polymorphic TOFU/MOFU/BOFU messaging ecosystem specification")
    metadata: Dict[str, Any] = Field(default_factory=dict, description="Extensible attributes")


class UniversalBrandEcosystem(BaseModel):
    brand_slug: str = Field(..., description="Unique slug for the overarching brand or holding")
    umbrella_name: Optional[str] = Field(default=None, description="Parent entity or holding name")
    design_tokens_ref: Optional[str] = Field(default="brandbook.json", description="SSoT pointer")
    verticals: Dict[str, DynamicVerticalSpec] = Field(default_factory=dict, description="Dynamic verticals map")


class ApotelosManifest(BaseModel):
    brand_slug: str
    vertical_slug: str
    timestamp: str
    grounding: Dict[str, Any]       # Step 0: Category of One & Unique Mechanism
    copy_manifest: Dict[str, Any]   # Step 1: 3s hooks, irresistible offer, objection crushing
    seo_aeo_spec: Dict[str, Any]    # Step 2: JSON-LD @graph, llms.txt, semantic entities
    telemetry_spec: Dict[str, Any]  # Step 3: Pixel events, CAPI, GTM, 1st-party cookies
    deployment_spec: Dict[str, Any] # Step 4: Checkout endpoints, gateways, components
    messaging_spec: Dict[str, Any] = Field(default_factory=dict, description="Omnichannel TOFU/MOFU/BOFU lifecycle messaging and anti-collision contracts")


# =====================================================================
# 2. STRING & SLUG HELPERS
# =====================================================================

def slugify(text: str) -> str:
    """Convert arbitrary text into a clean kebab-case slug."""
    text = text.lower().strip()
    text = re.sub(r'[áàäâ]', 'a', text)
    text = re.sub(r'[éèëê]', 'e', text)
    text = re.sub(r'[íìïî]', 'i', text)
    text = re.sub(r'[óòöô]', 'o', text)
    text = re.sub(r'[úùüû]', 'u', text)
    text = re.sub(r'[ñ]', 'n', text)
    text = re.sub(r'[^a-z0-9]+', '-', text)
    return text.strip('-')


def infer_funnel_type(text_sample: str) -> Tuple[str, List[str]]:
    """Infer funnel type and standard telemetry events from semantic keywords."""
    t = text_sample.lower()

    if any(k in t for k in ["cita", "agenda", "calendario", "consulta", "sesion", "sesión", "reserva", "booking"]):
        return CommercialFunnelType.BOOKING_CALENDAR, ["Schedule", "Lead"]

    if any(k in t for k in ["suscripci", "recurren", "mensual", "membres", "saas", "software"]):
        return CommercialFunnelType.SUBSCRIPTION, ["Subscribe", "InitiateCheckout"]

    if any(k in t for k in ["comunidad", "newsletter", "curso", "academia", "taller", "libro", "ebook"]):
        return CommercialFunnelType.CONTENT_COMMUNITY, ["CompleteRegistration", "Subscribe"]

    if any(k in t for k in ["tienda", "carrito", "comprar", "envio", "envío", "contra entrega", "cod", "flete", "calzado", "ropa", "activewear", "producto"]):
        return CommercialFunnelType.DIRECT_CHECKOUT, ["Purchase", "InitiateCheckout"]

    # Clean default: consultative / lead gen
    return CommercialFunnelType.LEAD_GENERATION, ["Lead", "Contact"]


# =====================================================================
# 3. AGNOSTIC EXTRACTION PIPELINE (DOCX, PDF, MD, YAML/JSON)
# =====================================================================

def extract_from_text(content: str, source_name: str) -> List[DynamicVerticalSpec]:
    """Extract business verticals from raw text content agnostically."""
    verticals: List[DynamicVerticalSpec] = []
    if not content or len(content.strip()) < 10:
        return verticals

    # 1. Segment text into distinct Markdown tables
    tables: List[List[str]] = []
    current_table: List[str] = []
    for line in content.splitlines():
        line_s = line.strip()
        if line_s.startswith('|') and line_s.endswith('|'):
            current_table.append(line_s)
        else:
            if current_table:
                tables.append(current_table)
                current_table = []
    if current_table:
        tables.append(current_table)

    # Process each discovered table independently
    for tbl in tables:
        if len(tbl) < 2:
            continue
        headers = [c.strip().lower() for c in tbl[0].strip('|').split('|') if c.strip()]
        data_rows = tbl[1:]
        # Skip separator row |--|--|
        if data_rows and re.match(r'^[\s\-:|]+$', data_rows[0].strip('|')):
            data_rows = data_rows[1:]

        # Identify candidate column with entity name
        col_idx = -1
        for i, h in enumerate(headers):
            if any(k in h for k in ["proyecto", "firma", "vertical", "marca", "producto", "servicio", "linea", "línea"]):
                col_idx = i
                break

        if col_idx >= 0:
            for r in data_rows:
                cells = [c.strip() for c in r.strip('|').split('|')]
                if len(cells) > col_idx:
                    name_cell = re.sub(r'\s*\(\d+\)\s*', '', cells[col_idx]).strip()
                    desc_cell = " ".join(cells[col_idx+1:]) if len(cells) > col_idx + 1 else name_cell
                    # Split multiple sub-entities if separated by / or ,
                    candidates = [c.strip() for c in name_cell.split("/") if c.strip()]
                    for cand in candidates:
                        v_slug = slugify(cand)
                        if len(v_slug) > 2 and not any(v.vertical_slug == v_slug for v in verticals):
                            fn, evts = infer_funnel_type(desc_cell)
                            verticals.append(DynamicVerticalSpec(
                                vertical_slug=v_slug,
                                display_name=cand,
                                funnel_type=fn,
                                target_avatar={"pain_points": [f"Desafío identificado en {cand}"], "source_document": source_name},
                                unique_mechanism={"name": f"Metodología {cand}"},
                                primary_offer={"structure": f"Propuesta {cand}"},
                                conversion_events=evts
                            ))

    # 2. If no table yielded verticals, search for H1/H2 Headings
    if not verticals:
        headings = re.findall(r'^(?:#|##)\s+(.+)$', content, re.MULTILINE)
        if headings:
            for h in headings:
                clean_title = re.sub(r'^(vertical|linea|marca|servicio):\s*', '', h.strip(), flags=re.IGNORECASE)
                v_slug = slugify(clean_title)
                if len(v_slug) > 2 and not any(v.vertical_slug == v_slug for v in verticals):
                    fn, evts = infer_funnel_type(content[:2000])
                    verticals.append(DynamicVerticalSpec(
                        vertical_slug=v_slug,
                        display_name=clean_title,
                        funnel_type=fn,
                        target_avatar={"pain_points": [f"Necesidad central en {clean_title}"], "source_document": source_name},
                        unique_mechanism={"name": f"Mecanismo {clean_title}"},
                        primary_offer={"structure": f"Programa {clean_title}"},
                        conversion_events=evts
                    ))

    return verticals


def extract_from_text_or_md(file_path: Path) -> List[DynamicVerticalSpec]:
    """Extract business verticals from Markdown or plain text files agnostically."""
    try:
        content = file_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        print(f"⚠️ Warning reading {file_path.name}: {e}")
        return []

    verticals = extract_from_text(content, file_path.name)

    # Single document fallback if content exists but no structured sections
    if not verticals and len(content.strip()) > 50:
        base_name = file_path.stem.replace("-", " ").replace("_", " ").title()
        v_slug = slugify(base_name)
        if len(v_slug) > 2:
            fn, evts = infer_funnel_type(content[:1000])
            verticals.append(DynamicVerticalSpec(
                vertical_slug=v_slug,
                display_name=base_name,
                funnel_type=fn,
                target_avatar={"pain_points": [f"Punto de dolor extraído de {file_path.name}"], "source_document": file_path.name},
                unique_mechanism={"name": f"Tesis {base_name}"},
                primary_offer={"structure": f"Oferta {base_name}"},
                conversion_events=evts
            ))

    return verticals


def extract_from_docx(file_path: Path) -> List[DynamicVerticalSpec]:
    """Extract business verticals from DOCX files supporting XML tables, text tables, and headings."""
    verticals: List[DynamicVerticalSpec] = []
    ns = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}

    try:
        with zipfile.ZipFile(file_path) as z:
            xml_data = z.read("word/document.xml")
            root = ET.fromstring(xml_data)
    except Exception as e:
        print(f"⚠️ Warning reading docx {file_path.name}: {e}")
        return []

    # 1. Strategy A: Real Word XML Tables (<w:tbl>)
    for tbl in root.findall(".//w:tbl", ns):
        rows = tbl.findall(".//w:tr", ns)
        if len(rows) < 2:
            continue

        header_cells = ["".join(tc.itertext()).strip().lower() for tc in rows[0].findall(".//w:tc", ns)]
        col_idx = -1
        for i, h in enumerate(header_cells):
            if any(k in h for k in ["proyecto", "firma", "vertical", "marca", "producto", "servicio", "linea", "línea"]):
                col_idx = i
                break

        if col_idx >= 0:
            for row in rows[1:]:
                cells = ["".join(tc.itertext()).strip() for tc in row.findall(".//w:tc", ns)]
                if len(cells) > col_idx:
                    name_cell = re.sub(r'\s*\(\d+\)\s*', '', cells[col_idx]).strip()
                    desc_cell = " ".join(cells[col_idx+1:]) if len(cells) > col_idx + 1 else name_cell
                    candidates = [c.strip() for c in name_cell.split("/") if c.strip()]
                    for cand in candidates:
                        v_slug = slugify(cand)
                        if len(v_slug) > 2 and not any(v.vertical_slug == v_slug for v in verticals):
                            fn, evts = infer_funnel_type(desc_cell)
                            verticals.append(DynamicVerticalSpec(
                                vertical_slug=v_slug,
                                display_name=cand,
                                funnel_type=fn,
                                target_avatar={"pain_points": [f"Demanda detectada en {cand}"], "source_document": file_path.name},
                                unique_mechanism={"name": f"Mecanismo {cand}"},
                                primary_offer={"structure": f"Oferta {cand}"},
                                conversion_events=evts
                            ))

    # 2. Strategy B: Text-based Markdown Tables inside Paragraphs
    if not verticals:
        full_text = "\n".join("".join(p.itertext()).strip() for p in root.findall(".//w:p", ns) if "".join(p.itertext()).strip())
        verticals = extract_from_text(full_text, file_path.name)

    # 3. Strategy C: Single Document Fallback
    if not verticals:
        clean_name = file_path.stem.replace("-", " ").replace("_", " ").title()
        v_slug = slugify(clean_name)
        if len(v_slug) > 2:
            fn, evts = infer_funnel_type(clean_name)
            verticals.append(DynamicVerticalSpec(
                vertical_slug=v_slug,
                display_name=clean_name,
                funnel_type=fn,
                target_avatar={"pain_points": [f"Demanda extraída de {file_path.name}"], "source_document": file_path.name},
                unique_mechanism={"name": f"Tesis {clean_name}"},
                primary_offer={"structure": f"Oferta {clean_name}"},
                conversion_events=evts
            ))

    return verticals


def extract_from_pdf(file_path: Path) -> List[DynamicVerticalSpec]:
    """Extract business verticals from PDF files using pdftotext or filename analysis."""
    verticals: List[DynamicVerticalSpec] = []
    pdf_text = ""
    noise_words = {"nivel", "niveles", "servicio", "servicios", "ejemplo", "descripcion", "descripción", "plano", "elemento", "vibracion", "vibración"}

    try:
        pdf_text = subprocess.check_output(["pdftotext", str(file_path), "-"], stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
    except Exception:
        pdf_text = ""

    # Check for explicit vertical headers anchored at line start
    if pdf_text:
        sections = re.findall(r'^\s*(?:Vertical|Línea de Negocio|Línea|Producto|Oferta):\s*([^\n\r]+)', pdf_text, re.IGNORECASE | re.MULTILINE)
        for s in sections:
            s_clean = s.strip()
            v_slug = slugify(s_clean)
            if len(v_slug) > 2 and v_slug not in noise_words and not any(v.vertical_slug == v_slug for v in verticals):
                fn, evts = infer_funnel_type(s_clean)
                verticals.append(DynamicVerticalSpec(
                    vertical_slug=v_slug,
                    display_name=s_clean,
                    funnel_type=fn,
                    target_avatar={"pain_points": [f"Necesidad identificada en {s_clean}"], "source_document": file_path.name},
                    unique_mechanism={"name": f"Mecanismo {s_clean}"},
                    primary_offer={"structure": f"Oferta {s_clean}"},
                    conversion_events=evts
                ))

    # If no multiple sections found, treat the PDF monograph as a cohesive vertical
    if not verticals:
        clean_name = file_path.stem.replace("Que es ", "").replace("que es ", "").replace("-", " ").replace("_", " ").strip().title()
        v_slug = slugify(clean_name)
        if len(v_slug) > 2:
            fn, evts = infer_funnel_type(pdf_text[:1000] if pdf_text else clean_name)
            verticals.append(DynamicVerticalSpec(
                vertical_slug=v_slug,
                display_name=clean_name,
                funnel_type=fn,
                target_avatar={"pain_points": [f"Solución documental y conceptual en {clean_name}"], "source_document": file_path.name},
                unique_mechanism={"name": f"Tesis {clean_name}"},
                primary_offer={"structure": f"Programa {clean_name}"},
                conversion_events=evts
            ))

    return verticals


def extract_verticals_from_directory(v_dir: Path) -> Tuple[Optional[UniversalBrandEcosystem], Optional[str]]:
    """Scan a target directory and aggregate all dynamic verticals into a unified ecosystem."""
    verticals_map: Dict[str, DynamicVerticalSpec] = {}
    source_files: List[str] = []
    brand_name: Optional[str] = None

    # Check parent hierarchy for brandbook.json to resolve brand name
    for p in [v_dir, v_dir.parent, v_dir.parent.parent]:
        bb = p / "brandbook.json"
        if bb.exists():
            try:
                bd = json.loads(bb.read_text(encoding="utf-8"))
                brand_name = bd.get("metadata", {}).get("brand_name") or bd.get("identity", {}).get("brandName")
                if brand_name:
                    break
            except Exception:
                pass

    if not brand_name:
        # Infer brand name from directory hierarchy
        if v_dir.name in ("verticals", "dev"):
            brand_name = v_dir.parent.name if v_dir.name == "verticals" and v_dir.parent.name != "dev" else v_dir.parent.parent.name
        else:
            brand_name = v_dir.name

    for f in sorted(v_dir.iterdir()):
        if f.name.startswith("."):
            continue

        extracted: List[DynamicVerticalSpec] = []
        if f.suffix == ".docx":
            source_files.append(f.name)
            extracted = extract_from_docx(f)
        elif f.suffix == ".pdf":
            source_files.append(f.name)
            extracted = extract_from_pdf(f)
        elif f.suffix in (".md", ".txt"):
            source_files.append(f.name)
            extracted = extract_from_text_or_md(f)
        elif f.suffix in (".json", ".yaml", ".yml"):
            try:
                if f.name in ("ecosystem.json", "ecosystem.yaml", "ecosystem.yml"):
                    data = json.loads(f.read_text(encoding="utf-8")) if f.suffix == ".json" else {}
                    if data:
                        eco = UniversalBrandEcosystem.model_validate(data)
                        return eco, str(f)
                else:
                    data = json.loads(f.read_text(encoding="utf-8")) if f.suffix == ".json" else {}
                    if "vertical_slug" in data:
                        extracted = [DynamicVerticalSpec.model_validate(data)]
            except Exception as e:
                print(f"⚠️ Warning parsing {f.name}: {e}")

        for v in extracted:
            if v.vertical_slug not in verticals_map:
                verticals_map[v.vertical_slug] = v

    if verticals_map:
        clean_slug = slugify(brand_name)
        return UniversalBrandEcosystem(
            brand_slug=clean_slug,
            umbrella_name=brand_name.title() if brand_name else "Ecosistema Multimarca",
            verticals=verticals_map
        ), f"{v_dir} ({', '.join(source_files)})"

    return None, None


# =====================================================================
# 4. CASCADING DISCOVERY (Without Theater or Mock Fallbacks)
# =====================================================================

def get_workspace_root() -> Path:
    candidates = [Path.cwd(), Path("/var/www/zerops-astrobranding"), Path("/var/www")]
    for c in candidates:
        if (c / "brandbook.json").exists() or (c / ".apotelos").exists() or (c / "zerops.yaml").exists():
            return c
    return Path.cwd()


def get_local_storage_path() -> Path:
    env_path = os.getenv("LOCAL_STORAGE_PATH")
    if env_path and Path(env_path).exists():
        return Path(env_path)
    if Path("/mnt/localstorage").exists():
        return Path("/mnt/localstorage")
    if Path("/var/www/localstorage").exists():
        return Path("/var/www/localstorage")
    return Path("/tmp/localstorage")


def resolve_playbooks_dir() -> Optional[Path]:
    """Resolve playbooks directory in priority order (NVMe POSIX first, FUSE SSoT second)."""
    candidates = [
        Path("/mnt/localstorage/playbooks"),
        Path("/var/www/localstorage/playbooks"),
        get_local_storage_path() / "playbooks",
        Path("/var/www/baiosfera/PLAYBOOKS"),
        Path("/var/www/zerops-astrobranding/templates/playbooks")
    ]
    for c in candidates:
        if c.exists() and c.is_dir():
            return c
    return None


def resolve_playbook_path(playbook_name: str) -> Optional[Path]:
    """Resolve a specific playbook file (e.g. 00_category_of_one_playbook.md)."""
    p_dir = resolve_playbooks_dir()
    if p_dir:
        target = p_dir / playbook_name
        if target.exists() and target.is_file():
            return target
    for base in [Path("/mnt/localstorage/playbooks"), Path("/var/www/localstorage/playbooks"), Path("/var/www/baiosfera/PLAYBOOKS")]:
        cand = base / playbook_name
        if cand.exists() and cand.is_file():
            return cand
    return None


def discover_ecosystem(target: Optional[str] = None, allow_fallback: bool = False) -> Tuple[UniversalBrandEcosystem, Optional[str]]:
    """Discover business ecosystem in strict cascading order without hardcoded names."""
    root = get_workspace_root()
    ls_path = get_local_storage_path()
    project_env = os.getenv("PROJECT_NAME") or os.getenv("ZEROPS_PROJECT_NAME") or ""

    # 1. Explicit Target Path or Project Slug (Priority 1)
    if target:
        tp = Path(target)
        if tp.exists():
            if tp.is_dir():
                eco, sinfo = extract_verticals_from_directory(tp)
                if eco:
                    return eco, sinfo
            elif tp.is_file():
                if tp.suffix == ".docx":
                    verts = extract_from_docx(tp)
                elif tp.suffix == ".pdf":
                    verts = extract_from_pdf(tp)
                elif tp.suffix in (".md", ".txt"):
                    verts = extract_from_text_or_md(tp)
                elif tp.suffix == ".json":
                    try:
                        data = json.loads(tp.read_text(encoding="utf-8"))
                        return UniversalBrandEcosystem.model_validate(data), str(tp)
                    except Exception:
                        verts = []
                else:
                    verts = []

                if verts:
                    v_dict = {v.vertical_slug: v for v in verts}
                    b_name = tp.stem.replace("-", " ").title()
                    return UniversalBrandEcosystem(brand_slug=slugify(b_name), umbrella_name=b_name, verticals=v_dict), str(tp)

        # Target as project name in SSoT or LocalStorage
        drive_proj = Path("/var/www/baiosfera/PROYECTOS")
        for base in [drive_proj, ls_path]:
            for cand in [
                base / target / "verticals",
                base / target / "dev" / "verticals",
                base / target.upper() / "verticals",
                base / target.upper() / "dev" / "verticals",
                base / target / "ecosystem.json"
            ]:
                if cand.exists():
                    if cand.is_dir():
                        eco, sinfo = extract_verticals_from_directory(cand)
                        if eco:
                            return eco, sinfo
                    elif cand.is_file():
                        try:
                            data = json.loads(cand.read_text(encoding="utf-8"))
                            return UniversalBrandEcosystem.model_validate(data), str(cand)
                        except Exception:
                            pass

    # 2. Project Environment ($PROJECT_NAME / $ZEROPS_PROJECT_NAME)
    if project_env:
        for base in [Path("/var/www/baiosfera/PROYECTOS"), ls_path]:
            for cand in [
                base / project_env / "verticals",
                base / project_env / "dev" / "verticals",
                base / project_env.upper() / "verticals",
                base / project_env.upper() / "dev" / "verticals",
                base / project_env / "ecosystem.json",
                base / project_env / "dev" / "brandbook.json"
            ]:
                if cand.exists():
                    if cand.is_dir():
                        eco, sinfo = extract_verticals_from_directory(cand)
                        if eco:
                            return eco, sinfo
                    elif cand.is_file() and cand.name == "brandbook.json":
                        try:
                            bb_data = json.loads(cand.read_text(encoding="utf-8"))
                            if "verticals" in bb_data and isinstance(bb_data["verticals"], dict):
                                b_name = bb_data.get("metadata", {}).get("brand_name") or project_env
                                v_dict = {k: DynamicVerticalSpec.model_validate(v) for k, v in bb_data["verticals"].items()}
                                return UniversalBrandEcosystem(brand_slug=slugify(b_name), umbrella_name=b_name, verticals=v_dict), str(cand)
                        except Exception:
                            pass

    # 3. Workspace Native .apotelos/ecosystem.json
    p_eco = root / ".apotelos" / "ecosystem.json"
    if p_eco.exists():
        try:
            data = json.loads(p_eco.read_text(encoding="utf-8"))
            return UniversalBrandEcosystem.model_validate(data), str(p_eco)
        except Exception as e:
            print(f"⚠️ Warning: Error parsing {p_eco}: {e}")

    # 4. Workspace brandbook.json with explicit verticals block
    bb_root = root / "brandbook.json"
    if bb_root.exists():
        try:
            bb_data = json.loads(bb_root.read_text(encoding="utf-8"))
            b_name = bb_data.get("metadata", {}).get("brand_name") or bb_data.get("identity", {}).get("brandName") or root.name
            if "verticals" in bb_data and isinstance(bb_data["verticals"], dict):
                v_dict = {k: DynamicVerticalSpec.model_validate(v) for k, v in bb_data["verticals"].items()}
                return UniversalBrandEcosystem(brand_slug=slugify(b_name), umbrella_name=b_name, verticals=v_dict), str(bb_root)
        except Exception:
            pass

    # 5. Local directory ./verticals
    local_v = root / "verticals"
    if local_v.exists() and local_v.is_dir():
        eco, sinfo = extract_verticals_from_directory(local_v)
        if eco:
            return eco, sinfo

    # 6. Clean Honest Result (Empty verticals if none found)
    current_brand = project_env or (root.name if root.name not in ("www", "var") else "proyecto-activo")
    clean_slug = slugify(current_brand)

    if allow_fallback:
        return UniversalBrandEcosystem(
            brand_slug=clean_slug,
            umbrella_name=current_brand.title(),
            verticals={
                "root_vertical": DynamicVerticalSpec(
                    vertical_slug="root_vertical",
                    display_name=f"{current_brand.title()} [Borrador]",
                    funnel_type=CommercialFunnelType.DIRECT_CHECKOUT,
                    target_avatar={"pain_points": ["Definir problema raíz a resolver"], "source_document": "Auto-generado"},
                    unique_mechanism={"name": f"Mecanismo {current_brand.title()}"},
                    primary_offer={"structure": "Oferta Principal"},
                    conversion_events=["Purchase"]
                )
            }
        ), "Borrador de fallback zero-config"

    return UniversalBrandEcosystem(
        brand_slug=clean_slug,
        umbrella_name=current_brand.title(),
        verticals={}
    ), None


# =====================================================================
# 5. DYNAMIC ZEROPS DISCOVERY & BLACKBOARD COMPILER
# =====================================================================

def check_service_health(url: str, timeout_sec: float = 0.8) -> bool:
    """Check TCP reachability and HTTP status with fast sub-second fail-fast."""
    try:
        parsed = urllib.parse.urlparse(url)
        host = parsed.hostname
        if not host:
            return False
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        # Fast DNS + TCP check
        with socket.create_connection((host, port), timeout=timeout_sec):
            pass
        # Fast HTTP probe
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=timeout_sec) as response:
            return response.status in (200, 204)
    except Exception:
        return False


def detect_zerops_capabilities(probe_llm: bool = False) -> Dict[str, Any]:
    """Dynamically discover available runtimes and services in this Zerops project."""
    hermes_url = os.getenv("HERMES_API_URL", "http://hermes:8000")
    bifrost_url = os.getenv("BIFROST_API_URL", "http://bifrost:8080")
    freellm_url = os.getenv("FREELLMAPI_URL", "http://freellmapi:3001")

    hermes_alive = check_service_health(f"{hermes_url}/healthz", timeout_sec=0.3)
    bifrost_alive = check_service_health(f"{bifrost_url}/health", timeout_sec=0.3) if probe_llm else False
    freellm_alive = check_service_health(f"{freellm_url}/health", timeout_sec=0.3) if probe_llm else False

    return {
        "hermes_alive": hermes_alive,
        "bifrost_alive": bifrost_alive,
        "freellmapi_alive": freellm_alive,
        "hermes_url": hermes_url,
        "bifrost_url": bifrost_url,
        "has_postgres": bool(os.getenv("DATABASE_URL") or os.getenv("database_connectionString")),
        "has_valkey": bool(os.getenv("valkey_connectionString") or os.getenv("REDIS_URL")),
        "has_nats": bool(os.getenv("nats_connectionString") or os.getenv("NATS_URL"))
    }


def build_default_messaging_spec(funnel_type: str, currency: str = "USD") -> MessagingEcosystemSpec:
    """Builds an agnostic, industry-tailored TOFU/MOFU/BOFU omnichannel messaging specification."""
    policy = AntiCollisionPolicy(
        cross_channel_suppression=True,
        frequency_cap_hours=24,
        quiet_hours_start=21,
        quiet_hours_end=8,
        fencing_ttl_seconds=86400
    )

    if funnel_type == CommercialFunnelType.DIRECT_CHECKOUT:
        return MessagingEcosystemSpec(
            enabled_channels=["email", "whatsapp"],
            tofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=0,
                    priority=MessagePriority.P3_PROMOTIONAL.value,
                    template_ref="welcome_series_intro"
                )
            ],
            mofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=1440,
                    priority=MessagePriority.P3_PROMOTIONAL.value,
                    template_ref="product_social_proof_benefits"
                )
            ],
            bofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=30,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="cart_assistance_email", condition="cart_unconverted"
                ),
                MessagingSequenceStep(
                    step_order=2, channel="whatsapp", delay_minutes=180,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="concierge_whatsapp_assistance", condition="cart_unconverted_and_unlocked"
                )
            ],
            post_conversion=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=0,
                    priority=MessagePriority.P1_TRANSACTIONAL.value,
                    template_ref="order_confirmation_receipt"
                ),
                MessagingSequenceStep(
                    step_order=2, channel="whatsapp", delay_minutes=5,
                    priority=MessagePriority.P1_TRANSACTIONAL.value,
                    template_ref="order_tracking_dispatch"
                )
            ],
            anti_collision=policy,
            currency=currency
        )
    elif funnel_type == CommercialFunnelType.BOOKING_CALENDAR:
        return MessagingEcosystemSpec(
            enabled_channels=["email", "whatsapp"],
            tofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=0,
                    priority=MessagePriority.P3_PROMOTIONAL.value,
                    template_ref="diagnostic_report_delivery"
                )
            ],
            mofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=720,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="case_study_authority"
                ),
                MessagingSequenceStep(
                    step_order=2, channel="whatsapp", delay_minutes=1440,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="consultant_booking_invite", condition="unbooked"
                )
            ],
            bofu=[
                MessagingSequenceStep(
                    step_order=1, channel="whatsapp", delay_minutes=120,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="limited_slots_closing", condition="unbooked"
                )
            ],
            post_conversion=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=0,
                    priority=MessagePriority.P1_TRANSACTIONAL.value,
                    template_ref="calendar_invite_ics"
                ),
                MessagingSequenceStep(
                    step_order=2, channel="whatsapp", delay_minutes=0,
                    priority=MessagePriority.P1_TRANSACTIONAL.value,
                    template_ref="appointment_reminder_pre_session"
                )
            ],
            anti_collision=policy,
            currency=currency
        )
    else:  # Generic / LEAD_GENERATION / SUBSCRIPTION
        return MessagingEcosystemSpec(
            enabled_channels=["email", "whatsapp"],
            tofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=0,
                    priority=MessagePriority.P3_PROMOTIONAL.value,
                    template_ref="welcome_onboarding_pack"
                )
            ],
            mofu=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=1440,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="core_transformation_framework"
                )
            ],
            bofu=[
                MessagingSequenceStep(
                    step_order=1, channel="whatsapp", delay_minutes=360,
                    priority=MessagePriority.P2_LIFECYCLE.value,
                    template_ref="direct_advisor_inquiry", condition="unconverted"
                )
            ],
            post_conversion=[
                MessagingSequenceStep(
                    step_order=1, channel="email", delay_minutes=0,
                    priority=MessagePriority.P1_TRANSACTIONAL.value,
                    template_ref="welcome_membership_credentials"
                )
            ],
            anti_collision=policy,
            currency=currency
        )


def compile_blackboard_manifest(eco: UniversalBrandEcosystem, vert: DynamicVerticalSpec) -> ApotelosManifest:
    """Compile the authoritative Reverse Causality Blackboard Manifest (τε-Final -> τε-0)."""
    ts = datetime.now(timezone.utc).isoformat()
    currency = vert.primary_offer.get("pricing", {}).get("currency") or os.getenv("DEFAULT_CURRENCY", "USD")

    # Polymorphic Messaging Ecosystem (TOFU / MOFU / BOFU / Post-Conversion)
    messaging_obj = vert.messaging_flows or build_default_messaging_spec(vert.funnel_type, currency=currency)
    messaging = messaging_obj.model_dump()

    # Domino 4 (τε-Final): Conversión y Cobro
    deployment = {
        "funnel_type": vert.funnel_type,
        "offer_structure": vert.primary_offer.get("structure", f"Oferta {vert.display_name}"),
        "currency": currency,
        "gateways": ["wompi", "cod_otp"] if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT else ["booking_calendar", "whatsapp_direct"],
        "post_purchase_webhook": "/api/webhooks/orders" if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT else "/api/webhooks/leads"
    }

    # Domino 3 (τε-1): Telemetría y Atribución
    telemetry = {
        "funnel_type": vert.funnel_type,
        "events": vert.conversion_events,
        "capi_enabled": True,
        "hash_algorithm": "SHA-256",
        "cookie_1st_party": "__attr_session",
        "cookie_ttl_days": 90,
        "consent_mode_v2": "default_denied"
    }

    # Domino 2 (τε-2): Descubrimiento AI-First & SEO
    seo_aeo = {
        "llms_txt": {
            "entity_name": vert.display_name,
            "category": "Ecosistema de Conversión Soberana",
            "url_slug": f"/{vert.vertical_slug}"
        },
        "schema_org": {
            "@context": "https://schema.org",
            "@type": "Product" if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT else "LocalBusiness",
            "name": vert.display_name,
            "description": vert.unique_mechanism.get("name", f"Metodología {vert.display_name}")
        }
    }

    # Domino 1 (τε-3): Copywriting & Oferta Irresistible
    avatar_pain = vert.target_avatar.get("pain_points", ["Frustración con alternativas genéricas"])[0]
    copy_m = {
        "hook_3s": f"¿Cansado de {avatar_pain.lower()}? Descubrí cómo resolverlo sin intermediarios.",
        "hormozi_equation": {
            "dream_outcome": f"Dominio absoluto y transformación con {vert.display_name}",
            "perceived_likelihood": "Validado con metodología de categoría única",
            "time_delay": "Implementación inmediata",
            "effort_and_sacrifice": "Cero fricción y acompañamiento directo"
        },
        "risk_reversal_guarantee": "Garantía de satisfacción incondicional de 30 días"
    }

    # Domino 0 (τε-0): Mecanismo Único Monopolístico
    coo_path = resolve_playbook_path("00_category_of_one_playbook.md")
    p_dir = resolve_playbooks_dir()
    grounding = {
        "brand_slug": eco.brand_slug,
        "umbrella_name": eco.umbrella_name,
        "vertical_slug": vert.vertical_slug,
        "mechanism_name": vert.unique_mechanism.get("name", f"Mecanismo {vert.display_name}"),
        "contrast": vert.unique_mechanism.get("contrast", "Frente a soluciones genéricas del mercado"),
        "category_of_one_playbook": str(coo_path) if coo_path else None,
        "playbooks_dir": str(p_dir) if p_dir else None
    }

    return ApotelosManifest(
        brand_slug=eco.brand_slug,
        vertical_slug=vert.vertical_slug,
        timestamp=ts,
        grounding=grounding,
        copy_manifest=copy_m,
        seo_aeo_spec=seo_aeo,
        telemetry_spec=telemetry,
        deployment_spec=deployment,
        messaging_spec=messaging
    )


# =====================================================================
# 5b. ASTRO 5 SSR CODE SCAFFOLDING & MATERIALIZATION (No Bare Skeletons)
# =====================================================================

def resolve_scaffold_target_dir(brand_slug: str, custom_output_dir: Optional[str] = None) -> Path:
    """
    Resolve the target directory for Astro 5 SSR scaffolding.
    CRITICAL ARCHITECTURAL INVARIANT: NEVER write brand pages into the upstream
    chassis repository (/var/www/zerops-astrobranding). Brand apps live in dedicated
    runtime mounts (/var/www/webdev, /var/www/web), brand app repos (/var/www/apps/<brand>),
    or explicitly provided output directories.
    """
    if custom_output_dir:
        p = Path(custom_output_dir)
        p.mkdir(parents=True, exist_ok=True)
        return p

    # 1. Active application runtime mount in Zerops (standard dev workspace)
    for runtime_cand in [
        Path("/var/www/webdev/src/pages"),
        Path("/var/www/web/src/pages"),
        Path(f"/var/www/{brand_slug}-web/src/pages"),
        Path(f"/var/www/{brand_slug}/src/pages")
    ]:
        if runtime_cand.exists() and runtime_cand.is_dir():
            return runtime_cand

    # 2. Dedicated brand app workspace outside chassis
    brand_app_pages = Path(f"/var/www/apps/{brand_slug}/src/pages")
    if brand_app_pages.parent.exists():
        brand_app_pages.mkdir(parents=True, exist_ok=True)
        return brand_app_pages

    # 3. Persistent LocalStorage brand app workspace (outside git chassis)
    ls_pages = get_local_storage_path() / "apps" / brand_slug / "src" / "pages"
    ls_pages.mkdir(parents=True, exist_ok=True)
    return ls_pages


def scaffold_astro_page(
    manifest: ApotelosManifest,
    target_file: Path,
    route_mode: str = "subroute",
    as_root: bool = False
) -> Path:
    """Materialize production-ready Astro 5 SSR code from an Apotelos Blackboard manifest."""
    # Invariant: Block contamination of upstream chassis
    chassis_root = Path("/var/www/zerops-astrobranding")
    try:
        resolved_target = target_file.resolve()
        if chassis_root in resolved_target.parents and "apps/astrobranding" in str(resolved_target):
            raise ValueError(
                f"CONTAMINATION HAZARD: Cannot write brand page to upstream chassis '{target_file}'. "
                f"Use a dedicated app workspace (/var/www/webdev, /var/www/apps/{manifest.brand_slug}) or --output-dir."
            )
    except Exception as e:
        if "CONTAMINATION HAZARD" in str(e):
            raise

    target_file.parent.mkdir(parents=True, exist_ok=True)

    # Hydrate modular templates from templates/astro into target app workspace
    templates_astro = None
    for cand_t in [Path("/var/www/artifacts/templates/astro"), Path("/var/www/zerops-astrobranding/templates/astro")]:
        if cand_t.exists() and cand_t.is_dir():
            templates_astro = cand_t
            break

    app_src = None
    if target_file.parent.name == "pages" and target_file.parent.parent.name == "src":
        app_src = target_file.parent.parent
    elif "src" in [p.name for p in target_file.parents]:
        for p in target_file.parents:
            if p.name == "src":
                app_src = p
                break

    if templates_astro and app_src:
        comp_dir = app_src / "components"
        actions_dir = app_src / "actions"
        lib_dir = app_src / "lib"
        comp_dir.mkdir(parents=True, exist_ok=True)
        actions_dir.mkdir(parents=True, exist_ok=True)
        lib_dir.mkdir(parents=True, exist_ok=True)

        for comp in ["SeoHead.astro", "CookieConsent.astro"]:
            src_f = templates_astro / comp
            dst_f = comp_dir / comp
            if src_f.exists() and not dst_f.exists():
                shutil.copy2(src_f, dst_f)
        for act in ["ContactAction.ts"]:
            src_f = templates_astro / act
            dst_f = actions_dir / "contact.ts"
            if src_f.exists() and not dst_f.exists():
                shutil.copy2(src_f, dst_f)
        for lib in ["phone.ts", "discountStrategy.ts"]:
            src_f = templates_astro / lib
            dst_f = lib_dir / lib
            if src_f.exists() and not dst_f.exists():
                shutil.copy2(src_f, dst_f)

    brand_title = manifest.grounding.get("umbrella_name") or manifest.brand_slug.replace("-", " ").title()
    vert_title = manifest.seo_aeo_spec.get("schema_org", {}).get("name") or manifest.vertical_slug.replace("-", " ").title()
    page_title = f"{vert_title} — {brand_title}"
    page_desc = manifest.copy_manifest.get("hook_3s", f"Propuesta de {vert_title}")

    mechanism = manifest.grounding.get("mechanism_name", f"Mecanismo {vert_title}")
    contrast = manifest.grounding.get("contrast", "Frente a alternativas convencionales del mercado")

    funnel = manifest.deployment_spec.get("funnel_type", CommercialFunnelType.LEAD_GENERATION)
    offer_struct = manifest.deployment_spec.get("offer_structure", f"Oferta {vert_title}")
    guarantee = manifest.copy_manifest.get("risk_reversal_guarantee", "Garantía de satisfacción incondicional")
    dream_outcome = manifest.copy_manifest.get("hormozi_equation", {}).get("dream_outcome", f"Transformación completa con {vert_title}")
    hook_3s = manifest.copy_manifest.get("hook_3s", f"Descubrí la solución definitiva con {vert_title}")

    cta_primary = "Comprar Ahora (Pago Seguro)" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else ("Agendar Cita en Calendario" if funnel == CommercialFunnelType.BOOKING_CALENDAR else "Iniciar Consulta por WhatsApp")
    checkout_url = f"/checkout?vertical={manifest.vertical_slug}" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else ("#agendar" if funnel == CommercialFunnelType.BOOKING_CALENDAR else "#whatsapp")

    schema_data = manifest.seo_aeo_spec.get("schema_org", {
        "@context": "https://schema.org",
        "@type": "Product" if funnel == CommercialFunnelType.DIRECT_CHECKOUT else "LocalBusiness",
        "name": vert_title,
        "description": mechanism
    })
    schema_json = json.dumps(schema_data, indent=2, ensure_ascii=False)
    events_json = json.dumps(manifest.telemetry_spec.get("events", ["Lead"]))

    astro_content = f"""---
// =====================================================================
// Auto-generated by Apotelos Protocol (Reverse Causality τε-Final -> τε-0)
// Brand: {manifest.brand_slug} | Vertical: {manifest.vertical_slug}
// Route Mode: {route_mode} | Timestamp: {manifest.timestamp}
// =====================================================================

import BaseLayout from "../layouts/BaseLayout.astro";

const title = "{page_title}";
const description = "{page_desc.replace('"', '\\"')}";
const schemaData = {schema_json};
---

<BaseLayout title={{title}} description={{description}}>
  <!-- Domino 2: SEO Semántico & Knowledge Graph Schema.org -->
  <script type="application/ld+json" is:inline set:html={{JSON.stringify(schemaData)}} />

  <!-- Domino 3: Telemetría de Primera Parte (__attr_session & CAPI) -->
  <script is:inline define:vars={{{{ funnelType: "{funnel}", events: {events_json}, verticalSlug: "{manifest.vertical_slug}" }}}}>
    (function() {{
      const cookieKey = '__attr_session';
      if (!document.cookie.includes(cookieKey)) {{
        const sessId = 'sess_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now();
        document.cookie = `${{cookieKey}}=${{sessId}}; path=/; max-age=7776000; SameSite=Lax`;
      }}
      console.log(`[Apotelos Telemetry] Active on ${{verticalSlug}} (${{funnelType}}). Monitored events:`, events);
    }})();
  </script>

  <div class="relative overflow-hidden min-h-screen bg-neutral-950 text-neutral-100">
    <!-- Navbar -->
    <nav class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between border-b border-neutral-800/80">
      <div class="flex items-center gap-3">
        <a href="/" class="font-extrabold text-lg tracking-tight hover:text-indigo-400 transition-colors">
          {brand_title}
        </a>
        <span class="text-neutral-600">/</span>
        <span class="text-indigo-400 text-sm font-semibold">{manifest.vertical_slug}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="#conversion" class="px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-600/20 transition-all">
          {cta_primary}
        </a>
      </div>
    </nav>

    <!-- Hero Section: Domino 1 (3s Hook + Hormozi Dream Outcome) -->
    <section class="max-w-5xl mx-auto px-6 pt-20 pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-950/60 border border-indigo-800/50 text-indigo-300 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
        {mechanism}
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight sm:leading-none">
        {hook_3s}
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-neutral-400 max-w-3xl mx-auto leading-relaxed">
        {dream_outcome}
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#conversion" class="w-full sm:w-auto px-8 py-4 text-base font-bold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white shadow-xl shadow-indigo-600/25 transition-all transform hover:-translate-y-0.5">
          {cta_primary}
        </a>
        <a href="#mecanismo" class="w-full sm:w-auto px-6 py-4 text-base font-medium rounded-xl border border-neutral-800 hover:border-neutral-700 text-neutral-300 hover:text-white transition-all">
          Ver Mecanismo Único
        </a>
      </div>
    </section>

    <!-- Domino 0: Mecanismo Único Monopolístico (Category of One) -->
    <section id="mecanismo" class="max-w-5xl mx-auto px-6 py-20 border-t border-neutral-900">
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">El Primer Dominó (τε-0)</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          {mechanism}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-neutral-400 leading-relaxed">
          {contrast}
        </p>
      </div>
    </section>

    <!-- Domino 4: Oferta & Conversión (τε-Final) -->
    <section id="conversion" class="max-w-4xl mx-auto px-6 py-20 border-t border-neutral-900">
      <div class="rounded-2xl bg-neutral-900/70 border border-neutral-800 p-8 sm:p-12 text-center shadow-2xl shadow-black/50">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Oferta de Conversión Inversa</span>
        <h3 class="mt-2 text-3xl font-bold text-white tracking-tight">
          {offer_struct}
        </h3>
        <p class="mt-4 text-sm text-neutral-400 max-w-xl mx-auto">
          🛡️ {guarantee}
        </p>
        <div class="mt-8">
          <a href="{checkout_url}" class="inline-block w-full sm:w-auto px-10 py-5 text-lg font-bold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white shadow-xl shadow-indigo-600/30 transition-all transform hover:-translate-y-0.5">
            {cta_primary}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
"""
    target_file.write_text(astro_content, encoding="utf-8")
    return target_file


# =====================================================================
# 6. SUBCOMMAND IMPLEMENTATIONS
# =====================================================================

def cmd_list(args):
    target = getattr(args, "target", None) or getattr(args, "path_opt", None)
    eco, sinfo = discover_ecosystem(target=target)

    print(f"\n🏛️ Ecosistema Activo: [{eco.brand_slug}] — Matriz: {eco.umbrella_name or 'Mono-marca'}")
    if sinfo:
        print(f"📁 Fuente Primaria: {sinfo}")
    print("=" * 75)

    if not eco.verticals:
        print("⚠️ No se encontraron verticales configuradas en este proyecto.")
        print("💡 Para registrar una nueva vertical ejecutá:")
        print("   apotelos add-vertical <slug> --name \"Nombre de la Vertical\" --funnel direct_checkout")
        print("   O especificá una ruta: apotelos list /ruta/a/verticals/")
        print("=" * 75 + "\n")
        return

    print(f"{'SLUG':<22} | {'DISPLAY NAME':<28} | {'FUNNEL TYPE':<18}")
    print("-" * 75)
    for slug, vert in eco.verticals.items():
        print(f"{slug:<22} | {vert.display_name:<28} | {vert.funnel_type:<18}")
    print("=" * 75)
    print(f"Total: {len(eco.verticals)} vertical(es) descubierta(s) en cascada.\n")


def cmd_add_vertical(args):
    root = get_workspace_root()
    apotelos_dir = root / ".apotelos"
    apotelos_dir.mkdir(parents=True, exist_ok=True)
    eco_file = apotelos_dir / "ecosystem.json"

    eco, _ = discover_ecosystem(allow_fallback=True)
    slug = slugify(args.slug)
    name = args.name or slug.replace("-", " ").title()
    funnel = args.funnel or CommercialFunnelType.DIRECT_CHECKOUT

    new_vert = DynamicVerticalSpec(
        vertical_slug=slug,
        display_name=name,
        funnel_type=funnel,
        target_avatar={"pain_points": ["Definir dolor raíz del avatar"], "desires": ["Definir transformación deseada"]},
        unique_mechanism={"name": f"Mecanismo {name}", "contrast": "Frente a competidores del mercado"},
        primary_offer={"structure": f"Oferta {name}", "pricing": {"currency": "COP", "amount": 100000}},
        conversion_events=["Purchase", "InitiateCheckout"] if funnel == CommercialFunnelType.DIRECT_CHECKOUT else ["Lead", "Contact"]
    )
    eco.verticals[slug] = new_vert

    with open(eco_file, "w", encoding="utf-8") as f:
        json.dump(eco.model_dump(), f, indent=2, ensure_ascii=False)

    print(f"✅ Vertical '{slug}' ({name}) registrada con éxito en: {eco_file}")


def cmd_audit(args):
    target = getattr(args, "brand", None) or getattr(args, "target", None)
    eco, sinfo = discover_ecosystem(target=target)

    if not eco.verticals:
        print("❌ Error: No hay verticales para auditar en el ecosistema.")
        sys.exit(1)

    target_v = args.vertical
    if not target_v:
        target_v = list(eco.verticals.keys())[0]

    if target_v not in eco.verticals:
        print(f"❌ Error: Vertical '{target_v}' no encontrada. Disponibles: {list(eco.verticals.keys())}")
        sys.exit(1)

    vert = eco.verticals[target_v]
    print(f"\n🔍 Auditando Contrato Estático Pydantic para: [{eco.brand_slug}] -> [{vert.vertical_slug}]")
    if sinfo:
        print(f"📁 Fuente: {sinfo}")
    print("-" * 65)

    errors = []
    if not vert.unique_mechanism.get("name"):
        errors.append("unique_mechanism.name está vacío o no definido")
    if not vert.primary_offer.get("structure"):
        errors.append("primary_offer.structure está vacío")
    if not vert.target_avatar.get("pain_points"):
        errors.append("target_avatar.pain_points no contiene dolores listados")

    if errors:
        print("❌ Fallas de contrato detectadas:")
        for err in errors:
            print(f"  • {err}")
        sys.exit(1)

    print("✅ Contrato Pydantic v2 validado al 100% (exit code 0)")
    print(f"  • Display Name: {vert.display_name}")
    print(f"  • Funnel Type:  {vert.funnel_type}")
    print(f"  • Mecanismo:    {vert.unique_mechanism.get('name')}")
    print(f"  • Eventos Tele: {vert.conversion_events}\n")


def cmd_plan(args):
    target = getattr(args, "target", None) or getattr(args, "brand", None)
    eco, sinfo = discover_ecosystem(target=target)

    if not eco.verticals:
        print(f"\n🗺️ Árbol de Regresión Causal Inversa (Apoτέlοs): [{eco.brand_slug}]")
        print("=" * 75)
        print("⚠️ No se encontraron verticales en el proyecto para trazar el árbol causal.")
        print("💡 Registrá una vertical con: apotelos add-vertical <slug> --name \"Nombre\"")
        print("=" * 75 + "\n")
        return

    if args.vertical:
        target_v = args.vertical
        if target_v not in eco.verticals:
            print(f"❌ Error: Vertical '{target_v}' no encontrada. Disponibles: {list(eco.verticals.keys())}")
            sys.exit(1)
        plan_verts = {target_v: eco.verticals[target_v]}
    else:
        plan_verts = eco.verticals

    print(f"\n🗺️ Árbol de Regresión Causal Inversa (Apoτέlοs): [{eco.brand_slug}] — Matriz: {eco.umbrella_name or 'Mono-marca'}")
    if sinfo:
        print(f"📁 Fuente Primaria: {sinfo}")
    print("=" * 75)

    for vslug, vert in plan_verts.items():
        print(f"\n📌 Vertical: [{vslug}] — {vert.display_name}")
        print("-" * 70)
        print("Dominó 4 (τε-Final): Conversión y Cobro")
        print(f"  └── Funnel: {vert.funnel_type} | Oferta: {vert.primary_offer.get('structure', 'Oferta Base')}")
        print("Dominó 3 (τε-1): Telemetría y Atribución")
        print(f"  └── Eventos: {vert.conversion_events} | CAPI, TikTok & GTM 1st-party cookies")
        print("Dominó 2 (τε-2): Descubrimiento AI-First & SEO Semántico")
        print(f"  └── /llms.txt + Schema.org @graph ({'Product' if vert.funnel_type == CommercialFunnelType.DIRECT_CHECKOUT else 'LocalBusiness'})")
        print("Dominó 1 (τε-3): Copywriting Neuro-persuasivo & Ganchos de 3s")
        print(f"  └── Avatar: {vert.target_avatar.get('pain_points', ['Demanda central'])[0]}")
        print("Dominó 0 (τε-0): El Primer Dominó — Mecanismo Único Monopolístico")
        print(f"  └── Monopolio: {vert.unique_mechanism.get('name')}")
    print("\n" + "=" * 75 + "\n")


def cmd_run(args):
    target = getattr(args, "brand", None) or getattr(args, "target", None)
    eco, sinfo = discover_ecosystem(target=target, allow_fallback=True)

    if not eco.verticals:
        print("❌ Error: No se encontraron verticales para ejecutar.")
        sys.exit(1)

    target_v = args.vertical or list(eco.verticals.keys())[0]
    vert = eco.verticals.get(target_v)
    if not vert:
        print(f"❌ Error: Vertical '{target_v}' no encontrada en el ecosistema.")
        sys.exit(1)

    print(f"\n🚀 Despachando Pipeline Apotelos: [{eco.brand_slug}:{vert.vertical_slug}]")

    # 1. Compile the authoritative Blackboard Manifest
    manifest = compile_blackboard_manifest(eco, vert)

    # 2. Write Manifest to Disk (Blackboard Architecture)
    root = get_workspace_root()
    manifest_dir = root / ".apotelos" / "manifests"
    manifest_dir.mkdir(parents=True, exist_ok=True)
    manifest_file = manifest_dir / f"{eco.brand_slug}_{vert.vertical_slug}.json"

    with open(manifest_file, "w", encoding="utf-8") as f:
        json.dump(manifest.model_dump(), f, indent=2, ensure_ascii=False)

    # Also mirror to persistent localstorage if available
    ls_path = get_local_storage_path()
    if ls_path.exists():
        ls_manifest_dir = ls_path / "manifests"
        try:
            ls_manifest_dir.mkdir(parents=True, exist_ok=True)
            with open(ls_manifest_dir / f"{eco.brand_slug}_{vert.vertical_slug}.json", "w", encoding="utf-8") as f:
                json.dump(manifest.model_dump(), f, indent=2, ensure_ascii=False)
        except Exception:
            pass

    print(f"✅ Manifiesto Blackboard guardado en: {manifest_file}")

    # 3. Dynamic Zerops Runtime Discovery
    caps = detect_zerops_capabilities()

    if caps["hermes_alive"]:
        print(f"🔗 Despachando tarea a runtime Hermes ({caps['hermes_url']})...")
        linear_issue = args.linear_issue
        if not linear_issue:
            for sf in ["/tmp/.linear_activity_state.json", "/var/www/artifacts/.linear_activity_state.json"]:
                if os.path.exists(sf):
                    try:
                        with open(sf, "r") as f:
                            l_data = json.load(f)
                            linear_issue = l_data.get("issueId")
                            if linear_issue:
                                print(f"🔗 Auto-vinculando Apotelos con issue activo de Linear: {linear_issue}")
                                break
                    except Exception:
                        pass

        payload = {
            "crew_name": "apotelos",
            "input": f"Ejecutar protocolo Apotelos inverso para la vertical '{vert.vertical_slug}' de la marca '{eco.brand_slug}'.",
            "tier": args.tier or "free",
            "context": {
                "manifest_path": str(manifest_file),
                "manifest": manifest.model_dump(),
                "linear_issue": linear_issue
            }
        }
        try:
            req = urllib.request.Request(
                f"{caps['hermes_url']}/v1/runs",
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json", "X-Crew-Name": "apotelos"},
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=10.0) as resp:
                res_data = json.loads(resp.read().decode("utf-8"))
                print(f"✅ Run despachado exitosamente a Hermes!")
                print(f"  • Run ID:  {res_data.get('id', res_data.get('run_id'))}")
                print(f"  • Status:  {res_data.get('status')}")
                print(f"  • Monitor: {caps['hermes_url']}/v1/runs/{res_data.get('id')}/events\n")
        except Exception as ex:
            print(f"⚠️ Error al comunicar con Hermes: {ex}")
            print("📋 El manifiesto local quedó intacto para ejecución directa por el agente ZCP.\n")
    else:
        # Decoupled Standalone / ZCP Local Execution Mode
        print("ℹ️ Runtime 'hermes' no está activo en Zerops (Arquitectura Lego Desacoplada).")
        print("📋 Manifiesto Blackboard listo para ejecución por el plano de control ZCP (AGY/Pi):")
        print(f"  • Dominó 4 (Conversión): {manifest.deployment_spec.get('funnel_type')} ({manifest.deployment_spec.get('offer_structure')})")
        print(f"  • Dominó 3 (Telemetría): {manifest.telemetry_spec.get('events')}")
        print(f"  • Dominó 2 (AI/SEO):     Schema.org @type {manifest.seo_aeo_spec.get('schema_org', {}).get('@type')}")
        print(f"  • Dominó 1 (Copywriting): Hook 3s listo contra dolor de avatar")
        print(f"  • Dominó 0 (Mecanismo):  {manifest.grounding.get('mechanism_name')}\n")

    # 4. Optional physical scaffolding (No Bare Skeletons)
    if getattr(args, "scaffold", False):
        target_dir = resolve_scaffold_target_dir(eco.brand_slug, getattr(args, "output_dir", None))
        target_path = target_dir / f"{vert.vertical_slug}.astro"
        scaffold_astro_page(manifest, target_path)
        print(f"✅ Código Astro 5 SSR materializado en: {target_path}\n")


def cmd_scaffold(args):
    target = getattr(args, "brand", None) or getattr(args, "target", None)
    eco, sinfo = discover_ecosystem(target=target, allow_fallback=True)

    if not eco.verticals:
        print("❌ Error: No se encontraron verticales para maquetar.")
        sys.exit(1)

    target_v = args.vertical or list(eco.verticals.keys())[0]
    vert = eco.verticals.get(target_v)
    if not vert:
        print(f"❌ Error: Vertical '{target_v}' no encontrada en el ecosistema.")
        sys.exit(1)

    manifest = compile_blackboard_manifest(eco, vert)

    out_dir = resolve_scaffold_target_dir(eco.brand_slug, args.output_dir)

    filename = "index.astro" if args.as_root else f"{vert.vertical_slug}.astro"
    target_path = out_dir / filename

    if args.dry_run:
        print(f"\n[DRY RUN] Scaffold Astro 5 SSR para [{eco.brand_slug}:{vert.vertical_slug}] -> {target_path}")
        tmp = Path("/tmp") / f"preview_{filename}"
        scaffold_astro_page(manifest, tmp, route_mode=args.route_mode, as_root=args.as_root)
        print(tmp.read_text(encoding="utf-8")[:600] + "\n... [truncated] ...\n")
        tmp.unlink(missing_ok=True)
        return

    scaffold_astro_page(manifest, target_path, route_mode=args.route_mode, as_root=args.as_root)
    print(f"\n✅ Código Astro 5 SSR materializado exitosamente!")
    print(f"  • Archivo:     {target_path}")
    print(f"  • Ruta Web:    {'/' if args.as_root else f'/{vert.vertical_slug}'}")
    print(f"  • Funnel:      {vert.funnel_type}")
    print(f"  • Telemetría:  {manifest.telemetry_spec.get('events')}")
    print(f"  • Schema.org:  {manifest.seo_aeo_spec.get('schema_org', {}).get('@type')}")

    if args.route_mode == "subdomain":
        print(f"\n🌐 Modo Subdominio ({vert.vertical_slug}.tudominio.com):")
        print(f"   Agregá a tu middleware.ts o zerops.yaml la redirección/rewrite de host a /{vert.vertical_slug}\n")
    else:
        print(f"\n🌐 Modo Subruta: Disponible de inmediato en tu dominio/subdominio bajo /{vert.vertical_slug}\n")


# =====================================================================
# 7. CLI ENTRYPOINT
# =====================================================================

def main():
    parser = argparse.ArgumentParser(
        prog="apotelos",
        description="Apotelos CLI: Sovereign Reverse Causality & Multi-Agent Mesh for Zerops"
    )
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # list
    p_list = subparsers.add_parser("list", help="Lista las marcas y verticales descubiertas en cascada")
    p_list.add_argument("target", nargs="?", default=None, help="Ruta específica o proyecto a inspeccionar")
    p_list.add_argument("--path", "-p", dest="path_opt", default=None, help="Ruta explícita al directorio de verticales")
    p_list.set_defaults(func=cmd_list)

    # add-vertical
    p_add = subparsers.add_parser("add-vertical", help="Agrega una nueva vertical al ecosistema")
    p_add.add_argument("slug", help="Slug único de la vertical (kebab-case)")
    p_add.add_argument("--name", help="Nombre descriptivo de la vertical")
    p_add.add_argument("--funnel", choices=[
        CommercialFunnelType.DIRECT_CHECKOUT,
        CommercialFunnelType.LEAD_GENERATION,
        CommercialFunnelType.BOOKING_CALENDAR,
        CommercialFunnelType.SUBSCRIPTION,
        CommercialFunnelType.CONTENT_COMMUNITY
    ], default=CommercialFunnelType.DIRECT_CHECKOUT)
    p_add.set_defaults(func=cmd_add_vertical)

    # audit
    p_audit = subparsers.add_parser("audit", help="Audita el contrato estático Pydantic de una vertical")
    p_audit.add_argument("target", nargs="?", default=None, help="Ruta específica o proyecto a inspeccionar")
    p_audit.add_argument("--brand", help="Slug de la marca (opcional)")
    p_audit.add_argument("--vertical", help="Slug de la vertical a auditar")
    p_audit.set_defaults(func=cmd_audit)

    # plan
    p_plan = subparsers.add_parser("plan", help="Muestra el árbol de regresión causal inverso")
    p_plan.add_argument("target", nargs="?", default=None, help="Ruta específica o proyecto a inspeccionar")
    p_plan.add_argument("--brand", help="Slug de la marca (opcional)")
    p_plan.add_argument("--vertical", help="Slug de la vertical a planificar")
    p_plan.set_defaults(func=cmd_plan)

    # run
    p_run = subparsers.add_parser("run", help="Despacha el pipeline causal o compila el manifiesto blackboard")
    p_run.add_argument("target", nargs="?", default=None, help="Ruta específica o proyecto a inspeccionar")
    p_run.add_argument("--brand", help="Slug de la marca (opcional)")
    p_run.add_argument("--vertical", help="Slug de la vertical a ejecutar")
    p_run.add_argument("--tier", choices=["free", "pro"], default="free", help="Tier de inferencia en Bifrost")
    p_run.add_argument("--linear-issue", help="ID del ticket Linear (ej: BAI-439)")
    p_run.add_argument("--headless", action="store_true", help="Ejecución desatendida")
    p_run.add_argument("--scaffold", action="store_true", help="Materializa automáticamente la página Astro 5 SSR en disco")
    p_run.set_defaults(func=cmd_run)

    # scaffold
    p_scaffold = subparsers.add_parser("scaffold", help="Materializa el código Astro 5 SSR de la vertical a partir del manifiesto Blackboard")
    p_scaffold.add_argument("target", nargs="?", default=None, help="Ruta específica o proyecto a inspeccionar")
    p_scaffold.add_argument("--brand", help="Slug de la marca (opcional)")
    p_scaffold.add_argument("--vertical", help="Slug de la vertical a maquetar")
    p_scaffold.add_argument("--output-dir", help="Directorio destino para escribir el archivo .astro")
    p_scaffold.add_argument("--as-root", action="store_true", help="Escribir como index.astro (landing principal)")
    p_scaffold.add_argument("--route-mode", choices=["subroute", "subdomain"], default="subroute", help="Modo de enrutamiento (subroute o subdomain)")
    p_scaffold.add_argument("--dry-run", action="store_true", help="Imprimir vista previa sin escribir en disco")
    p_scaffold.set_defaults(func=cmd_scaffold)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
