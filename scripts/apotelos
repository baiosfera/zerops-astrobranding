class MasterConcatenationMatrix(BaseModel):
    brand_slug: str = Field(..., min_length=2)
    canonical_domain: str = Field(..., min_length=4)
    topic_clusters: List[TopicClusterSpec] = Field(..., min_length=1)
    links: List[ConcatenationLink] = Field(..., min_length=1)
    hub_branches: List[HubBranchRoute] = Field(default_factory=list)
    affiliate_program: Optional[AffiliateProgramContract] = None
    cross_domain_bridge: Optional[CrossDomainBridgeContract] = None
    cross_funnel_bridges: List[CrossFunnelBridgeContract] = Field(default_factory=list)
    omnichannel_anti_collision: Optional[OmnichannelInterlacePolicy] = None
    offer_rings: List[OfferRingSpec] = Field(default_factory=list)
    dynamic_campaign_routes: List[str] = Field(default_factory=list)


def validate_concatenation_matrix(raw: Dict[str, Any]) -> Tuple[bool, List[str]]:
    errors: List[str] = []
    try:
        m = MasterConcatenationMatrix.model_validate(raw)
    except Exception as ex:
        return False, [str(ex)]

    routes_seen: Dict[str, str] = {}
    cluster_ids: set[str] = set()
    for c in m.topic_clusters:
        cluster_ids.add(c.cluster_id)
        if c.landing_route in routes_seen:
            errors.append(f"Canibalización SEO: ruta '{c.landing_route}' repetida entre '{routes_seen[c.landing_route]}' y '{c.cluster_id}' (1 intención = 1 URL).")
        routes_seen[c.landing_route] = c.cluster_id

    for lk in m.links:
        if lk.cluster_id not in cluster_ids:
            errors.append(f"Link '{lk.link_id}' apunta a cluster inexistente '{lk.cluster_id}'.")
        if lk.utm.allow_on_internal_links:
            errors.append(f"Link '{lk.link_id}' permite UTMs en enlaces internos (prohibido: borra atribución real).")
        for ev in lk.pixel_events:
            if not ev.shared_event_id:
                errors.append(f"Link '{lk.link_id}' evento '{ev.event_name}' sin event_id compartido Browser↔CAPI.")

    branch_slugs: set[str] = set()
    branch_routes: set[str] = set()
    for br in m.hub_branches:
        if br.branch_slug in branch_slugs:
            errors.append(f"Hub branch duplicado: '{br.branch_slug}'.")
        branch_slugs.add(br.branch_slug)
        if br.route_path in branch_routes:
            errors.append(f"Ruta de hub duplicada: '{br.route_path}'.")
        branch_routes.add(br.route_path)
        if br.entity_role == "operating_protocol" and br.delivery_tier not in ("editorial", "ecosystem_entry"):
            errors.append(
                f"Hub branch '{br.branch_slug}' es 'operating_protocol' y no debe clasificarse en tier comercial '{br.delivery_tier}' (usa 'editorial' o 'ecosystem_entry')."
            )

    if m.affiliate_program and m.affiliate_program.enabled:
        ap = m.affiliate_program
        if not ap.self_referral_blocked:
            errors.append("Programa de afiliados debe bloquear autocompra/self-referral (PB04/PB16).")
        if ap.cookie_window_days < 30:
            errors.append("Ventana de atribución de afiliados debe ser >= 30 días (recomendado 90d).")
        if ap.min_epc_usd < 1.0 or ap.min_epl_usd < 2.0:
            errors.append("Programa de afiliados bajo pisos mínimos PB16 Módulo 6.3 (EPC >= $1.00 y EPL >= $2.00).")
        if len(ap.commission_tiers) < 1:
            errors.append("Programa de afiliados activo requiere al menos 1 nivel en commission_tiers.")

    if m.cross_domain_bridge and m.cross_domain_bridge.enabled:
        cb = m.cross_domain_bridge
        if len(cb.target_domains) < 1:
            errors.append("Cross-domain CAPI bridge activo requiere al menos 1 dominio destino en target_domains.")
        if "fbp" not in cb.forward_params:
            errors.append("Cross-domain CAPI bridge requiere 'fbp' en forward_params.")
        if "event_source_url" not in cb.forward_params and "src" not in cb.forward_params:
            errors.append("Cross-domain CAPI bridge requiere 'event_source_url' o 'src' en forward_params.")

    bridges_seen: set[Tuple[str, str, str]] = set()
    for br in m.cross_funnel_bridges:
        if br.source_branch == br.target_branch:
            errors.append(f"Cross-funnel bridge '{br.bridge_id}' tiene self-loop ('{br.source_branch}' -> '{br.target_branch}').")
        key = (br.source_branch, br.target_branch, br.trigger_stage)
        if key in bridges_seen:
            errors.append(f"Cross-funnel bridge duplicado para {br.source_branch} -> {br.target_branch} ({br.trigger_stage}).")
        bridges_seen.add(key)
        if br.trigger_stage == "lifecycle_nurture" and br.delay_days < 7:
            errors.append(f"Cross-funnel bridge '{br.bridge_id}' en lifecycle_nurture requiere delay_days >= 7 (días 0-6 son exclusivos de la oferta principal).")

    if m.omnichannel_anti_collision:
        op = m.omnichannel_anti_collision
        if op.primary_focus_lock_days < 5:
            errors.append("OmnichannelInterlacePolicy requiere primary_focus_lock_days >= 5.")
        if op.max_active_bridge_sequences != 1:
            errors.append("OmnichannelInterlacePolicy requiere max_active_bridge_sequences == 1 para no saturar al contacto.")
        if op.cross_channel_suppression_hours < 12:
            errors.append("OmnichannelInterlacePolicy requiere cross_channel_suppression_hours >= 12.")
        if not op.state_tags_required:
            errors.append("OmnichannelInterlacePolicy requiere state_tags_required == True.")

    return len(errors) == 0, errors


def validate_campaign_landing(raw: Dict[str, Any]) -> Tuple[bool, List[str]]:
    """Deterministic Pydantic v2 gate for Ads-First CampaignLandingSpec payloads."""
    errors: List[str] = []
    try:
        spec = CampaignLandingSpec.model_validate(raw)
    except Exception as ex:
        return False, [str(ex)]

    if not spec.route_path.startswith("/"):
        errors.append("route_path debe comenzar por '/'.")
    for forbidden_prefix in ("/checkout", "/app", "/admin", "/gracias"):
        if spec.route_path == forbidden_prefix or spec.route_path.startswith(forbidden_prefix + "/"):
            errors.append(f"route_path '{spec.route_path}' colisiona con ruta privada/transaccional '{forbidden_prefix}'.")

    if spec.ad_creative.utm.allow_on_internal_links:
        errors.append("ad_creative.utm.allow_on_internal_links debe ser False (prohibido UTM interno).")

    if spec.robots.startswith("index") and not (spec.seo_cluster_id and spec.seo_cluster_id.strip()):
        errors.append("Campaña con robots='index, follow' requiere seo_cluster_id explícito para evitar canibalización SEO.")

    lm = spec.lead_magnet
    if lm.mechanism in (
        LeadMagnetMechanismType.FREEDOM_LEVERAGE_INDEX,
        LeadMagnetMechanismType.DIAGNOSTIC_QUIZ,
        LeadMagnetMechanismType.ROI_COST_GAP,
        LeadMagnetMechanismType.COMMISSION_SIMULATOR,
    ):
        if len(lm.inputs) < 1:
            errors.append(f"lead_magnet '{lm.mechanism.value}' requiere al menos 1 entrada en inputs.")
        if len(lm.outputs) < 1:
            errors.append(f"lead_magnet '{lm.mechanism.value}' requiere al menos 1 salida en outputs.")
        if not lm.title.strip():
            errors.append(f"lead_magnet '{lm.mechanism.value}' requiere title.")

    if not spec.wa_email_campaign_tag.startswith(("camp:", "entered:")):
        errors.append("wa_email_campaign_tag debe iniciar con 'camp:' o 'entered:' para segmentación sin colisiones.")

    return len(errors) == 0, errors


# =====================================================================
# 2. STRING & SLUG HELPERS
# =====================================================================

def slugify(text: str) -> str:
    """Convert arbitrary text into a clean kebab-case slug."""
    text = text.lower().strip()
    text = re.sub(r'[áàäâ]', 'a', text)
    text = re.sub(r'[éèëê]', 'e', text)
    text = re.sub(r'[íìïî]', 'i', text)
    text = re.sub(r'[óòöô]', 'o', text)
    text = re.sub(r'[úùüû]', 'u', text)
    text = re.sub(r'[ñ]', 'n', text)
    text = re.sub(r'[^a-z0-9]+', '-', text)
    return text.strip('-')


def infer_funnel_type(text_sample: str) -> Tuple[str, List[str]]:
    """Infer funnel type and standard telemetry events from semantic keywords."""
    t = text_sample.lower()

    # 1. Check for explicit funnel declaration
    m_funnel = re.search(r'(?:funnel|tipo\s+funnel|funnel_type):\s*([a-z_]+)', t)
    if m_funnel:
        declared = m_funnel.group(1).strip()
        if hasattr(CommercialFunnelType, declared.upper()):
            val = getattr(CommercialFunnelType, declared.upper())
            if val == CommercialFunnelType.BOOKING_CALENDAR:
                return val, ["Schedule", "Lead"]
            elif val == CommercialFunnelType.DIRECT_CHECKOUT:
                return val, ["Purchase", "InitiateCheckout"]
            elif val == CommercialFunnelType.SUBSCRIPTION:
                return val, ["Subscribe", "InitiateCheckout"]
            elif val == CommercialFunnelType.CONTENT_COMMUNITY:
                return val, ["CompleteRegistration", "Subscribe"]
            elif val == CommercialFunnelType.APPLICATION_FLOW:
                return val, ["ViewContent", "InitiateApplication", "Lead"]
            elif val == CommercialFunnelType.PWYW_REPORT:
                return val, ["ViewContent", "InitiateCheckout", "Purchase"]
            elif val == CommercialFunnelType.LOCAL_SERVICE:
                return val, ["ViewContent", "SchedulePhysicalVisit", "Lead"]
            elif val == CommercialFunnelType.BOOK_WAITLIST:
                return val, ["ViewContent", "JoinWaitlist", "Lead"]
            elif val == CommercialFunnelType.READY_NOW_BIFURCATED_SLO_APPLICATION:
                return val, ["ViewContent", "Lead", "InitiateCheckout", "Purchase"]
            return val, ["Lead", "Contact"]

    # 2. Check keyword patterns
    if any(k in t for k in ["ready_now_bifurcated_slo_application", "ready-now", "bifurcated", "bifurcado", "diagnostico pwyw"]):
        return CommercialFunnelType.READY_NOW_BIFURCATED_SLO_APPLICATION, ["ViewContent", "Lead", "InitiateCheckout", "Purchase"]

    if any(k in t for k in ["cita", "agenda", "calendario", "booking_calendar", "consulta", "sesion", "sesión", "reserva", "booking"]):
        return CommercialFunnelType.BOOKING_CALENDAR, ["Schedule", "Lead"]

    if any(k in t for k in ["postula", "admis", "mentoría 1 a 1", "mentoria 1 a 1", "mentoría 1:1", "mentoria 1:1", "high-ticket", "monopolio personal"]):
        return CommercialFunnelType.APPLICATION_FLOW, ["ViewContent", "InitiateApplication", "Lead"]

    if any(k in t for k in ["paga lo que quieras", "pwyw", "aporte voluntario", "precio flexible"]):
        return CommercialFunnelType.PWYW_REPORT, ["ViewContent", "InitiateCheckout", "Purchase"]

    if any(k in t for k in ["visita física", "visita presencial", "reclamar negocio", "ficha maps"]):
        return CommercialFunnelType.LOCAL_SERVICE, ["ViewContent", "SchedulePhysicalVisit", "Lead"]

    if any(k in t for k in ["saga", "lista de espera de libro", "waitlist", "saga editorial"]):
        return CommercialFunnelType.BOOK_WAITLIST, ["ViewContent", "JoinWaitlist", "Lead"]

    if any(k in t for k in ["suscripci", "recurren", "mensual", "membres", "saas", "software"]):
        return CommercialFunnelType.SUBSCRIPTION, ["Subscribe", "InitiateCheckout"]

    if any(k in t for k in ["comunidad", "newsletter", "curso", "academia", "taller", "ebook"]):
        return CommercialFunnelType.CONTENT_COMMUNITY, ["CompleteRegistration", "Subscribe"]

    if any(k in t for k in ["tienda", "carrito", "comprar", "envio", "envío", "contra entrega", "cod", "flete", "calzado", "ropa", "activewear", "producto"]):
        return CommercialFunnelType.DIRECT_CHECKOUT, ["Purchase", "InitiateCheckout"]

    # Clean default: consultative / lead gen
    return CommercialFunnelType.LEAD_GENERATION, ["Lead", "Contact"]


# =====================================================================
# 3. AGNOSTIC EXTRACTION PIPELINE (DOCX, PDF, MD, YAML/JSON)
# =====================================================================

def extract_from_text(content: str, source_name: str) -> List[DynamicVerticalSpec]:
    """Extract business verticals from raw text content agnostically."""
    verticals: List[DynamicVerticalSpec] = []
    if not content or len(content.strip()) < 10:
        return verticals

    # 1. Segment text into distinct Markdown tables
    tables: List[List[str]] = []
    current_table: List[str] = []
    for line in content.splitlines():
        line_s = line.strip()
        if line_s.startswith('|') and line_s.endswith('|'):
            current_table.append(line_s)
        else:
            if current_table:
                tables.append(current_table)
                current_table = []
    if current_table:
        tables.append(current_table)

    # Process each discovered table independently
    for tbl in tables:
        if len(tbl) < 2:
            continue
        headers = [c.strip().lower() for c in tbl[0].strip('|').split('|') if c.strip()]
        data_rows = tbl[1:]
        # Skip separator row |--|--|
        if data_rows and re.match(r'^[\s\-:|]+$', data_rows[0].strip('|')):
            data_rows = data_rows[1:]

        # Identify candidate column with entity name
        col_idx = -1
        for i, h in enumerate(headers):
            if any(k in h for k in ["proyecto", "firma", "vertical", "marca", "producto", "servicio", "linea", "línea"]):
                col_idx = i
                break

        if col_idx >= 0:
            for r in data_rows:
                cells = [c.strip() for c in r.strip('|').split('|')]
                if len(cells) > col_idx:
                    name_cell = re.sub(r'\s*\(\d+\)\s*', '', cells[col_idx]).strip()
                    desc_cell = " ".join(cells[col_idx+1:]) if len(cells) > col_idx + 1 else name_cell
                    # Split multiple sub-entities if separated by / or ,
                    candidates = [c.strip() for c in name_cell.split("/") if c.strip()]
                    for cand in candidates:
                        v_slug = slugify(cand)
                        if len(v_slug) > 2 and not any(v.vertical_slug == v_slug for v in verticals):
                            fn, evts = infer_funnel_type(desc_cell)
                            verticals.append(DynamicVerticalSpec(
                                vertical_slug=v_slug,
                                display_name=cand,
                                funnel_type=fn,
                                target_avatar={"pain_points": [f"Desafío identificado en {cand}"], "source_document": source_name},
                                unique_mechanism={"name": f"Metodología {cand}"},
                                primary_offer={"structure": f"Propuesta {cand}"},
                                conversion_events=evts
                            ))

    # 2. If no table yielded verticals, search for H1/H2 Headings
    if not verticals:
        headings = re.findall(r'^(?:#|##)\s+(.+)$', content, re.MULTILINE)
        if headings:
            for h in headings:
                clean_title = re.sub(r'^(vertical|linea|marca|servicio):\s*', '', h.strip(), flags=re.IGNORECASE)
                v_slug = slugify(clean_title)
                if len(v_slug) > 2 and not any(v.vertical_slug == v_slug for v in verticals):
                    fn, evts = infer_funnel_type(content[:2000])
                    verticals.append(DynamicVerticalSpec(
                        vertical_slug=v_slug,
                        display_name=clean_title,
                        funnel_type=fn,
                        target_avatar={"pain_points": [f"Necesidad central en {clean_title}"], "source_document": source_name},
                        unique_mechanism={"name": f"Mecanismo {clean_title}"},
                        primary_offer={"structure": f"Programa {clean_title}"},
                        conversion_events=evts
                    ))

    return verticals


def extract_from_text_or_md(file_path: Path) -> List[DynamicVerticalSpec]:
    """Extract business verticals from Markdown or plain text files agnostically."""
    try:
        content = file_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        print(f"⚠️ Warning reading {file_path.name}: {e}")
        return []

    verticals = extract_from_text(content, file_path.name)

    # Single document fallback if content exists but no structured sections
    if not verticals and len(content.strip()) > 50:
        base_name = file_path.stem.replace("-", " ").replace("_", " ").title()
        v_slug = slugify(base_name)
        if len(v_slug) > 2:
            fn, evts = infer_funnel_type(content[:1000])
            verticals.append(DynamicVerticalSpec(
                vertical_slug=v_slug,
                display_name=base_name,
                funnel_type=fn,
                target_avatar={"pain_points": [f"Punto de dolor extraído de {file_path.name}"], "source_document": file_path.name},
                unique_mechanism={"name": f"Tesis {base_name}"},
                primary_offer={"structure": f"Oferta {base_name}"},
                conversion_events=evts
            ))

    return verticals


def extract_from_docx(file_path: Path) -> List[DynamicVerticalSpec]:
    """Extract business verticals from DOCX files supporting XML tables, text tables, and headings."""
    verticals: List[DynamicVerticalSpec] = []
    ns = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}

    try:
        with zipfile.ZipFile(file_path) as z:
            xml_data = z.read("word/document.xml")
            root = ET.fromstring(xml_data)
    except Exception as e:
        print(f"⚠️ Warning reading docx {file_path.name}: {e}")
        return []

    # 1. Strategy A: Real Word XML Tables (<w:tbl>)
    for tbl in root.findall(".//w:tbl", ns):
        rows = tbl.findall(".//w:tr", ns)
        if len(rows) < 2:
            continue

        header_cells = ["".join(tc.itertext()).strip().lower() for tc in rows[0].findall(".//w:tc", ns)]
        col_idx = -1
        for i, h in enumerate(header_cells):
            if any(k in h for k in ["proyecto", "firma", "vertical", "marca", "producto", "servicio", "linea", "línea"]):
                col_idx = i
                break

        if col_idx >= 0:
            for row in rows[1:]:
                cells = ["".join(tc.itertext()).strip() for tc in row.findall(".//w:tc", ns)]
                if len(cells) > col_idx:
                    name_cell = re.sub(r'\s*\(\d+\)\s*', '', cells[col_idx]).strip()
                    desc_cell = " ".join(cells[col_idx+1:]) if len(cells) > col_idx + 1 else name_cell
                    candidates = [c.strip() for c in name_cell.split("/") if c.strip()]
                    for cand in candidates:
                        v_slug = slugify(cand)
                        if len(v_slug) > 2 and not any(v.vertical_slug == v_slug for v in verticals):
                            fn, evts = infer_funnel_type(desc_cell)
                            verticals.append(DynamicVerticalSpec(
                                vertical_slug=v_slug,
                                display_name=cand,
                                funnel_type=fn,
                                target_avatar={"pain_points": [f"Demanda detectada en {cand}"], "source_document": file_path.name},
                                unique_mechanism={"name": f"Mecanismo {cand}"},
                                primary_offer={"structure": f"Oferta {cand}"},
                                conversion_events=evts
                            ))

    # 2. Strategy B: Text-based Markdown Tables inside Paragraphs
    if not verticals:
        full_text = "\n".join("".join(p.itertext()).strip() for p in root.findall(".//w:p", ns) if "".join(p.itertext()).strip())
        verticals = extract_from_text(full_text, file_path.name)

    # 3. Strategy C: Single Document Fallback
    if not verticals:
        clean_name = file_path.stem.replace("-", " ").replace("_", " ").title()
        v_slug = slugify(clean_name)
        if len(v_slug) > 2:
            fn, evts = infer_funnel_type(clean_name)
            verticals.append(DynamicVerticalSpec(
                vertical_slug=v_slug,
                display_name=clean_name,
                funnel_type=fn,
                target_avatar={"pain_points": [f"Demanda extraída de {file_path.name}"], "source_document": file_path.name},
                unique_mechanism={"name": f"Tesis {clean_name}"},
                primary_offer={"structure": f"Oferta {clean_name}"},
                conversion_events=evts
            ))

    return verticals


def extract_from_pdf(file_path: Path) -> List[DynamicVerticalSpec]:
    """Extract business verticals from PDF files using pdftotext or filename analysis."""
    verticals: List[DynamicVerticalSpec] = []
    pdf_text = ""
    noise_words = {"nivel", "niveles", "servicio", "servicios", "ejemplo", "descripcion", "descripción", "plano", "elemento", "vibracion", "vibración"}

    try:
        pdf_text = subprocess.check_output(["pdftotext", str(file_path), "-"], stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
    except Exception:
        pdf_text = ""

    # Check for explicit vertical headers anchored at line start
    if pdf_text:
        sections = re.findall(r'^\s*(?:Vertical|Línea de Negocio|Línea|Producto|Oferta):\s*([^\n\r]+)', pdf_text, re.IGNORECASE | re.MULTILINE)
        for s in sections:
            s_clean = s.strip()
            v_slug = slugify(s_clean)
            if len(v_slug) > 2 and v_slug not in noise_words and not any(v.vertical_slug == v_slug for v in verticals):
                fn, evts = infer_funnel_type(s_clean)
                verticals.append(DynamicVerticalSpec(
                    vertical_slug=v_slug,
                    display_name=s_clean,
                    funnel_type=fn,
                    target_avatar={"pain_points": [f"Necesidad identificada en {s_clean}"], "source_document": file_path.name},
                    unique_mechanism={"name": f"Mecanismo {s_clean}"},
                    primary_offer={"structure": f"Oferta {s_clean}"},
                    conversion_events=evts
                ))

    # If no multiple sections found, treat the PDF monograph as a cohesive vertical
    if not verticals:
        clean_name = file_path.stem.replace("Que es ", "").replace("que es ", "").replace("-", " ").replace("_", " ").strip().title()
        v_slug = slugify(clean_name)
        if len(v_slug) > 2:
            fn, evts = infer_funnel_type(pdf_text[:1000] if pdf_text else clean_name)
            verticals.append(DynamicVerticalSpec(
                vertical_slug=v_slug,
                display_name=clean_name,
                funnel_type=fn,
                target_avatar={"pain_points": [f"Solución documental y conceptual en {clean_name}"], "source_document": file_path.name},
                unique_mechanism={"name": f"Tesis {clean_name}"},
                primary_offer={"structure": f"Programa {clean_name}"},
                conversion_events=evts
            ))

    return verticals


# =====================================================================
# AGNOSTIC SEMANTIC CORPUS SYNTHESIS
# =====================================================================

OFFERING_FORMAT_KEYWORDS = {
    "mentoria", "mentoría", "consultoria", "consultoría", "servicio", "servicios",
    "agencia", "asesoria", "asesoría", "coaching", "taller", "training",
    "academia", "saas", "software", "app", "plataforma", "tienda", "store", "shop"
}

NOISE_DOMAINS = {
    "w3.org", "schemas.openxmlformats.org", "purl.org", "xml.org", "schema.org",
    "github.com", "microsoft.com", "apple.com", "google.com", "adobe.com",
    "tunegocio.com", "ejemplo.com", "example.com"
}

def extract_agnostic_domains(text: str) -> List[str]:
    """Extract candidate domain names and routes from arbitrary text, filtering vendor schemas."""
    pattern = r'\b([a-zA-Z0-9][-a-zA-Z0-9]*(?:\.[a-zA-Z0-9][-a-zA-Z0-9]*)*\.(?:com|co|io|org|net|lat|ai|app|dev|biz|info)(?:/[a-zA-Z0-9._~:/?#[\]@!$&\'()*+,;=-]*)?)\b'
    matches = re.findall(pattern, text, re.IGNORECASE)
    cleaned = []
    for m in matches:
        m_clean = m.rstrip('/.,;:')
        m_lower = m_clean.lower()
        if any(noise in m_lower for noise in NOISE_DOMAINS):
            continue
        if m_lower not in [c.lower() for c in cleaned]:
            cleaned.append(m_clean)
    return cleaned


def extract_agnostic_pricing_tiers(text: str) -> List[Dict[str, str]]:
    """Agnostically extract pricing tiers and monetary scopes from unstructured document text."""
    tiers = []
    price_pattern = re.compile(
        r'(?:(?:\$|USD|COP|EUR|€|ARS|MXN)\s*[\d\.,]+(?:\s*[-–a]\s*[\d\.,]+)?|[\d\.,]+\s*(?:COP|USD|EUR|dólares|pesos)|(?:gratis|gratuito|\$0))',
        re.IGNORECASE
    )
    for line in text.splitlines():
        line_clean = line.strip().strip('-*•').strip()
        if not line_clean:
            continue
        if price_pattern.search(line_clean) and any(kw in line_clean.lower() for kw in ["diagnóstico", "diagnostico", "básico", "basico", "completo", "plan", "paquete", "tarifa", "precio", "inversión", "inversion", "tier", "$", "cobrar"]):
            m = price_pattern.search(line_clean)
            price_str = m.group(0).strip()
            parts = line_clean.split(":", 1)
            if len(parts) == 2:
                tier_title = parts[0].strip()
                tier_scope = parts[1].strip()
            else:
                tier_title = line_clean[:m.start()].strip(" :-") or "Nivel de Servicio"
                tier_scope = line_clean[m.end():].strip(" :-()") or line_clean
            tiers.append({
                "tier": tier_title or "Tarifa",
                "price": price_str,
                "scope": tier_scope or line_clean
            })
    return tiers[:5]


def extract_agnostic_subthemes(text: str, filename: str) -> List[str]:
    """Agnostically extract author subthemes, proprietary pillars, and doctrinal concepts."""
    subthemes = []
    stem = filename
    for ext in [".pdf", ".docx", ".md", ".txt"]:
        if stem.lower().endswith(ext):
            stem = stem[:-len(ext)]
    clean_stem = re.sub(r'^(?:que\s+es|qué\s+es|metodología|metodologia|framework|doctrina|tesis|el\s+metodo|el\s+método|protocolo\s+de|prompts\s+)\s+', '', stem, flags=re.IGNORECASE).strip()
    clean_stem = re.sub(r'\(.*?\)', '', clean_stem).strip()
    if clean_stem and len(clean_stem) > 2 and clean_stem.lower() not in ("verticales", "verticals", "dev", "documento", "archivo"):
        subthemes.append(clean_stem.title())

    # 1. Terms explicitly introduced or grouped (e.g. 'términos como metodología o doctrina')
    m_terms = re.findall(r'(?:términos|conceptos|métodos|disciplinas|subtemas|pilares)\s+como\s+([^\n\r.]+)', text, re.IGNORECASE)
    for mt in m_terms:
        for word in re.split(r'[\s,y/]+|(?:\s+o\s+)', mt):
            w = word.strip().strip('.,;:()')
            if len(w) > 3 and w.lower() not in ('como', 'para', 'este', 'esta', 'otros', 'otra'):
                if w.title() not in subthemes:
                    subthemes.append(w.title())

    # 2. Table-defined terms or categories (e.g. lines under 'Término' or 'Metodología')
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    for i, l in enumerate(lines):
        if l.lower() in ('término', 'termino', 'disciplina', 'subtema', 'pilar'):
            for next_l in lines[i+1:i+15]:
                if len(next_l) > 3 and next_l[0].isupper() and next_l.isalpha() and next_l.lower() not in ('etimología', 'etimologia', 'significado', 'propuesto', 'uso', 'ecosistema'):
                    if next_l.title() not in subthemes:
                        subthemes.append(next_l.title())

    # 3. Headings with foundational principles, modules or methods
    for line in lines:
        line_s = line.strip().strip('-*•').strip()
        m_head = re.match(r'^##\s*\d*[\.:\s]*(?:[A-ZÁÉÍÓÚ\s]+:\s*)?([A-ZÁÉÍÓÚa-záéíóú\s]+)', line_s)
        if m_head:
            c = m_head.group(1).strip().title()
            c = re.sub(r'^(?:Principio Fundamental|Protocolo De Interacción Proactiva|Lógica De La|Algoritmo De)\s*', '', c, flags=re.IGNORECASE).strip()
            if c and len(c) > 3 and c not in subthemes and len(c) < 35:
                subthemes.append(c)
        m_bold = re.findall(r'\*\*([A-ZÁÉÍÓÚ][a-záéíóúA-ZÁÉÍÓÚ\s]{3,30})\*\*', line)
        for b in m_bold:
            b_clean = b.strip().title()
            if any(k in b_clean for k in ['Interrogatorio', 'Apotelos', 'Causal', 'Omega', 'Triada', 'Tríada']):
                if b_clean not in subthemes:
                    subthemes.append(b_clean)

        m = re.match(r'^(?:(?:pilar|sistema|protocolo|dimension|dimensión|ley|fundamento|fase|módulo|modulo)\s+([A-ZÁÉÍÓÚ][a-záéíóúA-ZÁÉÍÓÚ\s]{2,30}))', line_s, re.IGNORECASE)
        if m:
            concept = m.group(0).strip().title()
            if concept not in subthemes and len(concept) < 40:
                subthemes.append(concept)
        triads = re.findall(r'\b([A-ZÁÉÍÓÚ][a-zñáéíóú]{4,15})\s*,\s*([A-ZÁÉÍÓÚ][a-zñáéíóú]{4,15})(?:\s*(?:y|,)\s*([A-ZÁÉÍÓÚ][a-zñáéíóú]{4,15}))?\b', line)
        for t in triads:
            for item in t:
                if item and item.lower() not in ("colombia", "bogota", "medellin", "enero", "febrero", "lunes", "martes", "google", "maps", "empresa", "negocio", "cuando"):
                    item_title = item.title()
                    if item_title not in subthemes:
                        subthemes.append(item_title)

    noise_subthemes = {
        "estereotipia", "nthemika", "profundo", "marca", "estere", "tipia",
        "raíz", "raiz", "como", "para", "este", "esta", "otro", "otra",
        "archivo", "documento", "cuando", "donde", "quien", "sobre"
    }
    cleaned_subthemes = []
    for s in subthemes:
        s_clean = s.strip().strip(".-_")
        if s_clean.lower() not in noise_subthemes and len(s_clean) >= 4:
            if s_clean not in cleaned_subthemes:
                cleaned_subthemes.append(s_clean)
    return cleaned_subthemes[:8]


def synthesize_corpus_ecosystem(v_dir: Path, brand_name: str) -> Optional[UniversalBrandEcosystem]:
    """Perform holistic multi-document semantic synthesis across primary sources agnostically."""
    docs_text: Dict[str, str] = {}
    docs_tables: Dict[str, List[List[str]]] = {}
    ns = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}

    for f in sorted(v_dir.iterdir()):
        if f.name.startswith("."):
            continue
        if f.suffix == ".docx":
            try:
                with zipfile.ZipFile(f) as z:
                    xml_data = z.read("word/document.xml")
                root = ET.fromstring(xml_data)
                text = "\n".join("".join(p.itertext()).strip() for p in root.findall(".//w:p", ns) if "".join(p.itertext()).strip())
                docs_text[f.name] = text
                
                parsed_tbls = []
                for tbl in root.findall(".//w:tbl", ns):
                    tbl_rows = []
                    for tr in tbl.findall(".//w:tr", ns):
                        cells = ["".join(tc.itertext()).strip() for tc in tr.findall(".//w:tc", ns)]
                        if cells:
                            tbl_rows.append(cells)
                    if tbl_rows:
                        parsed_tbls.append(tbl_rows)
                
                current_tbl = []
                for line in text.splitlines():
                    ls = line.strip()
                    if ls.startswith("|") and ls.endswith("|"):
                        cells = [c.strip() for c in ls.strip("|").split("|")]
                        if not re.match(r'^[\s\-:|]+$', "".join(cells)):
                            current_tbl.append(cells)
                    else:
                        if len(current_tbl) >= 2:
                            parsed_tbls.append(current_tbl)
                            current_tbl = []
                if len(current_tbl) >= 2:
                    parsed_tbls.append(current_tbl)

                if parsed_tbls:
                    docs_tables[f.name] = parsed_tbls
            except Exception:
                pass
        elif f.suffix == ".pdf":
            try:
                text = subprocess.check_output(["pdftotext", str(f), "-"], stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
                docs_text[f.name] = text
            except Exception:
                pass
        elif f.suffix in (".md", ".txt"):
            try:
                text = f.read_text(encoding="utf-8", errors="ignore")
                docs_text[f.name] = text
                lines = text.splitlines()
                current_tbl = []
                parsed_tbls = []
                for l in lines:
                    ls = l.strip()
                    if ls.startswith("|") and ls.endswith("|"):
                        cells = [c.strip() for c in ls.strip("|").split("|")]
                        if not re.match(r'^[\s\-:|]+$', "".join(cells)):
                            current_tbl.append(cells)
                    else:
                        if len(current_tbl) >= 2:
                            parsed_tbls.append(current_tbl)
                            current_tbl = []
                if len(current_tbl) >= 2:
                    parsed_tbls.append(current_tbl)
                if parsed_tbls:
                    docs_tables[f.name] = parsed_tbls
            except Exception:
                pass

    if not docs_text:
        return None

    full_corpus = "\n\n".join(docs_text.values())
    all_domains = extract_agnostic_domains(full_corpus)
    root_domains = [d for d in all_domains if "/" not in d]
    subroute_domains = [d for d in all_domains if "/" in d]

    monograph_subthemes: List[str] = []
    monograph_files: List[str] = []
    for fname, txt in docs_text.items():
        stem_lower = fname.lower()
        is_monograph = (
            any(k in stem_lower for k in ["que es", "qué es", "metodologia", "metodología", "tesis", "framework", "doctrina", "filosofia", "filosofía"]) or
            (len(txt) > 500 and not any(k in txt.lower() for k in ["precio", "precios", "$", "usd", "cop", "cotizacion", "cotización", "tarifa"]) and any(k in txt.lower() for k in ["tesis", "metodología", "concepto", "arquetipo", "filosofía", "doctrina"]))
        )
        if is_monograph:
            st = extract_agnostic_subthemes(txt, fname)
            for s in st:
                if s not in monograph_subthemes:
                    monograph_subthemes.append(s)
            monograph_files.append(fname)

    verticals_map: Dict[str, DynamicVerticalSpec] = {}
    candidate_entities: List[Dict[str, Any]] = []

    # 1. Parse Structured Tables
    for fname, tbls in docs_tables.items():
        for tbl in tbls:
            if len(tbl) < 2:
                continue
            headers = [c.lower() for c in tbl[0]]
            col_idx = -1
            for i, h in enumerate(headers):
                if any(k in h for k in ["proyecto", "firma", "vertical", "marca", "producto", "servicio", "linea", "línea"]):
                    col_idx = i
                    break
            if col_idx >= 0:
                for row in tbl[1:]:
                    if len(row) > col_idx:
                        raw_name = re.sub(r'\s*\(\d+\)\s*', '', row[col_idx]).strip()
                        raw_desc = " ".join(row[col_idx+1:]) if len(row) > col_idx + 1 else raw_name
                        if not raw_name:
                            continue
                        parts = [p.strip() for p in raw_name.split("/") if p.strip()]
                        if len(parts) == 2 and any(kw in parts[1].lower() for kw in OFFERING_FORMAT_KEYWORDS):
                            entity_name = parts[0]
                            offering_fmt = parts[1].capitalize()
                            candidate_entities.append({
                                "slug": slugify(entity_name),
                                "display_name": f"{entity_name} — {offering_fmt}",
                                "is_umbrella": True,
                                "desc": raw_desc,
                                "source_file": fname
                            })
                        else:
                            for p in parts:
                                candidate_entities.append({
                                    "slug": slugify(p),
                                    "display_name": p,
                                    "is_umbrella": False,
                                    "desc": raw_desc,
                                    "source_file": fname
                                })

    # Also detect standalone brands/platforms explicitly defined in prose
    for line in full_corpus.splitlines():
        m = re.search(r'(?:proyecto|plataforma|marca|ecosistema)\s+(?:como\s+)?([A-ZÁÉÍÓÚ][a-záéíóúA-ZÁÉÍÓÚ0-9]{3,20})\b', line)
        if m:
            found_brand = m.group(1).strip()
            b_slug = slugify(found_brand)
            if b_slug and len(b_slug) > 2 and b_slug not in ("como", "para", "este", "esta", "cada", "todo"):
                if not any(c["slug"] == b_slug for c in candidate_entities):
                    candidate_entities.append({
                        "slug": b_slug,
                        "display_name": found_brand,
                        "is_umbrella": False,
                        "desc": line.strip(),
                        "source_file": "Mención explícita en texto"
                    })

    # Assemble Primary & Table Entities
    for ent in candidate_entities:
        e_slug = ent["slug"]
        if e_slug in verticals_map or len(e_slug) < 2:
            continue
        
        matched_domain = None
        domain_strat = "subroute"
        for rd in root_domains:
            rd_clean = rd.split('/')[0].lower()
            if e_slug in rd_clean or rd_clean.startswith(e_slug):
                matched_domain = rd_clean
                domain_strat = "custom_domain"
                break

        fn, evts = infer_funnel_type(ent["desc"])
        is_primary = ent.get("is_umbrella") or (brand_name and brand_name.lower() in e_slug)
        sub = monograph_subthemes if is_primary else []
        mechanism_desc = f"Metodología integral ({', '.join(sub)})" if sub else f"Mecanismo de {ent['display_name']}"

        verticals_map[e_slug] = DynamicVerticalSpec(
            vertical_slug=e_slug,
            display_name=ent["display_name"],
            funnel_type=fn,
            domain_strategy=domain_strat,
            custom_domain=matched_domain,
            subthemes=sub,
            target_avatar={
                "pain_points": [f"Desafíos estratégicos y operativos en {ent['display_name']}"],
                "desires": [f"Posicionamiento soberano y categoría única en {ent['display_name']}"],
                "source_document": ent["source_file"]
            },
            unique_mechanism={
                "name": mechanism_desc,
                "subthemes": sub
            },
            primary_offer={
                "structure": f"Programa y Servicios de {ent['display_name']}",
                "pricing": "A consultar / Consultoría directa"
            },
            conversion_events=evts,
            metadata={"source_file": ent["source_file"]}
        )

    # 2. Identify Dedicated Service, Campaign, Methodology or Protocol Documents
    for fname, txt in docs_text.items():
        if fname in monograph_files:
            continue
        
        pricing_tiers = extract_agnostic_pricing_tiers(txt)
        has_service_focus = (
            bool(pricing_tiers) or
            any(k in fname.lower() for k in ["servicio", "service", "auditoria", "auditoría", "gbp", "seo", "campaña", "landing", "pack", "cobrar"])
        )
        has_protocol_focus = (
            any(k in fname.lower() for k in ["protocolo", "protocol", "metodo", "método", "sistema", "framework", "prompt", "manifiesto"]) or
            any(re.search(r'#(?:#)?\s*(?:sistema|protocolo|metodo|método|framework)', l, re.IGNORECASE) for l in txt.splitlines()[:10])
        )

        if has_service_focus or has_protocol_focus:
            first_heading = ""
            for l in txt.splitlines():
                if l.startswith("#"):
                    first_heading = l.lstrip("#").strip()
                    break
            
            clean_name = first_heading or fname
            for ext in [".pdf", ".docx", ".md", ".txt"]:
                if clean_name.lower().endswith(ext):
                    clean_name = clean_name[:-len(ext)]
            
            clean_name = re.sub(r'^(?:system\s+prompt:\s*|servicio|service|guia|guía|plan|auditoria|auditoría|manual\s+de\s*|el\s+metodo\s+de\s*|el\s+método\s+de\s*)', '', clean_name, flags=re.IGNORECASE).strip()
            clean_name = re.sub(r'\(.*?\)', '', clean_name).strip()
            clean_name = re.sub(r'v\d+(\.\d+)*', '', clean_name, flags=re.IGNORECASE).strip(' -:')

            if "GBP" in clean_name.upper() or "Google" in clean_name:
                clean_name = "Google Business Profile Colombia — Reclamación & SEO Local"
                srv_slug = "gbp-seo"
            elif "APOTELOS" in clean_name.upper():
                clean_name = "Protocolo Apotelos"
                srv_slug = "apotelos"
            elif len(clean_name.split()) > 4:
                words = clean_name.split()
                clean_name = " ".join(words[:4]).title()
                srv_slug = slugify(clean_name)
            else:
                srv_slug = slugify(clean_name)

            if srv_slug in verticals_map:
                existing_v = verticals_map[srv_slug]
                doc_subthemes = extract_agnostic_subthemes(txt, fname) if has_protocol_focus else []
                for st in doc_subthemes:
                    if st not in existing_v.subthemes:
                        existing_v.subthemes.append(st)
                if isinstance(existing_v.target_avatar, dict):
                    srcs = existing_v.target_avatar.get("source_document", "")
                    if fname not in srcs:
                        existing_v.target_avatar["source_document"] = f"{srcs}, {fname}"
            elif srv_slug not in verticals_map and len(srv_slug) > 2:
                matched_subroute = None
                for srd in subroute_domains:
                    if srv_slug in srd.lower() or any(w in srd.lower() for w in srv_slug.split('-')):
                        matched_subroute = srd
                        break
                
                if not matched_subroute and root_domains:
                    primary_rd = root_domains[0].split('/')[0]
                    matched_subroute = f"{primary_rd}/{srv_slug}"

                fn, evts = infer_funnel_type(txt[:2000])
                
                pain_candidates = []
                for line in txt.splitlines():
                    if any(kw in line.lower() for kw in ["problema", "dolor", "pain", "desafío", "riesgo", "perder", "suspens"]):
                        pain_candidates.append(line.strip().strip('-*•').strip())
                if not pain_candidates:
                    pain_candidates = [f"Necesidad de optimización y resultados en {clean_name}"]

                doc_subthemes = extract_agnostic_subthemes(txt, fname) if has_protocol_focus else (["SEO Local", "Optimización", clean_name] if "seo" in srv_slug else [clean_name])

                verticals_map[srv_slug] = DynamicVerticalSpec(
                    vertical_slug=srv_slug,
                    display_name=clean_name,
                    funnel_type=fn,
                    domain_strategy="subroute",
                    custom_domain=matched_subroute,
                    subthemes=doc_subthemes,
                    target_avatar={
                        "pain_points": pain_candidates[:3],
                        "source_document": fname
                    },
                    unique_mechanism={
                        "name": f"Metodología de entrega y optimización de {clean_name}"
                    },
                    primary_offer={
                        "structure": f"Paquete y estructura de {clean_name}",
                        "pricing_tiers": pricing_tiers if pricing_tiers else [{"tier": "Estándar", "price": "A convenir", "scope": "Servicio profesional"}]
                    },
                    conversion_events=evts,
                    metadata={"source_file": fname}
                )

    if brand_name:
        b_slug = slugify(brand_name)
        primary_key = None
        for k in verticals_map:
            if b_slug in k or k in b_slug:
                primary_key = k
                break
        
        if primary_key:
            filtered_map = {}
            for k, v in verticals_map.items():
                if k == primary_key:
                    filtered_map[k] = v
                elif v.domain_strategy == "subroute":
                    filtered_map[k] = v
                elif v.custom_domain and any(tok in v.custom_domain for tok in [b_slug, primary_key, "baiosfera"]):
                    filtered_map[k] = v
                elif v.custom_domain:
                    filtered_map[k] = v
            verticals_map = filtered_map

    if verticals_map:
        clean_slug = slugify(brand_name)
        return UniversalBrandEcosystem(
            brand_slug=clean_slug,
            umbrella_name=brand_name.title() if brand_name else "Holding Ecosistema",
            verticals=verticals_map
        )

    return None


def extract_verticals_from_directory(v_dir: Path) -> Tuple[Optional[UniversalBrandEcosystem], Optional[str]]:
    """Scan a target directory and aggregate all dynamic verticals into a unified ecosystem."""
    verticals_map: Dict[str, DynamicVerticalSpec] = {}
    source_files: List[str] = []
    brand_name: Optional[str] = None

    # Check parent hierarchy for brandbook.json to resolve brand name
    for p in [v_dir, v_dir.parent, v_dir.parent.parent]:
        bb = p / "brandbook.json"
        if bb.exists():
            try:
                bd = json.loads(bb.read_text(encoding="utf-8"))
                brand_name = bd.get("metadata", {}).get("brand_name") or bd.get("identity", {}).get("brandName")
                if brand_name:
                    break
            except Exception:
                pass

    if not brand_name:
        # Infer brand name from directory hierarchy
        if v_dir.name in ("verticals", "dev", "verticales"):
            brand_name = v_dir.parent.name if v_dir.name in ("verticals", "verticales") and v_dir.parent.name != "dev" else v_dir.parent.parent.name
        else:
            brand_name = v_dir.name

    # 1. Tier 1: Look for JSON definitions first (curated specs or ecosystem.json)
    eco_data = {}
    eco_file = None
    for f in sorted(v_dir.iterdir()):
        if f.name.startswith("."):
            continue
        if f.suffix in (".json", ".yaml", ".yml"):
            try:
                if f.name in ("ecosystem.json", "ecosystem.yaml", "ecosystem.yml"):
                    eco_data = json.loads(f.read_text(encoding="utf-8")) if f.suffix == ".json" else {}
                    eco_file = str(f)
                else:
                    data = json.loads(f.read_text(encoding="utf-8")) if f.suffix == ".json" else {}
                    if "vertical_slug" in data:
                        v_obj = DynamicVerticalSpec.model_validate(data)
                        verticals_map[v_obj.vertical_slug] = v_obj
                        source_files.append(f.name)
            except Exception as e:
                print(f"⚠️ Warning parsing {f.name}: {e}")

    if eco_data or verticals_map:
        clean_slug = slugify(brand_name) if brand_name else "universal-brand"
        base_eco = {
            "brand_slug": clean_slug,
            "umbrella_name": brand_name.title() if brand_name else "Ecosistema Multimarca",
            "verticals": verticals_map
        }
        if eco_data:
            if "verticals" in eco_data and isinstance(eco_data["verticals"], dict):
                for k, v in eco_data["verticals"].items():
                    if k not in verticals_map:
                        verticals_map[k] = DynamicVerticalSpec.model_validate(v) if isinstance(v, dict) else v
            base_eco.update({k: v for k, v in eco_data.items() if k != "verticals"})
            base_eco["verticals"] = verticals_map

        eco = UniversalBrandEcosystem.model_validate(base_eco)
        sources_desc = eco_file if (eco_file and not source_files) else f"{v_dir} ({', '.join(source_files + ([Path(eco_file).name] if eco_file else []))})"
        return eco, sources_desc

    # 2. Tier 2: Deep semantic synthesis across primary source documents
    has_docs = any(f.suffix in (".docx", ".pdf", ".md", ".txt") for f in v_dir.iterdir() if not f.name.startswith("."))
    if has_docs:
        eco = synthesize_corpus_ecosystem(v_dir, brand_name)
        if eco and eco.verticals:
            src_list = [f.name for f in v_dir.iterdir() if f.suffix in (".docx", ".pdf", ".md", ".txt")]
            return eco, f"{v_dir} ({', '.join(src_list)})"

    return None, None


# =====================================================================
# 4. CASCADING DISCOVERY (Without Theater or Mock Fallbacks)
# =====================================================================

def get_workspace_root() -> Path:
    candidates = [Path.cwd(), Path("/var/www/zerops-astrobranding"), Path("/var/www")]
    for c in candidates:
        if (c / "brandbook.json").exists() or (c / ".apotelos").exists() or (c / "zerops.yaml").exists():
            return c
    return Path.cwd()


def get_local_storage_path() -> Path:
    if Path("/mnt/localstorage").exists():
        return Path("/mnt/localstorage")
    if Path("/var/www/localstorage").exists():
        return Path("/var/www/localstorage")
    env_path = os.getenv("LOCAL_STORAGE_PATH")
    if env_path and Path(env_path).exists():
        p = Path(env_path)
        if p.name in ("hermes", "paperclip", "engram", "pidev") and p.parent.exists():
            return p.parent
        return p
    return Path("/tmp/localstorage")


def resolve_playbooks_dir() -> Optional[Path]:
    """Resolve playbooks directory from the single canonical SSoT."""
    candidates = [
        Path("/mnt/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"),
        Path("/var/www/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"),
        Path("/var/www/baiosfera/KNOWLEDGE_HUB/02_PLAYBOOKS_MAESTROS"),
    ]
    for c in candidates:
        if c.exists() and c.is_dir():
            return c
    return None


def resolve_playbook_path(playbook_name: str) -> Optional[Path]:
    """Resolve a specific playbook file from the single canonical SSoT."""
    p_dir = resolve_playbooks_dir()
    if p_dir:
        target = p_dir / playbook_name
        if target.exists() and target.is_file():
            return target
    for base in [
        Path("/mnt/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"),
        Path("/var/www/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"),
        Path("/var/www/baiosfera/KNOWLEDGE_HUB/02_PLAYBOOKS_MAESTROS"),
    ]:
        cand = base / playbook_name
        if cand.exists() and cand.is_file():
            return cand
    return None


def discover_ecosystem(target: Optional[str] = None, allow_fallback: bool = False) -> Tuple[UniversalBrandEcosystem, Optional[str]]:
    """Discover business ecosystem in strict cascading order without hardcoded names."""
    root = get_workspace_root()
    ls_path = get_local_storage_path()
    project_env = os.getenv("PROJECT_NAME") or os.getenv("ZEROPS_PROJECT_NAME") or ""

    # 1. Explicit Target Path or Project Slug (Priority 1)
    if target:
        tp = Path(target)
        if tp.exists():
            if tp.is_dir():
                eco, sinfo = extract_verticals_from_directory(tp)
                if eco:
                    return eco, sinfo
            elif tp.is_file():
                if tp.suffix == ".docx":
                    verts = extract_from_docx(tp)
                elif tp.suffix == ".pdf":
                    verts = extract_from_pdf(tp)
                elif tp.suffix in (".md", ".txt"):
                    verts = extract_from_text_or_md(tp)
                elif tp.suffix == ".json":
                    try:
                        data = json.loads(tp.read_text(encoding="utf-8"))
                        return UniversalBrandEcosystem.model_validate(data), str(tp)
                    except Exception:
                        verts = []
                else:
                    verts = []

                if verts:
                    v_dict = {v.vertical_slug: v for v in verts}
                    b_name = tp.stem.replace("-", " ").title()
                    return UniversalBrandEcosystem(brand_slug=slugify(b_name), umbrella_name=b_name, verticals=v_dict), str(tp)

        # Target as project name in SSoT or LocalStorage
        drive_proj = Path("/var/www/baiosfera/PROYECTOS")
        for base in [drive_proj, ls_path]:
            for cand in [
                base / target / "dev" / "verticals",
                base / target / "dev" / "verticales",
                base / target / "verticales",
                base / target / "verticals",
                base / target.upper() / "dev" / "verticals",
                base / target.upper() / "dev" / "verticales",
                base / target.upper() / "verticales",
                base / target.upper() / "verticals",
                base / target / "ecosystem.json"
            ]:
                if cand.exists():
                    if cand.is_dir():
                        eco, sinfo = extract_verticals_from_directory(cand)
                        if eco:
                            return eco, sinfo
                    elif cand.is_file():
                        try:
                            data = json.loads(cand.read_text(encoding="utf-8"))
                            return UniversalBrandEcosystem.model_validate(data), str(cand)
                        except Exception:
                            pass

    # 2. Project Environment ($PROJECT_NAME / $ZEROPS_PROJECT_NAME)
    if project_env:
        for base in [Path("/var/www/baiosfera/PROYECTOS"), ls_path]:
            for cand in [
                base / project_env / "dev" / "verticals",
                base / project_env / "dev" / "verticales",
                base / project_env / "verticales",
                base / project_env / "verticals",
                base / project_env.upper() / "dev" / "verticals",
                base / project_env.upper() / "dev" / "verticales",
                base / project_env.upper() / "verticales",
                base / project_env.upper() / "verticals",
                base / project_env / "ecosystem.json",
                base / project_env / "dev" / "brandbook.json"
            ]:
                if cand.exists():
                    if cand.is_dir():
                        eco, sinfo = extract_verticals_from_directory(cand)
                        if eco:
                            return eco, sinfo
                    elif cand.is_file() and cand.name == "brandbook.json":
                        try:
                            bb_data = json.loads(cand.read_text(encoding="utf-8"))
                            if "verticals" in bb_data and isinstance(bb_data["verticals"], dict):
                                b_name = bb_data.get("metadata", {}).get("brand_name") or project_env
                                v_dict = {k: DynamicVerticalSpec.model_validate(v) for k, v in bb_data["verticals"].items()}
                                return UniversalBrandEcosystem(brand_slug=slugify(b_name), umbrella_name=b_name, verticals=v_dict), str(cand)
                        except Exception:
                            pass

    # 3. Workspace Native .apotelos/ecosystem.json
    p_eco = root / ".apotelos" / "ecosystem.json"
    if p_eco.exists():
        try:
            data = json.loads(p_eco.read_text(encoding="utf-8"))
            return UniversalBrandEcosystem.model_validate(data), str(p_eco)
        except Exception as e:
            print(f"⚠️ Warning: Error parsing {p_eco}: {e}")

    # 4. Workspace brandbook.json with explicit verticals block
    bb_root = root / "brandbook.json"
    if bb_root.exists():
        try:
            bb_data = json.loads(bb_root.read_text(encoding="utf-8"))
            b_name = bb_data.get("metadata", {}).get("brand_name") or bb_data.get("identity", {}).get("brandName") or root.name
            if "verticals" in bb_data and isinstance(bb_data["verticals"], dict):
                v_dict = {k: DynamicVerticalSpec.model_validate(v) for k, v in bb_data["verticals"].items()}
                return UniversalBrandEcosystem(brand_slug=slugify(b_name), umbrella_name=b_name, verticals=v_dict), str(bb_root)
        except Exception:
            pass

    # 5. Local directory ./verticals
    local_v = root / "verticals"
    if local_v.exists() and local_v.is_dir():
        eco, sinfo = extract_verticals_from_directory(local_v)
        if eco:
            return eco, sinfo

    # 6. Clean Honest Result (Empty verticals if none found)
    current_brand = project_env or (root.name if root.name not in ("www", "var") else "proyecto-activo")
    clean_slug = slugify(current_brand)

    if allow_fallback:
        return UniversalBrandEcosystem(
            brand_slug=clean_slug,
            umbrella_name=current_brand.title(),
            verticals={
                "root_vertical": DynamicVerticalSpec(
                    vertical_slug="root_vertical",
                    display_name=f"{current_brand.title()} [Borrador]",
                    funnel_type=CommercialFunnelType.DIRECT_CHECKOUT,
                    target_avatar={"pain_points": ["Definir problema raíz a resolver"], "source_document": "Auto-generado"},
                    unique_mechanism={"name": f"Mecanismo {current_brand.title()}"},
                    primary_offer={"structure": "Oferta Principal"},
                    conversion_events=["Purchase"]
                )
            }
        ), "Borrador de fallback zero-config"

    return UniversalBrandEcosystem(
        brand_slug=clean_slug,
        umbrella_name=current_brand.title(),
        verticals={}
    ), None


# =====================================================================
# 5. DYNAMIC ZEROPS DISCOVERY & BLACKBOARD COMPILER
# =====================================================================

def check_service_health(url: str, timeout_sec: float = 0.8) -> bool:
    """Check TCP reachability and HTTP status with fast sub-second fail-fast."""
    try:
        parsed = urllib.parse.urlparse(url)
        host = parsed.hostname
        if not host:
            return False
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        # Fast DNS + TCP check
        with socket.create_connection((host, port), timeout=timeout_sec):
            pass
        # Fast HTTP probe
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=timeout_sec) as response:
            return response.status in (200, 204)
    except Exception:
        return False


def detect_zerops_capabilities(probe_llm: bool = False) -> Dict[str, Any]:
    """Dynamically discover available runtimes and services in this Zerops project."""
    hermes_url = os.getenv("HERMES_API_URL", "http://hermes:8000")
    bifrost_url = os.getenv("BIFROST_API_URL", "http://bifrost:8080")
    freellm_url = os.getenv("FREELLMAPI_URL", "http://freellmapi:3001")

    hermes_alive = check_service_health(f"{hermes_url}/healthz", timeout_sec=0.3)
    bifrost_alive = check_service_health(f"{bifrost_url}/health", timeout_sec=0.3) if probe_llm else False
    freellm_alive = check_service_health(f"{freellm_url}/health", timeout_sec=0.3) if probe_llm else False

    return {
        "hermes_alive": hermes_alive,
        "bifrost_alive": bifrost_alive,
        "freellmapi_alive": freellm_alive,
        "hermes_url": hermes_url,
        "bifrost_url": bifrost_url,
        "has_postgres": bool(os.getenv("DATABASE_URL") or os.getenv("database_connectionString")),
        "has_valkey": bool(os.getenv("valkey_connectionString") or os.getenv("REDIS_URL")),
        "has_nats": bool(os.getenv("nats_connectionString") or os.getenv("NATS_URL"))
    }


