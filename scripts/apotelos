        bad_bridge_ok, _ = validate_concatenation_matrix({
            "brand_slug": "aurelius-vance", "canonical_domain": "aureliusvance.com",
            "topic_clusters": [{"cluster_id": "c1", "search_intent": "i1", "primary_keyword": "k1", "landing_route": "/", "funnel_stage": "bofu"}],
            "links": [{
                "link_id": "l1", "cluster_id": "c1", "ad_angle": "x",
