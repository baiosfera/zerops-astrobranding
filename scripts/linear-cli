#!/usr/bin/env node
/**
 * Linear CLI Sovereign Tool for ZCP & Autonomous Agents
 * Version: 2.1.0 (Direct GraphQL API, Zero Hardcoded Hostnames, Anti-Checklist Theater Gate)
 *
 * Usage:
 *   linear-cli search <query>
 *   linear-cli issue <id|identifier>
 *   linear-cli comment <issueId> <commentText>
 *   linear-cli create "<title>" "[description]" [--team <teamId>] [--project <projectId>] [--priority <1-4>]
 *   linear-cli create-project "<name>" "[description]" [--team <teamId>]
 *   linear-cli update-status <issueId> "<statusName>" [--evidence "<proof of physical exit-0 tests>"]
 *   linear-cli update-status-batch "<statusName>" <issueId1> <issueId2>... [--evidence "<proof>"]
 *   linear-cli teams
 *   linear-cli projects
 *   linear-cli states [teamId]
 */

const https = require("https");
const fs = require("fs");
const path = require("path");
const { execSync } = require("child_process");

const LINEAR_API_KEY = process.env.LINEAR_API_KEY;
if (!LINEAR_API_KEY) {
  console.error("Error: LINEAR_API_KEY environment variable is required.");
  process.exit(1);
}

let cachedDefaultTeamId = process.env.LINEAR_TEAM_ID || null;
const DEFAULT_PROJECT_ID = process.env.LINEAR_PROJECT_ID || null;

function queryGraphQL(query, variables = {}) {
  return new Promise((resolve, reject) => {
    const postData = JSON.stringify({ query, variables });
    const req = https.request(
      "https://api.linear.app/graphql",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": LINEAR_API_KEY,
          "User-Agent": "ZCP-Linear-CLI/2.1"
        },
        timeout: 15000
      },
      (res) => {
        let data = "";
        res.on("data", (chunk) => (data += chunk));
        res.on("end", () => {
          try {
            const parsed = JSON.parse(data);
            if (parsed.errors && parsed.errors.length > 0) {
              reject(new Error(JSON.stringify(parsed.errors)));
            } else {
              resolve(parsed.data);
            }
          } catch (e) {
            reject(new Error(`Failed to parse response: ${e.message}`));
          }
        });
      }
    );
    req.on("error", reject);
    req.on("timeout", () => {
      req.destroy();
      reject(new Error("Request timed out after 15000ms"));
    });
    req.write(postData);
    req.end();
  });
}

async function getDefaultTeamId() {
  if (cachedDefaultTeamId) return cachedDefaultTeamId;
  try {
    const q = `query GetTeams { teams(first: 5) { nodes { id key name } } }`;
    const data = await queryGraphQL(q);
    const teams = data?.teams?.nodes || [];
    if (teams.length > 0) {
      cachedDefaultTeamId = teams[0].id;
      return cachedDefaultTeamId;
    }
  } catch (e) {}
  return "4b8ebc9c-ef67-4812-8699-a90dad6343ac";
}

async function resolveIssueId(identifierOrId) {
  if (!identifierOrId) return null;
  const clean = identifierOrId.trim();
  if (/^[A-Za-z0-9]+-\d+$/i.test(clean) || !clean.includes("-")) {
    const q = `query GetIssueId($id: String!) { issue(id: $id) { id team { id } } }`;
    try {
      const res = await queryGraphQL(q, { id: clean.toUpperCase() });
      if (res?.issue?.id) return { id: res.issue.id, teamId: res.issue.team?.id };
    } catch (e) {}
  }
  const defaultTeam = await getDefaultTeamId();
  return { id: clean, teamId: defaultTeam };
}

/**
 * Dynamically discovers services inside /var/www without hardcoding hostnames.
 */
function discoverServices() {
  const baseDir = "/var/www";
  const systemDirs = new Set([
    ".agents", ".atl", ".bin", ".gemini", "baiosfera", "artifacts", 
    "node_modules", "tmp", "logs", "cache", "bak", "dist", "build",
    "zerops-astrobranding", "zerops-astro-skills"
  ]);

  const services = [];
  try {
    const entries = fs.readdirSync(baseDir, { withFileTypes: true });
    for (const ent of entries) {
      if (ent.isDirectory() && !systemDirs.has(ent.name) && !ent.name.startsWith(".")) {
        const fullPath = path.join(baseDir, ent.name);
        const hasManifest = [
          "package.json", "pyproject.toml", "requirements.txt",
          "zerops.yaml", "Cargo.toml", "go.mod", "pom.xml"
        ].some((f) => fs.existsSync(path.join(fullPath, f)));
        if (hasManifest) {
          services.push(ent.name);
        }
      }
    }
  } catch (e) {}
  return services;
}

/**
 * Validates physical tests across dynamically discovered services and universal sensors.
 */
function validateApplicationTests() {
  console.log("🛡️ [F5 Reality Gate] Verificando tests físicos de la aplicación en runtime...");
  const services = discoverServices();
  let executedCount = 0;

  for (const svc of services) {
    const svcPath = path.join("/var/www", svc);
    const pkgPath = path.join(svcPath, "package.json");
    const pyTests = fs.existsSync(path.join(svcPath, "tests")) || fs.existsSync(path.join(svcPath, "test"));
    let hasPkgTest = false;
    try {
      if (fs.existsSync(pkgPath)) {
        const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf-8"));
        hasPkgTest = Boolean(pkg.scripts && pkg.scripts.test);
      }
    } catch (e) {}

    if (hasPkgTest || pyTests || fs.existsSync(path.join(svcPath, "pytest.ini"))) {
      const testCmd = hasPkgTest ? "npm test" : (pyTests ? "bun test" : "pytest");
      console.log(`🧪 [F5 Reality Gate] Ejecutando suite de pruebas en "${svc}" (${testCmd})...`);
      try {
        execSync(`ssh ${svc} "cd /var/www && ${testCmd}"`, { stdio: "inherit", timeout: 60000 });
        executedCount++;
        console.log(`✅ [F5 Reality Gate] Tests en "${svc}" validados con éxito (${testCmd} exit code 0).`);
      } catch (testErr) {
        console.error(`❌ F5 REALITY GATE RECHAZADO: Fallaron los tests en "${svc}".`);
        console.error("Prohibido marcar Done en Linear mientras la suite de pruebas físicas esté fallando.");
        process.exit(1);
      }
    }
  }

  if (executedCount === 0) {
    console.log("ℹ️ [F5 Reality Gate] No se detectaron suites de pruebas activas en servicios candidatos.");
  }

  // Universal Skills Sensor validation
  if (fs.existsSync("/var/www/.bin/skills-suite-validate")) {
    console.log("🛡️ [F5 Reality Gate] Ejecutando Sensor Universal de Habilidades (skills-suite-validate)...");
    try {
      execSync("/var/www/.bin/skills-suite-validate", { stdio: "inherit", timeout: 30000 });
      console.log("✅ [F5 Reality Gate] Sensor Universal de Habilidades validado (exit code 0).");
    } catch (err) {
      console.error("❌ F5 REALITY GATE RECHAZADO: Falló la validación de habilidades.");
      process.exit(1);
    }
  }
}

/**
 * Checks that all Git repositories in /var/www are clean and up-to-date with upstream.
 */
function checkGitParity() {
  const baseDir = "/var/www";
  const repos = [];

  try {
    const entries = fs.readdirSync(baseDir, { withFileTypes: true });
    for (const ent of entries) {
      if (ent.isDirectory() && ent.name !== "baiosfera") {
        const repoPath = path.join(baseDir, ent.name);
        if (fs.existsSync(path.join(repoPath, ".git"))) {
          repos.push(repoPath);
        }
      }
    }
  } catch (e) {}

  let pending = false;
  for (const repo of repos) {
    try {
      const stat = execSync("git status --porcelain", { cwd: repo }).toString().trim();
      if (stat !== "") {
        console.error(`❌ F5 GOBERNANZA FÍSICA: Cambios sin comitear en "${path.basename(repo)}".`);
        pending = true;
      }
      const unpushed = execSync("git log @{u}..HEAD --oneline 2>/dev/null || true", { cwd: repo }).toString().trim();
      if (unpushed !== "") {
        console.error(`❌ F5 GOBERNANZA FÍSICA: Commits sin pushear en "${path.basename(repo)}".`);
        pending = true;
      }
    } catch (e) {}
  }

  if (pending) {
    console.error("❌ F5 GOBERNANZA FÍSICA: Comiteá y pusheá todos los cambios antes de marcar Done.");
    process.exit(1);
  }
}

async function main() {
  const args = process.argv.slice(2);
  const cmd = args[0] || "search";

  if (cmd === "search") {
    const term = args.slice(1).join(" ") || "";
    const q = `
      query SearchIssues($term: String!) {
        issues(filter: { or: [{ title: { containsIgnoreCase: $term } }, { description: { containsIgnoreCase: $term } }] }, first: 10) {
          nodes {
            id
            identifier
            title
            priority
            url
            state { name }
          }
        }
      }
    `;
    const data = await queryGraphQL(q, { term });
    const nodes = data?.issues?.nodes || [];
    console.log(`Found ${nodes.length} issues matching "${term}":`);
    for (const issue of nodes) {
      console.log(`- ${issue.identifier}: ${issue.title} [Status: ${issue.state?.name || "None"}]`);
      console.log(`  ${issue.url}`);
    }
  } else if (cmd === "issue") {
    const id = args[1];
    if (!id) {
      console.error("Error: issue identifier or id required");
      process.exit(1);
    }
    const q = `
      query GetIssue($id: String!) {
        issue(id: $id) {
          id
          identifier
          title
          description
          priority
          url
          state { name }
          project { id name }
          team { id name key }
        }
      }
    `;
    const data = await queryGraphQL(q, { id });
    const issue = data?.issue;
    if (!issue) {
      console.log(`Issue ${id} not found`);
    } else {
      console.log(`[${issue.identifier}] ${issue.title}`);
      console.log(`Status: ${issue.state?.name || "None"} | Priority: ${issue.priority}`);
      console.log(`Team: ${issue.team?.name} (${issue.team?.key}) | Project: ${issue.project?.name || "None"}`);
      console.log(`URL: ${issue.url}`);
      console.log(`Description:\n${issue.description || "(No description)"}`);
    }
  } else if (cmd === "comment") {
    const issueId = args[1];
    const body = args.slice(2).join(" ");
    if (!issueId || !body) {
      console.error("Usage: linear-cli comment <issueId> <comment body>");
      process.exit(1);
    }
    const resolved = await resolveIssueId(issueId);
    if (!resolved?.id) {
      console.error(`Issue ${issueId} not found`);
      process.exit(1);
    }
    const q = `
      mutation CreateComment($issueId: String!, $body: String!) {
        commentCreate(input: { issueId: $issueId, body: $body }) {
          success
          comment { id url }
        }
      }
    `;
    const data = await queryGraphQL(q, { issueId: resolved.id, body });
    if (data?.commentCreate?.success) {
      console.log(`✅ Comment added: ${data.commentCreate.comment?.url}`);
    } else {
      console.log("❌ Failed to create comment");
    }
  } else if (cmd === "create") {
    let title = "";
    let description = "";
    let teamId = await getDefaultTeamId();
    let projectId = DEFAULT_PROJECT_ID;
    let priority = 2;

    let i = 1;
    while (i < args.length) {
      if (args[i] === "--team" && args[i + 1]) {
        teamId = args[i + 1];
        i += 2;
      } else if (args[i] === "--project" && args[i + 1]) {
        projectId = args[i + 1];
        i += 2;
      } else if (args[i] === "--priority" && args[i + 1]) {
        priority = parseInt(args[i + 1], 10) || 2;
        i += 2;
      } else if (!title) {
        title = args[i];
        i++;
      } else if (!description) {
        description = args[i];
        i++;
      } else {
        i++;
      }
    }

    if (!title) {
      console.error('Usage: linear-cli create "<title>" "[description]" [--team <id>] [--project <id>] [--priority <1-4>]');
      process.exit(1);
    }

    const q = `
      mutation CreateIssue($input: IssueCreateInput!) {
        issueCreate(input: $input) {
          success
          issue {
            id
            identifier
            title
            url
            state { name }
          }
        }
      }
    `;
    const input = {
      teamId,
      title,
      description: description || undefined,
      projectId: projectId || undefined,
      priority: priority || undefined
    };

    const data = await queryGraphQL(q, { input });
    const created = data?.issueCreate?.issue;
    if (data?.issueCreate?.success && created) {
      const activeFile = "/var/www/artifacts/linear_active.json";
      fs.mkdirSync(path.dirname(activeFile), { recursive: true });
      
      let activeLocks = [];
      if (fs.existsSync(activeFile)) {
        try {
          const content = fs.readFileSync(activeFile, "utf8");
          activeLocks = JSON.parse(content);
          if (!Array.isArray(activeLocks)) activeLocks = [activeLocks];
        } catch(e) {}
      }
      activeLocks.push({ issueId: created.identifier, timestamp: Date.now() });
      fs.writeFileSync(activeFile, JSON.stringify(activeLocks, null, 2));

      console.log(`✅ Issue created: [${created.identifier}] ${created.title}`);
      console.log(`  Status: ${created.state?.name || "Todo"} | URL: ${created.url}`);
    } else {
      console.error("❌ Failed to create issue");
      process.exit(1);
    }
  } else if (cmd === "create-project") {
    let name = "";
    let description = "";
    let teamId = await getDefaultTeamId();
    for (let i = 1; i < args.length; ) {
      if (args[i] === "--team" && args[i + 1]) {
        teamId = args[i + 1];
        i += 2;
      } else if (!name) {
        name = args[i];
        i++;
      } else if (!description) {
        description = args[i];
        i++;
      } else {
        i++;
      }
    }
    if (!name) {
      console.error('Usage: linear-cli create-project "<name>" "[description]" [--team <id>]');
      process.exit(1);
    }
    const q = `
      mutation ProjectCreate($input: ProjectCreateInput!) {
        projectCreate(input: $input) {
          success
          project {
            id
            name
            url
            state
          }
        }
      }
    `;
    const input = { name, description: description || undefined, teamIds: [teamId] };
    const data = await queryGraphQL(q, { input });
    const created = data?.projectCreate?.project;
    if (data?.projectCreate?.success && created) {
      console.log(`✅ Project created: ${created.name}`);
      console.log(`  State: ${created.state} | URL: ${created.url}`);
      console.log(`  ID: ${created.id}`);
    } else {
      console.error("❌ Failed to create project");
      process.exit(1);
    }
  } else if (cmd === "update-status") {
    const issueId = args[1];
    const targetStatus = args[2];
    if (!issueId || !targetStatus) {
      console.error('Usage: linear-cli update-status <issueId> "<statusName>" [--evidence "<text>"]');
      process.exit(1);
    }

    let evidence = "";
    const evIdx = args.indexOf("--evidence");
    if (evIdx !== -1 && args[evIdx + 1]) {
      evidence = args.slice(evIdx + 1).join(" ");
    }

    const resolved = await resolveIssueId(issueId);
    if (!resolved?.id) {
      console.error(`Issue ${issueId} not found`);
      process.exit(1);
    }

    const qStates = `
      query GetTeamStates($teamId: String!) {
        team(id: $teamId) {
          states {
            nodes {
              id
              name
              type
            }
          }
        }
      }
    `;
    const statesData = await queryGraphQL(qStates, { teamId: resolved.teamId || (await getDefaultTeamId()) });
    const states = statesData?.team?.states?.nodes || [];
    const matchedState = states.find(
      (s) => s.name.toLowerCase() === targetStatus.toLowerCase() ||
             (targetStatus.toLowerCase() === "in progress" && s.type === "started") ||
             (targetStatus.toLowerCase() === "done" && s.type === "completed") ||
             (targetStatus.toLowerCase() === "backlog" && s.type === "backlog")
    );

    if (!matchedState) {
      console.error(`❌ Status "${targetStatus}" not found. Available states: ${states.map(s => s.name).join(", ")}`);
      process.exit(1);
    }

    if (matchedState.name.toLowerCase() === "done" || matchedState.type === "completed") {
      if (!evidence || evidence.trim().length < 10) {
        console.error("❌ F5 REALITY GATE RECHAZADO (Anti-Checklist Theater):");
        console.error("Para marcar un issue como 'Done', debes suministrar evidencia física verificable del entregable.");
        console.error('Uso: linear-cli update-status <issueId> "Done" --evidence "<descripción de pruebas físicas exit 0, commits y entregables>"');
        process.exit(1);
      }

      validateApplicationTests();

      console.log("🛡️ [F5 Gate] Validating SSoT Parity & Git Push before closing issue...");
      try {
        if (fs.existsSync("/var/www/.bin/ssot-parity-check")) {
          execSync("/var/www/.bin/ssot-parity-check", { stdio: "inherit" });
        }
        checkGitParity();
      } catch (err) {
        console.error("❌ F5 GOBERNANZA FÍSICA: Falló la validación física de paridad o Git.");
        process.exit(1);
      }

      console.log("📝 [F5 Reality Gate] Registrando atestación física de cierre en Linear...");
      const commentBody = `### 🏁 Cierre de Hito (F5 Reality Attestation)\n\n**Evidencia Física:**\n${evidence}\n\n*Validado automáticamente por linear-cli con sensores físicos exit code 0.*`;
      try {
        await queryGraphQL(
          `mutation CreateComment($issueId: String!, $body: String!) { commentCreate(input: { issueId: $issueId, body: $body }) { success } }`,
          { issueId: resolved.id, body: commentBody }
        );
      } catch (commentErr) {
        console.warn("⚠️ No se pudo registrar el comentario de evidencia en Linear:", commentErr.message);
      }
    }

    const qUpdate = `
      mutation UpdateIssueState($id: String!, $stateId: String!) {
        issueUpdate(id: $id, input: { stateId: $stateId }) {
          success
          issue {
            id
            identifier
            title
            state { name }
            url
          }
        }
      }
    `;
    const updateRes = await queryGraphQL(qUpdate, { id: resolved.id, stateId: matchedState.id });
    const updated = updateRes?.issueUpdate?.issue;
    if (updateRes?.issueUpdate?.success && updated) {
      if (matchedState.name.toLowerCase() === "done" || matchedState.type === "completed") {
         if (fs.existsSync("/var/www/artifacts/linear_active.json")) {
             fs.unlinkSync("/var/www/artifacts/linear_active.json");
         }
      }
      console.log(`✅ Issue [${updated.identifier}] status updated to: "${updated.state?.name}"`);
    } else {
      console.error("❌ Failed to update issue status");
      process.exit(1);
    }
  } else if (cmd === "update-status-batch") {
    const targetStatus = args[1];
    let evidence = "";
    const evIdx = args.indexOf("--evidence");
    let issueIds = [];

    if (evIdx !== -1) {
      issueIds = args.slice(2, evIdx);
      if (args[evIdx + 1]) evidence = args.slice(evIdx + 1).join(" ");
    } else {
      issueIds = args.slice(2);
    }

    if (!targetStatus || issueIds.length === 0) {
      console.error('Usage: linear-cli update-status-batch "<statusName>" <issueId1> <issueId2> ... [--evidence "<text>"]');
      process.exit(1);
    }

    const defaultTeam = await getDefaultTeamId();
    const qStates = `
      query GetTeamStates($teamId: String!) {
        team(id: $teamId) {
          states {
            nodes {
              id
              name
              type
            }
          }
        }
      }
    `;
    const statesData = await queryGraphQL(qStates, { teamId: defaultTeam });
    const states = statesData?.team?.states?.nodes || [];
    const matchedState = states.find(
      (s) => s.name.toLowerCase() === targetStatus.toLowerCase() ||
             (targetStatus.toLowerCase() === "in progress" && s.type === "started") ||
             (targetStatus.toLowerCase() === "done" && s.type === "completed") ||
             (targetStatus.toLowerCase() === "backlog" && s.type === "backlog")
    );

    if (!matchedState) {
      console.error(`❌ Status "${targetStatus}" not found. Available: ${states.map(s => s.name).join(", ")}`);
      process.exit(1);
    }

    if (matchedState.name.toLowerCase() === "done" || matchedState.type === "completed") {
      if (!evidence || evidence.trim().length < 10) {
        console.error("❌ F5 REALITY GATE RECHAZADO (Anti-Checklist Theater):");
        console.error("Para marcar issues en lote como 'Done', debes suministrar evidencia física verificable.");
        console.error('Uso: linear-cli update-status-batch "Done" <ids...> --evidence "<descripción de pruebas físicas exit 0>"');
        process.exit(1);
      }

      validateApplicationTests();

      console.log("🛡️ [F5 Gate Batch] Validating SSoT Parity & Git Push once for batch...");
      try {
        if (fs.existsSync("/var/www/.bin/ssot-parity-check")) {
          execSync("/var/www/.bin/ssot-parity-check", { stdio: "inherit" });
        }
        checkGitParity();
      } catch (err) {
        console.error("❌ F5 GOBERNANZA FÍSICA: Parity or Git validation failed.");
        process.exit(1);
      }
    }

    const qUpdate = `
      mutation UpdateIssueState($id: String!, $stateId: String!) {
        issueUpdate(id: $id, input: { stateId: $stateId }) {
          success
          issue { id identifier title state { name } }
        }
      }
    `;

    for (const rawId of issueIds) {
      try {
        const resolved = await resolveIssueId(rawId);
        if (!resolved?.id) {
          console.error(`⚠️ Issue ${rawId} not found, skipping.`);
          continue;
        }

        if (matchedState.name.toLowerCase() === "done" || matchedState.type === "completed") {
          const commentBody = `### 🏁 Cierre de Hito (F5 Reality Attestation Batch)\n\n**Evidencia Física:**\n${evidence}\n\n*Validado automáticamente por linear-cli con sensores físicos exit code 0.*`;
          try {
            await queryGraphQL(
              `mutation CreateComment($issueId: String!, $body: String!) { commentCreate(input: { issueId: $issueId, body: $body }) { success } }`,
              { issueId: resolved.id, body: commentBody }
            );
          } catch (e) {}
        }

        const updateRes = await queryGraphQL(qUpdate, { id: resolved.id, stateId: matchedState.id });
        const updated = updateRes?.issueUpdate?.issue;
        if (updateRes?.issueUpdate?.success && updated) {
          console.log(`✅ [${updated.identifier}] -> "${updated.state?.name}"`);
        } else {
          console.error(`❌ Failed to update ${rawId}`);
        }
      } catch (e) {
        console.error(`❌ Error updating ${rawId}:`, e.message);
      }
    }

    if (matchedState.name.toLowerCase() === "done" || matchedState.type === "completed") {
      if (fs.existsSync("/var/www/artifacts/linear_active.json")) {
        fs.unlinkSync("/var/www/artifacts/linear_active.json");
        console.log("✓ Unlinked /var/www/artifacts/linear_active.json");
      }
    }
  } else if (cmd === "teams") {
    const q = `query GetTeams { teams { nodes { id name key } } }`;
    const data = await queryGraphQL(q);
    const teams = data?.teams?.nodes || [];
    console.log("Teams:");
    for (const t of teams) {
      console.log(`- ${t.key}: ${t.name} (ID: ${t.id})`);
    }
  } else if (cmd === "projects") {
    const q = `query GetProjects { projects(first: 20) { nodes { id name state progress } } }`;
    const data = await queryGraphQL(q);
    const projects = data?.projects?.nodes || [];
    console.log("Projects:");
    for (const p of projects) {
      console.log(`- ${p.name} [State: ${p.state}] (ID: ${p.id})`);
    }
  } else if (cmd === "states") {
    const tId = args[1] || (await getDefaultTeamId());
    const q = `
      query GetTeamStates($teamId: String!) {
        team(id: $teamId) {
          name
          states {
            nodes {
              id
              name
              type
            }
          }
        }
      }
    `;
    const data = await queryGraphQL(q, { teamId: tId });
    const states = data?.team?.states?.nodes || [];
    console.log(`States for team ${data?.team?.name || tId}:`);
    for (const s of states) {
      console.log(`- ${s.name} (type: ${s.type}, id: ${s.id})`);
    }
  } else {
    console.log("Linear CLI Commands:");
    console.log("  search <query>                                Search issues");
    console.log("  issue <id>                                    Get issue details");
    console.log("  comment <id> <text>                           Add comment to issue");
    console.log('  create "<title>" "[desc]" [opts]              Create new issue');
    console.log('  create-project "<name>" "[desc]" [opts]       Create new project');
    console.log('  update-status <id> "<status>" [--evidence ""] Update issue workflow status (Done requires --evidence)');
    console.log('  update-status-batch "<status>" <ids> [--evidence ""] Update multiple issues in batch (Done requires --evidence)');
    console.log("  teams                                         List teams");
    console.log("  projects                                      List projects");
    console.log("  states [teamId]                               List workflow states");
  }
}

main().catch((err) => {
  console.error("Linear CLI Error:", err.message);
  process.exit(1);
});
