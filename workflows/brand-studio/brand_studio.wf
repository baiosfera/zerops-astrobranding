"""
brand_studio.wf — Portable Antigravity `run_workflow` 5-Phase Playbook-First Brand Pipeline (v2.0).
Compiled with Python top-level await (`ast.PyCF_ALLOW_TOP_LEVEL_AWAIT`) via `run_workflow(ScriptPath=..., Args=...)`.
Hermes/CrewAI remain strictly reserved for post-launch 24/7 monitoring & ops.
"""
PLAYBOOKS_DIR = "/mnt/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"

project = args["project"]
vertical = args["vertical"]
ws_dir = args["workspace_dir"].rstrip("/")
intake_mode = args.get("intake_mode", "auto")
target_country = args.get("target_country", "Colombia y Latinoamérica")
reference_urls = args.get("reference_urls", [])
envato_urls = args.get("envato_urls", [])
hub_branches = args.get("hub_branches", [])
enable_affiliate_layer = args.get("enable_affiliate_layer", True)
enable_cross_funnel_mesh = args.get("enable_cross_funnel_mesh", True)
enable_ads_first_layer = args.get("enable_ads_first_layer", True)
lead_magnet_mechanism = args.get("lead_magnet_mechanism", "auto")
offer_model = args.get("offer_model", "auto")
vsl_mode = args.get("vsl_mode", "hybrid_smart_vsl")
offer_archetype = args.get("offer_archetype", "auto")
start_from = args.get("start_from_phase", "phase_1_seo")
stop_after = args.get("stop_after_phase", "phase_2_art_direction")

phase_order = ["phase_1_seo", "phase_2_art_direction", "phase_3_concatenation", "phase_4_copy", "phase_5_critic"]
start_idx = phase_order.index(start_from)
stop_idx = phase_order.index(stop_after)
should_run = lambda name: start_idx <= phase_order.index(name) <= stop_idx

log(
    f"Starting brand-studio v2.0 for {project}/{vertical} "
    f"(intake={intake_mode}, archetype={offer_archetype}, offer_model={offer_model}, "
    f"lead_magnet={lead_magnet_mechanism}, ads_first={enable_ads_first_layer}, "
    f"vsl={vsl_mode}, mesh={enable_cross_funnel_mesh}, affiliates={enable_affiliate_layer}, "
    f"start_from={start_from}, stop_after={stop_after})"
)

# PHASE 1: Positioning (Comprador Ideal + CO1 Contrast + 1->N) + Live SERP & Tech-Maturity Research
if should_run("phase_1_seo"):
    phase("Phase 1: Posicionamiento (Comprador Ideal + CO1 Contraste + Oferta 1->N), Hub & SERP (PB00, PB06, PB16)")
    seo_schema = {
        "type": "object",
        "required": ["positioning_roles", "public_brand_concepts", "multi_domain_bridge", "topic_clusters", "files_written"],
        "properties": {
            "positioning_roles": {"type": "array", "items": {"type": "string"}},
            "public_brand_concepts": {"type": "array", "items": {"type": "string"}},
            "multi_domain_bridge": {"type": "string"},
            "topic_clusters": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["cluster_id", "search_intent", "primary_keyword", "landing_route", "funnel_stage"],
                    "properties": {
                        "cluster_id": {"type": "string"},
                        "search_intent": {"type": "string"},
                        "primary_keyword": {"type": "string"},
                        "landing_route": {"type": "string"},
                        "funnel_stage": {"type": "string"}
                    }
                }
            },
            "files_written": {"type": "array", "items": {"type": "string"}}
        }
    }
    seo_res = await agent(
        f"""Fase 1 Strategist: Lee obligatoriamente los módulos clave de:
- {PLAYBOOKS_DIR}/00_category_of_one.md
- {PLAYBOOKS_DIR}/06_seo_aeo_geo_and_organic_content.md (Módulo 0 y Módulo 2 Keyword Research)
- {PLAYBOOKS_DIR}/16_personal_branding_authority_and_communities.md
Inspecciona el contexto real en {ws_dir} y /mnt/localstorage/{project}/dev/ (ecosystem.json como ÚNICA SSoT — nunca _shared/ecosystem.json —, vertical JSON, brand_brief.json o briefs Oráculo si intake_mode='{intake_mode}' es 'auto' u 'oraculo').
Posicionamiento estratégico obligatorio (para uso interno en estrategia, SIN filtrar etiquetas técnicas al público):
- Define al **Comprador Ideal** (hablando a la brecha entre su capacidad top y su estatus/libertad actual, no solo a gente en emergencia o dolor pasivo).
- Formula diferenciación **Category of One (CO1) por contraste polarizante** (las ideas atraen; las ofertas filtran).
- Modela la arquitectura **Oferta 1 -> N** (`offer_model='{offer_model}'`): un núcleo claro con anillos de acceso por cercanía/velocidad en lugar de multiplicar productos desconectados.
- Separa estrictamente las 2 capas web cuando `enable_ads_first_layer={enable_ads_first_layer}`:
  1) **Núcleo Orgánico (`SEO/AEO/GEO`)**: rutas canónicas fijas `index, follow` (1 intención SERP = 1 URL), `/llms.txt`, `@graph` JSON-LD completo (`FAQPage`, `Offer`, `Organization`, `Person`/`Service` o `Product`).
  2) **Capa Dinámica Ads-First**: reserva `/{vertical}/lp/[slug]` (`noindex, follow` por defecto salvo clúster SEO propio) para aterrizajes 1:1 de campañas generados con `ad-campaign-factory` sin contaminar el SEO canónico.
Si hay ramas en hub_branches ({hub_branches}), aplica **1 ruta = 1 workspace SSoT** sin duplicar copy/01..08 entre Hub y ramas aisladas.
Anti-AMN obligatorio (año vigente vía `date -u`): usa búsqueda web en vivo (`exa` / `tavily` / `brave` + `jina:read_url`) orientada a '{target_country}' para validar intención SERP real, ofertas vigentes y madurez agéntica actual (cero hombres de paja obsoletos).
Cortafuegos terminológico obligatorio: NUNCA expongas al público jerga interna ('verticales', 'DIY', 'DWY', 'DFY', 'BANT', 'PWYW', 'Order Bump', 'AEO/GEO', 'Rotación Barista', 'Ads-First', 'Comprador Ideal'), ni tarifas privadas (`private_call_only_pricing`).
Guarda {ws_dir}/strategy/seo_clusters.json y actualiza {ws_dir}/strategy/seo.md con fuentes verificadas y devuelve el JSON estructurado.""",
        schema=seo_schema,
        role="SEO & Positioning Strategist",
        model="pro",
    )
    log("Phase 1 SEO clusters:", seo_res["topic_clusters"])

if should_run("phase_2_art_direction"):
    phase("Phase 2: Dirección de Arte (taste-skill + impeccable + Orchesbrand v4.1)")
    art_schema = {
        "type": "object",
        "required": ["palette_json_path", "gallery_html_path", "chromatic_directions", "font_candidates"],
        "properties": {
            "palette_json_path": {"type": "string"},
            "gallery_html_path": {"type": "string"},
            "chromatic_directions": {"type": "array", "items": {"type": "string"}},
            "font_candidates": {"type": "array", "items": {"type": "string"}}
        }
    }
    envato_flag = f' --envato-urls "{",".join(envato_urls)}"' if envato_urls else ""
    art_res = await agent(
        f"""Fase 2 Art Director: Lee design-taste-frontend y impeccable.
Si hay URLs de referencia ({reference_urls}), inspecciónalas con firecrawl_scrape(formats=['branding', 'markdown']) para extraer psicología visual, contraste de temperatura, geometría intencional y formato media `100% WebP/AVIF` SIN copiar la identidad de ninguna referencia.
Inspecciona también `/mnt/localstorage/{project}/dev/ecosystem.json` y los workspaces hermanos en `/mnt/localstorage/{project}/dev/workspaces/*/brand` para asegurar diferenciación real de paletas y tipografías entre ramas.
Si intake_mode ('{intake_mode}') es 'auto' u 'oraculo', orchesbrand v4.1 resolverá automáticamente `brand_slug` desde `ecosystem.json` para cargar `client_dumps_15_shards.json` y `astrobranding_<brand_slug>.md` junto con tu `--palette-json`.
Diseña 3 ecosistemas cromáticos de alta convicción (contraste botón primario WCAG >= 4.5:1 garantizado, cero pasteles lavados ni clichés AI) en {ws_dir}/brand/art_direction_palettes.json (cada uno con light/dark, background, surface, primary, accent, text_primary).
Deriva `--preview-texts` desde el nombre público de la línea o marca (PROHIBIDO imprimir el nombre interno del proyecto como texto de muestra SVG).
Luego ejecuta: `orchesbrand --brand "{project}" --vertical "{vertical}" --project-dir "/mnt/localstorage/{project}/dev" --output-dir "{ws_dir}/brand" --palette-json "{ws_dir}/brand/art_direction_palettes.json" --preview-texts "<MARCA PUBLICA>,<MÉTODO>" {envato_flag} --audit`
Verifica que `chroma_preview.html` y `previews/preview_gallery.html` muestran los colores reales (`--primary`, `--accent`, `--on-primary` + Mini Hero CTA) y permiten cambiar ecosistemas y modo claro/oscuro sin errores. No escribas copy en esta fase.""",
        schema=art_schema,
        role="Art Director",
        model="pro",
    )
    log("Phase 2 Art Direction ready for human approval:", art_res["gallery_html_path"])

if should_run("phase_3_concatenation"):
    phase("Phase 3: Matriz de Concatenación, Lead Magnet Polimórfico, CAPI & Afiliados")
    concat_schema = {
        "type": "object",
        "required": ["matrix_path", "apotelos_valid", "links_count"],
        "properties": {
            "matrix_path": {"type": "string"},
            "apotelos_valid": {"type": "boolean"},
            "links_count": {"type": "integer"}
        }
    }
    concat_res = await agent(
        f"""Fase 3 Conversion & Telemetry Architect: Lee las secciones aplicables de PB01, PB03, PB04, PB05, PB07, PB09, PB12, PB13, PB14, PB16 (Módulo 6), {PLAYBOOKS_DIR}/18_affiliate_referral_and_partner_growth.md y la skill ad-telemetry.
Construye {ws_dir}/strategy/concatenation_matrix.json cumpliendo MasterConcatenationMatrix (offer_archetype='{offer_archetype}', offer_model='{offer_model}', vsl_mode='{vsl_mode}', lead_magnet_mechanism='{lead_magnet_mechanism}'):
- **Lead Magnet Polimórfico Opcional (`InteractiveProofSpec`)**: NUNCA fuerces una calculadora en toda landing. Elige según el Comprador Ideal y el ángulo de entrada: `none` (directo a VSL/evaluación/checkout), `freedom_leverage_index` (Libertad = Beneficios / Horas), `diagnostic_quiz` (con tarjeta compartible), `roi_cost_gap`, `commission_simulator`, `resource_guide` o `micro_trial`.
- **Oferta `offer_rings` (`1 -> N`)**: modela anillos de acceso coherentes (`entry`, `core`, `inner_circle`, `done_for_you`) sin multiplicar marcas inconexas.
- **Reserva `dynamic_campaign_routes`**: si enable_ads_first_layer={enable_ads_first_layer}, declara el patrón `/{vertical}/lp/<slug>` (`noindex, follow` por defecto) conectado a la misma pasarela, CAPI y UTMs.
- **Regla crítica de telemetría**: `ViewContent` se dispara ÚNICAMENTE en landings de captación (incl. `/{vertical}/lp/[slug]`, NUNCA en `/checkout`, `/app`, `/admin`, `/gracias`). Configura `cross_domain_bridge` (con escape IG/FB), `allow_on_internal_links=false`, `shared_event_id=true`.
- Si enable_affiliate_layer={enable_affiliate_layer}: incluye `affiliate_program` (`?ref=`, 90d, retención 30d, `self_referral_blocked: true`, `min_epc_usd >= 1.0`, `min_epl_usd >= 2.0`).
- Si enable_cross_funnel_mesh={enable_cross_funnel_mesh}: modela `cross_funnel_bridges` (`bottom_section`, `post_conversion_thank_you`, `non_buyer_downsell`, `lifecycle_nurture` con `delay_days >= 7`) + `omnichannel_anti_collision` (`primary_focus_lock_days >= 7`, `max_active_bridge_sequences = 1`, `cross_channel_suppression_hours >= 24`).
Valida físicamente ejecutando: `apotelos validate-chain {ws_dir}/strategy/concatenation_matrix.json`. No retornes hasta Exit 0.""",
        schema=concat_schema,
        role="Conversion & Telemetry Architect",
        model="pro",
    )
    log("Phase 3 Concatenation validated:", concat_res)

if should_run("phase_4_copy"):
    phase("Phase 4: Escuadrón Paralelo de Copy (Playbooks Íntegros 00..18 -> copy/*.md -> JSON)")
    copy_units = [
        {"id": "landing_funnel_offer", "playbooks": "02_copywriting_and_neurosales.md, 03_irresistible_offers_and_pricing.md, 04_funnels_vsl_webinars_and_challenges.md, 05_web_cro_landings_and_ecommerce.md", "targets": "copy/01..04 + copy/07 (hablando directo al Comprador Ideal desde la brecha de libertad/criterio y CO1 por contraste, implementando el lead_magnet_mechanism elegido — o directo sin calculadora si es 'none' —, testimonios por objeción, FAQ incómodo, popup rescate WA, disclaimer anti-hype y entrelazado secuencial SOLO tras FAQ)"},
        {"id": "lifecycle_email_wa_sales", "playbooks": "09_whatsapp_and_conversational_automation.md, 12_email_marketing_and_lifecycle_automation.md, 15_consultative_sales_and_high_ticket_closing.md", "targets": "copy/05..06 (secuencia omnicanal Email + WhatsApp por fases con tags por campaña `camp:<vertical>:<slug>`, Días 0-7 foco único, Días 8-14 pivote, Días 15-30+ puente lógico con máx. 1 secuencia activa y supresión 24h)"},
        {"id": "ads_social_utm_affiliates", "playbooks": "08_instagram_growth_reels_and_funnels.md, 10_tiktok_and_shortform_video.md, 11_linkedin_b2b_authority_and_ads.md, 13_meta_ads_media_buying_and_scaling.md, 14_google_ads_and_youtube_growth.md, 16_personal_branding_authority_and_communities.md (Módulo 6), 18_affiliate_referral_and_partner_growth.md", "targets": "copy/08_ads_social_and_acquisition_plan.md (incl. guía de uso `ad-library` + `ad-campaign-factory` para iterar campañas Ads-First) + copy/09_affiliate_partner_kit.md si enable_affiliate_layer=True"},
        {"id": "geo_schema_web_dict", "playbooks": "06_seo_aeo_geo_and_organic_content.md, 07_ad_telemetry_ga4_gtm_and_metrics.md", "targets": "web/copy_strings.es.json, web/llms_txt_spec.md, web/schema_graph.json (con @graph JSON-LD completo incl. FAQPage+Offer para todas las rutas orgánicas, guardas route-scoped ViewContent y soporte `[data-brand]` + ruta dinámica `/[vertical]/lp/[slug]`)"},
    ]
    copy_unit_schema = {
        "type": "object",
        "required": ["unit_id", "files_written", "anti_slop_passed"],
        "properties": {
            "unit_id": {"type": "string"},
            "files_written": {"type": "array", "items": {"type": "string"}},
            "anti_slop_passed": {"type": "boolean"}
        }
    }
    copy_results = await parallel(
        copy_units,
        lambda u: agent(
            f"""Especialista Copy/SEO ({u['id']}): Lee capítulos reales completos de {u['playbooks']} en {PLAYBOOKS_DIR} (PROHIBIDO truncar a 4000 caracteres).
Redacta {u['targets']} dentro de {ws_dir} consumiendo {ws_dir}/brand/brandbook.json, {ws_dir}/strategy/seo_clusters.json y {ws_dir}/strategy/concatenation_matrix.json.
Respeta ortografía española completa (tildes, ñ, ¿, ¡), permite únicamente public_brand_concepts declarados y PROHÍBE terminantemente jerga interna hacia el usuario final ('DIY', 'DWY', 'DFY', 'verticales', 'BANT', 'PWYW', 'Order Bump', 'Rotación Barista', 'Ads-First', 'Comprador Ideal', 'UPPER_SNAKE_CASE').
Valida cada archivo público con `anti-slop-linter --brand "{project}" --vertical "{vertical}" --file <ruta>` y devuelve el resultado.""",
            schema=copy_unit_schema,
            role=f"Copy Specialist: {u['id']}",
            model="pro",
        ),
    )
    sync_ok = await agent(
        f"Ejecuta `brand-play sync-copy --workspace {ws_dir} --all-files` para reconciliar checksums SHA-256 de copy/*.md y campaigns/*.json -> web/copy_strings.es.json, verifica `anti-slop-linter --brand \"{project}\" --vertical \"{vertical}\"` y asegura un `web/astro_readiness_spec.md` unificado con selector `[data-brand]` antes de Fase 5. Confirma exit 0.",
        schema={"type": "boolean"},
        role="Copy SSoT Reconciler",
        model="flash",
    )
    log("Phase 4 Copy Squad completed; sync-copy:", sync_ok)

if should_run("phase_5_critic"):
    phase("Phase 5: Juez Adversario Ciego (Negocio, Artesanía, SEO Real y Entrelazado)")
    critic_schema = {
        "type": "object",
        "required": ["verdict", "visual_punch_score", "positioning_fidelity", "critical_gaps", "actionable_fixes"],
        "properties": {
            "verdict": {"type": "string", "enum": ["APPROVED", "NEEDS_REVISION"]},
            "visual_punch_score": {"type": "integer"},
            "positioning_fidelity": {"type": "boolean"},
            "critical_gaps": {"type": "array", "items": {"type": "string"}},
            "actionable_fixes": {"type": "array", "items": {"type": "string"}}
        }
    }
    critic = await agent(
        f"""Juez Adversario Ciego (solo lectura, mentalidad crítica senior): Audita SIN complacencia todos los artefactos de {ws_dir}:
1. Posicionamiento & Oferta: ¿El copy habla al Comprador Ideal desde contraste CO1 y libertad/palanca sin sonar genérico ni forzar calculadoras innecesarias?
2. Arte & UX: ¿Contraste botón primario WCAG >= 4.5:1? ¿Especificación exige 100% WebP/AVIF y Skip-to-content?
3. SEO Técnico & Dual-Layer: ¿Cero `noindex` en landings orgánicas y `noindex, follow` en landings Ads-First sin clúster propio? ¿`web/schema_graph.json` completo?
4. Telemetría & Cross-Domain: ¿`ViewContent` restringido solo a landings? ¿UTMs + `ref_code` + puente CAPI y escape IG/FB intactos?
5. Copy & Lexicon: ¿Cero fugas de DIY/DWY/DFY/verticales/BANT/PWYW/Order Bump/Rotación Barista/Ads-First/Comprador Ideal?
Reporta honestamente APPROVED o NEEDS_REVISION con brechas concretas.""",
        schema=critic_schema,
        role="Blind Adversarial Critic",
        model="pro",
    )
    log("Phase 5 Blind Critic verdict:", critic)
