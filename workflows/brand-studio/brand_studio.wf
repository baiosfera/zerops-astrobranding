"""
brand_studio.wf — Portable Antigravity `run_workflow` 5-Phase Playbook-First Brand Pipeline (v1.2).
Compiled with Python top-level await (`ast.PyCF_ALLOW_TOP_LEVEL_AWAIT`) via `run_workflow(ScriptPath=..., Args=...)`.
Hermes/CrewAI remain strictly reserved for post-launch 24/7 monitoring & ops.
"""
PLAYBOOKS_DIR = "/mnt/localstorage/knowledge_hub/02_PLAYBOOKS_MAESTROS"

project = args["project"]
vertical = args["vertical"]
ws_dir = args["workspace_dir"].rstrip("/")
intake_mode = args.get("intake_mode", "auto")
target_country = args.get("target_country", "Colombia y Latinoamérica")
reference_urls = args.get("reference_urls", [])
envato_urls = args.get("envato_urls", [])
hub_branches = args.get("hub_branches", [])
enable_affiliate_layer = args.get("enable_affiliate_layer", True)
vsl_mode = args.get("vsl_mode", "hybrid_smart_vsl")
offer_archetype = args.get("offer_archetype", "auto")
stop_after = args.get("stop_after_phase", "phase_2_art_direction")

log(f"Starting brand-studio v1.2 for {project}/{vertical} (intake={intake_mode}, archetype={offer_archetype}, vsl={vsl_mode}, affiliates={enable_affiliate_layer}, stop_after={stop_after})")

# PHASE 1: Positioning + Live SERP Keyword Research (PB00 + PB06 + PB16)
phase("Phase 1: Posicionamiento, Hub Multirrama & Keyword Research SERP (PB00, PB06, PB16)")
seo_schema = {
    "type": "object",
    "required": ["positioning_roles", "public_brand_concepts", "multi_domain_bridge", "topic_clusters", "files_written"],
    "properties": {
        "positioning_roles": {"type": "array", "items": {"type": "string"}},
        "public_brand_concepts": {"type": "array", "items": {"type": "string"}},
        "multi_domain_bridge": {"type": "string"},
        "topic_clusters": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["cluster_id", "search_intent", "primary_keyword", "landing_route", "funnel_stage"],
                "properties": {
                    "cluster_id": {"type": "string"},
                    "search_intent": {"type": "string"},
                    "primary_keyword": {"type": "string"},
                    "landing_route": {"type": "string"},
                    "funnel_stage": {"type": "string"}
                }
            }
        },
        "files_written": {"type": "array", "items": {"type": "string"}}
    }
}
seo_res = await agent(
    f"""Fase 1 Strategist: Lee obligatoriamente los módulos clave de:
- {PLAYBOOKS_DIR}/00_category_of_one.md
- {PLAYBOOKS_DIR}/06_seo_aeo_geo_and_organic_content.md (Módulo 0 y Módulo 2 Keyword Research)
- {PLAYBOOKS_DIR}/16_personal_branding_authority_and_communities.md
Inspecciona el contexto real en {ws_dir} y /mnt/localstorage/{project}/dev/ (ecosystem.json como ÚNICA SSoT — nunca _shared/ecosystem.json —, vertical JSON, brand_brief.json o briefs Oráculo si intake_mode='{intake_mode}' es 'auto' u 'oraculo').
Si hay ramas en hub_branches ({hub_branches}), modela la arquitectura de Hub multimarca asignando 1 intención SERP por ruta y documentando el puente hacia dominios futuros sin canibalización.
Reglas SEO técnicas obligatorias (superando fallos comunes de constructores): toda landing de adquisición debe declarar `robots: index,follow` (PROHIBIDO `noindex` accidental), `<html lang>` coincidente con el idioma real del copy, jerarquía tipográfica estricta `H1 > H2 > body` y planificación explícita de `JSON-LD @graph` + `/llms.txt`.
Usa búsqueda web en vivo (exa / tavily / brave) orientada a '{target_country}' para validar demanda e intención real SERP en las palabras clave del cliente (NO inventes keywords).
Cortafuegos terminológico obligatorio: NUNCA expongas al público jerga interna ('verticales', 'DIY', 'DWY', 'DFY', 'BANT', 'PWYW', 'Order Bump', 'AEO/GEO'), y respeta únicamente los roles del fundador y conceptos públicos declarados en public_brand_concepts.
Guarda {ws_dir}/strategy/seo_clusters.json y actualiza {ws_dir}/strategy/seo.md con fuentes verificadas y devuelve el JSON estructurado.""",
    schema=seo_schema,
    role="SEO & Positioning Strategist",
    model="pro",
)
log("Phase 1 SEO clusters:", seo_res["topic_clusters"])

if stop_after != "phase_1_seo":
    # PHASE 2: Art Direction + Full-Color Orchesbrand v4.0 + Human Approval Gate
    phase("Phase 2: Dirección de Arte (taste-skill + impeccable + Orchesbrand v4.0)")
    art_schema = {
        "type": "object",
        "required": ["palette_json_path", "gallery_html_path", "chromatic_directions", "font_candidates"],
        "properties": {
            "palette_json_path": {"type": "string"},
            "gallery_html_path": {"type": "string"},
            "chromatic_directions": {"type": "array", "items": {"type": "string"}},
            "font_candidates": {"type": "array", "items": {"type": "string"}}
        }
    }
    envato_flag = f' --envato-urls "{",".join(envato_urls)}"' if envato_urls else ""
    art_res = await agent(
        f"""Fase 2 Art Director: Lee design-taste-frontend y impeccable.
Si hay URLs de referencia ({reference_urls}), inspecciónalas con firecrawl_scrape(formats=['branding', 'markdown']) para extraer psicología visual, contraste de temperatura (editorial claro, oscuro inmersivo o brutalista cálido sin sombras), geometría intencional (`0px` nítido vs `999px` píldora), acentos tipográficos (titulares display/poster + serif itálica puntual en 2–3 palabras + monoespaciado para cifras/badges) y formato media `100% WebP/AVIF` SIN copiar la identidad de ninguna referencia.
Diseña 3 ecosistemas cromáticos de alta convicción (contraste botón primario WCAG >= 4.5:1 garantizado, cero pasteles lavados ni clichés AI) en {ws_dir}/brand/art_direction_palettes.json (cada uno con light/dark, background, surface, primary, accent, text_primary).
Luego ejecuta: `orchesbrand --brand "{project}" --vertical "{vertical}" --output-dir "{ws_dir}/brand" --palette-json "{ws_dir}/brand/art_direction_palettes.json"{envato_flag} --include-shortlist --audit`
Verifica que `chroma_preview.html` y `previews/preview_gallery.html` muestran los colores reales (`--primary`, `--accent`, `--on-primary` + Mini Hero CTA). No escribas copy en esta fase.""",
        schema=art_schema,
        role="Art Director",
        model="pro",
    )
    log("Phase 2 Art Direction ready for human approval:", art_res["gallery_html_path"])

    if stop_after != "phase_2_art_direction":
        # PHASE 3: Reverse-Causality Concatenation Matrix
        phase("Phase 3: Matriz de Concatenación Total, CAPI Cross-Domain, VSL & Afiliados")
        concat_schema = {
            "type": "object",
            "required": ["matrix_path", "apotelos_valid", "links_count"],
            "properties": {
                "matrix_path": {"type": "string"},
                "apotelos_valid": {"type": "boolean"},
                "links_count": {"type": "integer"}
            }
        }
        concat_res = await agent(
            f"""Fase 3 Conversion & Telemetry Architect: Lee las secciones aplicables de PB01, PB03, PB04 (VSL/Funnels), PB05, PB07, PB13, PB14, PB16 (Módulo 6 Afiliados) y la skill ad-telemetry.
Construye {ws_dir}/strategy/concatenation_matrix.json cumpliendo MasterConcatenationMatrix (offer_archetype='{offer_archetype}', vsl_mode='{vsl_mode}'):
- topic_clusters únicos + links uniendo cluster_id -> ad_angle -> UTM externo (`allow_on_internal_links=false`, capturando `utm_source/medium/campaign/content/term`, `utm_adset`, `utm_ad`, `fbclid/gclid/wbraid/gbraid`) -> landing_route -> offer_hook -> pixel_events con host_env_prefix y shared_event_id=true -> remarketing_audience -> followup_flow.
- Modo de video: si usa `hybrid_smart_vsl`, modela autoplay silenciado + toque para sonido + barra rápida + compuerta "¿Ya viste el video?" + evento custom `VslWatched90s`; si usa `lazy_facade_video`, modela fachada WebP con duración visible (`Ver video · M:SS`) que carga el reproductor solo al clic + telemetría declarativa `data-track`.
- Arquitectura holística de oferta y garantía según oferta:
  * High-ticket / mentoría: barra de autoridad + calendario/evaluación pre-encuadrado + Garantía condicional de extensión por aplicación real.
  * Membresía / plataforma / academia: 3 planes con paridad de módulos (plan central destacado / paga 2 lleva 3) + prueba sin riesgo `$0 hoy`.
  * Producto/kit transformacional: 3 objeciones resueltas arriba + stack 10x con ancla en moneda local.
  * Hub multimarca (`hub_branches` no vacío): widget orientador flotante ("¿Te ayudo a elegir?") y rutas únicas en `hub_branches`.
- `cross_domain_bridge`: siempre que un enlace apunte a subdominio/dominio distinto de pago o app, decóralo con `fbp`, `fbc`, `src`, `event_source_url`, `utms` + `ref_code` en checkout + validación previa de correo y escape de navegador in-app IG/FB ("Abrir en Chrome/Safari" con fallback a 6s).
- Si enable_affiliate_layer={enable_affiliate_layer}: incluye `affiliate_program` (`enabled: true`, `ref_param: "ref"` paralelo a UTMs, ventana 90d, retención 30d, `self_referral_blocked: true`, `min_epc_usd >= 1.0`, `min_epl_usd >= 2.0` y `commission_tiers`).
Valida físicamente ejecutando: `apotelos validate-chain {ws_dir}/strategy/concatenation_matrix.json`. No retornes hasta Exit 0.""",
            schema=concat_schema,
            role="Conversion & Telemetry Architect",
            model="pro",
        )
        log("Phase 3 Concatenation validated:", concat_res)

        if stop_after != "phase_3_concatenation":
            # PHASE 4: Parallel Playbook-First Copy Squad + Sync Copy SSoT
            phase("Phase 4: Escuadrón Paralelo de Copy (Playbooks Íntegros -> copy/*.md -> JSON)")
            copy_units = [
                {"id": "landing_funnel_offer", "playbooks": "02_copywriting_and_neurosales.md, 03_irresistible_offers_and_pricing.md, 04_funnels_vsl_webinars_and_challenges.md, 05_web_cro_landings_and_ecommerce.md", "targets": "copy/01..04 + copy/07 (adaptado a offer_archetype: narrativa dolor día a día, disclaimer anti-hype realista, guion VSL/fachada, simulador 3 pestañas o muro de capturas reales, matriz 'Para quién sí/no', garantía condicional/trial, guía flotante en Hub, formulario 3 pasos y FAQ honesto)"},
                {"id": "lifecycle_email_wa_sales", "playbooks": "09_whatsapp_and_conversational_automation.md, 12_email_marketing_and_lifecycle_automation.md, 15_consultative_sales_and_high_ticket_closing.md", "targets": "copy/05..06"},
                {"id": "ads_social_utm_affiliates", "playbooks": "08_instagram_growth_reels_and_funnels.md, 10_tiktok_and_shortform_video.md, 11_linkedin_b2b_authority_and_ads.md, 13_meta_ads_media_buying_and_scaling.md, 14_google_ads_and_youtube_growth.md, 16_personal_branding_authority_and_communities.md (Módulo 6)", "targets": "copy/08_ads_social_and_acquisition_plan.md + copy/09_affiliate_partner_kit.md (si enable_affiliate_layer=True)"},
                {"id": "geo_schema_web_dict", "playbooks": "06_seo_aeo_geo_and_organic_content.md, 07_ad_telemetry_ga4_gtm_and_metrics.md", "targets": "web/copy_strings.es.json, web/llms_blueprint.md, web/schema_graph.json (con @graph JSON-LD real + presupuesto WebP/AVIF)"},
            ]
            copy_unit_schema = {
                "type": "object",
                "required": ["unit_id", "files_written", "anti_slop_passed"],
                "properties": {
                    "unit_id": {"type": "string"},
                    "files_written": {"type": "array", "items": {"type": "string"}},
                    "anti_slop_passed": {"type": "boolean"}
                }
            }
            copy_results = await parallel(
                copy_units,
                lambda u: agent(
                    f"""Especialista Copy/SEO ({u['id']}): Lee capítulos reales completos de {u['playbooks']} en {PLAYBOOKS_DIR} (PROHIBIDO truncar a 4000 caracteres).
Redacta {u['targets']} dentro de {ws_dir} consumiendo {ws_dir}/brand/brandbook.json, {ws_dir}/strategy/seo_clusters.json y {ws_dir}/strategy/concatenation_matrix.json.
Respeta ortografía española completa (tildes, ñ, ¿, ¡), permite únicamente public_brand_concepts declarados y PROHÍBE terminantemente jerga interna hacia el usuario final (DIY, DWY, DFY, verticales, BANT, PWYW, Order Bump, UPPER_SNAKE_CASE).
Valida cada archivo público con `anti-slop-linter --file <ruta>` y devuelve el resultado.""",
                    schema=copy_unit_schema,
                    role=f"Copy Specialist: {u['id']}",
                    model="pro",
                ),
            )
            sync_ok = await agent(
                f"Ejecuta `brand-play sync-copy --workspace {ws_dir}` para reconciliar checksums SHA-256 de copy/*.md -> web/copy_strings.es.json y confirma exit 0.",
                schema={"type": "boolean"},
                role="Copy SSoT Reconciler",
                model="flash",
            )
            log("Phase 4 Copy Squad completed; sync-copy:", sync_ok)

            if stop_after != "phase_4_copy":
                # PHASE 5: Blind Adversarial Business & Craft Critic
                phase("Phase 5: Juez Adversario Ciego (Negocio, Artesanía, SEO Real y Trazabilidad)")
                critic_schema = {
                    "type": "object",
                    "required": ["verdict", "visual_punch_score", "positioning_fidelity", "critical_gaps", "actionable_fixes"],
                    "properties": {
                        "verdict": {"type": "string", "enum": ["APPROVED", "NEEDS_REVISION"]},
                        "visual_punch_score": {"type": "integer"},
                        "positioning_fidelity": {"type": "boolean"},
                        "critical_gaps": {"type": "array", "items": {"type": "string"}},
                        "actionable_fixes": {"type": "array", "items": {"type": "string"}}
                    }
                }
                critic = await agent(
                    f"""Juez Adversario Ciego (solo lectura, mentalidad crítica senior): Audita SIN complacencia todos los artefactos de {ws_dir}:
1. Arte & UX: ¿Contraste botón primario WCAG >= 4.5:1 en chroma_manifest.json? ¿Sin pasteles lavados ni blanco/negro plano? ¿Especificación media exige 100% WebP/AVIF?
2. SEO Técnico & SERP: ¿Cero `noindex` en landings públicas? ¿Jerarquía H1 > H2 > body? ¿`web/schema_graph.json` no vacío y `seo_clusters.json` sin canibalización?
3. Trazabilidad & Cross-Domain: ¿UTMs externos + `ref_code` preservados hasta checkout? ¿Puente CAPI `cross_domain_bridge` (`fbp`, `fbc`, `src`, `event_source_url`) y escape IG/FB definidos si hay dominio externo? ¿`VslWatched90s` o fachada `lazy_facade_video` congruentes?
4. Copy & Lexicon: ¿Guion/oferta concretos para `{offer_archetype}` y CERO fugas de DIY/DWY/DFY/verticales/BANT/PWYW/Order Bump?
Reporta honestamente APPROVED o NEEDS_REVISION con brechas concretas.""",
                    schema=critic_schema,
                    role="Blind Adversarial Critic",
                    model="pro",
                )
                log("Phase 5 Blind Critic verdict:", critic)
