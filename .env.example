# Zerops AstroBranding Sovereign Environment Variables
# Copy to .env for local development: cp .env.example .env

# --- Application Core ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database & Cache (Zerops provides these automatically in runtime containers) ---
# DATABASE_URL: Managed PostgreSQL 18 connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astrobranding
# VALKEY_URL: Managed Valkey 7.2 connection string
VALKEY_URL=redis://127.0.0.1:6379

# --- Event Broker ---
# NATS_URL: NATS Server 2.12 JetStream connection string
NATS_URL=nats://localhost:4222

# --- Sovereign AI Mesh ---
# Maxim AI Bifrost Gateway
BIFROST_GATEWAY_URL=http://localhost:8080/v1
BIFROST_VIRTUAL_KEY=vk-production-main

# FreeLLMAPI Aggregator Upstream
FREELLMAPI_URL=http://localhost:3001/v1

# EvolutionGo WhatsApp Engine
EVOLUTION_GATEWAY_URL=http://localhost:8085
EVOLUTION_API_KEY=astrobranding-secret

# Nous Research Hermes-Agent Copilot
HERMES_MODEL_ENDPOINT=http://localhost:8080/v1
HERMES_MODEL_NAME=auto

# --- Storage ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=astrobranding
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
